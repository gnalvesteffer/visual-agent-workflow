@using System.Collections.Immutable
@using VisualAgentWorkflow.Core

<details class="vaw-parameter-editor">
    <summary>Workflow variables <span class="vaw-help">@VariableDefinitions.Count run-scoped values</span></summary>
    <p class="vaw-help">Variables are isolated per workflow run. This bounded Blueprint slice supports string, Boolean, integer, and finite number values through explicit Get variable and Set variable nodes.</p>
    @foreach (var (variableId, variable) in VariableDefinitions)
    {
        <fieldset @key="variableId" disabled="@Disabled">
            <legend>@variable.DisplayName · @variableId</legend>
            <label>Display name <input value="@variable.DisplayName" maxlength="128" @onchange="args => UpdateVariable(variableId, args, true)" /></label>
            <label>Default value <input value="@variable.DefaultValue" maxlength="16384" @onchange="args => UpdateVariable(variableId, args, false)" /></label>
            <label>Description <textarea rows="3" maxlength="512" placeholder="Explain what this run-scoped value represents" @onchange="args => UpdateVariableDescription(variableId, args)">@variable.Description</textarea></label>
            <label>Type <select value="@(variable.Type ?? WorkflowDataTypes.String)" @onchange="args => ChangeVariableType(variableId, args)">
                <option value="string">Text</option><option value="boolean">True / false</option><option value="integer">Integer</option><option value="number">Number</option>
            </select></label>
            <button type="button" @onclick="() => Edit(() => WorkflowVariableEditing.Remove(Definition, variableId))" disabled="@Disabled">Remove variable</button>
        </fieldset>
    }
    <div class="vaw-controls">
        <label>Variable ID <input @bind="newVariableId" maxlength="64" placeholder="current-count" disabled="@Disabled" /></label>
        <label>Display name <input @bind="newVariableName" maxlength="128" placeholder="Current count" disabled="@Disabled" /></label>
        <label>Default value <input @bind="newVariableDefault" maxlength="16384" placeholder="0" disabled="@Disabled" /></label>
        <label>Description <input @bind="newVariableDescription" maxlength="512" placeholder="Value shared by this run" disabled="@Disabled" /></label>
        <label>Type <select @bind="newVariableType" disabled="@Disabled">
            <option value="string">Text</option><option value="boolean">True / false</option><option value="integer">Integer</option><option value="number">Number</option>
        </select></label>
        <button type="button" @onclick="AddVariable" disabled="@Disabled">Add variable</button>
    </div>
    @if (error is not null) { <p class="vaw-error" role="alert">@error</p> }
</details>

@code {
    [Parameter, EditorRequired] public WorkflowDefinition Definition { get; set; } = default!;
    [Parameter] public EventCallback<WorkflowDefinition> DefinitionChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private string newVariableId = "", newVariableName = "", newVariableDefault = "", newVariableDescription = "";
    private string newVariableType = WorkflowDataTypes.String;
    private string? error;
    private ImmutableSortedDictionary<string, WorkflowVariableDefinition> VariableDefinitions =>
        Definition.Variables ?? ImmutableSortedDictionary<string, WorkflowVariableDefinition>.Empty;

    private async Task AddVariable()
    {
        var id = newVariableId.Trim();
        await Edit(() => WorkflowVariableEditing.Add(Definition, id,
            string.IsNullOrWhiteSpace(newVariableName) ? id : newVariableName.Trim(), newVariableDefault,
            EmptyToNull(newVariableDescription), newVariableType));
        if (error is null) { newVariableId = ""; newVariableName = ""; newVariableDefault = ""; newVariableDescription = ""; }
    }

    private Task UpdateVariable(string id, ChangeEventArgs args, bool displayName)
    {
        var existing = VariableDefinitions[id];
        return Edit(() => WorkflowVariableEditing.Update(Definition, id,
            displayName ? args.Value?.ToString() ?? "" : existing.DisplayName,
            displayName ? existing.DefaultValue : args.Value?.ToString() ?? ""));
    }

    private Task UpdateVariableDescription(string id, ChangeEventArgs args) =>
        Edit(() => WorkflowVariableEditing.UpdateDescription(Definition, id, EmptyToNull(args.Value?.ToString())));

    private Task ChangeVariableType(string id, ChangeEventArgs args)
    {
        var type = args.Value?.ToString() ?? WorkflowDataTypes.String;
        return Edit(() => WorkflowVariableEditing.SetType(Definition, id, type, VariableDefinitions[id].DefaultValue));
    }

    private async Task Edit(Func<WorkflowDefinition> change)
    {
        if (Disabled) return;
        try { error = null; await DefinitionChanged.InvokeAsync(change()); }
        catch (ArgumentException exception) { error = exception.Message; }
    }

    private static string? EmptyToNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
