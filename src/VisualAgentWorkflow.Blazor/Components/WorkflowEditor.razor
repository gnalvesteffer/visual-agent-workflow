    private string NodeKey(NodeDefinition node) => node.Agent is { } agent ? $"agent:{agent.ProviderId}" :
        node.Tool is { } tool && Bindings.FirstOrDefault(binding => BindingMatches(tool, binding)) is { } currentBinding ? ToolKey(currentBinding) :
        node.Tool is { } unavailable ? $"mcp:{unavailable.BindingId}:{unavailable.ContractHash}:{unavailable.DescriptionHash}" : node.Type;
    private static bool BindingMatches(ToolBindingRequest request, ToolBindingDescriptor binding) =>
        request.BindingId == binding.BindingId && request.ContractHash == binding.ContractHash &&
        (request.DescriptionHash is null || request.DescriptionHash == binding.DescriptionHash);
    private string ToolBindingStatus(ToolBindingRequest request) => Bindings.FirstOrDefault(binding => binding.BindingId == request.BindingId) switch
    {
        null => "is unavailable",
        { ContractHash: var contractHash } when contractHash != request.ContractHash => "schema has changed",
        { DescriptionHash: var descriptionHash } when request.DescriptionHash is not null && descriptionHash != request.DescriptionHash => "description has changed",
        _ => "is unavailable"
    };
    private static string ToolInputSummary(ToolBindingDescriptor binding) => binding.InputSummary;
    private static System.Collections.Immutable.ImmutableArray<McpInputPortDefinition> McpInputPorts(ToolBindingDescriptor binding)
    {
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(binding.InputSchemaJson);
            if (!document.RootElement.TryGetProperty("properties", out var properties) || properties.ValueKind != System.Text.Json.JsonValueKind.Object)
                return [];
            var required = document.RootElement.TryGetProperty("required", out var requiredValues) && requiredValues.ValueKind == System.Text.Json.JsonValueKind.Array
                ? requiredValues.EnumerateArray().Where(value => value.ValueKind == System.Text.Json.JsonValueKind.String).Select(value => value.GetString()!).ToHashSet(StringComparer.Ordinal)
                : new HashSet<string>(StringComparer.Ordinal);
            return [.. properties.EnumerateObject().Select(property => new McpInputPortDefinition(
                $"arg.{property.Name}", property.Name, McpPortDataType(property.Value), required.Contains(property.Name)))];
        }
        catch (System.Text.Json.JsonException)
        {
            return [];
        }
    }

    private static System.Collections.Generic.IReadOnlyDictionary<string, string> McpInputDescriptions(ToolBindingDescriptor binding)
    {
        const int maximumDescriptionLength = 2048;
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(binding.InputSchemaJson);
            if (!document.RootElement.TryGetProperty("properties", out var properties) || properties.ValueKind != System.Text.Json.JsonValueKind.Object)
                return new Dictionary<string, string>(StringComparer.Ordinal);

            var descriptions = new Dictionary<string, string>(StringComparer.Ordinal);
            foreach (var property in properties.EnumerateObject())
            {
                if (!property.Value.TryGetProperty("description", out var description) || description.ValueKind != System.Text.Json.JsonValueKind.String)
                    continue;
                var value = description.GetString()?.Trim();
                if (value is not null && value.Length <= maximumDescriptionLength && !value.Any(character => char.IsControl(character) && character is not '\r' and not '\n' and not '\t'))
                    descriptions.TryAdd($"arg.{property.Name}", value);
            }
            return descriptions;
        }
        catch (System.Text.Json.JsonException)
        {
            return new Dictionary<string, string>(StringComparer.Ordinal);
        }
    }

    private static string McpPortDataType(System.Text.Json.JsonElement schema) =>
        schema.TryGetProperty("type", out var type) && type.ValueKind == System.Text.Json.JsonValueKind.String && type.GetString() is "string" or "integer" or "number" or "boolean"
            ? type.GetString()!
            : "json";

    private System.Collections.Immutable.ImmutableArray<WorkflowPortDescriptor> CanvasPorts(NodeDefinition node)
    {
        if (WorkflowSchemaVersions.UsesExplicitGraph(Definition) && node.Type == NodeTypes.McpTool && SchemaDrivenMcpPins)
        {
            var ports = node.McpInputPorts ?? (Bindings.FirstOrDefault(binding => node.Tool is not null && BindingMatches(node.Tool, binding)) is { } binding
                ? McpInputPorts(binding)
                : []);
            var descriptions = Bindings.FirstOrDefault(binding => node.Tool is not null && BindingMatches(node.Tool, binding)) is { } matchingBinding
                ? McpInputDescriptions(matchingBinding)
                : null;
            return WorkflowPorts.Explicit(node, ports, descriptions);
        }
        return WorkflowSchemaVersions.UsesExplicitGraph(Definition)
            ? WorkflowPorts.Explicit(node)
            : [.. WorkflowPorts.Inputs(node).Select(port => new WorkflowPortDescriptor(port.Id, WorkflowPortDirection.Input, WorkflowPortKind.Data, port.DataType)),
                .. WorkflowPorts.Outputs(node).Select(port => new WorkflowPortDescriptor(port.Id, WorkflowPortDirection.Output, WorkflowPortKind.Data, port.DataType))];
    }
    private NodeDefinition FromSelection(string value, NodeDefinition? existing = null)
    {
        if (value == NodeTypes.StringConstant)
            return new(NodeTypes.StringConstant, "1.0.0") { StringConstant = existing?.StringConstant ?? new("") };
        if (value == NodeTypes.TextConcat) return new(NodeTypes.TextConcat, "1.0.0");
        if (value == NodeTypes.StringEquals) return new(NodeTypes.StringEquals, "1.0.0");
        if (value == NodeTypes.BooleanBranch) return new(NodeTypes.BooleanBranch, "1.0.0");
        if (value == NodeTypes.BooleanConstant)
            return new(NodeTypes.BooleanConstant, "1.0.0") { BooleanConstant = existing?.BooleanConstant ?? new(false) };
        if (value == NodeTypes.BooleanNot) return new(NodeTypes.BooleanNot, "1.0.0");
        if (value == NodeTypes.IntegerConstant)
            return new(NodeTypes.IntegerConstant, "1.0.0") { IntegerConstant = existing?.IntegerConstant ?? new(0) };
        if (value == NodeTypes.NumberConstant)
            return new(NodeTypes.NumberConstant, "1.0.0") { NumberConstant = existing?.NumberConstant ?? new(0d) };
        if (value == NodeTypes.IntegerAdd) return new(NodeTypes.IntegerAdd, "1.0.0");
        if (value == NodeTypes.NumberAdd) return new(NodeTypes.NumberAdd, "1.0.0");
        if (value == NodeTypes.IntegerEquals) return new(NodeTypes.IntegerEquals, "1.0.0");
        if (value == NodeTypes.JsonSelectString)
            return new(NodeTypes.JsonSelectString, "1.0.0") { JsonPropertySelection = existing?.JsonPropertySelection ?? new("/name") };
        if (value == NodeTypes.JsonProject)
            return new(NodeTypes.JsonProject, "1.0.0") { JsonProjection = existing?.JsonProjection ?? new([new("name", "/name")]) };
        if (value == NodeTypes.TextTemplate)
            return new(NodeTypes.TextTemplate, "1.0.0") { TextTemplate = existing?.TextTemplate ?? new([new("input", "")]) };
        if (value == NodeTypes.WorkflowValue)
        {
            var parameterId = ParameterDefinitions
                .Where(pair => Definition.SchemaVersion is not (WorkflowSchemaVersions.IntegerGraph or WorkflowSchemaVersions.ConfigurableParallelGraph or WorkflowSchemaVersions.NumberPropagationGraph or WorkflowSchemaVersions.NumberArithmeticGraph) || WorkflowParameterGraphTypes.DataType(pair.Value, Definition.SchemaVersion is WorkflowSchemaVersions.NumberPropagationGraph or WorkflowSchemaVersions.NumberArithmeticGraph) is not null)
                .Select(pair => pair.Key).FirstOrDefault();
            var outputType = (Definition.SchemaVersion is WorkflowSchemaVersions.IntegerGraph or WorkflowSchemaVersions.ConfigurableParallelGraph or WorkflowSchemaVersions.NumberPropagationGraph or WorkflowSchemaVersions.NumberArithmeticGraph) && parameterId is not null
                ? WorkflowParameterGraphTypes.DataType(ParameterDefinitions[parameterId], Definition.SchemaVersion is WorkflowSchemaVersions.NumberPropagationGraph or WorkflowSchemaVersions.NumberArithmeticGraph)
                : null;
            return new(NodeTypes.WorkflowValue, "1.0.0") { ParameterId = parameterId, OutputDataType = outputType };
        }
        if (FunctionCatalog?.List().FirstOrDefault(item => FunctionKey(item.Function) == value) is { } function)
            return new(NodeTypes.FunctionCall, "1.0.0") { GraphFunction = function.Function };
        var provider = Providers.SingleOrDefault(p => ProviderKey(p) == value);
        if (provider is not null) return new(NodeTypes.Agent, "1.0.0", Agent: (existing?.Agent ?? new(provider.ProviderId, null,
            "Use assigned tools when available and return the result.", [])) with { ProviderId = provider.ProviderId });
        var binding = Bindings.SingleOrDefault(b => ToolKey(b) == value);
        return binding is null ? new(value, "1.0.0") : new(NodeTypes.McpTool, "1.0.0", new(binding.BindingId, binding.ContractHash)
        { DescriptionHash = binding.DescriptionHash }) { McpInputPorts = SchemaDrivenMcpPins ? McpInputPorts(binding) : null };
    }

