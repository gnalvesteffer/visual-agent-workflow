    {
        var routes = (args.Value?.ToString() ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(line => line.Split('|', 3, StringSplitOptions.TrimEntries))
            .Select(parts => parts.Length == 3
                ? new AgentExecutionRoute(parts[0], parts[1], parts[2])
                : throw new ArgumentException("Enter each route as stable-id | Label | Description."))
            .ToImmutableArray();
        if (routes.Length > AgentExecutionRouteLimits.MaximumRoutes)
            throw new ArgumentException($"An agent can have at most {AgentExecutionRouteLimits.MaximumRoutes} execution routes.");
        if (!routes.IsEmpty && Definition.ExecutionConnections is null)
            throw new ArgumentException("Agent-selected routes require explicit execution wires. This workflow uses implicit linear execution.");
        var node = Definition.Nodes[id];
        var definition = Definition with
        {
            SchemaVersion = routes.IsEmpty ? Definition.SchemaVersion : WorkflowSchemaVersions.AgentExecutionRoutes,
            Nodes = Definition.Nodes.SetItem(id, node with { Agent = node.Agent! with { Routes = routes.IsEmpty ? null : routes } })
        };
        return definition;
    });
