<section class="vaw-workflow-editor" aria-label="Visual workflow editor">
    @if (!ReadOnly && WorkflowValidator.Validate(Definition) is { Length: > 0 } validationIssues)
    {
        <section class="vaw-graph-issues" role="alert" aria-label="Workflow validation issues">
            <h3>Workflow has @validationIssues.Length unresolved issue(s)</h3>
            <p>Save is allowed. Publishing and execution require fixing every issue.</p>
            <ul>@foreach (var issue in validationIssues) { <li><strong>@issue.Path</strong> · @issue.Message</li> }</ul>
        </section>
    }
    @if (!ReadOnly)
    {
        <details class="vaw-parameter-editor">
            <summary>Workflow parameters <span class="vaw-help">@ParameterDefinitions.Count configurable values</span></summary>
            <p class="vaw-help">Define non-secret string, integer, number, boolean, or choice inputs. Workflow value nodes pass the validated value through the graph.</p>
            @foreach (var (parameterId, parameter) in ParameterDefinitions)
            {
                <fieldset @key="parameterId" disabled="@Disabled">
                    <legend>@parameter.DisplayName · @parameterId</legend>
                    <label>Display name <input value="@parameter.DisplayName" maxlength="128" @onchange="args => UpdateParameter(parameterId, args, true)" /></label>
                    <label>Default value <textarea value="@parameter.DefaultValue" maxlength="16384" rows="2" @onchange="args => UpdateParameter(parameterId, args, false)"></textarea></label>
                    <label>Description <textarea value="@parameter.Description" maxlength="512" rows="2" placeholder="Explain what this value controls" @onchange="args => UpdateParameterDescription(parameterId, args)"></textarea></label>
                    <label>Type <select value="@(parameter.Type ?? "string")" @onchange="args => ChangeParameterType(parameterId, args)">
                        <option value="string">Text</option><option value="integer">Integer</option><option value="number">Number</option><option value="boolean">True / false</option><option value="choice">Choice</option>
                    </select></label>
                    @if (parameter.Type == "choice")
                    { <label>Allowed choices <input value="@string.Join(",", parameter.Choices ?? [])" @onchange="args => ChangeChoices(parameterId, args)" placeholder="default,low,medium,high" /></label> }
            <button type="button" @onclick="() => Edit(() => WorkflowParameterEditing.Remove(Definition, parameterId))" disabled="@(Disabled || ParameterIsReferenced(parameterId))">Remove parameter</button>
                </fieldset>
            }
            <div class="vaw-controls">
                <label>Parameter ID <input @bind="newParameterId" maxlength="64" placeholder="model-name" disabled="@Disabled" /></label>
                <label>Display name <input @bind="newParameterName" maxlength="128" placeholder="Model name" disabled="@Disabled" /></label>
                <label>Default value <input @bind="newParameterDefault" maxlength="16384" placeholder="qwen3.8-9b" disabled="@Disabled" /></label>
                <label>Description <input @bind="newParameterDescription" maxlength="512" placeholder="Model to use for each agent" disabled="@Disabled" /></label>
                <button type="button" @onclick="AddParameter" disabled="@Disabled">Add parameter</button>
            </div>
        </details>
    }
    <WorkflowGraphCanvas @ref="canvas" @key="Definition.WorkflowId" Definition="Definition" Layout="EffectiveLayout" LayoutChanged="LayoutEdited" ReadOnly="@(ReadOnly || LayoutReadOnly)" Disabled="Disabled" SelectedNodeId="@selectedNode" SelectedNodeIdChanged="SelectNode" ConnectionSelected="ConnectionSelected" ConnectionDisconnectRequested="id => Edit(() => GraphEditing.Disconnect(Definition, id))" ConnectionRequested="pins => Edit(() => GraphEditing.ConnectPins(Definition, pins.SourceId, pins.SourcePort, pins.TargetId, pins.TargetPort))" ShowNodeLibrary="@(!ReadOnly)" EnableContextMenu="@(!ReadOnly && !Disabled)" NodeCreateRequested="request => AddLibraryNode(request.Key, request.Context)" DeleteNodeRequested="id => RemoveSelected(id)">
    <ToolbarContent>@EditorActions</ToolbarContent>
    <NodeLibrary>
        @if (CanUpgradeBlankGraph)
        {
            <section class="vaw-library-note" aria-label="Typed graph preview">
                <strong>Typed graph preview</strong>
                <p class="vaw-help">Start a draft with separate execution and value wires. This preview currently supports text constants and concatenation.</p>
                <button type="button" @onclick="EnableExplicitPreview" disabled="@Disabled">Start typed graph preview</button>
            </section>
        }
        @if (CanUpgradeBranchGraph)
        {
            <section class="vaw-library-note" aria-label="Boolean branch preview">
                <strong>Boolean Branch preview</strong>
                <p class="vaw-help">Add ordinal string comparison, a typed Boolean Branch, and success or failure termination routes. The new nodes remain unconnected until you wire them.</p>
                <button type="button" @onclick="EnableBranchPreview" disabled="@Disabled">Enable Boolean Branch preview</button>
            </section>
        }
        @if (CanUpgradeTypedBooleanGraph)
        {
            <section class="vaw-library-note" aria-label="Typed Boolean primitives">
                <strong>Typed Boolean primitives</strong>
                <p class="vaw-help">Add explicit true/false constants and Boolean NOT. These pure nodes only compute when a downstream data input requests their value.</p>
                <button type="button" @onclick="EnableTypedBooleanPreview" disabled="@Disabled">Enable Boolean primitives</button>
            </section>
        }
        @if (CanUpgradeBooleanTopology)
        {
            <section class="vaw-library-note" aria-label="Boolean branch topology">
                <strong>Boolean branch topology</strong>
                <p class="vaw-help">Allow up to eight Boolean Branch nodes and sixteen success/failure exits. Each reached Branch takes one wired route; a structurally connected Output may still be unreachable for particular values.</p>
                <button type="button" @onclick="EnableBooleanTopologyPreview" disabled="@Disabled">Enable branch topologies</button>
            </section>
        }
        @if (CanUpgradePureGraphFunctions)
        {
            <section class="vaw-library-note" aria-label="Pure graph functions">
                <strong>Pure graph functions</strong>
                <p class="vaw-help">Upgrade this valid graph to insert pinned, reusable string/Boolean function snapshots as lazy data nodes.</p>
                <button type="button" @onclick="EnablePureGraphFunctionsPreview" disabled="@Disabled">Enable pure graph functions</button>
            </section>
        }
        @if (CanUpgradeAgentGraphFunctionTools)
        {
            <section class="vaw-library-note" aria-label="Agent graph-function tools">
                <strong>Agent graph-function tools</strong>
                <p class="vaw-help">Upgrade this valid pure graph to add scheduled Agent nodes. Each agent can expose selected immutable pure function revisions as bounded tools.</p>
                <button type="button" @onclick="EnableAgentGraphFunctionToolsPreview" disabled="@Disabled">Enable agent function tools</button>
            </section>
        }
        <WorkflowNodeLibrary Entries="LibraryEntries()" Disabled="Disabled" OnSelected="key => AddLibraryNode(key)" />
        <p class="vaw-help">Click to add an unconnected node. Connect its pins when ready; use a wire menu to explicitly insert into a path.</p>
        <p class="vaw-insertion-hint">@InsertionDescription(null)</p>
        @if (SelectedOutputs.Length > 1)
        {
            <label>Insert on output<select aria-label="Insert on output" @bind="selectedPort">
                @foreach (var port in SelectedOutputs) { <option value="@port.Id">@port.Id</option> }
            </select></label>
        }
    </NodeLibrary>
    <ContextMenu Context="context">
        <p class="vaw-insertion-hint">@InsertionDescription(context)</p>
        @if (context.ConnectionId is null && SelectedOutputs.Length > 1)
        {
            <label>Insert on output<select aria-label="Context output" @bind="selectedPort">
                @foreach (var port in SelectedOutputs) { <option value="@port.Id">@port.Id</option> }
            </select></label>
        }
        <WorkflowNodeLibrary @key="context.Id" Title="Add node" SearchLabel="Search node actions" Entries="LibraryEntries(context)"
            Disabled="Disabled" OnSelected="key => AddLibraryNode(key, context)" />
        @if (context.NodeId is { } contextNode)
        {
            <div class="vaw-context-actions">
                <button type="button" @onclick="() => CloseMenu(context)">Edit selected node properties</button>
                <button type="button" disabled="@(!CanDuplicate(contextNode))" @onclick="() => Duplicate(contextNode, context)">Duplicate node</button>
                <button type="button" disabled="@(!CanRemove(contextNode))" @onclick="() => RemoveSelected(contextNode, context)">@(Definition.Nodes[contextNode].Type == NodeTypes.Merge ? "Remove merge and split paths" : Definition.Nodes[contextNode].Type is NodeTypes.ParallelFork or NodeTypes.ParallelBranch or NodeTypes.ParallelJoin ? "Remove parallel block…" : Definition.Nodes[contextNode].Type == NodeTypes.Loop ? "Remove loop (run body once)" : "Delete node")</button>
                @if (Definition.Nodes[contextNode].Type == NodeTypes.Condition)
                { <button type="button" disabled="@Disabled" @onclick="() => RequestBlockRemoval(contextNode, context)">Remove conditional block…</button> }
            </div>
        }
        @if (context.ConnectionId is not null)
        { <button type="button" @onclick="() => Reroute(context)">Add reroute here</button>
          <button type="button" @onclick="() => Disconnect(context.ConnectionId!, context)">Disconnect wire</button> }
    </ContextMenu>
        <NodeContent Context="id">
            @if (Definition.Nodes.TryGetValue(id, out var summaryNode)) { <p class="vaw-node-summary">@Summary(summaryNode)</p> }
        </NodeContent>
        <NodeInspector Context="id">
            @if (Definition.Nodes.TryGetValue(id, out var node))
            {
            var index = Order.IndexOf(id);
            var terminal = node.Type is NodeTypes.Input or NodeTypes.Output;
                    @if (node.Type == NodeTypes.Input && WorkflowSchemaVersions.UsesExplicitGraph(Definition.SchemaVersion))
                    {
                        <p>The <strong>then</strong> pin activates the workflow path. The <strong>out</strong> pin is a value dependency and does not activate nodes.</p>
                    }
                    else if (node.Type == NodeTypes.Input && !ReadOnly)
                    {
                        <p>The workflow input is text by default.</p>
                        @if (node.InputDataType == "json")
                        { <p class="vaw-help">This input is validated JSON. Add a JSON projection or select a value with an RFC 6901 pointer.</p> }
                        else
                        { <button type="button" @onclick="() => Edit(() => GraphEditing.InsertJsonSelectorAfterInput(Definition, id))" disabled="@(Disabled || Definition.Nodes.Count >= 256)">Use JSON input and add a value selector</button> }
                    }
                    else if (node.Type == NodeTypes.JsonSelectString)
                    {
                        <label>JSON Pointer
                            <input aria-label="JSON pointer for @id" value="@node.JsonPropertySelection!.Pointer" @onchange="args => JsonPointer(id, args)" maxlength="1024" disabled="@Disabled" />
                        </label>
                        <p class="vaw-help">Uses RFC 6901 paths such as <code>/customer/name</code>. Strings become text; other JSON values become compact JSON.</p>
                    }
                    else if (node.Type == NodeTypes.JsonProject)
                    {
                        <fieldset disabled="@Disabled">
                            <legend>Output JSON fields</legend>
                            <p class="vaw-help">Each field copies a value from the incoming JSON using a JSON Pointer. No expressions or input values are evaluated.</p>
                            @foreach (var (field, fieldIndex) in node.JsonProjection!.Fields.Select((field, fieldIndex) => (field, fieldIndex)))
                            {
                                <fieldset @key="fieldIndex">
                                    <legend>Field @(fieldIndex + 1)</legend>
                                    <label>Output property <input aria-label="JSON output property @fieldIndex for @id" value="@field.Name" maxlength="@JsonProjectionLimits.MaximumNameCharacters" @onchange="args => JsonProjectionName(id, fieldIndex, args)" disabled="@Disabled" /></label>
                                    <label>JSON Pointer <input aria-label="JSON pointer @fieldIndex for @id" value="@field.Pointer" maxlength="@WorkflowJsonPointer.MaximumLength" @onchange="args => JsonProjectionPointer(id, fieldIndex, args)" disabled="@Disabled" /></label>
                                    <label>Expected JSON type
                                        <select aria-label="Expected JSON type for field @fieldIndex on @id" value="@(field.ValueSchema?.Type ?? field.ValueType ?? "any")" @onchange="args => JsonProjectionType(id, fieldIndex, args)" disabled="@Disabled">
                                            @foreach (var valueType in JsonProjectionLimits.ValueTypes) { <option value="@valueType">@valueType</option> }
                                        </select>
                                    </label>
                                    <p class="vaw-help">The run fails at this node if the selected value does not match this type.</p>
                                    @if (field.ValueSchema is { } valueSchema)
                                    {
                                        <JsonValueSchemaEditor Schema="valueSchema" SchemaChanged="schema => JsonProjectionSchema(id, fieldIndex, schema)"
                                                               EditorLabel="@($"JSON field {fieldIndex} {field.Name}")" Depth="1" Disabled="@Disabled" />
                                    }
                                    <button type="button" @onclick="() => RemoveJsonProjectionField(id, fieldIndex)" disabled="@(Disabled || node.JsonProjection.Fields.Length <= 1)">Remove field</button>
                                </fieldset>
                            }
                            <button type="button" @onclick="() => AddJsonProjectionField(id)" disabled="@(Disabled || node.JsonProjection.Fields.Length >= JsonProjectionLimits.MaximumFields)">Add JSON field</button>
                        </fieldset>
                    }
                    else if (node.Type == NodeTypes.TextTemplate)
                    {
                        <fieldset disabled="@Disabled">
                            <legend>Text template</legend>
                            <p class="vaw-help">Build deterministic text from the incoming value and declared workflow parameters. References are tokens, not expressions.</p>
                            <PromptTemplateEditor EditorLabel="Template text" Value="node.TextTemplate!" Parameters="ParameterDefinitions" ValueChanged="template => SetTextTemplate(id, template)" Disabled="Disabled" />
                        </fieldset>
                    }
                    else if (node.Type == NodeTypes.StringConstant)
                    {
                        <label>Constant value
                            <textarea aria-label="String constant value for @id" rows="3" maxlength="16384" value="@node.StringConstant?.Value" @onchange="args => ChangeStringConstant(id, args)" disabled="@Disabled"></textarea>
                        </label>
                        <p class="vaw-help">Pure value node. It is evaluated only when a connected data input needs it.</p>
                    }
                    else if (node.Type == NodeTypes.TextConcat)
                    {
                        <p>Concatenates the <strong>left</strong> and <strong>right</strong> string inputs when a downstream data input requests its output. It does not activate through execution wires.</p>
                    }
                    else if (node.Type == NodeTypes.StringEquals)
                    {
                        <p>Compares the <strong>left</strong> and <strong>right</strong> string values using ordinal, case-sensitive equality. Its output is a Boolean value.</p>
                    }
                    else if (node.Type == NodeTypes.BooleanBranch)
                    {
                        <p>Reads a Boolean data value and activates exactly one execution output: <strong>true</strong> or <strong>false</strong>. It never converts text to a Boolean.</p>
                    }
                    else if (node.Type == NodeTypes.BooleanConstant)
                    {
                        <label>Boolean value
                            <select aria-label="Boolean constant value for @id" value="@(node.BooleanConstant?.Value == true ? "true" : "false")" @onchange="args => ChangeBooleanConstant(id, args)" disabled="@Disabled">
                                <option value="true">True</option>
                                <option value="false">False</option>
                            </select>
                        </label>
                        <p class="vaw-help">Pure value node. It does not activate through an execution wire.</p>
                    }
                    else if (node.Type == NodeTypes.BooleanNot)
                    {
                        <p>Outputs the opposite of its Boolean <strong>value</strong> input. It never accepts or produces text.</p>
                    }
                    else if (node.Type == NodeTypes.FunctionCall && node.GraphFunction is { } function)
                    {
                        <fieldset>
                            <legend>Pure graph function</legend>
                            <p>@function.Definition.Description</p>
                            <dl>
                                <dt>Function</dt><dd>@function.Definition.DisplayName</dd>
                                <dt>Identity</dt><dd>@function.Definition.FunctionId</dd>
                                <dt>Version</dt><dd>@function.Definition.Version</dd>
                                <dt>Effect</dt><dd>Deterministic · no external capabilities</dd>
                                <dt>Content hash</dt><dd><code>@function.ContentHash</code></dd>
                            </dl>
                            <h5>Inputs</h5>
                            <ul>@foreach (var (portId, port) in function.Definition.Inputs) { <li>@port.DisplayName · <code>@portId</code> · @port.DataType</li> }</ul>
                            <h5>Outputs</h5>
                            <ul>@foreach (var (portId, port) in function.Definition.Outputs) { <li>@port.DisplayName · <code>@portId</code> · @port.DataType</li> }</ul>
                            <p class="vaw-help">This call is a lazy data node, not an execution step. The exact function graph is embedded in this workflow revision. Studio does not yet provide a separate function library/editor.</p>
                        </fieldset>
                    }
                    else if (node.Type == NodeTypes.WorkflowCall)
                    {
                        <p>This node executes the embedded workflow revision. Its input and output pins inherit the child workflow’s declared string or JSON types. The workflow ID, revision, version, and content hash are pinned in this node. Its tools, model providers, and skills remain subject to the host’s configured catalogs and grants.</p>
                        @if (node.WorkflowCall is { } child)
                        {
                            <dl><dt>Workflow</dt><dd>@child.WorkflowId</dd><dt>Version</dt><dd>@child.Version</dd><dt>Input type</dt><dd>@WorkflowCallInputType(child.Definition)</dd><dt>Output type</dt><dd>@WorkflowCallOutputType(child.Definition)</dd><dt>Revision</dt><dd><code>@child.RevisionId</code></dd><dt>Content hash</dt><dd><code>@child.ContentHash</code></dd></dl>
                            var childParameters = child.Definition.Parameters ?? System.Collections.Immutable.ImmutableSortedDictionary<string, WorkflowParameterDefinition>.Empty;
                            @if (childParameters.Count > 0)
                            {
                                <fieldset disabled="@(ReadOnly || Disabled)">
                                    <legend>Child workflow parameters</legend>
                                    <p class="vaw-help">Map declared values from this workflow into the pinned child. Unmapped values keep their child defaults. Only compatible types are offered.</p>
                                    @foreach (var (childParameterId, childParameter) in childParameters)
                                    {
                                        var mappedParentId = child.ParameterMappings?.FirstOrDefault(mapping => mapping.ChildParameterId == childParameterId)?.ParentParameterId ?? "";
                                        <label>@childParameter.DisplayName · @childParameterId
                                            <select aria-label="Parent value for child parameter @childParameterId on @id" value="@mappedParentId" @onchange="args => MapChildParameter(id, childParameterId, args)" disabled="@Disabled">
                                                <option value="">Use child default</option>
                                                @foreach (var (parentParameterId, parentParameter) in ParameterDefinitions.Where(pair => WorkflowParameters.AreCompatible(pair.Value, childParameter)))
                                                { <option value="@parentParameterId">@parentParameter.DisplayName · @parentParameterId</option> }
                                            </select>
                                        </label>
                                    }
                                </fieldset>
                            }
                        }
                        @if (!ReadOnly) { <button type="button" @onclick="() => RemoveSelected(id)" disabled="@Disabled">Remove workflow call</button> }
                    }
                    else if (node.Type == NodeTypes.Loop)
                    {
                        <p>A bounded loop sends the current text through the body while the predicate matches. The loop stops when it no longer matches or reaches its maximum. The body anchor is on the graph; insert deterministic steps, agents, or MCP tools after it. Only one linear body is supported in this version.</p>
                        @if (!ReadOnly)
                        {
                            <label>Continue while
                                <select aria-label="Loop predicate operator for @id" value="@node.Loop!.ContinueWhile.Operator" @onchange="args => LoopOperator(id, args)" disabled="@Disabled">
                                    <option value="equals">Equals</option><option value="contains">Contains</option><option value="starts-with">Starts with</option><option value="is-empty">Is empty</option>
                                </select>
                            </label>
                            <label>Match text
                                <input aria-label="Loop predicate text for @id" value="@node.Loop!.ContinueWhile.Operand" @onchange="args => LoopOperand(id, args)" maxlength="1024" disabled="@(Disabled || node.Loop.ContinueWhile.Operator == "is-empty")" />
                            </label>
                            <label>Maximum iterations
                                <input aria-label="Maximum loop iterations for @id" type="number" min="1" max="@WorkflowLoopLimits.MaximumIterations" step="1" value="@node.Loop.MaximumIterations" @onchange="args => LoopMaximumIterations(id, args)" disabled="@Disabled" />
                            </label>
                            <p class="vaw-help">Maximum: @WorkflowLoopLimits.MaximumIterations iterations per run. Iteration starts, completions, and stop reason are recorded for playback.</p>
                            <button type="button" @onclick="() => RemoveSelected(id)" disabled="@Disabled" aria-label="Remove bounded loop @id">Remove loop and run body once</button>
                        }
                        else
                        { <p>Continue while @node.Loop!.ContinueWhile.Operator @node.Loop.ContinueWhile.Operand · maximum @node.Loop.MaximumIterations iterations.</p> }
                    }
                    else if (node.Type == NodeTypes.LoopBody)
                    {
                        <p>Start of the loop body. Insert text transforms, workflow values, agents, or MCP tools after this anchor. The body must return to the loop input.</p>
                    }
                    else if (node.Type == NodeTypes.Approval)
                    {
                        <p>Review the exact next MCP call. Approval does not grant tool access.</p>
                        @if (ReadOnly) { <pre>@node.Approval!.Prompt</pre> }
                        else
                        {
                            <label>Approval prompt<textarea aria-label="Approval prompt for @id" value="@node.Approval!.Prompt" @onchange="args => ApprovalPrompt(id, args)" maxlength="2000" rows="3" disabled="@Disabled"></textarea></label>
                            <button type="button" @onclick="() => Edit(() => GraphEditing.RemoveApproval(Definition, id))" disabled="@Disabled" aria-label="Remove approval @id">Remove approval step</button>
                        }
                    }
                    else if (node.Type == NodeTypes.ParallelFork)
                    {
                        <p>Starts both branches concurrently with the same input. Connect each output to its matching branch anchor. A branch failure fails the workflow; side effects already performed by another branch are not rolled back.</p>
                        @if (pendingParallelBlockRemoval == id)
                        {
                            <section aria-label="Confirm parallel block removal">
                                <p>Remove this parallel block and its @pendingParallelBlockNodes.Length nodes, then reconnect its original input to the following node?</p>
                                <ul>
                                    @foreach (var removedId in pendingParallelBlockNodes)
                                    { <li>@(string.IsNullOrWhiteSpace(EffectiveLayout.Nodes[removedId].Label) ? WorkflowGraphCanvas.FriendlyName(Definition.Nodes[removedId]) : EffectiveLayout.Nodes[removedId].Label) · @removedId</li> }
                                </ul>
                                <button type="button" disabled="@Disabled" @onclick="ConfirmParallelBlockRemoval">Remove parallel block and reconnect</button>
                                <button type="button" @onclick="CancelParallelBlockRemoval">Cancel block removal</button>
                            </section>
                        }
                        else if (!ReadOnly)
                        { <button type="button" disabled="@Disabled" @onclick="() => RequestParallelBlockRemoval(id)">Remove parallel block…</button> }
                    }
                    else if (node.Type == NodeTypes.ParallelBranch)
                    {
                        <p>Visible branch anchor. Add text transforms, agents, or MCP tools after this node. The path must reach the matching input on the parallel join.</p>
                    }
                    else if (node.Type == NodeTypes.ParallelJoin)
                    {
                        <p>Waits until both named branches finish, then emits a JSON object with <code>branch_1</code> and <code>branch_2</code> values. Use a JSON selector to continue with one value as text.</p>
                    }
                    else if (node.Type == NodeTypes.Condition && !ReadOnly)
                    {
                        <label>Condition operator
                            <select aria-label="Condition operator for @id" value="@node.Condition!.Operator" @onchange="args => ConditionOperator(id, args)" disabled="@Disabled">
                                <option value="equals">Equals</option><option value="contains">Contains</option><option value="starts-with">Starts with</option><option value="is-empty">Is empty</option>
                            </select>
                        </label>
                        <label>Compare with
                            <input aria-label="Condition operand for @id" value="@node.Condition!.Operand" @onchange="args => ConditionOperand(id, args)" maxlength="1024" disabled="@(Disabled || node.Condition.Operator == "is-empty")" />
                        </label>
                        <p class="vaw-help">Ordinal, case-sensitive text comparison. Exactly one output passes the unchanged text.</p>
                        @if (pendingBlockRemoval == id)
                        {
                            <section aria-label="Confirm conditional block removal">
                                <p>Remove these @pendingBlockNodes.Length nodes, including both branches and nested decisions? The input will pass directly to the next node.</p>
                                <ul>
                                    @foreach (var removedId in pendingBlockNodes)
                                    { <li>@(string.IsNullOrWhiteSpace(EffectiveLayout.Nodes[removedId].Label) ? WorkflowGraphCanvas.FriendlyName(Definition.Nodes[removedId]) : EffectiveLayout.Nodes[removedId].Label) · @removedId</li> }
                                </ul>
                                <button type="button" disabled="@Disabled" @onclick="ConfirmBlockRemoval">Remove block and reconnect</button>
                                <button type="button" @onclick="CancelBlockRemoval">Cancel block removal</button>
                            </section>
                        }
                        else
                        { <button type="button" disabled="@Disabled" @onclick="() => RequestBlockRemoval(id)">Remove conditional block…</button> }
                    }
                    else if (node.Type == NodeTypes.WorkflowValue)
                    {
                        var parameterChoices = ParameterDefinitions;
                        @if (!ReadOnly && parameterChoices.Count > 0)
                        {
                            <label>Workflow parameter
                                <select aria-label="Workflow parameter for @id" value="@node.ParameterId" @onchange="args => BindParameter(id, args)" disabled="@Disabled">
                                    @foreach (var (parameterId, parameter) in parameterChoices) { <option value="@parameterId">@parameter.DisplayName · @parameterId</option> }
                                </select>
                            </label>
                        }
                        else if (node.ParameterId is { } parameterId && parameterChoices.TryGetValue(parameterId, out var parameter))
                        { <p>@parameter.DisplayName · @parameterId</p><p class="vaw-help">Passes this value onward, replacing the incoming string.</p> }
                    }
                    else if (node.Type == NodeTypes.Merge)
                    {
                        <p>Passes the selected branch value into shared downstream processing. A merge is optional when branches take different routes or end at the Output node.</p>
                        @if (!ReadOnly)
                        {
                            <button type="button" @onclick="() => RemoveSelected(id)" disabled="@Disabled" aria-label="Remove merge @id">Remove merge and split paths</button>
                        }
                    }
                    else if (node.Type == NodeTypes.Terminate)
                    {
                        var outcome = node.Termination?.Outcome ?? WorkflowTerminationOutcomes.Success;
                        @if (!ReadOnly)
                        {
                            <label>Run outcome
                                <select aria-label="Run outcome for @id" value="@outcome" @onchange="args => SetTerminationOutcome(id, args)" disabled="@Disabled">
                                    <option value="@WorkflowTerminationOutcomes.Success">Success</option>
                                    <option value="@WorkflowTerminationOutcomes.Failure">Failure</option>
                                </select>
                            </label>
                        }
                        <p>A successful end is recorded as <strong>Terminated</strong>; a failure end is recorded as a failed run with no result.</p>
                    }
                    else if (terminal || ReadOnly)
                    {
                        <p>@node.Type</p>
                        @if (node.Type == NodeTypes.Output) { <p>Result data type: @(node.OutputDataType ?? "string")</p> }
                    }
                    else
                    {
                        <label>Operation
                            <select aria-label="Operation for @id" value="@NodeKey(node)" @onchange="args => ChangeType(id, args)" disabled="@Disabled">
                                @if (!GuardedTool(id))
                                {
                                    <option value="@NodeTypes.Uppercase">Uppercase</option>
                                    <option value="@NodeTypes.Reverse">Reverse</option>
                                }
                                @if (node.Tool is { } pinned && !Bindings.Any(b => BindingMatches(pinned, b)))
                                { <option value="@NodeKey(node)">Pinned MCP binding @ToolBindingStatus(pinned): @pinned.BindingId</option> }
                                @foreach (var binding in Bindings) { <option @key="ToolKey(binding)" value="@ToolKey(binding)">@binding.DisplayName</option> }
                                @if (node.Agent is { } pinnedAgent && !Providers.Any(p => p.ProviderId == pinnedAgent.ProviderId))
                                { <option value="@NodeKey(node)">Model connection unavailable: @pinnedAgent.ProviderId</option> }
                                @if (!GuardedTool(id))
                                { @foreach (var provider in Providers) { <option @key="ProviderKey(provider)" value="@ProviderKey(provider)">@provider.DisplayName</option> } }
                            </select>
                        </label>
                        <div class="vaw-controls">
                            @if (!UsesGraphEditing)
                            {
                            <button type="button" @onclick="() => Edit(() => WorkflowEditing.Move(Definition, id, -1))" disabled="@(Disabled || index == 1)" aria-label="Move @id up">Move up</button>
                            <button type="button" @onclick="() => Edit(() => WorkflowEditing.Move(Definition, id, 1))" disabled="@(Disabled || index == Order.Length - 2)" aria-label="Move @id down">Move down</button>
                            }
                            <button type="button" @onclick="() => Edit(() => UseGraphRemoval ? GraphEditing.RemoveNode(Definition, id) : WorkflowEditing.Remove(Definition, id))" disabled="@(Disabled || GuardedTool(id))" aria-label="Remove @id">Remove</button>
                        </div>
                    }
                    @if (!ReadOnly && node.Type is not (NodeTypes.Approval or NodeTypes.ParallelFork or NodeTypes.Loop) && WorkflowPorts.Outputs(node).Length > 0)
                    {
                    <details class="vaw-insertion-options"><summary>Insertion options</summary>
            @if (!ReadOnly)
            {
                <label>New node operation<select aria-label="New node operation" @bind="newType" disabled="@Disabled">
                    <option value="@NodeTypes.Uppercase">Uppercase</option><option value="@NodeTypes.Reverse">Reverse</option>
                    @foreach (var binding in Bindings) { <option value="@ToolKey(binding)">@binding.DisplayName</option> }
                    @foreach (var provider in Providers) { <option value="@ProviderKey(provider)">@provider.DisplayName</option> }
                </select></label>
            }
                    @if (!ReadOnly && node.Type is not (NodeTypes.Approval or NodeTypes.ParallelFork or NodeTypes.Loop))
                    {
                        @foreach (var port in WorkflowPorts.Outputs(node))
                        {
                            @if (port.DataType == "string")
                            {
                                <button type="button" @onclick="() => InsertAfter(id, port.Id)" disabled="@(Disabled || Definition.Nodes.Count >= 256)" aria-label="Add node after @PortLabel(id, port.Id)">+ Add node after @port.Id</button>
                                @if (!IsParallelBranchPath(new(id, port.Id)) && !Definition.Nodes.Values.Any(existing => existing.Type == NodeTypes.Loop))
                                { <button type="button" @onclick="AddConditionNode" disabled="@(Disabled || Definition.Nodes.Count >= 256)" aria-label="Add condition node near @PortLabel(id, port.Id)">+ Condition node</button> }
                            }
                        }
                    }
                    </details>
                    }
                    @if (!ReadOnly && node.Type == NodeTypes.McpTool)
                    {
                        @if (!GuardedTool(id))
                        { <button type="button" @onclick="() => Edit(() => GraphEditing.InsertApprovalBefore(Definition, id))" disabled="@(Disabled || Definition.Nodes.Count >= 256)" aria-label="Require approval before @id">Require approval before tool</button> }
                        else
                        { <p class="vaw-help">Remove the approval step before deleting this tool or changing it to a non-tool operation.</p> }
                    }
                    @if (node.Type == NodeTypes.Merge) { <p class="vaw-help">Passes the selected incoming value. This is not a parallel join.</p> }
                    @if (node.Condition is { } recordedCondition && ReadOnly) { <p>@recordedCondition.Operator · @recordedCondition.Operand</p> }
                    @if (node.Origin is { } origin)
                    { <p class="vaw-node-origin">Copied from @origin.WorkflowId · version @origin.Version. Local edits are independent.</p> }
                    @if (node.Tool is { } tool)
                    { <p>MCP binding: @tool.BindingId · pinned contract @tool.ContractHash[..8]</p> }
                    @if (node.Agent is { } agent)
                    {
                        <p>Model connection: @agent.ProviderId</p>
                        @if (!ReadOnly)
                        {
                            <label>Maximum output tokens
                                <input aria-label="Maximum output tokens for @id" type="number" min="@AgentOutputTokenLimits.Minimum" max="@AgentOutputTokenLimits.Maximum" step="256" value="@(agent.MaxOutputTokens ?? AgentOutputTokenLimits.LegacyDefault)" @onchange="args => MaxOutputTokens(id, args)" disabled="@Disabled" />
                            </label>
                            <p class="vaw-help">Caps each model response. The endpoint may enforce a lower model-specific limit.</p>
                            <label>Maximum total tokens
                                <input aria-label="Maximum total tokens for @id" type="number" min="@AgentTotalTokenLimits.Minimum" max="@AgentTotalTokenLimits.Maximum" value="@agent.MaxTotalTokens" placeholder="No agent limit" @onchange="args => MaxTotalTokens(id, args)" disabled="@Disabled" />
                            </label>
                            <p class="vaw-help">Caps provider-reported input plus output tokens across this agent and its delegated profiles. Requires provider usage reporting. Oversized prompts and parallel requests already in flight can exceed the limit.</p>
                            <label>Maximum model turns
                                <input aria-label="Maximum model turns for @id" type="number" min="@AgentExecutionLimits.UnlimitedTurns" step="1" value="@(agent.MaxTurns ?? AgentExecutionLimits.DefaultMaximumTurns)" @onchange="args => MaxTurns(id, args)" disabled="@Disabled" />
                            </label>
                            <p class="vaw-help">Limits model responses, including tool-call rounds. Enter -1 for unlimited; any positive integer is allowed. Zero is invalid. Default: @AgentExecutionLimits.DefaultMaximumTurns. Timeout and token limits can still bound execution.</p>
                            <label><input aria-label="Require structured result for @id" type="checkbox" checked="@(agent.RequireStructuredResult == true)" @onchange="args => RequireStructuredResult(id, args)" disabled="@Disabled" /> Require a structured result</label>
                            <p class="vaw-help">Adds a built-in submit_result tool. The node returns JSON with status and payload; select status to route success, reported failure, or runtime limit outcomes.</p>
                            <label>Agent timeout in seconds
                                <input aria-label="Agent timeout in seconds for @id" type="number" min="1" step="1" value="@agent.TimeoutSeconds" placeholder="Host default" @onchange="args => AgentTimeout(id, args)" disabled="@Disabled" />
                            </label>
                            <p class="vaw-help">Any positive whole number of seconds. Blank uses the model connection's timeout; the connection timeout remains the hard upper bound.</p>
                        }
                        else
                        {
                            <p>Limits: @(agent.MaxOutputTokens ?? AgentOutputTokenLimits.LegacyDefault) output tokens per response, @(agent.MaxTotalTokens?.ToString() ?? "no total-token cap") reported total tokens, @(agent.MaxTurns is null ? $"{AgentExecutionLimits.DefaultMaximumTurns} (default)" : agent.MaxTurns == AgentExecutionLimits.UnlimitedTurns ? "unlimited" : agent.MaxTurns.ToString()) model turns, and @(agent.TimeoutSeconds is { } seconds ? $"{seconds} seconds" : "host-configured timeout"). Structured result: @(agent.RequireStructuredResult == true ? "required" : "disabled").</p>
                        }
                        @if (!ReadOnly && Providers.FirstOrDefault(p => p.ProviderId == agent.ProviderId) is { SupportsReasoningEffort: true })
                        {
                            <label>Reasoning effort
                                <select aria-label="Reasoning effort for @id" value="@(agent.ReasoningEffortParameterId is { } reasoningParam ? "parameter:" + reasoningParam : agent.ReasoningEffort?.ToString() ?? "")" @onchange="args => ReasoningEffort(id, args)" disabled="@Disabled">
                                    <option value="">Provider default</option><option value="Off">Off</option><option value="Low">Low</option><option value="Medium">Medium</option><option value="High">High</option>
                                    @foreach (var (parameterId, parameter) in ParameterDefinitions.Where(pair => pair.Value.Type == "choice" && pair.Value.Choices is { } choices && new[] { "default", "off", "low", "medium", "high" }.All(choices.Contains)))
                                    { <option value="parameter:@parameterId">From workflow input: @parameter.DisplayName</option> }
                                </select>
                            </label>
                            <p class="vaw-help">The provider adapter sends this preference. Compatible endpoints may interpret or ignore it.</p>
                        }
                        else if (!ReadOnly && agent.ReasoningEffort is not null)
                        { <p role="alert" class="vaw-error">This provider does not advertise reasoning effort support.</p> }
                        @if (Providers.Any(p => p.ProviderId == agent.ProviderId && p.IsDeterministic))
                        { <p>Scripted fixture: calls the first assigned tool or echoes input. It does not interpret instructions.</p> }
                        @if (Providers.FirstOrDefault(p => p.ProviderId == agent.ProviderId) is { IsDeterministic: false } liveProvider)
                        { <p class="vaw-help">External model: @liveProvider.ModelId. Running this node sends its instructions, input and assigned tool results to the host-configured provider.</p> }
                        @if (ReadOnly)
                        { <pre>@agent.Instructions</pre><p>User message: @(agent.UserMessage is null ? "Incoming graph value" : "Structured template")</p> }
                        else
                        {
                            <label>System instructions
                                <textarea aria-label="Agent instructions for @id" value="@agent.Instructions" @onchange="args => Instructions(id, args)" maxlength="8192" rows="3" disabled="@Disabled"></textarea>
                            </label>
                            <fieldset disabled="@Disabled">
                                <legend>User message</legend>
                                <p class="vaw-help">The incoming graph value is used by default. Reference tokens resolve only declared inputs, never arbitrary expressions.</p>
                                @if (agent.UserMessage is null)
                                { <button type="button" @onclick="() => StartUserTemplate(id)">Customize user message</button> }
                                else
                                { <PromptTemplateEditor Value="agent.UserMessage" Parameters="ParameterDefinitions" ValueChanged="template => SetUserTemplate(id, template)" Disabled="Disabled" /> }
                            </fieldset>
                            <fieldset disabled="@Disabled"><legend>Skills</legend>
                                <p class="vaw-help">Only assigned revisions are sent to this agent. Skills cannot grant tools.</p>
                                @foreach (var item in SkillLibrary?.List() ?? [])
                                {
                                    var skill = item.Skill;
                                    var assigned = (agent.Skills ?? []).Any(reference => reference.Id == skill.Id && reference.Version == skill.Version);
                                    <label @key="skill.Id + skill.Version"><input type="checkbox" checked="@assigned" @onchange="args => AssignSkill(id, skill, args)" disabled="@(!assigned && (agent.Skills?.Length ?? 0) >= 8)" />@skill.Name · @skill.Version @(string.IsNullOrEmpty(item.Folder) ? "" : "· " + item.Folder)</label>
                                }
                                @foreach (var reference in agent.Skills ?? [])
                                { <p>Assigned: @reference.Id · @reference.Version · @reference.ContentHash[..8]</p> }
                                @if (SkillLibrary is not null) { <a href="/projects/@ProjectId/skills">Manage skill library</a> }
                            </fieldset>
                            <fieldset disabled="@Disabled"><legend>Subagents</legend>
                                <p class="vaw-help">Selected profiles appear as delegate tools, so the parent agent chooses which specialist to call and when. Sequential delegate turns can exchange bounded messages on shared Agent Designer channels; the parallel team tool uses a separate channel scope for that team call. Membership is pinned with each profile revision. Each child gets only its own profile tools within host authorization. Teams run up to four members concurrently, one level deep, with a four-child-call limit per parent-agent invocation.</p>
                                @foreach (var item in AgentProfileLibrary?.List() ?? [])
                                {
                                    var profile = item.Profile;
                                    var assigned = (agent.Delegates ?? []).Any(reference => reference.Id == profile.Id && reference.Version == profile.Version);
                                    <label @key="profile.Id + profile.Version"><input type="checkbox" checked="@assigned" @onchange="args => AssignProfile(id, profile, args)" disabled="@(!assigned && (agent.Delegates?.Length ?? 0) >= 4)" />@profile.Name · @profile.Version @(string.IsNullOrEmpty(item.Folder) ? "" : "· " + item.Folder) @if (profile.Channels is { Length: > 0 }) { <small>Channels: @string.Join(", ", profile.Channels)</small> }</label>
                                }
                                @foreach (var reference in agent.Delegates ?? [])
                                {
                                    @if (!(AgentProfileLibrary?.List() ?? []).Any(item => item.Profile.Id == reference.Id && item.Profile.Version == reference.Version))
                                    { <p>Embedded profile: @reference.Id · @reference.Version · @reference.ContentHash[..8] <button type="button" @onclick="() => RemoveProfile(id, reference)">Remove unavailable profile</button></p> }
                                }
                                @if (AgentProfileLibrary is not null) { <a href="/projects/@ProjectId/agents">Open Agent Designer</a> }
                            </fieldset>
                            @if (Definition.SchemaVersion is WorkflowSchemaVersions.PureGraphFunctions or WorkflowSchemaVersions.AgentGraphFunctionTools)
                            {
                                <fieldset disabled="@Disabled"><legend>Graph function tools</legend>
                                    <p class="vaw-help">Expose only selected immutable pure functions as tools. Their graph body runs deterministically in this workflow; it receives no MCP, network, filesystem, or parent-agent capabilities.</p>
                                    @foreach (var item in FunctionCatalog?.List() ?? [])
                                    {
                                        var function = item.Function;
                                        var assigned = (agent.GraphFunctionTools ?? []).Any(snapshot => snapshot.ContentHash == function.ContentHash);
                                        var replacesRevision = (agent.GraphFunctionTools ?? []).Any(snapshot => snapshot.Definition.FunctionId == function.Definition.FunctionId && snapshot.ContentHash != function.ContentHash);
                                        <label @key="function.ContentHash"><input type="checkbox" aria-label="Expose graph function @function.Definition.DisplayName to @id" checked="@assigned"
                                            @onchange="args => AssignGraphFunction(id, function, args)" disabled="@(Disabled || !assigned && !replacesRevision && (agent.GraphFunctionTools?.Length ?? 0) >= AgentGraphFunctionToolLimits.MaximumAssignedFunctions)" />
                                            @function.Definition.DisplayName · v@function.Definition.Version @(string.IsNullOrEmpty(item.Folder) ? "" : "· " + item.Folder)</label>
                                    }
                                    @foreach (var snapshot in agent.GraphFunctionTools ?? [])
                                    {
                                        @if (!(FunctionCatalog?.List() ?? []).Any(item => item.Function.ContentHash == snapshot.ContentHash))
                                        { <p>Embedded function: @snapshot.Definition.DisplayName · v@snapshot.Definition.Version · @snapshot.ContentHash[..8] <button type="button" @onclick="() => RemoveGraphFunction(id, snapshot.ContentHash)" disabled="@Disabled">Remove embedded function</button></p> }
                                    }
                                    @if (FunctionCatalog is not null) { <a href="/projects/@ProjectId/functions">Manage function library</a> }
                                    <p class="vaw-help">At most @AgentGraphFunctionToolLimits.MaximumAssignedFunctions function revisions and @AgentGraphFunctionToolLimits.MaximumCallsPerInvocation calls per agent invocation. Aggregate inputs and outputs are bounded to @AgentGraphFunctionToolLimits.MaximumInputCharacters characters each.</p>
                                </fieldset>
                            }
                                @foreach (var binding in Bindings)
                                {
                                    var assigned = agent.Tools.Any(request => BindingMatches(request, binding));
                                    <div class="vaw-agent-tool-assignment" @key="ToolKey(binding)">
                                        <label><input type="checkbox" aria-label="Assign @binding.BindingId to @id" checked="@assigned"
                                            @onchange="args => AssignTool(id, binding, args)" disabled="@(Disabled || !assigned && agent.Tools.Length >= 8)" /> @binding.DisplayName</label>
                                        <details>
                                            <summary>Tool details</summary>
                                            @if (!string.IsNullOrWhiteSpace(binding.ToolDescription)) { <p>@binding.ToolDescription</p> }
                                            <p class="vaw-help">Input fields: @ToolInputSummary(binding)</p>
                                            <p class="vaw-help">Schema @binding.ContractHash[..8] · description @binding.DescriptionHash?[..8]</p>
                                        </details>
                                    </div>
                                }
                        }
                        <ul>
                            @foreach (var request in agent.Tools)
                            {
                                <li @key="(request.BindingId, request.ContractHash)">Requested: @request.BindingId · @request.ContractHash[..8]
                                    @if (!ReadOnly && !Bindings.Any(b => BindingMatches(request, b)))
                                    { <button type="button" @onclick="() => RemoveTool(id, request.BindingId)" disabled="@Disabled">Remove unavailable request @request.BindingId</button> }
                                </li>
                            }
                        </ul>
                    }
            }
        </NodeInspector>
    </WorkflowGraphCanvas>
    @if (error is not null) { <p role="alert" class="vaw-error">@error</p> }
</section>

@code {
    [Parameter] public string ProjectId { get; set; } = "default";
    [Parameter, EditorRequired] public WorkflowDefinition Definition { get; set; } = default!;
    [Parameter] public RenderFragment? EditorActions { get; set; }
    [Parameter] public EventCallback<WorkflowGraphEdit> GraphEdited { get; set; }
    private WorkflowGraphCanvas? canvas;
    [Parameter] public EventCallback<WorkflowDefinition> DefinitionChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public WorkflowLayout? Layout { get; set; }
    [Parameter] public EventCallback<WorkflowLayout> LayoutChanged { get; set; }
    [Parameter] public bool LayoutReadOnly { get; set; }
    private WorkflowLayout? localLayout;
    private WorkflowLayout EffectiveLayout => Layout ?? localLayout!;
    private Task LayoutEdited(WorkflowLayout value)
    {
        localLayout = value;
        return LayoutChanged.InvokeAsync(value);
    }
    [Parameter] public IReadOnlyList<ToolBindingDescriptor> Bindings { get; set; } = [];
    [Parameter] public IReadOnlyList<AgentProviderDescriptor> Providers { get; set; } = [];
    [Parameter] public ISkillLibrary? SkillLibrary { get; set; }
    [Parameter] public IAgentProfileLibrary? AgentProfileLibrary { get; set; }
    [Parameter] public IGraphFunctionCatalog? FunctionCatalog { get; set; }
    private string newType = NodeTypes.Uppercase;
    private string newParameterId = "";
    private string newParameterName = "";
    private string newParameterDefault = "";
    private string newParameterDescription = "";
    private System.Collections.Immutable.ImmutableSortedDictionary<string, WorkflowParameterDefinition> ParameterDefinitions =>
        Definition.Parameters ?? System.Collections.Immutable.ImmutableSortedDictionary<string, WorkflowParameterDefinition>.Empty;
    private string CapabilitySchema => Definition.SchemaVersion is WorkflowSchemaVersions.AgentGraphFunctionTools or "1.22" or "1.21" or "1.20" or "1.19" or "1.18" or "1.17" or "1.16" or "1.15" or "1.14" or "1.13" or "1.12" or "1.11" or "1.10" or "1.9" ? Definition.SchemaVersion : Definition.SchemaVersion == "1.8" || ParameterDefinitions.Values.Any(parameter => parameter.Type is not (null or "string")) ? "1.8" : "1.7";
    private string? error;
    private string? selectedNode;
    private string selectedPort = "out";
    private Task SelectNode(string id) { insertionConnection = null; if (selectedNode != id) selectedPort = WorkflowSchemaVersions.UsesExplicitGraph(Definition.SchemaVersion)
        ? WorkflowPorts.Explicit(Definition.Nodes[id]).FirstOrDefault(port => port.Direction == WorkflowPortDirection.Output)?.Id ?? "out"
        : WorkflowPorts.Outputs(Definition.Nodes[id]).FirstOrDefault()?.Id ?? "out"; selectedNode = id; return Task.CompletedTask; }
    private string Summary(NodeDefinition node) => node.Type switch
    {
        NodeTypes.Input => "Workflow input",
        NodeTypes.Output => "Workflow result",
        NodeTypes.Uppercase => "Convert text to uppercase",
        NodeTypes.Reverse => "Reverse text",
        NodeTypes.JsonSelectString => $"JSON pointer · {node.JsonPropertySelection?.Pointer}",
        NodeTypes.JsonProject => $"JSON object · {string.Join(", ", node.JsonProjection?.Fields.Select(field => $"{field.Name}: {field.ValueSchema?.Type ?? field.ValueType ?? "any"}") ?? [])}",
        NodeTypes.TextTemplate => $"Template · {PromptTemplateCodec.Format(node.TextTemplate)}",
        NodeTypes.StringConstant => node.StringConstant?.Value ?? "Empty text constant",
        NodeTypes.TextConcat => "Join left + right",
        NodeTypes.StringEquals => "Ordinal string equality",
        NodeTypes.BooleanBranch => "Route by Boolean value",
        NodeTypes.BooleanConstant => node.BooleanConstant?.Value == true ? "True" : "False",
        NodeTypes.BooleanNot => "Invert Boolean value",
        NodeTypes.FunctionCall => node.GraphFunction is { } function
            ? $"{function.Definition.Inputs.Count} typed inputs · {function.Definition.Outputs.Count} typed outputs · pinned v{function.Definition.Version}"
            : "Graph function snapshot unavailable",
        NodeTypes.WorkflowValue => node.ParameterId is { } parameterId && ParameterDefinitions.TryGetValue(parameterId, out var parameter)
            ? $"Workflow value · {parameter.DisplayName}" : "Workflow value",
        NodeTypes.Condition => $"{node.Condition!.Operator} · {node.Condition.Operand}",
        NodeTypes.Loop => $"Continue while {node.Loop!.ContinueWhile.Operator} · max {node.Loop.MaximumIterations}",
        NodeTypes.LoopBody => "Start of bounded loop body",
        NodeTypes.Terminate => "End this route with a successful or failed workflow result",
        NodeTypes.WorkflowCall => $"Pinned workflow · {node.WorkflowCall?.WorkflowId} v{node.WorkflowCall?.Version}",
        NodeTypes.Merge => "Continue the selected path",
        NodeTypes.ParallelFork => "Start both branches concurrently",
        NodeTypes.ParallelBranch => "Parallel branch anchor",
        NodeTypes.ParallelJoin => "Wait for both branch results",
        NodeTypes.Approval => "Review before the next tool call",
        NodeTypes.Agent => Providers.FirstOrDefault(p => p.ProviderId == node.Agent!.ProviderId)?.DisplayName ?? "Host-configured agent",
        _ => Bindings.FirstOrDefault(b => b.BindingId == node.Tool?.BindingId)?.DisplayName ?? "Host-approved tool"
    };
    private System.Collections.Immutable.ImmutableArray<string> Order = [];
    private WorkflowDefinition? orderedDefinition;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(orderedDefinition, Definition)) return;
        CancelBlockRemoval();
        CancelParallelBlockRemoval();
        Order = WorkflowGraph.DisplayOrder(Definition);
        localLayout = orderedDefinition?.WorkflowId != Definition.WorkflowId
            ? WorkflowLayout.Create(Definition)
            : (localLayout ?? WorkflowLayout.Create(Definition)).Reconcile(Definition);
        if (selectedNode is null || !Definition.Nodes.ContainsKey(selectedNode)) selectedNode = Definition.EntryNodeId;
        orderedDefinition = Definition;
        error = null;
    }

    private bool GuardedTool(string id) => Definition.Connections.Values.Any(e => e.Target.NodeId == id && Definition.Nodes[e.Source.NodeId].Type == NodeTypes.Approval);
    private Task ApprovalPrompt(string id, ChangeEventArgs args) => Edit(() => GraphEditing.ReplaceNode(Definition, id,
        Definition.Nodes[id] with { Approval = new(args.Value?.ToString() ?? "") }));
    private static string WorkflowCallInputType(WorkflowDefinition child) =>
        child.Nodes is { } nodes && nodes.TryGetValue(child.EntryNodeId, out var input) && input is not null
            ? WorkflowPorts.Outputs(input).SingleOrDefault()?.DataType ?? "unavailable"
            : "unavailable";
    private static string WorkflowCallOutputType(WorkflowDefinition child) =>
        child.Nodes is { } nodes && nodes.Values.FirstOrDefault(candidate => candidate?.Type == NodeTypes.Output) is { } output
            ? WorkflowPorts.Inputs(output).SingleOrDefault()?.DataType ?? "unavailable"
            : "unavailable";
    private Task MapChildParameter(string nodeId, string childParameterId, ChangeEventArgs args) => Edit(() =>
    {
        var node = Definition.Nodes[nodeId];
        var call = node.WorkflowCall ?? throw new ArgumentException("The pinned child workflow is unavailable.");
        var mappings = System.Collections.Immutable.ImmutableArray.CreateRange((call.ParameterMappings ?? []).Where(mapping => mapping.ChildParameterId != childParameterId));
        var parentParameterId = args.Value?.ToString();
        if (!string.IsNullOrEmpty(parentParameterId)) mappings = mappings.Add(new(childParameterId, parentParameterId));
        return GraphEditing.ReplaceNode(Definition, nodeId, node with { WorkflowCall = call with { ParameterMappings = mappings.IsEmpty ? null : mappings } });
    });
    private bool HasRouting => WorkflowGraph.HasControlNodes(Definition);
    private bool UsesGraphEditing => WorkflowSchemaVersions.UsesExplicitGraph(Definition.SchemaVersion) || HasRouting || WorkflowGraph.HasTypedJson(Definition);
    private static string PortLabel(string id, string port) => port == "out" ? id : id + "." + port;
    private WorkflowDefinition ReplaceProcessing(string id, NodeDefinition node) => UsesGraphEditing
        ? GraphEditing.ReplaceNode(Definition, id, node) : WorkflowEditing.ReplaceNode(Definition, id, node);
    private Task InsertAfter(string id, string port) => Edit(() => UsesGraphEditing
        ? GraphEditing.InsertNodeAfter(Definition, id, port, FromSelection(newType)) : WorkflowEditing.InsertNodeAfter(Definition, id, FromSelection(newType)));
    private Task ConditionOperator(string id, ChangeEventArgs args) => Edit(() =>
    {
        var operation = args.Value?.ToString() ?? "";
        return GraphEditing.ReplaceNode(Definition, id, Definition.Nodes[id] with
            { Condition = new(operation, operation == "is-empty" ? "" : Definition.Nodes[id].Condition!.Operand) });
    });
    private Task ConditionOperand(string id, ChangeEventArgs args) => Edit(() => GraphEditing.ReplaceNode(Definition, id,
        Definition.Nodes[id] with { Condition = Definition.Nodes[id].Condition! with { Operand = args.Value?.ToString() ?? "" } }));
    private Task LoopOperator(string id, ChangeEventArgs args) => Edit(() =>
    {
        var operation = args.Value?.ToString() ?? "contains";
        if (!WorkflowLoopLimits.Operators.Contains(operation, StringComparer.Ordinal))
            throw new ArgumentException("Choose a supported loop predicate.");
        var current = Definition.Nodes[id].Loop!.ContinueWhile;
        return GraphEditing.ReplaceNode(Definition, id, Definition.Nodes[id] with
        { Loop = Definition.Nodes[id].Loop! with { ContinueWhile = new(operation, operation == "is-empty" ? "" : current.Operand) } });
    });
    private Task LoopOperand(string id, ChangeEventArgs args) => Edit(() => GraphEditing.ReplaceNode(Definition, id,
        Definition.Nodes[id] with { Loop = Definition.Nodes[id].Loop! with
        { ContinueWhile = Definition.Nodes[id].Loop!.ContinueWhile with { Operand = args.Value?.ToString() ?? "" } } }));
    private Task LoopMaximumIterations(string id, ChangeEventArgs args) => Edit(() =>
    {
        if (!int.TryParse(args.Value?.ToString(), out var maximum) || maximum is < 1 or > WorkflowLoopLimits.MaximumIterations)
            throw new ArgumentException($"Choose from 1 to {WorkflowLoopLimits.MaximumIterations} iterations.");
        return GraphEditing.ReplaceNode(Definition, id, Definition.Nodes[id] with
        { Loop = Definition.Nodes[id].Loop! with { MaximumIterations = maximum } });
    });

    private async Task AddParameter()
    {
        var id = newParameterId.Trim();
        await Edit(() => WorkflowParameterEditing.Add(Definition, id,
            string.IsNullOrWhiteSpace(newParameterName) ? id : newParameterName.Trim(), newParameterDefault, EmptyToNull(newParameterDescription)));
        if (error is null) { newParameterId = ""; newParameterName = ""; newParameterDefault = ""; newParameterDescription = ""; }
    }
    private Task UpdateParameter(string id, ChangeEventArgs args, bool displayName)
    {
        var existing = ParameterDefinitions[id];
        var name = displayName ? args.Value?.ToString() ?? "" : existing.DisplayName;
        var value = displayName ? existing.DefaultValue : args.Value?.ToString() ?? "";
        return Edit(() => WorkflowParameterEditing.Update(Definition, id, name, value));
    }
    private Task UpdateParameterDescription(string id, ChangeEventArgs args) =>
