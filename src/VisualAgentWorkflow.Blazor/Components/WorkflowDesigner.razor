@implements IAsyncDisposable
@attribute [StreamRendering]

<section @ref="designerRoot" class="vaw-designer @(IdeMode ? "vaw-designer-in-ide" : null)" aria-label="Workflow designer">
    <header class="vaw-section-header"><div><h2>Workflow designer</h2>
    <p>Compose a string workflow with tools, agents and conditional paths.</p></div><span class="vaw-badge">Draft workspace</span></header>
    <fieldset class="vaw-designer-fields" disabled="@(!interactive || busy)">
    @if (definition is not null)
    {
        @if (IdeMode)
        {
            <header class="vaw-document-header">
                <nav @ref="workflowTabStrip" class="vaw-workflow-document-tabs" aria-label="Open workflow documents" aria-description="Scroll horizontally to reach tabs that do not fit. Drag tabs to reorder; press Alt+Shift+Arrow keys on a tab to move it.">
                    @foreach (var id in openWorkflowIds)
                    {
                        var current = id == definition.WorkflowId;
                        var name = current ? WorkflowDisplayName(definition) : workflows.FirstOrDefault(item => item.Definition.WorkflowId == id) is { } opened ? WorkflowDisplayName(opened.Definition) : id;
                        <div class="vaw-workflow-document-tab @(current ? "is-active" : null) @(draggedWorkflowTabId == id ? "is-dragging" : null) @(workflowDropTargetId == id ? "is-drop-target" : null)" data-workflow-tab-id="@id" @ondragstart="() => StartWorkflowTabDrag(id)" @ondragenter="() => workflowDropTargetId = id" @ondragover:preventDefault="true" @ondrop="() => DropWorkflowTab(id)" @ondrop:preventDefault="true" @ondragend="ClearWorkflowTabDrag" data-vaw-closable-tab @key="id" @onmousedown="args => CloseWorkflowMiddle(id, args)">
                        <button type="button" draggable="true" aria-current="@(current ? "page" : null)" aria-description="Drag this tab to reorder. Press Alt+Shift+ArrowLeft or ArrowRight to move it." aria-keyshortcuts="Alt+Shift+ArrowLeft Alt+Shift+ArrowRight" @onkeydown="args => ReorderWorkflowTabFromKeyboard(id, args)" disabled="@(!current && dirty)" @onclick="() => current ? Task.CompletedTask : SelectWorkflow(new ChangeEventArgs { Value = id })" title="@name"><svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="3" width="5" height="5" rx="1"/><rect x="12" y="12" width="5" height="5" rx="1"/><path d="M8 5.5h3a2 2 0 0 1 2 2V12" /></svg><span>@(name).workflow</span>@if (current && dirty) { <span class="vaw-document-dirty" aria-label="Unsaved changes"></span> }</button>
                            <button type="button" class="vaw-workflow-tab-close" aria-label="Close @(name).workflow" title="Close workflow" @onclick="() => RequestCloseWorkflow(id)">×</button>
                        </div>
                    }
                </nav>
                <div class="vaw-document-actions">
                    <button type="button" data-graph-save @onclick="Save" disabled="@(busy || !interactive)" title="Save workflow">Save</button>
                    <button type="button" class="vaw-primary" @onclick="OpenRunDialog" disabled="@(busy || dirty || generation == 0)"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m6 3 10 7-10 7z" /></svg>Run workflow</button>
                    <button type="button" @onclick="() => documentSettingsOpen = !documentSettingsOpen" aria-label="Workflow settings" aria-expanded="@(documentSettingsOpen ? "true" : "false")" title="Workflow settings"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m8 2-.5 2-2 .8L3.7 4 2 7l1.5 1.4v3.2L2 13l1.7 3 1.8-.8 2 .8.5 2h4l.5-2 2-.8 1.8.8 1.7-3-1.5-1.4V8.4L18 7l-1.7-3-1.8.8-2-.8L12 2z"/><circle cx="10" cy="10" r="3"/></svg></button>
                </div>
            </header>
            <div class="vaw-document-breadcrumb"><span>workflows</span><span aria-hidden="true">/</span><strong>@(WorkflowDisplayName(definition)).workflow</strong><span class="vaw-document-save-state">@(dirty ? "Unsaved changes" : generation == 0 ? "Not saved" : "Saved")</span></div>
        }
        <div class="vaw-document-settings @(documentSettingsOpen ? "is-open" : null)" role="region" aria-label="Workflow settings panel" @onkeydown="CloseSettingsOnEscape">
        @if (IdeMode) { <header class="vaw-settings-heading"><h2>Workflow settings</h2><button type="button" aria-label="Close workflow settings" @onclick="() => documentSettingsOpen = false">Close</button></header> }
        <div class="vaw-controls vaw-designer-toolbar">
            @if (IdeMode)
            {
                <select hidden aria-hidden="true" tabindex="-1" data-vaw-workflow-selector
                    @key="(definition.WorkflowId, generation, workflows)" value="@definition.WorkflowId"
                    @onchange="SelectWorkflow" disabled="@(busy || dirty)">
                    @if (generation == 0) { <option value="@definition.WorkflowId">@WorkflowDisplayName(definition) · New workflow</option> }
                    @foreach (var item in workflows) { <option @key="item.Definition.WorkflowId" value="@item.Definition.WorkflowId">@WorkflowDisplayName(item.Definition)</option> }
                </select>
            }
            else
            {
                <label class="vaw-workflow-search">Find workflow <input aria-label="Find workflow" @bind="workflowFilter" @bind:event="oninput" placeholder="Filter by name or ID" /></label>
                <label>Saved workflow
                    <select @key="(definition.WorkflowId, generation, workflows)" aria-label="Saved workflow" value="@definition.WorkflowId" @onchange="SelectWorkflow" disabled="@(busy || dirty)">
                        @if (generation == 0) { <option value="@definition.WorkflowId">@WorkflowDisplayName(definition) · New workflow</option> }
                        @foreach (var item in workflows.Where(w => w.Definition.WorkflowId == definition.WorkflowId || WorkflowMatchesFilter(w.Definition))) { <option @key="item.Definition.WorkflowId" value="@item.Definition.WorkflowId">@WorkflowDisplayName(item.Definition)</option> }
                    </select>
                </label>
            }
            <button type="button" data-vaw-new-workflow hidden="@IdeMode" @onclick="NewWorkflow" disabled="@(busy || dirty)">New workflow</button>
            <button type="button" @onclick="Discard" disabled="@busy">Discard local changes and reload</button>
        </div>
        <div class="vaw-workflow-identity">
            <label>Workflow name <input aria-label="Workflow name" value="@WorkflowDisplayName(definition)" maxlength="@WorkflowMetadataEditing.MaximumDisplayNameLength" @onchange="RenameWorkflow" /></label>
            <p class="vaw-definition-status"><code>@definition.WorkflowId</code> · @(dirty ? "Unsaved changes" : generation == 0 ? "Not saved" : "Draft saved")</p>
        </div>
        @if (dirty) { <p class="vaw-help">Save or discard edits before switching workflows.</p> }
        @if (IdeMode) { <WorkflowParameterSettings @key="definition.WorkflowId" Definition="definition" DefinitionChanged="Changed" Disabled="busy" /> }
        <details class="vaw-secondary-workflow-tools @((!IdeMode || documentSettingsOpen) ? "is-visible" : null)">
            <summary>Reusable assets, import / export, and audit</summary>
        <details class="vaw-reuse-panel">
            <summary>Reusable workflows</summary>
            @if (WorkflowGraph.HasControlNodes(definition)) { <p class="vaw-help">Reusable workflow extraction and insertion currently require a linear workflow. Control-flow graphs can still be shared as complete packages.</p> }
            <p class="vaw-help">Insert a copy when you want to edit the steps in this graph. Add a workflow call when you want to keep a reusable published workflow as a separately visible, version-pinned child.</p>
            <div class="vaw-layout-columns">
                <section aria-label="Save reusable section">
                    <h3>Save a section</h3>
                    <label>Section to save
                        <select aria-label="Section to save" @bind="reusableSectionId" disabled="@(preview is not null || layout?.Sections.Count == 0)">
                            <option value="">Choose a section</option>
                            @foreach (var (id, section) in layout?.Sections ?? System.Collections.Immutable.ImmutableSortedDictionary<string, GraphSection>.Empty)
                            { <option @key="id" value="@id">@section.Label</option> }
                        </select>
                    </label>
                    <label>Reusable workflow ID <input aria-label="Reusable workflow ID" @bind="newReusableWorkflowId" maxlength="128" /></label>
                    <button type="button" @onclick="SaveReusableSection" disabled="@(preview is not null || WorkflowGraph.HasControlNodes(definition) || reusableSectionId.Length == 0 || Catalog is not IWorkflowDesignCatalog)">Save section as reusable draft</button>
                    <p class="vaw-help">Creates a separate draft. Open, review, and publish it before reuse. Input/output nodes cannot be section members.</p>
                </section>
                <section aria-label="Insert reusable workflow">
                    <h3>Insert a published version</h3>
                    <label>Reusable workflow
                        <select aria-label="Reusable workflow" value="@reusableWorkflowId" @onchange="ChooseReusableWorkflow">
                            <option value="">Choose a published workflow</option>
                            @foreach (var workflow in workflows.Where(w => w.HeadRevisionId is not null && w.Definition.WorkflowId != definition.WorkflowId))
                            { <option @key="workflow.Definition.WorkflowId" value="@workflow.Definition.WorkflowId">@WorkflowDisplayName(workflow.Definition)</option> }
                        </select>
                    </label>
                    <label>Reusable version
                        <select aria-label="Reusable version" value="@reusableRevisionId" @onchange="ChooseReusableVersion" disabled="@(reusableVersions.Count == 0)">
                            @foreach (var version in reusableVersions)
                            { <option @key="version.Revision.RevisionId" value="@version.Revision.RevisionId">Version @version.Version · @version.Revision.ContentHash[..8]</option> }
                        </select>
                    </label>
                    <label>Insert workflow after
                        <select aria-label="Insert workflow after" value="@(insertAfterNode.Length == 0 || !definition.Nodes.ContainsKey(insertAfterNode) ? definition.EntryNodeId : insertAfterNode)" @onchange="args => insertAfterNode = args.Value?.ToString() ?? definition.EntryNodeId">
                        @foreach (var id in WorkflowGraph.DisplayOrder(definition).Where(id => definition.Nodes[id].Type != NodeTypes.Output))
                            { <option @key="id" value="@id">@(layout?.Nodes[id].Label is { Length: > 0 } label ? label : id)</option> }
                        </select>
                    </label>
                    <button type="button" @onclick="InsertReusableWorkflow" disabled="@(preview is not null || WorkflowGraph.HasControlNodes(definition) || ReusableHasControlNodes || reusableRevisionId is null)">Insert published workflow</button>
                    <button type="button" @onclick="InsertReusableWorkflowCall" disabled="@(preview is not null || reusableRevisionId is null || reusableWorkflowId == definition.WorkflowId || IsSequenceCallDraft)">Call pinned workflow version</button>
                    <p class="vaw-help">A call embeds the selected immutable revision. Pins inherit the child’s string or JSON boundary types; compatible parent parameters can be mapped in the call node properties. Its tools and provider requirements remain host-configured.</p>
                    @if (IsSequenceCallDraft)
                    {
                        <fieldset class="vaw-sequence-call-authoring" aria-label="Append a workflow call to a Sequence output">
                            <legend>Sequence path call</legend>
                            <p class="vaw-help">Append the selected published child to a direct-MCP Sequence output. The graph stays a saveable schema 1.49 draft until you explicitly promote the WorkflowCall path.</p>
                            @if (SequenceCallPaths.IsEmpty)
                            {
                                <p class="vaw-help">No eligible direct-MCP output paths are available. Transforms, Agents, and existing calls cannot precede this bounded call.</p>
                            }
                            else
                            {
                                <label>Sequence output
                                    <select aria-label="Sequence output for workflow call" @bind="sequenceCallOutputId" disabled="@(preview is not null || busy || reusableRevisionId is null)">
                                        <option value="">Choose an eligible output</option>
                                        @foreach (var path in SequenceCallPaths)
                                        {
                                            <option @key="path.OutputId" value="@path.OutputId">@path.OutputId · @path.NodeIds.Length direct MCP node(s)</option>
                                        }
                                    </select>
                                </label>
                                <button type="button" @onclick="InsertSequenceWorkflowCall" disabled="@(preview is not null || busy || reusableRevisionId is null || string.IsNullOrWhiteSpace(sequenceCallOutputId) || !SequenceCallPaths.Any(path => path.OutputId == sequenceCallOutputId))">Append call to Sequence output</button>
                            }
                        </fieldset>
                    }
                    @if (IsSequenceCallTransformDraft)
                    {
                        <fieldset class="vaw-sequence-call-authoring" aria-label="Append a deterministic transform after a WorkflowCall">
                            <legend>WorkflowCall transform</legend>
                            <p class="vaw-help">Add one deterministic text step after a pinned string child. The graph stays a saveable schema 1.50 draft until you explicitly promote it to schema 1.51.</p>
                            @if (SequenceCallTransformPaths.IsEmpty)
                            {
                                <p class="vaw-help">No eligible terminal WorkflowCall paths are available. The call must be pinned, valid, and connected directly to Output.</p>
                            }
                            else
                            {
                                <label>WorkflowCall path
                                    <select aria-label="WorkflowCall path for deterministic transform" @bind="sequenceCallTransformNodeId" disabled="@(preview is not null || busy)">
                                        <option value="">Choose a pinned call</option>
                                        @foreach (var path in SequenceCallTransformPaths)
                                        {
                                            <option @key="path.CallNodeId" value="@path.CallNodeId">@path.CallNodeId · @path.ChildWorkflowId</option>
                                        }
                                    </select>
                                </label>
                                <label>Transform
                                    <select aria-label="WorkflowCall deterministic transform" @bind="sequenceCallTransformType" disabled="@(preview is not null || busy)">
                                        <option value="@NodeTypes.SequenceUppercase">Uppercase</option>
                                        <option value="@NodeTypes.SequenceReverse">Reverse</option>
                                    </select>
                                </label>
                                <button type="button" @onclick="InsertSequenceWorkflowCallTransform" disabled="@(preview is not null || busy || string.IsNullOrWhiteSpace(sequenceCallTransformNodeId) || !SequenceCallTransformPaths.Any(path => path.CallNodeId == sequenceCallTransformNodeId))">Append transform after call</button>
                            }
                        </fieldset>
                    }
                    @if (IsSequenceCallJsonDraft)
                    {
                        <fieldset class="vaw-sequence-call-authoring" aria-label="Append a JSON workflow call to a Sequence output">
                            <legend>JSON child call</legend>
                            <p class="vaw-help">Add a pinned child with JSON input and output to a new Sequence output. This guarded edit is available only on a clean direct-MCP draft; existing calls, Agents, and transforms are not reinterpreted.</p>
                            @if (!SequenceCallJsonDraftEligible)
                            {
                                <p class="vaw-help">This draft is not eligible. Start with direct MCP paths only and remove existing WorkflowCall, Agent, or transform nodes.</p>
                            }
                            else if (!SelectedReusableHasJsonBoundary)
                            {
                                <p class="vaw-help">Choose a published child whose entry input and Output both use JSON.</p>
                            }
                            <button type="button" @onclick="InsertSequenceWorkflowCallJson" disabled="@(preview is not null || busy || !CanAuthorSequenceWorkflowCallJson)">Add pinned JSON child path</button>
                        </fieldset>
                    }
                    @if (SequenceCallJsonPaths.Length > 0)
                    {
                        <fieldset class="vaw-sequence-call-authoring" aria-label="Add JSON composition after a WorkflowCall">
                            <legend>JSON composition</legend>
                            <p class="vaw-help">Add one pure JSON node to a pinned child path. The execution wire still goes directly to Output; the node changes only the data value.</p>
                            <label>WorkflowCall path
                                <select aria-label="WorkflowCall path for JSON composition" @bind="sequenceCallJsonNodeId" disabled="@(preview is not null || busy)">
                                    <option value="">Choose a direct JSON call</option>
                                    @foreach (var path in SequenceCallJsonPaths)
                                    {
                                        <option @key="path.CallNodeId" value="@path.CallNodeId">@path.CallNodeId · @path.ChildWorkflowId</option>
                                    }
                                </select>
                            </label>
                            <label>Composition node
                                <select aria-label="JSON composition node" @bind="sequenceCallJsonCompositionType" disabled="@(preview is not null || busy)">
                                    <option value="@NodeTypes.JsonSelectString">Select value as text</option>
                                    <option value="@NodeTypes.JsonProject">Project JSON object</option>
                                </select>
                            </label>
                            <label>JSON Pointer
                                <input aria-label="JSON pointer for WorkflowCall composition" @bind="sequenceCallJsonPointer" maxlength="1024" disabled="@(preview is not null || busy)" />
                            </label>
                            <p class="vaw-help">The selector returns the pointed value as text. The projection creates one <code>value</code> field from the pointed value; edit the node’s fields afterward for additional mappings.</p>
                            <button type="button" @onclick="InsertSequenceWorkflowCallJsonComposition" disabled="@(preview is not null || busy || !CanAuthorSequenceWorkflowCallJsonComposition)">Add JSON composition node</button>
                        </fieldset>
                    }
                    @if (SequenceCallJsonChainPaths.Length > 0)
                    {
                        <fieldset class="vaw-sequence-call-authoring" aria-label="Add a second JSON composition node">
                            <legend>JSON chain</legend>
                            <p class="vaw-help">Extend a JSON projection with one compatible pure data node. Selectors are terminal; execution still goes directly to Output.</p>
                            <label>WorkflowCall path
                                <select aria-label="WorkflowCall path for JSON chain" @bind="sequenceCallJsonNodeId" disabled="@(preview is not null || busy)">
                                    <option value="">Choose a JSON projection path</option>
                                    @foreach (var path in SequenceCallJsonChainPaths)
                                    {
                                        <option @key="path.CallNodeId" value="@path.CallNodeId">@path.CallNodeId · @path.ChildWorkflowId</option>
                                    }
                                </select>
                            </label>
                            <label>Next composition node
                                <select aria-label="Next JSON chain node" @bind="sequenceCallJsonCompositionType" disabled="@(preview is not null || busy)">
                                    <option value="@NodeTypes.JsonSelectString">Select value as text</option>
                                    <option value="@NodeTypes.JsonProject">Project JSON object</option>
                                </select>
                            </label>
                            <label>JSON Pointer
                                <input aria-label="JSON pointer for second composition" @bind="sequenceCallJsonPointer" maxlength="1024" disabled="@(preview is not null || busy)" />
                            </label>
                            <button type="button" @onclick="InsertSequenceWorkflowCallJsonChainComposition" disabled="@(preview is not null || busy || !CanAuthorSequenceWorkflowCallJsonChainComposition)">Add second JSON node</button>
                            <button type="button" @onclick="InsertSequenceWorkflowCallJsonMerge" disabled="@(preview is not null || busy || !CanAuthorSequenceWorkflowCallJsonMerge)">Add bounded JSON merge</button>
                        </fieldset>
                    }
                    <ul class="vaw-requirements">
                        @foreach (var requirement in reusableRequirements)
                        { <li @key="requirement">@RequirementLabel(requirement): @RequirementAvailability(requirement)</li> }
                    </ul>
                    <p class="vaw-help">Listed requirements are not permission grants. The host authorizes each actual node invocation.</p>
                </section>
            </div>
            <section class="vaw-call-upgrade" aria-label="Inspect or upgrade a pinned workflow call">
                <h3>Inspect or upgrade a pinned call</h3>
                <p class="vaw-help">Review the embedded child’s dependencies, then compare another published revision before applying it to this draft. The current pin stays in place until you accept the review.</p>
                <label>Pinned workflow call
                    <select aria-label="Pinned workflow call to inspect" value="@upgradeCallNodeId" @onchange="SelectWorkflowCallForUpgrade" disabled="@(preview is not null || busy)">
                        <option value="">Choose a call node</option>
                        @foreach (var (nodeId, callNode) in definition.Nodes.Where(pair => pair.Value.Type == NodeTypes.WorkflowCall))
                        { <option @key="nodeId" value="@nodeId">@WorkflowCallLabel(nodeId)</option> }
                    </select>
                </label>
                @if (SelectedCallForUpgrade is { } pinnedCall)
                {
                    <p><strong>Current pin:</strong> @pinnedCall.WorkflowId · version @pinnedCall.Version · <code>@pinnedCall.RevisionId</code></p>
                    <h4>Dependencies in this pinned revision</h4>
                    <ul class="vaw-requirements">
                        @foreach (var requirement in WorkflowPackageJson.Requirements(pinnedCall.Definition))
                        { <li @key="requirement">@RequirementLabel(requirement) · @RequirementAvailability(requirement)</li> }
                    </ul>
                    <details class="vaw-child-graph" open>
                        <summary>Inspect pinned child graph (@pinnedCall.Definition.Nodes.Count nodes)</summary>
                        @if (upgradeChildLayoutIsDerived)
                        { <p class="vaw-help">This call embeds the child definition but not its editor layout, so the graph is arranged for inspection.</p> }
                        <WorkflowGraphSnapshot @key="pinnedCall.RevisionId" Definition="pinnedCall.Definition" Layout="upgradeChildLayout" AccessibleLabel="@($"Pinned child workflow {pinnedCall.WorkflowId} version {pinnedCall.Version}")" />
                    </details>
                    <label>Published revision to compare
                        <select aria-label="Published revision to upgrade the workflow call to" value="@upgradeRevisionId" @onchange="SelectUpgradeRevision" disabled="@(preview is not null || busy || upgradeVersions.All(item => item.Revision.RevisionId == pinnedCall.RevisionId))">
                            @foreach (var candidate in upgradeVersions.Where(item => item.Revision.RevisionId != pinnedCall.RevisionId))
                            { <option @key="candidate.Revision.RevisionId" value="@candidate.Revision.RevisionId">Version @candidate.Version · @candidate.Revision.ContentHash[..8]</option> }
                        </select>
                    </label>
                    <button type="button" @onclick="ReviewWorkflowCallUpgrade" disabled="@(preview is not null || busy || SelectedUpgradeRevision is null)">Review revision changes</button>
                    @if (upgradeVersions.All(item => item.Revision.RevisionId == pinnedCall.RevisionId))
                    { <p class="vaw-help">No other published revision is available for this workflow.</p> }
                    @if (upgradeReviewOpen && SelectedUpgradeRevision is { } target)
                    {
                        <section class="vaw-upgrade-review" aria-label="Workflow call upgrade review">
                            <h4>Review version @pinnedCall.Version → @target.Version</h4>
                            <p>The target remains a preview. Applying it changes this draft only; save and publish explicitly to activate the new pin. Undo edit restores the previous revision and parameter mappings.</p>
                            @if (upgradeChanges.IsEmpty)
                            { <p>The child workflow definition has no structural changes; the revision identity and content hash will still change.</p> }
                            else
                            {
                                <details open>
                                    <summary>Child definition changes (@upgradeChanges.Length)</summary>
                                    <ul>
                                        @foreach (var change in upgradeChanges)
                                        {
                                            <li @key="(change.Kind, change.Id)"><strong>@change.Kind · @change.Id</strong>
                                                <details><summary>Before / after</summary>
                                                    <p>Before</p><pre>@(change.Before ?? "Absent")</pre>
                                                    <p>After</p><pre>@(change.After ?? "Absent")</pre>
                                                </details>
                                            </li>
                                        }
                                    </ul>
                                </details>
                            }
                            <details class="vaw-child-graph" open>
                                <summary>Inspect target child graph (@target.Revision.Definition.Nodes.Count nodes)</summary>
                                <p class="vaw-help">This is a read-only view of the candidate revision. Applying the upgrade leaves the parent graph and its context intact.</p>
                                <WorkflowGraphSnapshot @key="target.Revision.RevisionId" Definition="target.Revision.Definition" AccessibleLabel="@($"Candidate child workflow {target.Revision.Definition.WorkflowId} version {target.Version}")" />
                            </details>
                            <details>
                                <summary>Dependency changes (@upgradeRequirementChanges.Length)</summary>
                                @if (upgradeRequirementChanges.IsEmpty) { <p>No dependency requirements changed.</p> }
                                else { <ul>@foreach (var change in upgradeRequirementChanges) { <li @key="change">@change</li> }</ul> }
                            </details>
                            @if (!droppedUpgradeMappings.IsEmpty)
                            {
                                <p role="status">These mappings cannot be retained; the corresponding child values will use their new defaults:</p>
                                <ul>@foreach (var mapping in droppedUpgradeMappings) { <li @key="mapping.ChildParameterId">@mapping.ChildParameterId ← @mapping.ParentParameterId</li> }</ul>
                            }
                            @if (upgradeReviewError is not null) { <p role="alert" class="vaw-error">Upgrade cannot be applied: @upgradeReviewError</p> }
                            <div class="vaw-controls">
                                <button type="button" class="vaw-primary" @onclick="AcceptWorkflowCallUpgrade" disabled="@(busy || preview is not null || !upgradeReviewValid)">Apply upgrade to draft</button>
                                <button type="button" @onclick="ClearUpgradeReview">Cancel review</button>
                            </div>
                        </section>
                    }
                }
            </section>
        </details>

        <details>
            <summary>Import / export definition</summary>
            <p>Import replaces this draft's graph and keeps its workflow ID. It does not grant capabilities or execute code.</p>
            <label>Workflow JSON <textarea @bind="jsonText" rows="8" maxlength="3145728"></textarea></label>
            <div class="vaw-controls">
                <button type="button" @onclick="Export" disabled="@(busy || !CanExportViewedDefinition)">Copy definition into JSON editor</button>
                <button type="button" @onclick="Import" disabled="@(busy || preview is not null)">Import JSON into draft</button>
                @if (CanExportViewedDefinition) { <a download="workflow.json" href="@DownloadHref">Download viewed definition</a> }
                <button type="button" @onclick="ExportLayout" disabled="@(busy || !CanExportViewedDefinition)">Copy graph layout into JSON editor</button>
                <button type="button" @onclick="ImportLayout" disabled="@(busy || preview is not null || Catalog is not IWorkflowDesignCatalog)">Import graph layout into draft</button>
                @if (CanExportViewedDefinition) { <a download="workflow.layout.json" href="@LayoutDownloadHref">Download graph layout</a> }
                <button type="button" @onclick="ExportPackage" disabled="@(busy || !CanExportViewedDefinition)">Copy workflow package into JSON editor</button>
                <button type="button" @onclick="ImportPackage" disabled="@(busy || preview is not null || Catalog is not IWorkflowDesignCatalog)">Import package into draft</button>
                @if (CanExportViewedDefinition) { <a download="workflow.package.json" href="@PackageDownloadHref">Download workflow package</a> }
                else { <span class="vaw-help">Resolve graph issues before exporting a workflow or package.</span> }
            </div>
            <p class="vaw-help">Packages include definition, layout, checksums, and declared requirements. Imports retain this workflow's ID and grant no permissions.</p>
            <ul class="vaw-requirements">
                @foreach (var requirement in packageRequirements)
                { <li @key="requirement">@RequirementLabel(requirement): @RequirementAvailability(requirement)</li> }
            </ul>
        </details>
        <details>
            <summary>Catalog audit (@audit.Count entries)</summary>
            <ul>@foreach (var entry in audit) { <li @key="entry.Sequence">@entry.Timestamp.ToString("u") · @entry.Actor · @entry.Kind · generation @entry.Generation</li> }</ul>
        </details>
        </details>
        </div>
        @if (preview is not null)
        {

            <p role="status">Viewing published version @preview.Version (read-only).</p>
            <button type="button" @onclick="() => preview = null">Return to draft</button>
            <details>
                <summary>Changes from this version to the current draft</summary>
                <ul>
                    @foreach (var change in WorkflowDifference.Compare(preview.Revision.Definition, definition))
                    { <li @key="(change.Kind, change.Id)">@change.Kind @change.Id: @(change.Before ?? "Absent") → @(change.After ?? "Absent")</li> }
                </ul>
            </details>
        }
        @if (Catalog is not IWorkflowDesignCatalog) { <p class="vaw-help">This host does not save graph layout. Position and annotation editing are disabled.</p> }
        <WorkflowEditor IdeMode="IdeMode" ShowWorkflowSettings="@(!IdeMode)" ProjectId="@ProjectId" HideNodeLibrary="IdeMode" Layout="@(preview is not null ? previewLayout ?? WorkflowLayout.Create(preview.Revision.Definition) : layout)" LayoutChanged="ChangedLayout" LayoutReadOnly="@(Catalog is not IWorkflowDesignCatalog)" Definition="@(preview?.Revision.Definition ?? definition)" DefinitionChanged="Changed" ReadOnly="@(preview is not null)" Disabled="@busy" Bindings="bindings" Providers="providers" ProviderChoicesLoading="providerChoicesLoading" SkillLibrary="SkillLibrary" AgentProfileLibrary="AgentProfileLibrary" FunctionCatalog="FunctionCatalog" TemplateCatalog="TemplateCatalog" GraphEdited="ChangedGraph">
            <EditorActions>
                @if (preview is null)
                {
                    @if (!IdeMode) { <button type="button" data-graph-save @onclick="Save" disabled="@(busy || !interactive)">Save draft</button> }
                    @if (!IdeMode)
                    { <button type="button" class="vaw-primary" @onclick="Publish" disabled="@(busy || dirty || generation == 0 || WorkflowValidator.Validate(definition!).Length > 0)">Publish &amp; activate</button> }
                    @if (CanPromoteWorkflowCallDraft)
                    { <button type="button" class="vaw-primary" @onclick="PromoteWorkflowCallDraft">Promote WorkflowCall draft</button> }
                    <button type="button" data-graph-undo @onclick="Undo" disabled="@(busy || undo.Count == 0)">Undo edit</button>
                    <button type="button" data-graph-redo @onclick="Redo" disabled="@(busy || redo.Count == 0)">Redo edit</button>
                    @if (ToolCatalog is not null) { <button type="button" @onclick="RefreshTools" disabled="@busy">Refresh MCP tools</button> }
                }
                else { <button type="button" disabled>Save draft</button> }
            </EditorActions>
        </WorkflowEditor>
        <button type="button" class="vaw-pane-resizer vaw-pane-resizer-vertical" data-pane-resizer="bottom" role="separator" aria-orientation="horizontal" aria-label="Resize workflow details panel" aria-valuemin="128" aria-valuemax="520" aria-valuenow="192" title="Resize workflow details panel"></button>
        <section class="vaw-bottom-tray @(IdeMode && !bottomTrayExpanded ? "is-collapsed" : "is-expanded")" aria-label="Workflow runs, output and problems">
            <nav aria-label="Workflow details tabs">
                @if (IdeMode)
                {
                    <button type="button" aria-pressed="@(bottomTab == "runs" ? "true" : "false")" @onclick='() => SelectBottomTab("runs")'>Runs</button>
                    <button type="button" aria-pressed="@(bottomTab == "output" ? "true" : "false")" @onclick='() => SelectBottomTab("output")'>Output</button>
                }
                else { <button type="button" aria-pressed="@(bottomTab == "run" ? "true" : "false")" @onclick='() => SelectBottomTab("run")'>Run</button> }
                @if (!IdeMode)
                { <button type="button" aria-pressed="@(bottomTab == "versions" ? "true" : "false")" @onclick='() => SelectBottomTab("versions")'>Versions</button> }
                <button type="button" aria-pressed="@(bottomTab == "issues" ? "true" : "false")" @onclick='() => SelectBottomTab("issues")'>@(IdeMode ? "Problems" : "Issues") <span class="vaw-bottom-count">@(WorkflowValidator.Validate(definition).Length + (mcpChoicesError is null ? 0 : 1) + (providerChoicesError is null ? 0 : 1))</span></button>
                @if (IdeMode)
                { <button type="button" class="vaw-bottom-toggle" aria-expanded="@(bottomTrayExpanded ? "true" : "false")" aria-label="@(bottomTrayExpanded ? "Collapse workflow details" : "Expand workflow details")" title="@(bottomTrayExpanded ? "Collapse details" : "Expand details")" @onclick="() => bottomTrayExpanded = !bottomTrayExpanded"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button> }
            </nav>
            @if (IdeMode)
            {
                <section class="vaw-bottom-panel" aria-label="Workflow run history" hidden="@(bottomTab != "runs")">@RunHistoryContent</section>
                <section class="vaw-bottom-panel" aria-label="Workflow output" hidden="@(bottomTab != "output")">@OutputContent</section>
            }
            @if (!IdeMode)
            {
            <section class="vaw-bottom-panel" aria-label="Run controls" hidden="@(bottomTab != "run")">
                <div class="vaw-version-run">
                    <label>@(IdeMode ? "Workflow input" : "Published run input") <textarea @bind="runInput" maxlength="16384" rows="2"></textarea></label>
                    @foreach (var (parameterId, parameter) in SelectedRunParameters)
                    {
                        <label @key="parameterId">@parameter.DisplayName · @parameterId
                            @if (!string.IsNullOrWhiteSpace(parameter.Description)) { <span class="vaw-help">@parameter.Description</span> }
                            @if (parameter.Type == "choice")
                            { <select value="@RunParameterValue(parameterId, parameter)" @onchange="args => SetRunParameter(parameterId, args)">@foreach (var choice in parameter.Choices ?? []) { <option value="@choice">@choice</option> }</select> }
                            else if (parameter.Type == "boolean")
                            { <select value="@RunParameterValue(parameterId, parameter)" @onchange="args => SetRunParameter(parameterId, args)"><option value="true">True</option><option value="false">False</option></select> }
                            else if (parameter.Type is "integer" or "number")
                            { <input type="number" step="@(parameter.Type == "integer" ? "1" : "any")" value="@RunParameterValue(parameterId, parameter)" @onchange="args => SetRunParameter(parameterId, args)" /> }
                            else
                            { <textarea value="@RunParameterValue(parameterId, parameter)" @onchange="args => SetRunParameter(parameterId, args)" maxlength="16384" rows="2"></textarea> }
                        </label>
                    }
                    @if (SelectedRunParameters.Count > 0) { <p class="vaw-help">Per-run values override defaults and are included in the run evidence. Do not enter secrets.</p> }
                    @if (IdeMode ? Client is IWorkflowRunControl : Client is IPublishedWorkflowRunControl)
                    { <label class="vaw-run-option"><input type="checkbox" @bind="startPublishedPaused" />Start run paused</label> }
                    @if (!IdeMode) { <button type="button" class="vaw-primary" @onclick="RunPublished" disabled="@(busy || (IdeMode ? dirty || generation == 0 || WorkflowValidator.Validate(definition).Length > 0 : selectedRevisionId is null))">@(IdeMode ? "Run workflow" : "Run selected version")</button> }
                    <button type="button" @onclick="RequestRunInspector" disabled="@(!interactive || !OpenRunInspector.HasDelegate)">Open run inspector</button>
                    <p class="vaw-help">@(IdeMode ? "Runs the saved workflow source. Save changes first; recorded history and execution evidence open in Run inspector." : "Runs a published version, including when the draft has unsaved edits. Recorded history and execution evidence open in Run inspector.")</p>
                </div>
            </section>
            }
            <section class="vaw-bottom-panel" aria-label="Workflow issues" hidden="@(bottomTab != "issues")">
                @if (runValidationRequested && WorkflowValidator.Validate(definition).Length > 0)
                {
                    <p class="vaw-run-validation" role="alert"><strong>Run blocked.</strong> Resolve the workflow issues below before starting a run. Saving this draft is still allowed.</p>
                }
                @if (mcpChoicesError is not null) { <p class="vaw-error">@mcpChoicesError</p><button type="button" @onclick="RefreshTools" disabled="@busy">Retry MCP connections</button> }
                @if (providerChoicesError is not null) { <p class="vaw-error">@providerChoicesError</p> }
                @if (WorkflowValidator.Validate(definition) is { Length: > 0 } issues)
                {
                    <ul class="vaw-bottom-issues">@foreach (var issue in issues) { <li @key="(issue.Path, issue.Code)"><strong>@issue.Path</strong><span>@issue.Message</span></li> }</ul>
                    <p class="vaw-help">Save this draft if needed; resolve every issue before running it.</p>
                }
                else { <p class="vaw-bottom-empty">No workflow issues. The current graph is valid for its schema.</p> }
            </section>
            @if (!IdeMode)
            {
            <section class="vaw-bottom-panel" aria-label="Published workflow versions" hidden="@(bottomTab != "versions")">
                <section class="vaw-version-panel">
                    <div class="vaw-version-management">
                        <h3>Published versions</h3>
                        <p class="vaw-help">Active version: @(versions.FirstOrDefault(v => v.Revision.RevisionId == activeRevisionId)?.Version.ToString() ?? "None")</p>
                        <label>Published version
                            <select aria-label="Published version" value="@selectedRevisionId" @onchange="SelectRevision" disabled="@(busy || versions.Count == 0)">
                                @foreach (var version in versions)
                                { <option @key="version.Revision.RevisionId" value="@version.Revision.RevisionId">Version @version.Version · @version.Revision.CreatedAt.ToString("u")</option> }
                            </select>
                        </label>
                        <div class="vaw-controls">
                            <button type="button" @onclick="Preview" disabled="@(busy || selectedRevisionId is null)">View selected version</button>
                            <button type="button" @onclick="Restore" disabled="@(busy || dirty || selectedRevisionId is null)">Restore selected to draft</button>
                            <button type="button" @onclick="Activate" disabled="@(busy || dirty || !CurrentDraftIsValid || selectedRevisionId is null)">Activate selected version</button>
                        </div>
                    </div>
                </section>
            </section>
            }
        </section>

    }
    else if (loadingWorkflow)
    {
        <div class="vaw-editor-loading" role="status" aria-live="polite">
            <span class="vaw-editor-loading-indicator" aria-hidden="true"></span>
            <div><strong>Opening workflow editor…</strong><p>Loading this project's saved workflows and graph layout.</p></div>
        </div>
    }
    @if (IdeMode && definition is not null)
    {
        <footer class="vaw-document-statusbar" aria-label="Workflow status"><span>@(choicesLoading ? "Loading connections…" : busy ? "Working…" : dirty ? "Unsaved changes" : "Ready")</span><span>@definition.Nodes.Count nodes</span><button type="button" @onclick='() => SelectBottomTab("issues")'>Problems: @(WorkflowValidator.Validate(definition).Length + (mcpChoicesError is null ? 0 : 1) + (providerChoicesError is null ? 0 : 1))</button><span>Project: @ProjectId</span></footer>
    }
    @if (!IdeMode && choicesLoading)
    {
        @if (mcpChoicesLoading)
        { <p class="vaw-editor-choice-status" role="status" aria-live="polite"><span class="vaw-editor-loading-indicator" aria-hidden="true"></span>Loading MCP tool choices. You can continue editing while they load.</p> }
        @if (providerChoicesLoading)
        { <p class="vaw-editor-choice-status" role="status" aria-live="polite"><span class="vaw-editor-loading-indicator" aria-hidden="true"></span>Loading model connection choices. You can continue editing while they load.</p> }
    }
    @if (!IdeMode && mcpChoicesError is not null) { <p role="alert" class="vaw-error">@mcpChoicesError</p> }
    @if (!IdeMode && providerChoicesError is not null) { <p role="alert" class="vaw-error">@providerChoicesError</p> }
    @if (message is not null) { <p role="status" class="vaw-document-feedback">@message</p> }
    @if (error is not null) { <p role="alert" class="vaw-error">@error</p> }
    </fieldset>
</section>

@if (runDialogOpen && definition is not null)
{
    <dialog @ref="runDialog" class="vaw-run-dialog" aria-labelledby="run-dialog-title" aria-describedby="run-dialog-description" @oncancel="CloseRunDialog" @oncancel:preventDefault="true">
        <h2 id="run-dialog-title">Run @WorkflowDisplayName(definition)</h2>
        <p id="run-dialog-description">Enter test input for this saved workflow. The input and parameter values are recorded with the run.</p>
        <label>Workflow input
            <textarea @bind="runInput" maxlength="16384" rows="5" autofocus disabled="@busy"></textarea>
        </label>
        @foreach (var (parameterId, parameter) in SelectedRunParameters)
        {
            <label @key="parameterId">@parameter.DisplayName · @parameterId
                @if (!string.IsNullOrWhiteSpace(parameter.Description)) { <span class="vaw-help">@parameter.Description</span> }
                @if (parameter.Type == "choice")
                { <select value="@RunParameterValue(parameterId, parameter)" @onchange="args => SetRunParameter(parameterId, args)" disabled="@busy">@foreach (var choice in parameter.Choices ?? []) { <option value="@choice">@choice</option> }</select> }
                else if (parameter.Type == "boolean")
                { <select value="@RunParameterValue(parameterId, parameter)" @onchange="args => SetRunParameter(parameterId, args)" disabled="@busy"><option value="true">True</option><option value="false">False</option></select> }
                else if (parameter.Type is "integer" or "number")
                { <input type="number" step="@(parameter.Type == "integer" ? "1" : "any")" value="@RunParameterValue(parameterId, parameter)" @onchange="args => SetRunParameter(parameterId, args)" disabled="@busy" /> }
                else
                { <textarea value="@RunParameterValue(parameterId, parameter)" @onchange="args => SetRunParameter(parameterId, args)" maxlength="16384" rows="2" disabled="@busy"></textarea> }
            </label>
        }
        @if (SelectedRunParameters.Count > 0) { <p class="vaw-help">Per-run values override defaults and are recorded with the run. Do not enter secrets.</p> }
        @if (IdeMode && Client is IWorkflowRunControl)
        { <label class="vaw-run-option"><input type="checkbox" @bind="startPublishedPaused" disabled="@busy" />Start run paused</label> }
        @if (error is not null) { <p role="alert" class="vaw-error">@error</p> }
        <div class="vaw-run-dialog-actions">
            <button type="button" @onclick="CloseRunDialog" disabled="@busy">Cancel</button>
            <button type="button" class="vaw-primary" @onclick="RunPublished" disabled="@busy">@(busy ? "Starting…" : "Run workflow")</button>
        </div>
    </dialog>
}

<TabCloseBehavior />
@if (pendingCloseWorkflowId is not null)
{
    <DiscardChangesDialog Name="@(definition is null ? pendingCloseWorkflowId : WorkflowDisplayName(definition))" Cancel="CancelCloseWorkflow" Confirm="ConfirmCloseWorkflow" />
}
