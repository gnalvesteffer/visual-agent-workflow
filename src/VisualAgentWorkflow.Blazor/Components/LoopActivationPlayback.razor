@using System.Text.Json
@using System.Globalization
@using VisualAgentWorkflow.Core

@if (Activations.Count > 0 || HasUnmatchedCompletions)
{
    <section class="vaw-loop-activation-playback" aria-label="Loop activation history">
        <details>
            <summary>Loop activations (@Activations.Count)</summary>
            <p class="vaw-help">Recorded activation outcomes at this playback position. This view does not rerun nodes.</p>
            @if (HasUnmatchedCompletions)
            {
                <p class="vaw-loop-activation-warning" role="status">Some iteration completion events have no matching start; this history is incomplete.</p>
            }
            <ol>
                @foreach (var activation in Activations)
                {
                    <li @key="activation.Start.Sequence">
                        <details>
                            <summary>
                                <strong>@activation.NodeId · Iteration @activation.Iteration · @activation.Status</strong>
                                <code>@(activation.Start.ScopeId ?? "root")</code>
                            </summary>
                            @if (activation.OutcomeEvidence is { } outcomeEvidence)
                            {
                                <p class="vaw-loop-activation-evidence" role="note">@outcomeEvidence</p>
                            }
                            @if (activation.BodyEvents.Count > 0)
                            {
                                <p>Recorded body events:</p>
                                <ul>
                                    @foreach (var bodyEvent in activation.BodyEvents)
                                    {
                                        <li @key="bodyEvent.Sequence">@bodyEvent.NodeId · @bodyEvent.Kind</li>
                                    }
                                </ul>
                            }
                            @foreach (var join in activation.Joins)
                            {
                                <p class="vaw-loop-activation-join">Parallel join @join.NodeId · @join.Status</p>
                            }
                        </details>
                    </li>
                }
            </ol>
        </details>
    </section>
}

@code {
    [Parameter] public IEnumerable<ExecutionEvent> Events { get; set; } = [];
    [Parameter] public string RunStatus { get; set; } = "running";
    [Parameter] public WorkflowDefinition? Definition { get; set; }

    private IReadOnlyList<Activation> Activations
    {
        get
        {
            var events = Events.OrderBy(evt => evt.Sequence).ToArray();
            var starts = events.Where(evt => evt.Kind == ExecutionEventKinds.LoopIterationStarted).ToArray();
            return starts.Select(start => Project(start, events)).ToArray();
        }
    }

    private bool HasUnmatchedCompletions
    {
        get
        {
            var events = Events.ToArray();
            return events.Where(evt => evt.Kind == ExecutionEventKinds.LoopIterationCompleted)
                .Any(completed => !events.Any(start => IsMatchingPair(start, completed)));
        }
    }

    private Activation Project(ExecutionEvent start, ExecutionEvent[] events)
    {
        var matchingStarts = events.Count(evt => evt.Kind == ExecutionEventKinds.LoopIterationStarted &&
            SameIteration(start, evt));
        var matchingCompletions = events.Where(evt => IsMatchingPair(start, evt)).ToArray();
        var completion = matchingCompletions.Length == 1 ? matchingCompletions[0] : null;
        var status = matchingStarts > 1 || matchingCompletions.Length > 1
            ? "Evidence incomplete"
            : completion is null
                ? IsTerminal(RunStatus) ? "Incomplete · run ended" : "In progress"
                : CompletionStatus(completion);
        var bodyEvents = start.ScopeId is null
            ? []
            : events.Where(evt => evt.ScopeId == start.ScopeId &&
                    evt.Kind is not (ExecutionEventKinds.LoopIterationStarted or ExecutionEventKinds.LoopIterationCompleted))
                .ToArray();
        var outcomeEvidence = ToolOutcomeEvidence(bodyEvents, includeFailureDetails: status != "Completed") ??
            (matchingCompletions.Length == 0 ? IncompleteOutcomeEvidence(bodyEvents) : null);
        var joins = start.ScopeId is null || Definition is null
            ? []
            : Definition.Nodes.Where(pair => pair.Value.Type == NodeTypes.ParallelJoin)
                .Select(pair => new JoinActivity(pair.Key, JoinStatus(pair.Key, start.ScopeId, events)))
                .ToArray();

        return new(start, start.NodeId ?? "Loop", Iteration(start), status, bodyEvents,
            outcomeEvidence, joins);
    }

    private static string? ToolOutcomeEvidence(ExecutionEvent[] bodyEvents, bool includeFailureDetails)
    {
        var authorizedCallIds = bodyEvents
            .Where(evt => evt.Kind == ExecutionEventKinds.ToolAuthorized)
            .Select(ToolCallId)
            .Where(callId => !string.IsNullOrWhiteSpace(callId))
            .ToHashSet(StringComparer.Ordinal);
        var settledCallIds = bodyEvents
            .Where(evt => evt.Kind is ExecutionEventKinds.ToolCompleted or ExecutionEventKinds.ToolFailed or
                ExecutionEventKinds.ToolDenied or ExecutionEventKinds.ToolUncertain)
            .Select(ToolCallId)
            .Where(callId => !string.IsNullOrWhiteSpace(callId))
            .ToHashSet(StringComparer.Ordinal);
        var evidence = new List<string>();
        if (authorizedCallIds.Any(callId => !settledCallIds.Contains(callId)))
            evidence.Add("An MCP call was authorized, but no outcome event was recorded. Its external effect may be unknown.");

        foreach (var uncertainTool in bodyEvents.Where(evt => evt.Kind == ExecutionEventKinds.ToolUncertain))
        {
            var reason = ToolReason(uncertainTool.Data);
            evidence.Add(reason is { Length: > 0 }
                ? $"MCP outcome is unknown: {reason}"
                : "MCP outcome is unknown; review its recorded event before retrying.");
        }

        foreach (var failedTool in bodyEvents.Where(evt => includeFailureDetails && evt.Kind == ExecutionEventKinds.ToolFailed))
        {
            if (ToolReason(failedTool.Data) is { Length: > 0 } failure)
                evidence.Add($"MCP call failed: {failure}");
        }

        return evidence.Count > 0 ? string.Join(" ", evidence) : null;
    }

    private static string? IncompleteOutcomeEvidence(ExecutionEvent[] bodyEvents)
    {
        var hasFailure = bodyEvents.Any(evt => evt.Kind == ExecutionEventKinds.NodeFailed);
        var hasCancellation = bodyEvents.Any(evt => evt.Kind == ExecutionEventKinds.NodeCancelled);
        return (hasFailure, hasCancellation) switch
        {
            (true, true) => "Recorded node failure and cancellation events; the iteration outcome is not established.",
            (true, false) => "Recorded node failure event; the iteration outcome is not established.",
            (false, true) => "Recorded node cancellation event; the iteration outcome is not established.",
            _ => null
        };
    }

    private static string? ToolCallId(ExecutionEvent evt) => ReadToolString(evt.Data, "toolCallId");

    private static string? ToolReason(string? data) => ReadToolString(data, "reason");

    private static string? ReadToolString(string? data, string propertyName)
    {
        if (string.IsNullOrWhiteSpace(data)) return null;
        try
        {
            using var document = JsonDocument.Parse(data);
            return document.RootElement.ValueKind == JsonValueKind.Object &&
                document.RootElement.TryGetProperty(propertyName, out var value) &&
                value.ValueKind == JsonValueKind.String
                ? value.GetString()
                : null;
        }
        catch (JsonException) { return null; }
    }

    private static bool IsMatchingPair(ExecutionEvent start, ExecutionEvent candidate) =>
        candidate.Kind == ExecutionEventKinds.LoopIterationCompleted &&
        candidate.Sequence > start.Sequence && SameIteration(start, candidate);

    private static bool SameIteration(ExecutionEvent first, ExecutionEvent second)
    {
        if (first.NodeId != second.NodeId || first.ScopeId != second.ScopeId)
            return false;

        return TryIteration(first, out var firstIteration) && TryIteration(second, out var secondIteration)
            ? firstIteration == secondIteration
            : first.InvocationId == second.InvocationId;
    }

    private static bool TryIteration(ExecutionEvent evt, out int iteration)
    {
        if (evt.ScopeId is { } scope &&
            int.TryParse(scope[(scope.LastIndexOf('/') + 1)..], NumberStyles.None,
                CultureInfo.InvariantCulture, out var zeroBased) && zeroBased >= 0 && zeroBased < int.MaxValue)
        {
            iteration = zeroBased + 1;
            return true;
        }

        try
        {
            using var payload = JsonDocument.Parse(evt.Data ?? "{}");
            if (payload.RootElement.ValueKind == JsonValueKind.Object &&
                payload.RootElement.TryGetProperty("iteration", out var value) &&
                value.TryGetInt32(out iteration) && iteration > 0)
                return true;
        }
        catch (JsonException) { }

        iteration = 0;
        return false;
    }

    private static int Iteration(ExecutionEvent start)
    {
        if (start.ScopeId is { } scope && int.TryParse(scope[(scope.LastIndexOf('/') + 1)..],
                NumberStyles.None, CultureInfo.InvariantCulture, out var zeroBased))
            return zeroBased + 1;
        try
        {
            using var payload = JsonDocument.Parse(start.Data ?? "{}");
            return payload.RootElement.TryGetProperty("iteration", out var value) &&
                value.TryGetInt32(out var iteration) && iteration > 0 ? iteration : 1;
        }
        catch (JsonException) { return 1; }
    }

    private static string CompletionStatus(ExecutionEvent completion)
    {
        if (string.IsNullOrWhiteSpace(completion.Data)) return "Completed";
        try
        {
            using var payload = JsonDocument.Parse(completion.Data);
            if (payload.RootElement.ValueKind != JsonValueKind.Object ||
                !payload.RootElement.TryGetProperty("outcome", out var outcome) ||
                outcome.ValueKind != JsonValueKind.String)
                return "Completed";
            return outcome.GetString() switch
            {
                "break" => "Break",
                "terminated" => "Terminated",
                "cancelled" => "Cancelled",
                "failed" => "Failed",
                "outcome-unknown" => "Outcome unknown",
                _ => "Evidence incomplete"
            };
        }
        catch (JsonException) { return "Evidence incomplete"; }
    }

    private static string JoinStatus(string nodeId, string scopeId, ExecutionEvent[] events)
    {
        var recorded = events.LastOrDefault(evt => evt.NodeId == nodeId && evt.ScopeId == scopeId &&
            evt.Kind is ExecutionEventKinds.NodeStarted or ExecutionEventKinds.NodeCompleted or
                ExecutionEventKinds.NodeFailed or ExecutionEventKinds.NodeCancelled or
                ExecutionEventKinds.ParallelJoinProgress);
        return recorded?.Kind switch
        {
            ExecutionEventKinds.NodeCompleted => "completed",
            ExecutionEventKinds.NodeFailed => "failed",
            ExecutionEventKinds.NodeCancelled => "cancelled",
            ExecutionEventKinds.NodeStarted or ExecutionEventKinds.ParallelJoinProgress => "in progress",
            _ => "no event recorded at this position"
        };
    }

    private static bool IsTerminal(string status) => status is "completed" or "terminated" or
        "failed" or "cancelled" or "interrupted" or "outcome-unknown";

    private sealed record Activation(ExecutionEvent Start, string NodeId, int Iteration, string Status,
        IReadOnlyList<ExecutionEvent> BodyEvents, string? OutcomeEvidence,
        IReadOnlyList<JoinActivity> Joins);

    private sealed record JoinActivity(string NodeId, string Status);
}
