    private async Task AddParameter()
    {
        var id = newParameterId.Trim();
        await Edit(() => WorkflowParameterEditing.Add(Definition, id,
            string.IsNullOrWhiteSpace(newParameterName) ? id : newParameterName.Trim(), newParameterDefault, EmptyToNull(newParameterDescription)));
        if (error is null) { newParameterId = ""; newParameterName = ""; newParameterDefault = ""; newParameterDescription = ""; }
