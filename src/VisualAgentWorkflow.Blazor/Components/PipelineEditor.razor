    private Task UpdateParameterDescription(string id, ChangeEventArgs args) =>
        Edit(() => WorkflowParameterEditing.UpdateDescription(Definition, id, EmptyToNull(args.Value?.ToString())));
    private static string? EmptyToNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private Task ChangeParameterType(string id, ChangeEventArgs args)
    {
        var type = args.Value?.ToString() ?? "string";
        return Edit(() => WorkflowParameterEditing.SetType(Definition, id, type,
            type == "boolean" ? "false" : ParameterDefinitions[id].DefaultValue,
