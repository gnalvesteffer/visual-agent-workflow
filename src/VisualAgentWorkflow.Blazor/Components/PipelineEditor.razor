    private Task ChangeType(string id, ChangeEventArgs args) =>
        Edit(() => ReplaceProcessing(id, FromSelection(args.Value?.ToString() ?? "", Definition.Nodes[id])));

    private Task JsonPointer(string id, ChangeEventArgs args) => Edit(() => GraphEditing.ReplaceNode(Definition, id,
        Definition.Nodes[id] with { JsonPropertySelection = new(args.Value?.ToString() ?? "") }));

    private Task JsonProjectionField(string id, int index, string property, ChangeEventArgs args) => Edit(() =>
    {
        var node = Definition.Nodes[id];
        var projection = node.JsonProjection!;
        var field = projection.Fields[index];
        var value = args.Value?.ToString() ?? "";
        var updated = property switch
        {
            "name" => field with { Name = value },
            "pointer" => field with { Pointer = value },
            "type" => value switch
            {
                "object" => field with { ValueType = null, ValueSchema = new JsonValueSchema("object") { Properties = System.Collections.Immutable.ImmutableArray<JsonValueProperty>.Empty } },
                "array" => field with { ValueType = null, ValueSchema = new JsonValueSchema("array") { Items = new("any") } },
                "any" => field with { ValueType = null, ValueSchema = null },
                _ => field with { ValueType = value, ValueSchema = null }
            },
            _ => throw new ArgumentOutOfRangeException(nameof(property))
        };
        return GraphEditing.ReplaceNode(Definition, id, node with
        { JsonProjection = projection with { Fields = projection.Fields.SetItem(index, updated) } });
    });

    private Task JsonProjectionName(string id, int index, ChangeEventArgs args) => JsonProjectionField(id, index, "name", args);
    private Task JsonProjectionPointer(string id, int index, ChangeEventArgs args) => JsonProjectionField(id, index, "pointer", args);
    private Task JsonProjectionType(string id, int index, ChangeEventArgs args) => JsonProjectionField(id, index, "type", args);

    private Task JsonProjectionSchema(string id, int index, JsonValueSchema schema) => Edit(() =>
    {
        var node = Definition.Nodes[id];
        var projection = node.JsonProjection!;
        var field = projection.Fields[index] with { ValueType = null, ValueSchema = schema };
        return GraphEditing.ReplaceNode(Definition, id, node with
        { JsonProjection = projection with { Fields = projection.Fields.SetItem(index, field) } });
    });

    private Task AddJsonProjectionField(string id) => Edit(() =>
    {
        var node = Definition.Nodes[id];
        var fields = node.JsonProjection!.Fields;
        return GraphEditing.ReplaceNode(Definition, id, node with
        { JsonProjection = node.JsonProjection with { Fields = fields.Add(new($"value{fields.Length + 1}", "")) } });
    });

    private Task RemoveJsonProjectionField(string id, int index) => Edit(() =>
    {
        var node = Definition.Nodes[id];
        return GraphEditing.ReplaceNode(Definition, id, node with
        { JsonProjection = node.JsonProjection! with { Fields = node.JsonProjection.Fields.RemoveAt(index) } });
    });

    private Task SetTextTemplate(string id, PromptTemplate? template) => Edit(() => ReplaceProcessing(id,
        Definition.Nodes[id] with { TextTemplate = template ?? new([new("input", "")]) }));

    private bool ParameterIsReferenced(string parameterId) => Definition.Nodes.Values.Any(node =>
        node.Type == NodeTypes.WorkflowValue && node.ParameterId == parameterId ||
        node.TextTemplate?.Parts.Any(part => part.Kind == "parameter" && part.Value == parameterId) == true ||
        node.Agent?.ReasoningEffortParameterId == parameterId ||
        node.Agent?.UserMessage?.Parts.Any(part => part.Kind == "parameter" && part.Value == parameterId) == true);

    private static string ToolKey(ToolBindingDescriptor binding) => $"mcp:{binding.BindingId}:{binding.ContractHash}:{binding.DescriptionHash}";
    private static string ProviderKey(AgentProviderDescriptor provider) => $"agent:{provider.ProviderId}:{provider.Version}";
    private string NodeKey(NodeDefinition node) => node.Agent is { } agent ? $"agent:{agent.ProviderId}:{agent.ProviderVersion}" :
        node.Tool is { } tool && Bindings.FirstOrDefault(binding => BindingMatches(tool, binding)) is { } currentBinding ? ToolKey(currentBinding) :
        node.Tool is { } unavailable ? $"mcp:{unavailable.BindingId}:{unavailable.ContractHash}:{unavailable.DescriptionHash}" : node.Type;
    private static bool BindingMatches(ToolBindingRequest request, ToolBindingDescriptor binding) =>
        request.BindingId == binding.BindingId && request.ContractHash == binding.ContractHash &&
        (request.DescriptionHash is null || request.DescriptionHash == binding.DescriptionHash);
    private string ToolBindingStatus(ToolBindingRequest request) => Bindings.FirstOrDefault(binding => binding.BindingId == request.BindingId) switch
    {
        null => "is unavailable",
        { ContractHash: var contractHash } when contractHash != request.ContractHash => "schema has changed",
        { DescriptionHash: var descriptionHash } when request.DescriptionHash is not null && descriptionHash != request.DescriptionHash => "description has changed",
        _ => "is unavailable"
    };
    private static string ToolInputSummary(ToolBindingDescriptor binding) => binding.InputSummary;
    private NodeDefinition FromSelection(string value, NodeDefinition? existing = null)
    {
        if (value == NodeTypes.JsonSelectString)
            return new(NodeTypes.JsonSelectString, "1.0.0") { JsonPropertySelection = existing?.JsonPropertySelection ?? new("/name") };
        if (value == NodeTypes.JsonProject)
            return new(NodeTypes.JsonProject, "1.0.0") { JsonProjection = existing?.JsonProjection ?? new([new("name", "/name")]) };
        if (value == NodeTypes.TextTemplate)
            return new(NodeTypes.TextTemplate, "1.0.0") { TextTemplate = existing?.TextTemplate ?? new([new("input", "")]) };
        if (value == NodeTypes.WorkflowValue)
            return new(NodeTypes.WorkflowValue, "1.0.0") { ParameterId = ParameterDefinitions.Keys.FirstOrDefault() };
        var provider = Providers.SingleOrDefault(p => ProviderKey(p) == value);
        if (provider is not null) return new(NodeTypes.Agent, "1.0.0", Agent: (existing?.Agent ?? new(provider.ProviderId, provider.Version,
            "Use assigned tools when available and return the result.", [])) with { ProviderId = provider.ProviderId, ProviderVersion = provider.Version });
        var binding = Bindings.SingleOrDefault(b => ToolKey(b) == value);
        return binding is null ? new(value, "1.0.0") : new(NodeTypes.McpTool, "1.0.0", new(binding.BindingId, binding.ContractHash)
        { DescriptionHash = binding.DescriptionHash });
    }

    private Task Instructions(string id, ChangeEventArgs args) => Edit(() => ReplaceProcessing(id,
        Definition.Nodes[id] with { Agent = Definition.Nodes[id].Agent! with { Instructions = args.Value?.ToString() ?? "" } }));
    private Task ReasoningEffort(string id, ChangeEventArgs args) => Edit(() =>
    {
        var value = args.Value?.ToString();
        var effort = Enum.TryParse<AgentReasoningEffort>(value, ignoreCase: false, out var parsed) ? parsed : (AgentReasoningEffort?)null;
        var parameterId = value?.StartsWith("parameter:", StringComparison.Ordinal) == true ? value[10..] : null;
        var node = Definition.Nodes[id];
        var parameterIncludesOff = parameterId is not null && ParameterDefinitions.TryGetValue(parameterId, out var parameter) && parameter.Choices?.Contains("off") == true;
        var schema = effort == AgentReasoningEffort.Off || parameterIncludesOff ? Definition.SchemaVersion is "1.19" or "1.18" or "1.17" or "1.16" or "1.15" or "1.14" or "1.13" or "1.12" or "1.11" ? Definition.SchemaVersion : "1.10" : parameterId is not null ? Definition.SchemaVersion is "1.19" or "1.18" or "1.17" or "1.16" or "1.15" or "1.14" or "1.13" or "1.12" or "1.11" or "1.10" or "1.9" ? Definition.SchemaVersion : "1.8" : CapabilitySchema;
        var definition = Definition with { SchemaVersion = schema, Nodes = Definition.Nodes.SetItem(id,
            node with { Agent = node.Agent! with { ReasoningEffort = parameterId is null ? effort : null, ReasoningEffortParameterId = parameterId } }) };
        WorkflowValidator.ThrowIfInvalid(definition);
        return definition;
    });

    private Task MaxOutputTokens(string id, ChangeEventArgs args) => Edit(() =>
    {
        if (!int.TryParse(args.Value?.ToString(), out var limit) || limit is < AgentOutputTokenLimits.Minimum or > AgentOutputTokenLimits.Maximum)
            throw new ArgumentException($"Choose an output limit from {AgentOutputTokenLimits.Minimum} to {AgentOutputTokenLimits.Maximum} tokens.");
        var node = Definition.Nodes[id];
        var schema = Definition.SchemaVersion is "1.19" or "1.18" or "1.17" or "1.16" or "1.15" or "1.14" or "1.13" or "1.12" or "1.11" ? Definition.SchemaVersion : "1.10";
        var definition = Definition with { SchemaVersion = schema, Nodes = Definition.Nodes.SetItem(id,
            node with { Agent = node.Agent! with { MaxOutputTokens = limit } }) };
        WorkflowValidator.ThrowIfInvalid(definition);
        return definition;
    });

    private Task StartUserTemplate(string id) => SetUserTemplate(id, new([new("input", "")]));
    private Task SetUserTemplate(string id, PromptTemplate? template) => Edit(() =>
    {
        var node = Definition.Nodes[id];
        var definition = Definition with { SchemaVersion = CapabilitySchema, Nodes = Definition.Nodes.SetItem(id,
            node with { Agent = node.Agent! with { UserMessage = template } }) };
        WorkflowValidator.ThrowIfInvalid(definition);
        return definition;
    });

    private Task AssignSkill(string id, WorkflowSkill skill, ChangeEventArgs args) => Edit(() =>
    {
        var node = Definition.Nodes[id];
        var references = System.Collections.Immutable.ImmutableArray.CreateRange((node.Agent!.Skills ?? []).Where(reference => reference.Id != skill.Id || reference.Version != skill.Version));
        var embedded = Definition.Skills ?? System.Collections.Immutable.ImmutableSortedDictionary<string, WorkflowSkill>.Empty;
        if (args.Value is true)
        {
            references = references.Add(new(skill.Id, skill.Version, skill.ContentHash));
            embedded = embedded.SetItem(skill.Id + "@" + skill.Version, skill);
        }
        var definition = Definition with { SchemaVersion = CapabilitySchema, Skills = embedded.Count == 0 ? null : embedded,
            Nodes = Definition.Nodes.SetItem(id, node with { Agent = node.Agent with { Skills = references.IsEmpty ? null : references } }) };
        WorkflowValidator.ThrowIfInvalid(definition);
        return definition;
    });

    private Task AssignProfile(string id, AgentProfile profile, ChangeEventArgs args) => Edit(() =>
    {
        var node = Definition.Nodes[id];
        var references = System.Collections.Immutable.ImmutableArray.CreateRange((node.Agent!.Delegates ?? [])
            .Where(reference => reference.Id != profile.Id || reference.Version != profile.Version));
        var profiles = Definition.AgentProfiles ?? System.Collections.Immutable.ImmutableSortedDictionary<string, AgentProfile>.Empty;
        var skills = Definition.Skills ?? System.Collections.Immutable.ImmutableSortedDictionary<string, WorkflowSkill>.Empty;
        if (args.Value is true)
        {
            if (references.Length >= 4) throw new ArgumentException("An agent can use up to four delegated profiles.");
            references = references.Add(new(profile.Id, profile.Version, profile.ContentHash!));
            profiles = profiles.SetItem(profile.Id + "@" + profile.Version, profile);
            foreach (var skill in profile.Skills ?? [])
            {
                var key = skill.Id + "@" + skill.Version;
                if (skills.TryGetValue(key, out var existing) && existing.ContentHash != skill.ContentHash)
                    throw new ArgumentException($"Skill revision {key} conflicts with a different embedded copy.");
                skills = skills.SetItem(key, skill);
            }
        }
        var nodes = Definition.Nodes.SetItem(id, node with { Agent = node.Agent with { Delegates = references.IsEmpty ? null : references } });
        var stillUsed = nodes.Values.Where(item => item.Agent is not null).SelectMany(item => item.Agent!.Delegates ?? [])
            .Any(reference => reference.Id == profile.Id && reference.Version == profile.Version);
        if (!stillUsed) profiles = profiles.Remove(profile.Id + "@" + profile.Version);
        var definition = Definition with { SchemaVersion = profile.Channels is not null ? (Definition.SchemaVersion is "1.19" or "1.18" or "1.17" or "1.16" or "1.15" or "1.14" or "1.13" ? Definition.SchemaVersion : "1.12") : Definition.SchemaVersion is "1.19" or "1.18" or "1.17" or "1.16" or "1.15" or "1.14" or "1.13" or "1.12" or "1.11" ? Definition.SchemaVersion : "1.11", AgentProfiles = profiles.Count == 0 ? null : profiles,
            Skills = skills.Count == 0 ? null : skills, Nodes = nodes };
        WorkflowValidator.ThrowIfInvalid(definition);
        return definition;
    });

    private Task RemoveProfile(string id, AgentProfileReference reference) => Edit(() =>
    {
        var node = Definition.Nodes[id];
        var delegates = System.Collections.Immutable.ImmutableArray.CreateRange((node.Agent!.Delegates ?? []).Where(item => item != reference));
        var nodes = Definition.Nodes.SetItem(id, node with { Agent = node.Agent with { Delegates = delegates.IsEmpty ? null : delegates } });
        var profiles = Definition.AgentProfiles ?? System.Collections.Immutable.ImmutableSortedDictionary<string, AgentProfile>.Empty;
        var stillUsed = nodes.Values.Where(item => item.Agent is not null).SelectMany(item => item.Agent!.Delegates ?? [])
            .Any(item => item.Id == reference.Id && item.Version == reference.Version);
        if (!stillUsed) profiles = profiles.Remove(reference.Id + "@" + reference.Version);
        var definition = Definition with { AgentProfiles = profiles.Count == 0 ? null : profiles, Nodes = nodes };
        WorkflowValidator.ThrowIfInvalid(definition);
        return definition;
    });

    private Task AssignTool(string id, ToolBindingDescriptor binding, ChangeEventArgs args) => Edit(() =>
    {
        var node = Definition.Nodes[id];
        var tools = node.Agent!.Tools.RemoveAll(t => t.BindingId == binding.BindingId);
        if (args.Value is true) tools = tools.Add(new(binding.BindingId, binding.ContractHash) { DescriptionHash = binding.DescriptionHash });
        return ReplaceProcessing(id, node with { Agent = node.Agent with { Tools = tools } });
    });

    private Task RemoveTool(string id, string bindingId) => Edit(() =>
    {
        var node = Definition.Nodes[id];
        return ReplaceProcessing(id, node with { Agent = node.Agent! with { Tools = node.Agent!.Tools.RemoveAll(t => t.BindingId == bindingId) } });
    });

    private async Task Edit(Func<WorkflowDefinition> edit, GraphContextRequest? placement = null, PortReference? insertion = null)
    {
        if (ReadOnly || Disabled) return;
        try
        {
            error = null;
            var next = edit();
            var added = next.Nodes.Keys.Where(id => !Definition.Nodes.ContainsKey(id)).ToArray();
            if (added.Length > 0) selectedNode = added.FirstOrDefault(id => next.Nodes[id].Type == NodeTypes.ParallelFork) ?? added.FirstOrDefault(id => next.Nodes[id].Type is NodeTypes.Condition or NodeTypes.Approval) ?? added[0];
            var nextLayout = PlaceAddedNodes(next, EffectiveLayout.Reconcile(next), added, placement, insertion);
            if (GraphEdited.HasDelegate) await GraphEdited.InvokeAsync(new(next, nextLayout));
            else
            {
                localLayout = nextLayout;
                await DefinitionChanged.InvokeAsync(next);
                if (LayoutChanged.HasDelegate) await LayoutChanged.InvokeAsync(nextLayout);
            }
        }
        catch (ArgumentException exception) { error = $"The graph edit is invalid: {exception.Message}"; }
    }
}
