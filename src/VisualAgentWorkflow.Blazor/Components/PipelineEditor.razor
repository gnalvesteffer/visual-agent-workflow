    private Task ChangeChoices(string id, ChangeEventArgs args)
    {
        var choices = System.Collections.Immutable.ImmutableArray.CreateRange((args.Value?.ToString() ?? "").Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries));
        var defaultValue = choices.Contains(ParameterDefinitions[id].DefaultValue) ? ParameterDefinitions[id].DefaultValue : choices.FirstOrDefault() ?? "";
        return Edit(() => WorkflowParameterEditing.SetType(Definition, id, "choice", defaultValue, choices));
