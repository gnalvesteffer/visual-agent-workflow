@implements IAsyncDisposable

<section class="vaw-studio">
    <header>
        <p class="vaw-eyebrow">VISUAL AGENT WORKFLOW</p>
        <h1>Pipeline studio</h1>
        <p>Run an Agent Framework pipeline. Inspect the recorded inputs, outputs, and messages.</p>
        <p class="vaw-notice">Local development prototype · linear pipelines, approved MCP text tools, and deterministic demo agents.</p>
    </header>
    <div class="vaw-workspace">
        <aside class="vaw-sidebar">
            <h2>Quick template run</h2>
            <label>Pipeline
                <select @bind="operation">
                    <option value="uppercase">Uppercase</option>
                    <option value="reverse">Reverse</option>
                    <option value="uppercase-reverse">Uppercase → Reverse</option>
                </select>
            </label>
            <label>Input <textarea @bind="input" maxlength="16384" rows="4"></textarea></label>
            <button type="button" class="vaw-primary" @onclick="StartRun" disabled="@(!interactive || starting)">@(starting ? "Starting…" : "Start independent run")</button>
            @if (snapshot is { IsTerminal: false })
            {
                <button type="button" @onclick="Cancel" disabled="@(!interactive)">Cancel selected run</button>
            }
            <p>The backend owns execution. Closing this page does not cancel a run.</p>
            <h2>Recorded runs</h2>
            <button type="button" @onclick="Refresh" disabled="@(!interactive)">Refresh history</button>
            <ul class="vaw-history">
                @foreach (var run in runs.Take(50))
                {
                    <li @key="run.Header.RunId"><button type="button" @onclick="() => SelectRun(run.Header.RunId)" aria-pressed="@(snapshot?.Header.RunId == run.Header.RunId)">
                        @run.Header.CreatedAt.ToString("u") · @run.Status
                        <small>@run.Header.RunId.ToString()[..8]</small>
                    </button></li>
                }
            </ul>
        </aside>
        <section class="vaw-main" aria-label="Workflow workspace">
            @if (historyError is not null) { <p role="alert" class="vaw-error">@historyError</p> }
            @if (actionError is not null) { <p role="alert" class="vaw-error">@actionError</p> }
            @if (Catalog is not null && Client is IPublishedWorkflowClient publishedClient)
            {
                <WorkflowDesigner @key="(Catalog, publishedClient)" Catalog="Catalog" Client="publishedClient" OnRunStarted="PublishedCallback(publishedClient)" ToolCatalog="ToolCatalog" AgentCatalog="AgentCatalog" />
            }
            <WorkflowRunViewer Snapshot="snapshot" />
        </section>
    </div>
</section>
