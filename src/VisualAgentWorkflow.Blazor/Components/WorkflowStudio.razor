@implements IAsyncDisposable

<section class="vaw-studio">
    <header>
        <p class="vaw-eyebrow">VISUAL AGENT WORKFLOW</p>
        <h1>Pipeline studio</h1>
        <p>Run an Agent Framework pipeline. Inspect the recorded inputs, outputs, and messages.</p>
        <p class="vaw-notice">Local development prototype · no agents, MCP calls, or full graph editing yet.</p>
    </header>
    <div class="vaw-workspace">
        <aside class="vaw-sidebar">
            <h2>New run</h2>
            <label>Pipeline
                <select @bind="operation">
                    <option value="uppercase">Uppercase</option>
                    <option value="reverse">Reverse</option>
                    <option value="uppercase-reverse">Uppercase → Reverse</option>
                </select>
            </label>
            <label>Input <textarea @bind="input" maxlength="16384" rows="4"></textarea></label>
            <button class="vaw-primary" @onclick="StartRun" disabled="@(!interactive || starting)">@(starting ? "Starting…" : "Start independent run")</button>
            @if (snapshot is { IsTerminal: false })
            {
                <button @onclick="Cancel">Cancel selected run</button>
            }
            <p>The backend owns execution. Closing this page does not cancel a run.</p>
            <h2>Recorded runs</h2>
            <button @onclick="Refresh">Refresh history</button>
            <ul class="vaw-history">
                @foreach (var run in runs.Take(50))
                {
                    <li><button @onclick="() => SelectRun(run.Header.RunId)" aria-pressed="@(snapshot?.Header.RunId == run.Header.RunId)">
                        @run.Header.CreatedAt.ToString("u") · @run.Status
                        <small>@run.Header.RunId.ToString()[..8]</small>
                    </button></li>
                }
            </ul>
        </aside>
        <main>
            @if (error is not null) { <p role="alert" class="vaw-error">@error</p> }
            <WorkflowRunViewer Snapshot="snapshot" />
        </main>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public IWorkflowClient Client { get; set; } = default!;
    private string operation = "uppercase-reverse";
    private string input = "Hello, workflows!";
    private IReadOnlyList<RunSnapshot> runs = [];
    private RunSnapshot? snapshot;
    private bool starting;
    private bool interactive;
    private string? error;
    private readonly CancellationTokenSource lifetime = new();
    private Task? polling;

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
        polling = PollAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        interactive = true;
        StateHasChanged();
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(500));
        try
        {
            while (await timer.WaitForNextTickAsync(lifetime.Token))
                await InvokeAsync(async () => { await Refresh(); StateHasChanged(); });
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
    }

    private async Task Refresh()
    {
        try
        {
            runs = await Client.ListRunsAsync();
            if (snapshot is not null) snapshot = await Client.GetRunAsync(snapshot.Header.RunId);
            error = null;
        }
        catch { error = "Could not load run history. Check the backend diagnostics."; }
    }

    private async Task StartRun()
    {
        starting = true;
        try
        {
            snapshot = await Client.StartRunAsync(PipelineTemplates.Create(operation), input);
            await Refresh();
        }
        catch { error = "The run could not be started. Check the definition, input limit, and backend diagnostics."; }
        finally { starting = false; }
    }

    private async Task SelectRun(Guid id) { snapshot = await Client.GetRunAsync(id); }
    private async Task Cancel() { if (snapshot is not null) await Client.CancelRunAsync(snapshot.Header.RunId); await Refresh(); }

    public async ValueTask DisposeAsync()
    {
        await lifetime.CancelAsync();
        if (polling is not null) await polling;
        lifetime.Dispose();
    }
}
