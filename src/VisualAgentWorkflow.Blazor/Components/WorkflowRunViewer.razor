@using System.Text.Json
@using System.Collections.Immutable
<section class="vaw-viewer" aria-label="Workflow run viewer">
    @if (Snapshot is null)
    {
        <div class="vaw-empty-state"><h2>Execution inspector</h2><p>Start a run or select one from history to inspect its path and recorded payloads.</p></div>
    }
    else
    {
        <header class="vaw-run-header">
            <h2>@(string.IsNullOrWhiteSpace(Snapshot.Header.Definition.DisplayName) ? Snapshot.Header.Definition.WorkflowId : Snapshot.Header.Definition.DisplayName)</h2>
            <div><strong>@(follow ? "Live / latest" : "Recorded playback")</strong> · Latest run status: @Snapshot.Status</div>
            @if (VisibleStatus == "terminated") { <p class="vaw-help" role="status">The workflow ended successfully without returning a result.</p> }
            <p class="vaw-help">State at recorded position: @VisibleStatus</p>
            <small>Run @Snapshot.Header.RunId · revision @Snapshot.Header.RevisionId</small>
            @if (Snapshot.Header.Parameters is { Count: > 0 } parameters)
            {
                <details class="vaw-run-parameters"><summary>Recorded workflow parameters (@parameters.Count)</summary>
                    <dl>@foreach (var (id, value) in parameters) { <dt>@id</dt><dd><pre>@value</pre></dd> }</dl>
                </details>
            }
        </header>
        <WorkflowGraphCanvas @key="Snapshot.Header.RunId" Definition="Snapshot.Header.Definition" Layout="Presentation" ReadOnly="true" NodesLabel="@(WorkflowGraph.HasRouting(Snapshot.Header.Definition) ? "Workflow nodes in topological display order" : "Workflow nodes in execution order")" NodeClass="NodeStateClass" DeliveredConnections="Delivered" SelectedNodeId="@selectedNode" SelectedNodeIdChanged="SelectNode" InspectorTitle="Execution details">
            <ToolbarContent>
        <div class="vaw-controls" aria-label="Playback controls">
            <button type="button" @onclick="Previous" disabled="@(Position == 0)">Previous event</button>
            <button type="button" @onclick="Next" disabled="@(Position >= Snapshot.Events.Length)">Next event</button>
            <button type="button" @onclick="() => follow = true">Follow latest</button>
            <label>Recorded position
                <input type="range" min="0" max="@Snapshot.Events.Length" value="@Position" @oninput="Scrub" />
            </label>
            <span>@Position / @Snapshot.Events.Length events</span>
        </div>
            </ToolbarContent>
            <NodeContent Context="nodeId">
                @{ var node = Snapshot.Header.Definition.Nodes[nodeId]; var state = State(nodeId); var evaluation = DataEvaluation(nodeId); var pendingNode = PendingRootNodeId; var label = pendingNode == nodeId ? PendingApproval?.Action.ScopeId is null ? "Awaiting approval" : "Child awaiting approval" : PausedBefore(nodeId) && state is null ? "Paused before execution" : node.Type == NodeTypes.Terminate && state?.Kind == ExecutionEventKinds.NodeCompleted ? "Terminated successfully" : evaluation is not null ? "Evaluated" : StateLabel(state); var activity = ActiveActivity(nodeId); }
                <button type="button" class="vaw-node-button" aria-label="@($"{nodeId} {node.Type} {label}")" @onclick="() => selectedNode = nodeId" aria-pressed="@(selectedNode == nodeId ? "true" : "false")">
                    <span>@label</span>
                </button>
                @if (activity is not null) { <p class="vaw-node-activity" role="status">@activity</p> }
                @if (node.Type == NodeTypes.Agent && AgentMetrics(nodeId) is { } metrics)
                {
                    <div class="vaw-agent-metrics" aria-label="Agent usage statistics">
                        <span title="Counts recorded model requests for this agent and its delegated agents.">Model turns · @metrics.ModelTurns@(metrics.ModelTurnLimit is { } turnLimit ? $" / {turnLimit:N0}" : null)</span>
                        @if (!metrics.HasReportedUsage) { <span>Tokens · unavailable (provider did not report usage)</span> }
                        else
                        {
                            <span>Tokens · @metrics.InputTokens.ToString("N0") in / @metrics.OutputTokens.ToString("N0") out</span>
                            @if (metrics.CachedInputTokens is not null || metrics.CacheWriteInputTokens is not null)
                            {
                                <span>Cache · @(metrics.CachedInputTokens?.ToString("N0") ?? "—") read / @(metrics.CacheWriteInputTokens?.ToString("N0") ?? "—") write</span>
                            }
                            @if (metrics.ReasoningTokens is { } reasoningTokens)
                            {
                                <span>Reasoning · @reasoningTokens.ToString("N0") tokens (included in output)</span>
                            }
                            @if (metrics.CostIsComplete && metrics.ResponseCount > 0)
                            {
                                <span>Estimated cost · $@metrics.EstimatedCost.ToString("0.000000")</span>
                            }
                            else
                            {
                                <span>Cost estimate · unavailable (configure prices and token usage)</span>
                            }
                        }
                        @if (metrics.ContextWindowTokens is > 0 and { } contextWindow && metrics.LatestInputTokens is { } contextInput)
                        {
                            var percent = Math.Clamp((int)Math.Round(contextInput * 100d / contextWindow), 0, 100);
                            <label>@(metrics.ModelRequestInFlight ? "Last completed context" : "Context") · @contextInput.ToString("N0") / @contextWindow.ToString("N0") (@percent%)
                                <progress max="100" value="@percent" aria-label="Latest provider-reported prompt context usage"></progress>
                            </label>
                        }
                        else if (metrics.ContextWindowTokens is { } configuredWindow)
                        {
                            <span>Context window · @configuredWindow.ToString("N0") tokens; prompt usage pending</span>
                        }
                        else
                        {
                            <span>Context window · not configured in this model connection</span>
                        }
                        @if (metrics.ModelRequestInFlight) { <span>Model request in progress · current usage updates when it responds</span> }
                        <span>Host context compactions · @metrics.CompactionCount</span>
                        @if (metrics.ModelId is { Length: > 0 } modelId) { <small>@modelId</small> }
                    </div>
                }
                @if (BranchPort(nodeId) is { } chosenPort) { <p class="vaw-help">Selected output: @chosenPort</p> }
            </NodeContent>
            <NodeInspector Context="inspected">
            @{ var selectedNode = inspected;
            var started = RootEvents.LastOrDefault(e => e.NodeId == selectedNode && e.Kind == ExecutionEventKinds.NodeStarted);
            var completed = RootEvents.LastOrDefault(e => e.NodeId == selectedNode && e.Kind == ExecutionEventKinds.NodeCompleted);
            var failure = RootEvents.LastOrDefault(e => e.NodeId == selectedNode && e.Kind is ExecutionEventKinds.NodeFailed or ExecutionEventKinds.NodeCancelled);
            var node = Snapshot.Header.Definition.Nodes[selectedNode];
            var dataEvaluation = DataEvaluation(selectedNode);
            var childEvents = VisibleEvents.Where(e => e.ScopeId == selectedNode || e.ScopeId?.StartsWith(selectedNode + "/", StringComparison.Ordinal) == true).ToArray(); }
            <section class="vaw-inspector" aria-label="Selected node payloads">
                <h3>@(string.IsNullOrWhiteSpace(Presentation.Nodes[inspected].Label) ? WorkflowGraphCanvas.FriendlyName(Snapshot.Header.Definition.Nodes[inspected]) : Presentation.Nodes[inspected].Label)</h3>
                <p>Invocation: @(started?.InvocationId?.ToString() ?? "Not recorded at this position")</p>
                @if (node.Type is NodeTypes.StringConstant or NodeTypes.TextConcat or NodeTypes.IntegerConstant or NodeTypes.IntegerAdd or NodeTypes.IntegerEquals or NodeTypes.WorkflowValue)
                {
                    <h4>Evaluated value</h4><pre>@(dataEvaluation is null ? "Not evaluated at this position" : EvaluatedValue(dataEvaluation))</pre>
                    @if (dataEvaluation?.ConnectionId is { } dataConnection) { <p>Delivered on @dataConnection</p> }
                }
                else
                {
                    <h4>Input</h4><pre>@(started?.Data ?? "Not recorded at this position")</pre>
                    <h4>Output</h4><pre>@(completed?.Data ?? "Not recorded at this position")</pre>
                }
                @if (failure is not null) { <h4>@StateLabel(failure)</h4><pre>@failure.Data</pre> }
                @if (Snapshot.Header.Definition.Nodes[inspected].Type == NodeTypes.WorkflowCall)
                {
                    <details><summary>Nested workflow events (@childEvents.Length)</summary>
                        <ul>@foreach (var childEvent in childEvents) { <li><code>@childEvent.ScopeId</code> · @childEvent.Kind · @childEvent.NodeId @if (childEvent.Data is { Length: > 0 } data) { <pre>@data</pre> }</li> }</ul>
                    </details>
                }
            </section>
        <WorkflowApprovalPanel Snapshot="VisibleSnapshot" Client="ApprovalClient" CanDecide="@(follow && !Snapshot.IsTerminal)" OnDecision="ApprovalChanged" />
            </NodeInspector>
        </WorkflowGraphCanvas>
        <ParallelCollaborationPlayback Events="VisibleEvents" />
        <details>
            <summary>Recorded events at this position (@Position)</summary>
            <div class="vaw-table-scroll">
                <table><caption>Execution evidence</caption>
                    <colgroup><col class="vaw-event-sequence-column" /><col class="vaw-event-time-column" /><col class="vaw-event-kind-column" /><col class="vaw-event-node-column" /><col class="vaw-event-node-column" /><col /></colgroup>
                    <thead><tr><th>Sequence</th><th>Time (local)</th><th>Event</th><th>Scope</th><th>Node</th><th>Data</th></tr></thead>
                    <tbody>
                        @foreach (var evt in VisibleEvents)
                        {
                            var localTimestamp = evt.Timestamp.ToLocalTime();
                            var preciseTimestamp = evt.Timestamp.ToString("O");
                            var accessibleTimestamp = localTimestamp.ToString("yyyy-MM-dd HH:mm:ss.fff zzz");
                            var displayTimestamp = localTimestamp.ToString("HH:mm:ss.fff");
                            <tr @key="evt.Sequence"><td>@evt.Sequence</td><td><time datetime="@preciseTimestamp" title="@preciseTimestamp" aria-label="@accessibleTimestamp">@displayTimestamp</time></td><td>@evt.Kind</td><td>@evt.ScopeId</td><td>@evt.NodeId</td><td><pre>@evt.Data</pre></td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>
    }
</section>

@code {
    [Parameter] public RunSnapshot? Snapshot { get; set; }
    [Parameter] public IWorkflowApprovalClient? ApprovalClient { get; set; }
    [Parameter] public EventCallback ApprovalChanged { get; set; }
    private RunSnapshot? VisibleSnapshot => Snapshot is null ? null : follow ? Snapshot : Snapshot with { Events = Snapshot.Events.Take(Position).ToImmutableArray() };
    private WorkflowApprovalRequest? PendingApproval => VisibleSnapshot is { } visible ? WorkflowApprovalEvidence.Pending(visible) : null;
    [Parameter] public WorkflowLayout? Layout { get; set; }
    private WorkflowLayout Presentation = default!;
    private IEnumerable<ExecutionEvent> RootEvents => VisibleEvents.Where(e => e.ScopeId is null);
    private ExecutionEvent? State(string id) => RootEvents.LastOrDefault(e => e.NodeId == id && e.Kind is ExecutionEventKinds.NodeStarted or ExecutionEventKinds.NodeCompleted or ExecutionEventKinds.NodeFailed or ExecutionEventKinds.NodeCancelled);
    private ExecutionEvent? DataEvaluation(string id) => RootEvents.LastOrDefault(e => e.NodeId == id && e.Kind == ExecutionEventKinds.DataEvaluated);
    private static string EvaluatedValue(ExecutionEvent evt)
    {
        try
        {
            using var document = JsonDocument.Parse(evt.Data!);
            var value = document.RootElement.GetProperty("value");
            return value.ValueKind == JsonValueKind.String ? value.GetString() ?? "" : value.GetRawText();
        }
        catch (JsonException) { return evt.Data ?? ""; }
    }
    private string? ActiveActivity(string id)
    {
        if (State(id)?.Kind != ExecutionEventKinds.NodeStarted) return null;
        if (Snapshot?.Header.Definition.Nodes.GetValueOrDefault(id)?.Type == NodeTypes.WorkflowCall)
        {
            var child = VisibleEvents.LastOrDefault(evt => evt.ScopeId == id || evt.ScopeId?.StartsWith(id + "/", StringComparison.Ordinal) == true);
            if (child is not null)
                return child.Kind switch
                {
                    ExecutionEventKinds.SubworkflowStarted => "Starting pinned workflow",
                    ExecutionEventKinds.NodeStarted => $"Running child node · {child.NodeId}",
                    ExecutionEventKinds.ModelRequested => "Waiting for child agent model",
                    ExecutionEventKinds.ToolRequested => "Calling a child MCP tool",
                    ExecutionEventKinds.AgentStarted => "Child agent working",
                    ExecutionEventKinds.SubworkflowCompleted => "Child workflow completed",
                    ExecutionEventKinds.SubworkflowTerminated => "Child workflow ended successfully",
                    ExecutionEventKinds.SubworkflowFailed => "Child workflow failed",
                    _ => child.Kind
                };
        }
        if (Snapshot?.Header.Definition.Nodes.GetValueOrDefault(id)?.Type == NodeTypes.Loop &&
            RootEvents.LastOrDefault(evt => evt.NodeId == id && evt.Kind is ExecutionEventKinds.LoopIterationStarted or ExecutionEventKinds.LoopIterationCompleted or ExecutionEventKinds.LoopStopped) is { } loopActivity)
            return LoopActivity(loopActivity, "Preparing loop");
        var invocation = State(id)?.InvocationId;
        var events = RootEvents.Where(e => e.NodeId == id &&
            (e.InvocationId == invocation || IsDelegatedInvocation(e, invocation))).ToArray();
        var terminalIndex = Array.FindLastIndex(events, e => e.Kind is ExecutionEventKinds.NodeCompleted or ExecutionEventKinds.NodeFailed or ExecutionEventKinds.NodeCancelled);
        if (terminalIndex >= 0) return null;
        var current = events.LastOrDefault(e => e.Kind is ExecutionEventKinds.AgentTeamStarted or ExecutionEventKinds.AgentTeamCompleted or ExecutionEventKinds.AgentTeamFailed or ExecutionEventKinds.AgentChannelMessageSent or ExecutionEventKinds.AgentChannelMessagesRead or ExecutionEventKinds.AgentStarted or ExecutionEventKinds.AgentCompleted or ExecutionEventKinds.AgentFailed or ExecutionEventKinds.ModelRequested or ExecutionEventKinds.ModelResponded or ExecutionEventKinds.ToolRequested or ExecutionEventKinds.ToolAuthorized or ExecutionEventKinds.ToolCompleted or ExecutionEventKinds.ToolFailed or ExecutionEventKinds.ApprovalRequested or ExecutionEventKinds.ParallelJoinProgress);
        if (current is null && Snapshot?.Header.Definition.Nodes.GetValueOrDefault(id)?.Type == NodeTypes.ParallelJoin &&
            RootEvents.LastOrDefault(evt => evt.NodeId == id && evt.Kind == ExecutionEventKinds.ParallelJoinProgress) is { } joinProgress)
            return joinProgress.Data ?? "Waiting for both branch results";
        if (current is null) return "Preparing node";
        var delegatedPrefix = DelegatedProfileLabel(current);
        if (delegatedPrefix is not null)
        {
            var childActivity = current.Kind switch
            {
                ExecutionEventKinds.AgentStarted => "starting",
                ExecutionEventKinds.AgentCompleted => "completed",
                ExecutionEventKinds.AgentFailed => "failed",
                ExecutionEventKinds.ModelRequested => "waiting for model",
                ExecutionEventKinds.ModelResponded => "processing model response",
                ExecutionEventKinds.ToolRequested => ToolActivity(current, "calling MCP tool"),
                ExecutionEventKinds.ToolAuthorized => ToolActivity(current, "MCP tool authorized"),
                ExecutionEventKinds.ToolCompleted => ToolActivity(current, "MCP tool completed"),
                ExecutionEventKinds.ToolFailed => ToolActivity(current, "MCP tool failed"),
                ExecutionEventKinds.AgentChannelMessageSent => "sending team message",
                ExecutionEventKinds.AgentChannelMessagesRead => "reading team channel",
                _ => "running"
            };
            return $"Subagent {delegatedPrefix} · {childActivity}";
        }
        return current.Kind switch
        {
            ExecutionEventKinds.AgentTeamStarted => "Running parallel agent team",
            ExecutionEventKinds.AgentTeamCompleted => "Joining named team results",
            ExecutionEventKinds.AgentTeamFailed => "Agent team failed",
            ExecutionEventKinds.AgentChannelMessageSent => "Sending team message",
            ExecutionEventKinds.AgentChannelMessagesRead => "Reading team channel",
            ExecutionEventKinds.AgentStarted => "Preparing agent",
            ExecutionEventKinds.ModelRequested => "Waiting for model response",
            ExecutionEventKinds.ModelResponded => "Processing model response",
            ExecutionEventKinds.ToolRequested => ToolActivity(current, "Calling MCP tool"),
            ExecutionEventKinds.ToolAuthorized => ToolActivity(current, "MCP tool authorized"),
            ExecutionEventKinds.ToolCompleted => ToolActivity(current, "MCP tool completed"),
            ExecutionEventKinds.ToolFailed => ToolActivity(current, "MCP tool failed"),
            ExecutionEventKinds.ApprovalRequested => "Waiting for approval",
            ExecutionEventKinds.ParallelJoinProgress => current.Data ?? "Waiting for both branch results",
            _ => "Processing"
        };
    }
    private static string LoopActivity(ExecutionEvent evt, string fallback)
    {
        try
        {
            using var data = JsonDocument.Parse(evt.Data ?? "{}");
            var root = data.RootElement;
            var iteration = root.TryGetProperty("iteration", out var iterationValue) && iterationValue.TryGetInt32(out var currentIteration) ? currentIteration :
                root.TryGetProperty("iterations", out var iterationsValue) && iterationsValue.TryGetInt32(out var completedIterations) ? completedIterations : 0;
            var maximum = root.TryGetProperty("maximumIterations", out var maximumValue) && maximumValue.TryGetInt32(out var maxIterations) ? maxIterations : 0;
            var reason = root.TryGetProperty("reason", out var reasonValue) && reasonValue.ValueKind == JsonValueKind.String ? reasonValue.GetString() : null;
            return evt.Kind switch
            {
                ExecutionEventKinds.LoopIterationStarted when maximum > 0 => $"Iteration {iteration} of {maximum} · entering body",
                ExecutionEventKinds.LoopIterationCompleted when iteration > 0 => $"Completed iteration {iteration}",
                ExecutionEventKinds.LoopStopped when reason == "maximum-iterations" => $"Reached iteration limit · {iteration} of {maximum}",
                ExecutionEventKinds.LoopStopped when reason == "predicate-false" => $"Predicate no longer matches after {iteration} iterations",
                _ => fallback
            };
        }
        catch (JsonException) { return fallback; }
    }
    private static bool IsDelegatedInvocation(ExecutionEvent evt, Guid? parentInvocationId)
    {
        if (parentInvocationId is not { } expectedParent) return false;
        try
        {
            using var data = JsonDocument.Parse(evt.Data ?? "{}");
            return data.RootElement.TryGetProperty("parentInvocationId", out var parent) && parent.TryGetGuid(out var value) && value == expectedParent;
        }
        catch (JsonException) { return false; }
    }
    private static string? DelegatedProfileLabel(ExecutionEvent evt)
    {
        try
        {
            using var data = JsonDocument.Parse(evt.Data ?? "{}");
            return data.RootElement.TryGetProperty("delegatedProfileId", out var profile) && profile.ValueKind == JsonValueKind.String
                ? profile.GetString() : null;
        }
        catch (JsonException) { return null; }
    }
    private static string ToolActivity(ExecutionEvent evt, string description)
    {
        try
        {
            using var data = JsonDocument.Parse(evt.Data ?? "{}");
            var payload = data.RootElement.TryGetProperty("eventData", out var nested) && nested.ValueKind == JsonValueKind.String
                ? nested.GetString() : evt.Data;
            if (!string.IsNullOrEmpty(payload) && payload != evt.Data)
            {
                using var nestedData = JsonDocument.Parse(payload);
                return ToolActivity(nestedData.RootElement, description);
            }
            return ToolActivity(data.RootElement, description);
        }
        catch (JsonException) { }
        return description;
    }
    private static string ToolActivity(JsonElement data, string description)
    {
        if (data.TryGetProperty("bindingId", out var binding) && binding.ValueKind == JsonValueKind.String &&
            binding.GetString() is { } id)
            return $"{description}: {id[(id.LastIndexOf('.') + 1)..]}";
        return description;
    }

    private sealed record AgentUsageStatistics(long InputTokens, long OutputTokens, int ResponseCount,
        long? LatestInputTokens, int? ContextWindowTokens, decimal EstimatedCost, bool CostIsComplete, string? ModelId,
        bool ModelRequestInFlight, int ModelTurns, int CompactionCount, long? CachedInputTokens,
        long? CacheWriteInputTokens, long? ReasoningTokens, bool HasReportedUsage, int? ModelTurnLimit);

    private AgentUsageStatistics? AgentMetrics(string nodeId)
    {
        if (Snapshot?.Header.Definition.Nodes.GetValueOrDefault(nodeId)?.Type != NodeTypes.Agent) return null;
        var invocation = RootEvents.LastOrDefault(evt => evt.NodeId == nodeId && evt.Kind == ExecutionEventKinds.NodeStarted)?.InvocationId;
        if (invocation is null) return null;

        var agentStarts = RootEvents.Where(evt => evt.NodeId == nodeId && evt.Kind == ExecutionEventKinds.AgentStarted &&
            (evt.InvocationId == invocation || IsDelegatedInvocation(evt, invocation))).ToArray();
        var providers = agentStarts.Where(evt => evt.InvocationId is not null)
            .ToDictionary(evt => evt.InvocationId!.Value, ProviderUsageFromAgentStart);
        var modelEvents = RootEvents.Where(evt => evt.NodeId == nodeId &&
            evt.InvocationId is { } responseInvocation && providers.ContainsKey(responseInvocation)).ToArray();
        var responses = modelEvents.Where(evt => evt.Kind == ExecutionEventKinds.ModelResponded).ToArray();
        var requests = modelEvents.Where(evt => evt.Kind == ExecutionEventKinds.ModelRequested).ToArray();
        var responseCallIds = responses.Select(ModelCallId).Where(id => id is not null).ToHashSet(StringComparer.Ordinal);
        var requestInFlight = requests.Any(request => ModelCallId(request) is { } callId && !responseCallIds.Contains(callId));
        var compactionCount = modelEvents.Count(evt => evt.Kind == ExecutionEventKinds.AgentContextCompacted);
        var rootProvider = providers.GetValueOrDefault(invocation.Value);
        var modelTurnLimit = rootProvider?.MaximumTurns;
        if (responses.Length == 0)
        {
            return rootProvider is null ? null : new(0, 0, 0, null, rootProvider.ContextWindowTokens, 0, false,
                rootProvider.ModelId, requestInFlight, requests.Length, compactionCount, null, null, null, false, modelTurnLimit);
        }

        long inputTokens = 0;
        long outputTokens = 0;
        long? latestInputTokens = null;
        long cachedInputTokens = 0;
        long cacheWriteInputTokens = 0;
        long reasoningTokens = 0;
        var allCacheReadsReported = true;
        var allCacheWritesReported = true;
        var allReasoningCountsReported = true;
        int? contextWindow = rootProvider?.ContextWindowTokens;
        decimal estimatedCost = 0;
        var costComplete = true;
        string? modelId = null;
        var reportedResponseCount = 0;
        foreach (var response in responses)
        {
            var provider = providers[response.InvocationId!.Value];
            modelId = ModelIdFromResponse(response) ?? provider?.ModelId ?? modelId;
            if (!TryGetUsage(response.Data, out var usage))
            {
                costComplete = false;
                allCacheReadsReported = allCacheWritesReported = allReasoningCountsReported = false;
                continue;
            }
            reportedResponseCount++;

            var input = usage.InputTokens;
            var output = usage.OutputTokens;
            inputTokens = checked(inputTokens + input);
            outputTokens = checked(outputTokens + output);
            if (usage.CachedInputTokens is { } cached) cachedInputTokens = checked(cachedInputTokens + cached);
            else allCacheReadsReported = false;
            if (usage.CacheWriteInputTokens is { } cacheWrite) cacheWriteInputTokens = checked(cacheWriteInputTokens + cacheWrite);
            else allCacheWritesReported = false;
            if (usage.ReasoningTokens is { } reasoning) reasoningTokens = checked(reasoningTokens + reasoning);
            else allReasoningCountsReported = false;
            latestInputTokens = input;
            contextWindow = provider?.ContextWindowTokens;
            var cacheRead = usage.CachedInputTokens ?? 0;
            var cacheWriteTokens = usage.CacheWriteInputTokens ?? 0;
            if (cacheRead > input || cacheWriteTokens > input - cacheRead)
            {
                costComplete = false;
                continue;
            }
            if (provider is null || provider.InputCostPerMillionTokens is not { } inputRate || provider.OutputCostPerMillionTokens is not { } outputRate)
            {
                costComplete = false;
                continue;
            }
            if ((cacheRead > 0 && provider.CacheReadCostPerMillionTokens is not { }) ||
                (cacheWriteTokens > 0 && provider.CacheWriteCostPerMillionTokens is not { }) ||
                (provider.CacheReadCostPerMillionTokens is not null && usage.CachedInputTokens is null) ||
                (provider.CacheWriteCostPerMillionTokens is not null && usage.CacheWriteInputTokens is null))
            {
                costComplete = false;
                continue;
            }
            var uncachedInput = input - cacheRead - cacheWriteTokens;
            estimatedCost += uncachedInput * inputRate / 1_000_000m + output * outputRate / 1_000_000m;
            if (cacheRead > 0) estimatedCost += cacheRead * provider.CacheReadCostPerMillionTokens!.Value / 1_000_000m;
            if (cacheWriteTokens > 0) estimatedCost += cacheWriteTokens * provider.CacheWriteCostPerMillionTokens!.Value / 1_000_000m;
        }

        return new(inputTokens, outputTokens, reportedResponseCount, latestInputTokens, contextWindow, estimatedCost, costComplete,
            modelId, requestInFlight, requests.Length, compactionCount,
            allCacheReadsReported ? cachedInputTokens : null,
            allCacheWritesReported ? cacheWriteInputTokens : null,
            allReasoningCountsReported ? reasoningTokens : null, reportedResponseCount > 0, modelTurnLimit);
    }

    private static string? ModelCallId(ExecutionEvent evt) =>
        TryParse(evt.Data, out var root) && TryGet(root, "modelCallId", out var callId) && callId.ValueKind == JsonValueKind.String
            ? callId.GetString() : null;

    private sealed record ProviderUsage(int? ContextWindowTokens, decimal? InputCostPerMillionTokens,
        decimal? OutputCostPerMillionTokens, decimal? CacheReadCostPerMillionTokens,
        decimal? CacheWriteCostPerMillionTokens, string? ModelId, int? MaximumTurns);

    private static ProviderUsage? ProviderUsageFromAgentStart(ExecutionEvent evt)
    {
        if (!TryParse(evt.Data, out var root) || !TryGet(root, "provider", out var provider)) return null;
        var context = TryGet(provider, "ContextWindowTokens", out var contextElement) &&
            contextElement.ValueKind == JsonValueKind.Number && contextElement.TryGetInt32(out var contextValue)
                ? Math.Max(0, contextValue) : (int?)null;
        var inputRate = TryGet(provider, "InputCostPerMillionTokens", out var inputElement) &&
            inputElement.ValueKind == JsonValueKind.Number && inputElement.TryGetDecimal(out var inputValue)
                ? inputValue : (decimal?)null;
        var outputRate = TryGet(provider, "OutputCostPerMillionTokens", out var outputElement) &&
            outputElement.ValueKind == JsonValueKind.Number && outputElement.TryGetDecimal(out var outputValue)
                ? outputValue : (decimal?)null;
        var cacheReadRate = TryGet(provider, "CacheReadCostPerMillionTokens", out var cacheReadElement) &&
            cacheReadElement.ValueKind == JsonValueKind.Number && cacheReadElement.TryGetDecimal(out var cacheReadValue)
                ? cacheReadValue : (decimal?)null;
        var cacheWriteRate = TryGet(provider, "CacheWriteCostPerMillionTokens", out var cacheWriteElement) &&
            cacheWriteElement.ValueKind == JsonValueKind.Number && cacheWriteElement.TryGetDecimal(out var cacheWriteValue)
                ? cacheWriteValue : (decimal?)null;
        var model = TryGet(provider, "ModelId", out var modelElement) && modelElement.ValueKind == JsonValueKind.String
            ? modelElement.GetString() : null;
        var maximumTurns = TryGet(root, "maximumTurns", out var turnsElement) &&
            turnsElement.ValueKind == JsonValueKind.Number && turnsElement.TryGetInt32(out var turnsValue) && turnsValue > 0
                ? turnsValue : (int?)null;
        return new(context is > 0 ? context : null, inputRate, outputRate, cacheReadRate, cacheWriteRate, model, maximumTurns);
    }

    private sealed record RecordedUsage(long InputTokens, long OutputTokens, long? CachedInputTokens,
        long? CacheWriteInputTokens, long? ReasoningTokens);

    private static bool TryGetUsage(string? data, out RecordedUsage usageResult)
    {
        usageResult = default!;
        if (!TryParse(data, out var root) || !TryGet(root, "usage", out var usage) ||
            !TryGet(usage, "InputTokenCount", out var input) || !input.TryGetInt64(out var inputTokens) ||
            !TryGet(usage, "OutputTokenCount", out var output) || !output.TryGetInt64(out var outputTokens))
            return false;
        if (inputTokens < 0 || outputTokens < 0) return false;
        bool OptionalCount(string name, out long? count)
        {
            count = null;
            if (!TryGet(usage, name, out var value)) return true;
            if (value.ValueKind != JsonValueKind.Number || !value.TryGetInt64(out var parsedCount) || parsedCount < 0) return false;
            count = parsedCount;
            return true;
        }
        if (!OptionalCount("CachedInputTokenCount", out var cachedInput) ||
            !OptionalCount("ReasoningTokenCount", out var reasoning) ||
            !OptionalCount("cacheWriteInputTokenCount", out var cacheWrite)) return false;
        long? cacheWriteFromAdditional = null;
        if (TryGet(usage, "AdditionalCounts", out var additional) && TryGet(additional, "cache_write_input_tokens", out var writeValue))
        {
            if (writeValue.ValueKind != JsonValueKind.Number || !writeValue.TryGetInt64(out var writeCount) || writeCount < 0) return false;
            cacheWriteFromAdditional = writeCount;
        }
        usageResult = new(inputTokens, outputTokens, cachedInput, cacheWrite ?? cacheWriteFromAdditional, reasoning);
        return true;
    }

    private static string? ModelIdFromResponse(ExecutionEvent evt) =>
        TryParse(evt.Data, out var root) && TryGet(root, "ModelId", out var model) && model.ValueKind == JsonValueKind.String
            ? model.GetString() : null;

    private static bool TryParse(string? json, out JsonElement root)
    {
        root = default;
        if (string.IsNullOrWhiteSpace(json)) return false;
        try
        {
            using var document = JsonDocument.Parse(json);
            root = document.RootElement.Clone();
            return true;
        }
        catch (JsonException) { return false; }
    }

    private static bool TryGet(JsonElement element, string name, out JsonElement value)
    {
        if (element.ValueKind == JsonValueKind.Object)
        {
            foreach (var property in element.EnumerateObject())
            {
                if (!property.Name.Equals(name, StringComparison.OrdinalIgnoreCase)) continue;
                value = property.Value;
                return true;
            }
        }
        value = default;
        return false;
    }

    private string? BranchPort(string id)
    {
        var decision = RootEvents.LastOrDefault(e => e.NodeId == id && e.Kind == ExecutionEventKinds.BranchSelected);
        if (decision?.Data is null) return null;
        try
        {
            using var document = JsonDocument.Parse(decision.Data);
            return document.RootElement.TryGetProperty("port", out var port) && port.ValueKind == JsonValueKind.String && port.GetString() is "true" or "false"
                ? port.GetString() : null;
        }
        catch (JsonException) { return null; }
    }
    private bool PausedBefore(string id) => VisibleStatus == "paused" &&
        RootEvents.LastOrDefault(e => e.Kind == ExecutionEventKinds.Paused)?.NodeId == id;
    private string? PendingRootNodeId => PendingApproval?.Action.ScopeId is { } scope
        ? scope.Split('/', 2, StringSplitOptions.None)[0]
        : PendingApproval?.Action.ApprovalNodeId;
    private string NodeStateClass(string id) => PendingRootNodeId == id ? "vaw-waiting-approval" : DataEvaluation(id) is not null ? "vaw-complete" : State(id)?.Kind switch
    {
        ExecutionEventKinds.NodeCompleted => "vaw-complete",
        ExecutionEventKinds.NodeFailed or ExecutionEventKinds.NodeCancelled => "vaw-failed",
        _ => PausedBefore(id) ? "vaw-paused-boundary" : ""
    };
    private IReadOnlySet<string> Delivered => VisibleEvents.Where(e => e.Kind is ExecutionEventKinds.Transfer or ExecutionEventKinds.ExecutionActivated or ExecutionEventKinds.DataEvaluated && e.ConnectionId is not null).Select(e => e.ConnectionId!).ToHashSet(StringComparer.Ordinal);
    private Guid? currentRun;
    private bool follow = true;
    private int cursor;
    private string? selectedNode;
    private string VisibleStatus => Snapshot is null ? "queued" : follow ? Snapshot.Status :
        (Snapshot with { Events = Snapshot.Events.Take(Position).ToImmutableArray() }).Status;
    private int Position => Snapshot is null ? 0 : follow ? Snapshot.Events.Length : Math.Clamp(cursor, 0, Snapshot.Events.Length);
    private IEnumerable<ExecutionEvent> VisibleEvents => Snapshot?.Events.Take(Position) ?? [];

    protected override void OnParametersSet()
    {
        if (Snapshot is not null) Presentation = Layout ?? (currentRun == Snapshot.Header.RunId && Presentation is not null ? Presentation : WorkflowLayout.Create(Snapshot.Header.Definition));
        if (currentRun == Snapshot?.Header.RunId) return;
        currentRun = Snapshot?.Header.RunId;
        selectedNode = Snapshot?.Header.Definition.EntryNodeId;
        cursor = 0;
        follow = true;
    }

    private Task SelectNode(string id) { selectedNode = id; return Task.CompletedTask; }
    private void Previous() { cursor = Math.Max(0, Position - 1); follow = false; }
    private static string StateLabel(ExecutionEvent? state) => state?.Kind switch
    {
        null => "Not executed at this position",
        ExecutionEventKinds.NodeCompleted => "Completed",
        ExecutionEventKinds.NodeFailed => "Failed",
        ExecutionEventKinds.NodeCancelled => "Cancelled",
        _ => "Running"
    };
    private void Next() { cursor = Math.Min(Snapshot!.Events.Length, Position + 1); follow = false; }
    private void Scrub(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var value)) { cursor = value; follow = false; }
    }

}
