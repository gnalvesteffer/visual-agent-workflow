@inject StudioProjectWorkspace ProjectWorkspace
@inject StudioOpenWorkspaceStore OpenWorkspace
@inject NavigationManager Navigation

<nav class="vaw-studio-navigation" aria-label="Studio navigation">
    @if (ShowProjectSelector)
    {
        <label class="vaw-project-picker">Project
            <select aria-label="Current project" value="@SelectedProjectId" @onchange="ChangeProject">
                @foreach (var project in ProjectWorkspace.Projects.Where(project => !project.IsArchived))
                {
                    <option value="@project.Id">@project.Name</option>
                }
            </select>
        </label>
    }
    <a data-vaw-route-link href="@ProjectRoute" aria-current="@(ActivePage == "workflow" ? "page" : null)">Workflow</a>
    <a data-vaw-route-link href="@ProjectAssetRoute("agents")" aria-current="@(ActivePage == "agents" ? "page" : null)">Agents</a>
    <a data-vaw-route-link href="@ProjectAssetRoute("skills")" aria-current="@(ActivePage == "skills" ? "page" : null)">Skills</a>
    <a data-vaw-route-link href="@ProjectAssetRoute("functions")" aria-current="@(ActivePage == "functions" ? "page" : null)">Functions</a>
    <a data-vaw-route-link href="/projects" aria-current="@(ActivePage == "projects" ? "page" : null)">Projects</a>
    <a data-vaw-route-link href="/source-project" aria-current="@(ActivePage == "source-project" ? "page" : null)">Open folder</a>
    <a data-vaw-route-link href="/mcp" aria-current="@(ActivePage == "mcp" ? "page" : null)">MCP library</a>
    <a data-vaw-route-link href="/settings" aria-current="@(ActivePage == "models" ? "page" : null)">Models</a>
    <a data-vaw-route-link href="/observe" aria-current="@(ActivePage == "observe" ? "page" : null)">Observe</a>
    <StudioThemePicker />
    @if (projectSelectError is not null)
    {
        <span class="vaw-navigation-error" role="status">@projectSelectError</span>
    }
</nav>

@code {
    [Parameter] public bool ShowProjectSelector { get; set; } = true;
    [Parameter] public string? ProjectId { get; set; }
    private string? projectSelectError;

    private string SelectedProjectId => ProjectId ?? ProjectWorkspace.CurrentProjectId;
    private StudioProject SelectedProject => ProjectWorkspace.Projects.Single(project => project.Id == SelectedProjectId);
    private string ProjectRoute => SelectedProject.IsFolderBacked
        ? $"/source-project/folder/{Uri.EscapeDataString(SelectedProject.Id)}"
        : $"/projects/{Uri.EscapeDataString(SelectedProject.Id)}";

    private string ProjectAssetRoute(string asset) => SelectedProject.IsFolderBacked
        ? ProjectRoute
        : $"/projects/{Uri.EscapeDataString(SelectedProject.Id)}/{asset}";

    private string ActivePage
    {
        get
        {
            var path = new Uri(Navigation.Uri).AbsolutePath.Trim('/');
            if (path == "projects") return "projects";
            if (path == "source-project") return "source-project";
            if (path == "mcp") return "mcp";
            if (path == "settings") return "models";
            if (path == "observe") return "observe";
            if (path.EndsWith("/agents", StringComparison.Ordinal) || path == "agents") return "agents";
            if (path.EndsWith("/skills", StringComparison.Ordinal) || path == "skills") return "skills";
            if (path.EndsWith("/functions", StringComparison.Ordinal) || path == "functions") return "functions";
            return "workflow";
        }
    }

    private void ChangeProject(ChangeEventArgs args)
    {
        var projectId = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(projectId)) return;
        try
        {
            var project = ProjectWorkspace.Projects.Single(item => item.Id == projectId);
            if (project.IsFolderBacked)
            {
                OpenWorkspace.Open(projectId);
                if (!new Uri(Navigation.Uri).AbsolutePath.StartsWith("/source-project", StringComparison.Ordinal))
                    Navigation.NavigateTo($"/source-project/folder/{Uri.EscapeDataString(projectId)}");
            }
            else
            {
                Navigation.NavigateTo($"/projects/{Uri.EscapeDataString(projectId)}");
            }
            projectSelectError = null;
        }
        catch (Exception exception) when (exception is InvalidOperationException or KeyNotFoundException or IOException)
        {
            projectSelectError = exception.Message;
        }
    }
}
