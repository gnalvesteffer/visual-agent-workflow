@inject StudioProjectWorkspace ProjectWorkspace
@inject NavigationManager Navigation

<nav class="vaw-studio-navigation" aria-label="Studio navigation">
    <label class="vaw-project-picker">Project
        <select aria-label="Current project" value="@ProjectWorkspace.CurrentProjectId" @onchange="ChangeProject">
            @foreach (var project in ProjectWorkspace.Projects.Where(project => !project.IsArchived))
            {
                <option value="@project.Id">@project.Name</option>
            }
        </select>
    </label>
    <a href="/projects/@ProjectWorkspace.CurrentProjectId" aria-current="@(ActivePage == "workflow" ? "page" : null)">Workflow</a>
    <a href="/projects/@ProjectWorkspace.CurrentProjectId/agents" aria-current="@(ActivePage == "agents" ? "page" : null)">Agents</a>
    <a href="/projects/@ProjectWorkspace.CurrentProjectId/skills" aria-current="@(ActivePage == "skills" ? "page" : null)">Skills</a>
    <a href="/projects/@ProjectWorkspace.CurrentProjectId/functions" aria-current="@(ActivePage == "functions" ? "page" : null)">Functions</a>
    <a href="/projects" aria-current="@(ActivePage == "projects" ? "page" : null)">Projects</a>
    <a href="/mcp" aria-current="@(ActivePage == "mcp" ? "page" : null)">MCP library</a>
    <a href="/settings" aria-current="@(ActivePage == "models" ? "page" : null)">Models</a>
    <a href="/observe" aria-current="@(ActivePage == "observe" ? "page" : null)">Observe</a>
    <StudioThemePicker />
</nav>

@code {
    private string ActivePage
    {
        get
        {
            var path = new Uri(Navigation.Uri).AbsolutePath.Trim('/');
            if (path == "projects") return "projects";
            if (path == "mcp") return "mcp";
            if (path == "settings") return "models";
            if (path == "observe") return "observe";
            if (path.EndsWith("/agents", StringComparison.Ordinal) || path == "agents") return "agents";
            if (path.EndsWith("/skills", StringComparison.Ordinal) || path == "skills") return "skills";
            if (path.EndsWith("/functions", StringComparison.Ordinal) || path == "functions") return "functions";
            return "workflow";
        }
    }

    private void ChangeProject(ChangeEventArgs args)
    {
        var projectId = args.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(projectId))
            Navigation.NavigateTo($"/projects/{Uri.EscapeDataString(projectId)}", forceLoad: true);
    }
}
