                            <button type="button" role="tab" aria-selected="@(bottomTab == "runs" ? "true" : "false")" @onclick='() => bottomTab = "runs"'>Runs</button>
                            <button type="button" role="tab" aria-selected="@(bottomTab == "issues" ? "true" : "false")" @onclick='() => bottomTab = "issues"'>Problems <span class="vaw-bottom-count">@(WorkflowValidator.Validate(definition).Length + (mcpChoicesError is null ? 0 : 1) + (providerChoicesError is null ? 0 : 1))</span></button>
                            <button type="button" role="tab" aria-selected="@(bottomTab == "output" ? "true" : "false")" @onclick='() => bottomTab = "output"'>Output</button>
                        </nav>
                        <section class="vaw-bottom-panel" role="tabpanel" aria-label="Workflow run history" hidden="@(bottomTab != "runs")">
