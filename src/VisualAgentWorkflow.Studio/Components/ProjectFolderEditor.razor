    private void DeleteProjectDirectory()
    {
        if (!CanManageTree || openDirectory is null || manifest is null || treeContext?.Path is not { Length: > 0 } path) return;
        if (!treeDeleteArmed) { treeDeleteArmed = true; return; }
        busy = true;
        try
        {
            _ = StudioProjectSourceTreeOperations.DeleteEmptyDirectory(openDirectory, path, sourceManifestHash);
            RefreshProjectSource();
            CloseTreeContext();
            message = $"Deleted empty folder {path}.";
            error = null;
        }
        catch (Exception exception) when (exception is ArgumentException or IOException or UnauthorizedAccessException or System.Security.SecurityException or System.Text.Json.JsonException)
        { TreeOperationError = exception.Message; treeDeleteArmed = false; }
        finally { busy = false; }
    }

    private void DeleteTreeFile()
    {
        if (!CanManageTree || openDirectory is null || manifest is null || treeContext?.File is not { } file) return;
        if (!treeDeleteArmed) { treeDeleteArmed = true; return; }
        busy = true;
        try
        {
            _ = StudioProjectSourceTreeOperations.DeleteFile(openDirectory, file.Path, sourceManifestHash);
            editorTabs.RemoveAll(tab => tab.Path == file.Path);
            if (SelectedFilePath == file.Path) ClearOpenEditor();
            RefreshProjectSource();
            CloseTreeContext();
            message = $"Deleted {file.Path} from the project.";
            error = null;
        }
        catch (Exception exception) when (exception is ArgumentException or IOException or UnauthorizedAccessException or System.Security.SecurityException or System.Text.Json.JsonException)
        { TreeOperationError = exception.Message; treeDeleteArmed = false; }
        finally { busy = false; }
    }

