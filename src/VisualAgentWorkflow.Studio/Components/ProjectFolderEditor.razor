                            else
                            {
                                <table class="vaw-ide-run-table"><thead><tr><th scope="col">Status</th><th scope="col">Workflow</th><th scope="col">Started</th><th scope="col">Run</th><th scope="col">Actions</th></tr></thead><tbody><tr><td><span class="vaw-run-state" data-status="@folderRun.Status">@folderRun.Status</span></td><td>@WorkflowName(folderRun.Header.Definition)</td><td>@folderRun.Header.CreatedAt.ToLocalTime().ToString("MMM d, HH:mm:ss")</td><td><code>@folderRun.Header.RunId.ToString()[..8]</code></td><td><button type="button" @onclick="() => folderInspectRun = true">Inspect execution</button></td></tr></tbody></table>
                            }
                            @if (folderRunError is not null) { <p role="alert" class="vaw-error">@folderRunError</p> }
                        </section>
                        <section class="vaw-bottom-panel" role="tabpanel" aria-label="Workflow issues" hidden="@(bottomTab != "issues")">
                            @if (mcpChoicesError is not null) { <p class="vaw-error">@mcpChoicesError</p> }
                            @if (providerChoicesError is not null) { <p class="vaw-error">@providerChoicesError</p> }
                            @if (WorkflowValidator.Validate(definition) is { Length: > 0 } issues)
                            { <ul class="vaw-bottom-issues">@foreach (var issue in issues) { <li @key="(issue.Path, issue.Code)"><strong>@issue.Path</strong><span>@issue.Message</span></li> }</ul> }
                            else { <p class="vaw-bottom-empty">No workflow issues. This graph is valid and ready to run.</p> }
                        </section>
                        <section class="vaw-bottom-panel" role="tabpanel" aria-label="Workflow output" hidden="@(bottomTab != "output")">
                            @if (folderRun is not null)
                            {
                                <div class="vaw-output-heading"><span>@folderRun.Status · <code>@folderRun.Header.RunId.ToString()[..8]</code></span><button type="button" @onclick="() => folderInspectRun = true">Inspect execution</button></div>
                                <pre class="vaw-workflow-result">@(folderRun.Events.LastOrDefault(item => item.Kind is ExecutionEventKinds.Completed or ExecutionEventKinds.Failed)?.Data ?? "No result recorded.")</pre>
                            }
                            else { <p class="vaw-bottom-empty">Run this workflow to inspect its output and execution evidence.</p> }
                        </section>
                    </section>
                    <footer class="vaw-document-statusbar"><span>@(dirty ? "Unsaved changes" : "Ready")</span><span>@definition.Nodes.Count nodes</span><button type="button" @onclick='() => bottomTab = "issues"'>Problems: @(WorkflowValidator.Validate(definition).Length + (mcpChoicesError is null ? 0 : 1) + (providerChoicesError is null ? 0 : 1))</button><span>Project: @manifest.ProjectName</span></footer>
                    </div>
                }
            </section>
        </section>
    }

</section>
@if (IsActive && runDialogOpen && definition is not null)
{
    <dialog @ref="runDialog" class="vaw-run-dialog" aria-labelledby="folder-run-dialog-title" @oncancel="CloseRunDialog" @oncancel:preventDefault="true">
        <h2 id="folder-run-dialog-title">Run @WorkflowName(definition)</h2>
        <p>Enter test values for this run. Studio runs the saved workflow; unsaved edits must be saved first.</p>
        <label>Workflow input <textarea @bind="runInput" rows="5" maxlength="16384" autofocus="autofocus"></textarea></label>
        @if (definition.Parameters is { Count: > 0 } runParameterDefinitions)
        {
            @foreach (var (parameterId, parameter) in runParameterDefinitions)
            {
                <label @key="parameterId">@(string.IsNullOrWhiteSpace(parameter.DisplayName) ? parameterId : parameter.DisplayName)
                    @if (parameter.Type == "choice" && parameter.Choices is { } choices)
                    { <select value="@RunParameterValue(parameterId)" @onchange="args => SetRunParameter(parameterId, args.Value?.ToString())">@foreach (var choice in choices) { <option value="@choice">@choice</option> }</select> }
                    else if (parameter.Type == "boolean")
                    { <select value="@RunParameterValue(parameterId)" @onchange="args => SetRunParameter(parameterId, args.Value?.ToString())"><option value="true">True</option><option value="false">False</option></select> }
                    else if (parameter.Type == "integer" || parameter.Type == "number")
                    { <input type="number" step="@(parameter.Type == "integer" ? "1" : "any")" value="@RunParameterValue(parameterId)" @oninput="args => SetRunParameter(parameterId, args.Value?.ToString())" /> }
                    else
                    { <input value="@RunParameterValue(parameterId)" @oninput="args => SetRunParameter(parameterId, args.Value?.ToString())" /> }
                    @if (!string.IsNullOrWhiteSpace(parameter.Description)) { <small class="vaw-help">@parameter.Description</small> }
                </label>
            }
        }
        <p class="vaw-help">Run history is stored by Studio outside the project. Do not enter secrets in workflow inputs.</p>
        @if (folderRunError is not null) { <p role="alert" class="vaw-error">@folderRunError</p> }
        <div class="vaw-run-dialog-actions">
            <button type="button" @onclick="CloseRunDialog" disabled="@folderRunActive">Cancel</button>
            <button type="button" class="vaw-primary" @onclick="RunSavedWorkflow" disabled="@(!CanRunSavedWorkflow)">@(folderRunActive ? "Starting…" : "Run workflow")</button>
        </div>
    </dialog>
}
