            markdownEditorReady = false;
        }
        else if (openedDocumentationPath is { } path && manifest?.Files.SingleOrDefault(file => file.Path == path) is { } file)
        {
            documentationDirty = false;
            _ = OpenDocumentation(file);
        }
        error = null;
        message = "Markdown changes discarded.";
    }

