    private void SaveProfile()
    {
        if (profileSource is null || !profileFormDirty) return;
        busy = true;
        error = null;
        try
        {
            var selectedTools = bindings.Where(tool => selectedProfileTools.Contains(tool.BindingId))
                .Select(tool => new ToolBindingRequest(tool.BindingId, tool.ContractHash) { DescriptionHash = tool.DescriptionHash });
            var profileTools = selectedTools.Concat(unavailableProfileTools)
                .DistinctBy(tool => tool.BindingId).ToImmutableArray();
            var selectedSkills = projectSkills.Where(item => selectedProfileSkills.Contains(item.Skill.Id + "@" + item.Skill.Version))
                .Select(item => item.Skill);
            var profileSkills = selectedSkills.Concat(unavailableProfileSkills)
                .DistinctBy(skill => skill.Id + "@" + skill.Version).ToImmutableArray();
            var channels = profileChannelsText.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(channel => channel.TrimEnd('\r')).Distinct(StringComparer.Ordinal).ToImmutableArray();
            if (channels.Length > 8) throw new ArgumentException("An agent profile can join up to eight coordination channels.");
            var effort = Enum.TryParse<AgentReasoningEffort>(profileReasoning, out var selectedEffort)
                ? selectedEffort : (AgentReasoningEffort?)null;
            var provider = providers.SingleOrDefault(item => item.ProviderId == profileProviderId);
            if (effort is not null && provider is not null && !provider.SupportsReasoningEffort)
                throw new ArgumentException("The selected provider does not advertise reasoning effort support.");
            var profile = AgentProfile.Create(profileId.Trim(), profileVersion.Trim(), profileName.Trim(), profileDescription.Trim(),
                profileProviderId.Trim(), profileBeingEdited?.ProviderVersion, profileInstructions, profileTools, profileSkills,
                effort, profileMaxOutputTokens, channels.IsEmpty ? null : channels);
            var saved = profileSource.SaveNewVersion(profile, profileFolder.Trim(), sourceManifestHash, creationDirectory);
            RefreshProjectSource();
            openedProfile = saved;
            AddEditorTab(manifest!.Files.Single(file => file.Path == saved.RelativePath));
            creatingNewProfile = false;
            creationDirectory = null;
            LoadProfileRevision(saved);
            message = $"Saved agent profile revision {saved.Item.Profile.Id}@{saved.Item.Profile.Version}.";
        }
        catch (Exception exception) when (exception is ArgumentException or IOException or UnauthorizedAccessException or System.Security.SecurityException or System.Text.Json.JsonException)
        {
            error = exception.Message;
        }
        finally { busy = false; }
    }

    private void RefreshProjectSource()
    {
        var (loadedManifest, _) = StudioProjectSourceDirectory.Read(openDirectory!);
        manifest = loadedManifest;
        sourceManifestHash = StudioProjectSourceArchive.ComputeManifestHash(loadedManifest);
        fileTree = StudioProjectFileTree.Build(loadedManifest.Files, loadedManifest.Directories);
        projectSkills = skillSource!.List().Select(skill => skill.Item).ToArray();
        RefreshFileNames();
    }

    private void RefreshFileNames()
    {
        var names = new Dictionary<string, string>(StringComparer.Ordinal);
        if (skillSource is not null)
            foreach (var item in skillSource.List()) names[item.RelativePath] = $"{item.Item.Skill.Name}.skill";
        if (profileSource is not null)
            foreach (var item in profileSource.List()) names[item.RelativePath] = $"{item.Item.Profile.Name}.agent";
        if (graphFunctionCatalog is not null)
            foreach (var item in graphFunctionCatalog.ListAssets()) names[item.RelativePath] = $"{item.Item.Function.Definition.DisplayName}.function";
        fileNames = names;
    }

