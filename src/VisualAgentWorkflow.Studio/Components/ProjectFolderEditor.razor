    private async Task ApplyTreeRename()
    {
        if (!CanManageTree || openDirectory is null || treeContext is not { } context) return;
        var name = treeOperationName.Trim();
        if (string.IsNullOrWhiteSpace(name) || name is "." or "..") return;
        var oldPath = context.Path;
        var parent = Path.GetDirectoryName(oldPath)?.Replace('\\', '/') ?? "";
        var newPath = context.IsDirectory ? (string.IsNullOrEmpty(parent) ? name : $"{parent}/{name}") :
            $"{(string.IsNullOrEmpty(parent) ? "" : parent + "/")}{name}{Path.GetExtension(oldPath)}";
        busy = true;
        try
        {
            if (context.IsDirectory)
                _ = StudioProjectSourceTreeOperations.RenameDirectory(openDirectory, oldPath, newPath, sourceManifestHash);
            else
                _ = StudioProjectSourceTreeOperations.MoveFile(openDirectory, oldPath, newPath, sourceManifestHash);
            RefreshProjectSource();
            var renamedFile = manifest!.Files.SingleOrDefault(file => file.Path == newPath);
            CloseTreeContext();
            if (renamedFile is not null) await OpenTreeFile(renamedFile);
            message = $"Moved {oldPath} to {newPath}.";
            error = null;
        }
        catch (Exception exception) when (exception is ArgumentException or IOException or UnauthorizedAccessException or System.Security.SecurityException or System.Text.Json.JsonException)
        { TreeOperationError = exception.Message; }
        finally { busy = false; }
    }

