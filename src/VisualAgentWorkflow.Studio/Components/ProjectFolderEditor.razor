    private async Task CloseRunDialog()
    {
        if (runDialogShown)
        {
            try
            {
                await using var dialogModule = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./_content/VisualAgentWorkflow.Blazor/tabInteractions.js");
                await dialogModule.InvokeVoidAsync("closeModalDialog", runDialog);
            }
            catch (JSException) { }
        }
        runDialogShown = false;
        runDialogOpen = false;
    }

    private async Task RunSavedWorkflow()
    {
        if (!CanRunSavedWorkflow || openedWorkflow is null || openDirectory is null || manifest is null) return;
        await StartFolderRun(() => FolderRunner.StartSavedAsync(openDirectory, manifest!.ProjectId, openedWorkflow.WorkflowId,
            sourceManifestHash, openedWorkflow.ContentHash, runInput, RunParameters()));
    }

    private async Task RunRestorePoint(string snapshotContentHash)
    {
        if (!CanRunRestorePoint || openedWorkflow is null || openDirectory is null) return;
        await StartFolderRun(() => FolderRunner.StartRestorePointAsync(openDirectory, manifest!.ProjectId,
            openedWorkflow.WorkflowId, snapshotContentHash, runInput, RunParameters()));
    }

    private IReadOnlyDictionary<string, string>? RunParameters() => runParameters.Count == 0
        ? null : new Dictionary<string, string>(runParameters, StringComparer.Ordinal);

    private async Task StartFolderRun(Func<Task<RunSnapshot>> start)
    {
        folderRunError = null;
        folderRunActive = true;
        folderRunPolling?.Cancel();
        folderRunPolling?.Dispose();
        folderRunPolling = new CancellationTokenSource();
        var cancellationToken = folderRunPolling.Token;
        try
        {
            folderRun = await start();
            bottomTab = "runs";
            if (runDialogOpen) await CloseRunDialog();
            await InvokeAsync(StateHasChanged);
            while (!folderRun.IsTerminal)
            {
                await Task.Delay(TimeSpan.FromMilliseconds(500), cancellationToken);
                folderRun = await Runtime.GetRunAsync(folderRun.Header.RunId) ?? folderRun;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (Exception exception) when (exception is ArgumentException or IOException or InvalidDataException or InvalidOperationException or KeyNotFoundException or System.Text.Json.JsonException)
        {
            folderRunError = exception.Message;
        }
        finally
        {
            folderRunActive = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CancelFolderRun()
    {
        if (folderRun is null || !folderRunActive) return;
        try { await Runtime.CancelRunAsync(folderRun.Header.RunId); }
        catch (KeyNotFoundException) { }
    }

    private static string WorkflowName(WorkflowDefinition value) => string.IsNullOrWhiteSpace(value.DisplayName) ? value.WorkflowId : value.DisplayName;
    private string WorkflowName(string workflowId) => workflowNames.TryGetValue(workflowId, out var name) ? name : workflowId;
    private static IReadOnlyDictionary<string, string> ToWorkflowNames(IEnumerable<StudioFolderWorkflow> items) =>
        items.ToDictionary(item => item.WorkflowId, item => string.IsNullOrWhiteSpace(item.DisplayName) ? item.WorkflowId : item.DisplayName,
            StringComparer.Ordinal);
