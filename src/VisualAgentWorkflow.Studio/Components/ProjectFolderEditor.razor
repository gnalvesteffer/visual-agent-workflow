        skillFormDirty = false;
    }

    private void LoadProfileRevision(StudioFolderAgentProfile profile)
    {
        var value = profile.Item.Profile;
        profileBeingEdited = value;
        profileId = value.Id;
        profileVersion = NextVersion(value.Version);
        profileName = value.Name;
        profileFolder = profile.Item.Folder;
        profileDescription = value.Description;
        profileProviderId = value.ProviderId;
        profileInstructions = value.Instructions;
        profileReasoning = value.ReasoningEffort?.ToString() ?? "";
        profileMaxOutputTokens = value.MaxOutputTokens;
        profileChannelsText = string.Join("\n", value.Channels ?? []);
        selectedProfileTools.Clear();
        foreach (var tool in value.Tools.Where(tool => bindings.Any(available => available.BindingId == tool.BindingId)))
            selectedProfileTools.Add(tool.BindingId);
        selectedProfileSkills.Clear();
        foreach (var skill in value.Skills ?? [])
            if (projectSkills.Any(available => available.Skill.Id == skill.Id && available.Skill.Version == skill.Version))
                selectedProfileSkills.Add(skill.Id + "@" + skill.Version);
        profileFormDirty = false;
    }

    private static string NextVersion(string version)
    {
        var parts = version.Split('.');
        if (parts.Length == 3 && parts.All(part => int.TryParse(part, out _)) &&
            int.TryParse(parts[2], out var patch) && patch < int.MaxValue)
            return $"{parts[0]}.{parts[1]}.{patch + 1}";
        return version + ".1";
    }

    private void MarkProfileFormDirty() => profileFormDirty = true;

    private void ToggleProfileTool(ToolBindingDescriptor tool, ChangeEventArgs args)
