    private StudioFolderSkillSource? skillSource;
    private StudioFolderAgentProfileSource? profileSource;
    private StudioFolderGraphFunctionCatalog? graphFunctionCatalog;
    private List<StudioFolderWorkflow> workflows = [];
    private readonly HashSet<string> selectedPackageWorkflows = new(StringComparer.Ordinal);
    private IReadOnlyDictionary<string, string> workflowNames = new Dictionary<string, string>();
    private IReadOnlyDictionary<string, string> fileNames = new Dictionary<string, string>();
    private StudioFolderWorkflow? openedWorkflow;
    private StudioFolderSkill? openedSkill;
    private StudioFolderAgentProfile? openedProfile;
    private StudioFolderGraphFunction? openedGraphFunction;
    private bool creatingNewGraphFunction;
    private bool graphFunctionDirty;
    private string? openedDocumentationPath;
    private bool creatingNewDocumentation;
    private bool documentationDirty;
    private string markdownFileName = "README.md";
    private string markdownText = "";
    private ElementReference markdownEditorHost;
    private IJSObjectReference? markdownEditorModule;
    private DotNetObjectReference<ProjectFolderEditor>? markdownEditorDotNet;
    private bool markdownEditorReady;
    private bool markdownEditorCreated;
    private bool markdownEditorNeedsSync;
    private string? markdownEditorError;
    private bool IsMarkdownEditorOpen => openedDocumentationPath is not null || creatingNewDocumentation;
    private int graphFunctionEditorGeneration;
    private string sourceManifestHash = "";
    private IReadOnlyList<StudioProjectSnapshot> snapshots = [];
    private StudioProjectSnapshotPreview? snapshotPreview;
    private string? snapshotError;
    private string? deleteSnapshotId;
    private string skillId = "";
    private string skillVersion = "1.0.0";
    private string skillName = "";
    private string skillFolder = "";
    private string skillInstructions = "";
    private bool creatingNewSkill;
    private bool skillFormDirty;
    private string profileId = "";
    private string profileVersion = "1.0.0";
    private string profileName = "";
    private string profileFolder = "";
    private string profileDescription = "";
    private string profileProviderId = "";
    private string profileInstructions = "";
    private string profileReasoning = "";
    private int? profileMaxOutputTokens;
    private string profileChannelsText = "";
    private AgentProfile? profileBeingEdited;
    private readonly HashSet<string> selectedProfileTools = new(StringComparer.Ordinal);
    private readonly HashSet<string> selectedProfileSkills = new(StringComparer.Ordinal);
    private bool creatingNewProfile;
    private bool profileFormDirty;
    private IReadOnlyList<SkillLibraryItem> projectSkills = [];
    private IReadOnlyList<ToolBindingRequest> unavailableProfileTools => (profileBeingEdited?.Tools ?? [])
        .Where(tool => !bindings.Any(available => available.BindingId == tool.BindingId)).ToArray();
    private IReadOnlyList<WorkflowSkill> unavailableProfileSkills => (profileBeingEdited?.Skills ?? [])
        .Where(skill => !projectSkills.Any(available => available.Skill.Id == skill.Id && available.Skill.Version == skill.Version)).ToArray();
    private WorkflowDefinition? definition;
    private WorkflowLayout? layout;
    private IReadOnlyList<ToolBindingDescriptor> bindings = [];
    private IReadOnlyList<AgentProviderDescriptor> providers = [];
    private bool mcpChoicesLoading;
    private bool providerChoicesLoading;
    private string? mcpChoicesError;
    private string? providerChoicesError;
    private bool dirty;
    private bool busy;
    private bool CanManageTree => manifest is not null && openDirectory is not null && !busy && !HasUnsavedEdits && !externalSourceChanged;
    private string? TreeOperationError { get; set; }
    private string runInput = "";
    private Dictionary<string, string> runParameters = new(StringComparer.Ordinal);
    private bool runDialogOpen;
    private bool runDialogShown;
    private ElementReference runDialog;
    private RunSnapshot? folderRun;
    private bool folderRunActive;
    private string? folderRunError;
    private CancellationTokenSource? folderRunPolling;
    private bool CanRunSavedWorkflow => !busy && !dirty && !externalSourceChanged && !folderRunActive && openedWorkflow is not null &&
        definition is not null && layout is not null && WorkflowValidator.Validate(definition).IsEmpty;
    private bool CanRunRestorePoint => !busy && !dirty && !folderRunActive && openedWorkflow is not null && definition is not null &&
        WorkflowValidator.Validate(definition).IsEmpty;
    private bool externalSourceChanged;
    private string? externalSourceProblem;
    private FileSystemWatcher? sourceWatcher;
    private CancellationTokenSource? sourceMonitorCancellation;
    private SemaphoreSlim? sourceMonitorSignal;
    private Task? sourceMonitorTask;
    private string? sourceMonitorRoot;
    private long sourceMonitorGeneration;
    private bool disposed;
    public bool HasUnsavedEdits => dirty || skillFormDirty || profileFormDirty || graphFunctionDirty || documentationDirty;
    private string? loadedProjectId;
    private bool wasActive;
    private bool? lastReportedDirty;
    private string? error;
    private string? message;
    private string EditorTitle => openedWorkflow is not null ? "Workflow editor" : openedDocumentationPath is not null || creatingNewDocumentation ? "Markdown editor" : openedProfile is not null || creatingNewProfile ? "Agent profile editor" : openedSkill is not null || creatingNewSkill ? "Skill editor" : "Project editor";
    private string bottomTab = "runs";
    private bool folderSettingsOpen;
    private bool projectToolsOpen;
    private bool folderInspectRun;
    private string? SelectedFilePath => openedWorkflow?.RelativePath ?? openedSkill?.RelativePath ?? openedProfile?.RelativePath ?? openedGraphFunction?.RelativePath ?? openedDocumentationPath;
    private bool FileTabIsDirty(StudioProjectFile file) => file.Path == SelectedFilePath && (file.Kind switch
    {
        "workflow" => dirty,
        "skill" => skillFormDirty,
        "agent-profile" => profileFormDirty,
        "graph-function" => graphFunctionDirty,
        "documentation" => documentationDirty,
        _ => false
    });
    private bool MatchesProjectTreeFilter(StudioProjectFileTreeNode node)
    {
        if (string.IsNullOrWhiteSpace(projectTreeFilter)) return true;
        var query = projectTreeFilter.Trim();
        if (node.Name.Contains(query, StringComparison.OrdinalIgnoreCase)) return true;
        if (node.File is { } file)
        {
            if (file.Path.Contains(query, StringComparison.OrdinalIgnoreCase)
                || fileNames.GetValueOrDefault(file.Path, "").Contains(query, StringComparison.OrdinalIgnoreCase)
                || workflowNames.GetValueOrDefault(file.Id, "").Contains(query, StringComparison.OrdinalIgnoreCase)) return true;
        }
        return node.Children.Any(MatchesProjectTreeFilter);
    }
    private string EditorDescription => openedWorkflow is not null
        ? "Workflow drafts save directly to source files. A stale edit is rejected if the project changed since it was loaded."
        : openedSkill is not null || creatingNewSkill
            ? "Skill text saves as a new immutable project revision. A stale project edit is rejected."
            : openedProfile is not null || creatingNewProfile
                ? "Profile settings save as an immutable project revision; provider and MCP services remain host-owned."
                : openedDocumentationPath is not null || creatingNewDocumentation
                    ? "Edit project documentation as Markdown source. Saved text is indexed in the project manifest and versioned with Git."
                    : openedGraphFunction is not null || creatingNewGraphFunction
                    ? "Pure graph functions are edited visually and saved as immutable project revisions."
                    : "Select a source file to edit. Graph function revisions can be created from the project.";

    protected override Task OnInitializedAsync()
    {
        mcpChoicesLoading = true;
        providerChoicesLoading = true;
        _ = LoadMcpChoicesAsync();
        _ = LoadProviderChoicesAsync();
        return Task.CompletedTask;
    }

    private async Task LoadMcpChoicesAsync()
    {
        try { bindings = await ToolCatalog.ListBindingsAsync(); }
        catch
        {
            if (!disposed) mcpChoicesError = "Could not load MCP tools. Project source remains editable; return to the MCP library and retry discovery.";
        }
        finally
        {
            mcpChoicesLoading = false;
            if (!disposed) await RenderChoiceStatusAsync();
        }
    }

    private async Task LoadProviderChoicesAsync()
    {
        try { providers = await ProviderCatalog.ListProvidersAsync(); }
        catch
        {
            if (!disposed) providerChoicesError = "Could not load model connections. Project source remains editable; check Studio settings and retry.";
        }
        finally
        {
            providerChoicesLoading = false;
            if (!disposed) await RenderChoiceStatusAsync();
        }
    }

    private async Task RenderChoiceStatusAsync()
    {
        try { await InvokeAsync(StateHasChanged); }
        catch (InvalidOperationException) when (disposed) { }
        catch (ObjectDisposedException) { }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!IsActive)
        {
            if (wasActive) await StopSourceMonitorAsync();
            wasActive = false;
            return;
        }

        try
        {
            var newlyActive = !wasActive;
            if (!string.Equals(loadedProjectId, ProjectId, StringComparison.Ordinal))
            {
                directoryPath = ProjectStore.FolderProjectPath(ProjectId);
                await LoadProjectFolderAsync(directoryPath);
                loadedProjectId = ProjectId;
            }
            else if (newlyActive && openDirectory is not null)
            {
                await ReconcileSourceSnapshotAsync();
            }

            if (openDirectory is not null) await StartSourceMonitorAsync(openDirectory);
            wasActive = true;
        }
        catch (Exception exception) when (exception is KeyNotFoundException or InvalidOperationException or IOException or UnauthorizedAccessException or System.Security.SecurityException or System.Text.Json.JsonException)
        {
            Logger.LogError(exception, "Could not load folder-backed project {ProjectId} from {ProjectPath}", ProjectId, directoryPath);
            ClearProjectFolder();
            error = exception.Message;
            loadedProjectId = null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsActive && runDialogOpen && !runDialogShown)
        {
            await using var dialogModule = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./_content/VisualAgentWorkflow.Blazor/tabInteractions.js");
            await dialogModule.InvokeVoidAsync("showModalDialog", runDialog);
            runDialogShown = true;
        }
        if (IsActive && editorTabs.Count > 0)
            await JavaScript.InvokeVoidAsync("vawStudioIde.revealActiveTab", fileTabStrip);
        if (IsActive && treeContext is { } menu)
        {
            await JavaScript.InvokeVoidAsync("vawStudioIde.layoutExplorerMenu", treeMenuElement, menu.ClientX, menu.ClientY, focusTreeMenu);
            focusTreeMenu = false;
        }
        if (IsActive && IsMarkdownEditorOpen)
            await EnsureMarkdownEditorAsync();
        else if (markdownEditorModule is not null)
            await DisposeMarkdownEditorAsync();

        if (lastReportedDirty != HasUnsavedEdits)
        {
            lastReportedDirty = HasUnsavedEdits;
            await DirtyChanged.InvokeAsync(HasUnsavedEdits);
        }
    }

    private async Task ReconcileSourceSnapshotAsync()
    {
        if (openDirectory is null) return;
        try
        {
            var (currentManifest, _) = StudioProjectSourceDirectory.Read(openDirectory);
            externalSourceChanged = StudioProjectSourceArchive.ComputeManifestHash(currentManifest) != sourceManifestHash;
            externalSourceProblem = null;
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or System.Security.SecurityException or System.Text.Json.JsonException)
        {
            externalSourceChanged = true;
            externalSourceProblem = "Studio could not validate the current project snapshot. Your editor contents are preserved.";
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadProjectFolderAsync(string folder)
    {
        var canonicalDirectory = Path.GetFullPath(folder);
        var (loadedManifest, _) = StudioProjectSourceDirectory.Read(canonicalDirectory);
        var loadedSource = new StudioFolderWorkflowSource(canonicalDirectory);
        var loadedSkillSource = new StudioFolderSkillSource(canonicalDirectory);
        var loadedProfileSource = new StudioFolderAgentProfileSource(canonicalDirectory);
        var loadedGraphFunctionCatalog = new StudioFolderGraphFunctionCatalog(canonicalDirectory);
        var loadedWorkflows = loadedSource.List().ToList();
        openDirectory = canonicalDirectory;
        manifest = loadedManifest;
        fileTree = StudioProjectFileTree.Build(loadedManifest.Files, loadedManifest.Directories);
        source = loadedSource;
        skillSource = loadedSkillSource;
        profileSource = loadedProfileSource;
        graphFunctionCatalog = loadedGraphFunctionCatalog;
        projectSkills = loadedSkillSource.List().Select(skill => skill.Item).ToArray();
        sourceManifestHash = StudioProjectSourceArchive.ComputeManifestHash(loadedManifest);
        RefreshSnapshots();
        workflows = loadedWorkflows;
        workflowNames = ToWorkflowNames(loadedWorkflows);
        RefreshFileNames();
        selectedPackageWorkflows.Clear();
        dirty = false;
        SetWorkflow(workflows.FirstOrDefault());
        externalSourceChanged = false;
        externalSourceProblem = null;
        error = null;
        message = $"Opened {loadedManifest.ProjectName}.";
    }

    private void RefreshSnapshots()
    {
        if (openDirectory is null) return;
        try
        {
            snapshots = SnapshotStore.List(openDirectory);
            snapshotError = null;
        }
        catch (Exception exception) when (exception is IOException or InvalidDataException or UnauthorizedAccessException or System.Security.SecurityException)
        {
            snapshots = [];
            snapshotError = exception.Message;
        }
    }

    private void CreateSnapshot()
    {
        if (openDirectory is null || HasUnsavedEdits || externalSourceChanged) return;
        busy = true;
        snapshotError = null;
        try
        {
            var snapshot = SnapshotStore.Create(openDirectory);
            RefreshSnapshots();
            message = $"Created local restore point {snapshot.Id[..12]}.";
            snapshotPreview = null;
        }
        catch (Exception exception) when (exception is ArgumentException or IOException or InvalidDataException or UnauthorizedAccessException or InvalidOperationException or System.Security.SecurityException or System.Text.Json.JsonException)
        {
            snapshotError = exception.Message;
        }
        finally { busy = false; }
    }

    private void PreviewSnapshot(string id)
    {
        if (openDirectory is null || HasUnsavedEdits || externalSourceChanged) return;
        try
        {
            snapshotPreview = SnapshotStore.Preview(openDirectory, id);
            deleteSnapshotId = null;
            snapshotError = null;
        }
        catch (Exception exception) when (exception is ArgumentException or IOException or InvalidDataException or UnauthorizedAccessException or System.Security.SecurityException or System.Text.Json.JsonException)
        {
            snapshotPreview = null;
            snapshotError = exception.Message;
            RefreshSnapshots();
