@implements IAsyncDisposable
@using VisualAgentWorkflow.Blazor
@using System.Collections.Immutable
@using Microsoft.JSInterop
@inject IJSRuntime JavaScript
@inject IToolBindingCatalog ToolCatalog
@inject IAgentProviderCatalog ProviderCatalog
@inject StudioProjectStore ProjectStore
@inject StudioProjectSnapshotStore SnapshotStore
@inject StudioFolderWorkflowRunner FolderRunner
@inject VisualAgentWorkflow.Hosting.LocalWorkflowRuntime Runtime
@inject ILogger<ProjectFolderEditor> Logger

<section id="@PanelId" class="vaw-project-folder-editor" role="tabpanel" aria-labelledby="@TabId"
    aria-label="Project folder editor" hidden="@(!IsActive)" aria-hidden="@(!IsActive)">
    @if (manifest is not null)
    {
        <header class="vaw-project-tab-heading" hidden="@(!projectToolsOpen)">
            <div><h2>@manifest.ProjectName</h2><p><code>@openDirectory</code> · @manifest.Files.Length indexed files</p></div>
            <span class="vaw-provider-state"><span aria-hidden="true"></span>Folder open</span>
        </header>
        @if (externalSourceChanged)
        {
            <aside class="vaw-error vaw-source-change" role="alert">
                <strong>The project folder changed outside Studio.</strong>
                <p>Your current editor contents are preserved. Review or reload the validated folder snapshot before continuing.</p>
                @if (externalSourceProblem is not null) { <p>@externalSourceProblem</p> }
                @if (HasUnsavedEdits)
                { <button type="button" class="vaw-secondary" @onclick="DiscardAndReloadFolder" disabled="@busy">Discard local edits and reload folder</button> }
                else
                { <button type="button" class="vaw-secondary" @onclick="ReloadFolder" disabled="@busy">Reload project files</button> }
            </aside>
        }
        @if (error is not null) { <p role="alert" class="vaw-error">@error</p> }
        @if (message is not null) { <p role="status" class="vaw-folder-feedback">@message</p> }
        @if (openedWorkflow is null && mcpChoicesLoading) { <p class="vaw-editor-choice-status" role="status" aria-live="polite">Loading MCP tool choices…</p> }
        @if (openedWorkflow is null && providerChoicesLoading) { <p class="vaw-editor-choice-status" role="status" aria-live="polite">Loading model connections…</p> }
        @if (openedWorkflow is null && mcpChoicesError is not null) { <p role="status" class="vaw-editor-choice-warning">@mcpChoicesError</p> }
        @if (openedWorkflow is null && providerChoicesError is not null) { <p role="status" class="vaw-editor-choice-warning">@providerChoicesError</p> }
        <details hidden="@(!projectToolsOpen)" class="vaw-project-utility" aria-label="Build a consumer release">
        <summary>Consumer package</summary>
        <section class="vaw-settings-section vaw-project-release" aria-label="Build a consumer release">
            <div class="vaw-settings-section-heading">
                <div><h2>Build consumer package</h2><p>Select saved, executable workflows to include in a portable <code>.vawpkg</code>. Reusable assets embedded in those workflows travel with them; model connections, MCP endpoints, credentials, and grants stay with the consuming host.</p></div>
            </div>
            @if (manifest.Files.All(file => file.Kind != "workflow"))
            {
                <p class="vaw-empty-state">This project has no workflow source files yet.</p>
            }
            else
            {
                <form method="get" action="@($"/api/projects/{Uri.EscapeDataString(ProjectId)}/release.vawpkg")">
                    <fieldset class="vaw-release-workflow-list" disabled="@(busy || HasUnsavedEdits || externalSourceChanged)">
                        <legend>Workflow entry points</legend>
                        @foreach (var workflowFile in manifest.Files.Where(file => file.Kind == "workflow").OrderBy(file => file.Id, StringComparer.Ordinal))
                        {
                            <label @key="workflowFile.Id">
                                <input type="checkbox" name="workflowId" value="@workflowFile.Id"
                                    checked="@selectedPackageWorkflows.Contains(workflowFile.Id)"
                                    @onchange="args => TogglePackageWorkflow(workflowFile.Id, args)" />
                                <span>@WorkflowName(workflowFile.Id)</span><code>@workflowFile.Id</code>
                            </label>
                        }
                    </fieldset>
                    @if (HasUnsavedEdits) { <p class="vaw-help">Save or discard editor changes first. The package uses files currently saved in the project folder.</p> }
                    @if (externalSourceChanged) { <p class="vaw-help">Reload the changed project files before creating a release.</p> }
                    <button type="submit" class="vaw-primary" disabled="@(busy || HasUnsavedEdits || externalSourceChanged || selectedPackageWorkflows.Count == 0)">Download selected workflows</button>
                </form>
            }
        </section>
        </details>
        <details hidden="@(!projectToolsOpen)" class="vaw-project-utility" aria-label="Local restore points">
        <summary>Restore points <span class="vaw-help">@snapshots.Count saved</span></summary>
        <section class="vaw-settings-section vaw-project-snapshots" aria-label="Local restore points">
            <div class="vaw-settings-section-heading">
                <div><h2>Local restore points</h2><p>Save or restore a validated copy of this project’s indexed source. Restore points stay in ignored <code>.vaw/</code> and never enter exports.</p></div>
                <button type="button" class="vaw-secondary" @onclick="CreateSnapshot" disabled="@(busy || HasUnsavedEdits || externalSourceChanged)">Create restore point</button>
            </div>
            @if (snapshotError is not null) { <p role="status" class="vaw-error">Local restore points are unavailable: @snapshotError Project source remains available.</p> }
            @if (snapshots.Count == 0 && snapshotError is null) { <p class="vaw-empty-state">No local restore points yet.</p> }
            @if (snapshots.Count > 0)
            {
                <ul class="vaw-snapshot-list">
                    @foreach (var snapshot in snapshots)
                    {
                        <li @key="snapshot.Id">
                            <div><strong>@snapshot.CreatedAtUtc.ToLocalTime().ToString("g")</strong>
                                <code>@snapshot.Id[..Math.Min(snapshot.Id.Length, 12)]</code>
                                <span>@(snapshot.ArchiveBytes / 1024) KB</span>
                                @if (!snapshot.IsValid) { <span class="vaw-error">Unavailable: @snapshot.Problem</span> }
                            </div>
                            <div class="vaw-provider-actions">
                                <button type="button" class="vaw-secondary" @onclick="() => PreviewSnapshot(snapshot.Id)" disabled="@(busy || !snapshot.IsValid || HasUnsavedEdits || externalSourceChanged)">Preview restore</button>
                                @if (openedWorkflow is not null)
                                {
                                    <button type="button" class="vaw-secondary" @onclick="() => RunRestorePoint(snapshot.Id)" disabled="@(!CanRunRestorePoint || !snapshot.IsValid)">Test selected workflow</button>
                                }
                                <button type="button" class="vaw-danger-quiet" @onclick="() => RequestSnapshotDelete(snapshot.Id)" disabled="@busy">@(deleteSnapshotId == snapshot.Id ? "Confirm delete point" : "Delete point")</button>
                            </div>
                        </li>
                    }
                </ul>
            }
            @if (snapshotPreview is { } preview)
            {
                <aside class="vaw-source-restore-preview" role="group" aria-label="Restore preview">
                    <h3>Restore preview</h3>
                    <p>Current source <code>@preview.CurrentManifestHash[..12]</code> · restore point <code>@preview.SnapshotManifestHash[..12]</code></p>
                    <p>@preview.AddedFiles files will become indexed, @preview.RemovedFiles will leave the manifest, and @preview.ChangedFiles have changed content.</p>
                    <p>Restore switches the project manifest after validating and adding any missing immutable files. Newer or unindexed files are kept. No files are merged or deleted.</p>
                    @if (HasUnsavedEdits || externalSourceChanged)
                    { <p class="vaw-error">Save or discard edits and reload the current folder before restoring.</p> }
                    <div class="vaw-provider-actions">
                        <button type="button" class="vaw-secondary" @onclick="CancelSnapshotPreview">Cancel</button>
                        <button type="button" class="vaw-danger" @onclick="RestoreSnapshot" disabled="@(busy || HasUnsavedEdits || externalSourceChanged)">Restore this project snapshot</button>
                    </div>
                </aside>
            }
        </section>
        </details>
    }
    @if (manifest is not null && source is not null)
    {
        <section class="vaw-settings-section vaw-source-workspace" aria-label="Project explorer and project editor">
            <aside class="vaw-project-explorer" aria-label="Project explorer" tabindex="0" @oncontextmenu="args => OpenTreeContext(args, string.Empty)" @oncontextmenu:preventDefault="true">
                <header>
                    <h2 title="@manifest.ProjectName">@manifest.ProjectName</h2><button type="button" class="vaw-tree-more" aria-label="Project tools" title="Project tools" @onclick="() => projectToolsOpen = !projectToolsOpen"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="4" cy="10" r="1"/><circle cx="10" cy="10" r="1"/><circle cx="16" cy="10" r="1"/></svg></button>
                    <button type="button" class="vaw-tree-more" aria-label="Create project item" title="Create project item" @onclick="() => OpenTreeContext(null, string.Empty)">＋</button>
                </header>
                <div class="vaw-project-tree-filter">
                    <label class="vaw-sr-only" for="project-file-filter">Filter project files</label>
                    <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5"/><path d="m13 13 4 4"/></svg>
                    <input id="project-file-filter" type="search" placeholder="Filter files…" @bind="projectTreeFilter" @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(projectTreeFilter))
                    { <button type="button" aria-label="Clear file filter" title="Clear filter" @onclick="() => projectTreeFilter = string.Empty">×</button> }
                </div>
                <ul class="vaw-project-tree">
                    @if (fileTree.Count == 0)
                    { <li><p class="vaw-empty-state">No source files yet. Right-click the project root to create a file or folder.</p></li> }
                    else
                    {
                        @foreach (var node in fileTree)
                        {
                            @if (MatchesProjectTreeFilter(node))
                            {
                            <li @key="node.Name + node.File?.Path">
                                <ProjectFileTreeItem Node="@node" SelectedPath="@SelectedFilePath" Filter="@projectTreeFilter"
                                    WorkflowNames="@workflowNames" FileNames="@fileNames" CanOpenFiles="@(!busy && !HasUnsavedEdits)"
                                    ClipboardPath="@treeClipboard?.Path" ClipboardIsCut="@(treeClipboard?.IsCut == true)"
                                    OnOpenWorkflow="@OpenWorkflow" OnOpenSkill="@OpenSkill" OnOpenAgentProfile="@OpenAgentProfile" OnOpenGraphFunction="@OpenGraphFunction"
                                    OnOpenDocumentation="@OpenDocumentation" OnContextMenu="@OpenTreeContext" />
                            </li>
                            }
                        }
                    }
                    @if (string.IsNullOrWhiteSpace(projectTreeFilter) || "vaw.project.json".Contains(projectTreeFilter.Trim(), StringComparison.OrdinalIgnoreCase))
                    { <li><span class="vaw-project-tree-file is-read-only" aria-label="Project manifest vaw.project.json, read only" title="Edit this file with your normal source-control tools"><StudioFileIcon Kind="file"/><span class="vaw-project-tree-file-name">vaw.project.json</span></span></li> }
                    @if (!string.IsNullOrWhiteSpace(projectTreeFilter) && !fileTree.Any(MatchesProjectTreeFilter) && !"vaw.project.json".Contains(projectTreeFilter.Trim(), StringComparison.OrdinalIgnoreCase))
                    { <li><p class="vaw-empty-state" role="status">No files match “@projectTreeFilter”.</p></li> }
                </ul>
                @if (!manifest.Files.IsEmpty) { <p class="vaw-project-tree-legend">W Workflow · S Skill · A Agent preset · F Graph function · M Markdown</p> }
                @if (HasUnsavedEdits) { <p class="vaw-help">Save or discard the current edits before opening another file.</p> }
            </aside>

            @if (treeContext is { } context)
            {
                <div class="vaw-tree-menu-backdrop" @onclick="CloseTreeContext" @onkeydown="HandleTreeMenuKey" @onkeydown:stopPropagation="true">
                    <div class="vaw-tree-context-menu" @ref="treeMenuElement" tabindex="-1" role="menu" aria-label="@(context.IsDirectory ? $"Actions for {context.Path}" : $"Actions for {TreeFileLabel(context.File!)}")"
                         style="left:@(context.ClientX)px;top:@(context.ClientY)px" @onclick:stopPropagation="true">
                        <p class="vaw-tree-menu-heading">@(context.IsDirectory ? (string.IsNullOrEmpty(context.Path) ? manifest.ProjectName : Path.GetFileName(context.Path)) : TreeFileLabel(context.File!))</p>
                        @if (!CanManageTree)
                        { <p class="vaw-tree-menu-error" role="status">@(HasUnsavedEdits ? "Save or discard your edits before changing project files." : externalSourceChanged ? "Reload the changed project before changing its files." : "Wait for the current operation to finish.")</p> }
                        @if (context.IsDirectory)
                        {
                            @if (treeClipboard is not null)
                            { <button type="button" role="menuitem" disabled="@(!CanManageTree)" @onclick="PasteTreeClipboard">Paste into this folder</button> }
                            <button type="button" role="menuitem" aria-expanded="@showCreateSubmenu" disabled="@(!CanManageTree)" @onclick="() => showCreateSubmenu = !showCreateSubmenu">New file <span aria-hidden="true">›</span></button>
                            @if (showCreateSubmenu)
                            {
                                <div class="vaw-tree-submenu" role="group" aria-label="New project file type">
                                    <button type="button" role="menuitem" disabled="@(!CanManageTree)" @onclick="() => CreateWorkflow(context.Path)">Workflow <span>.workflow</span></button>
                                    <button type="button" role="menuitem" disabled="@(!CanManageTree)" @onclick="() => CreateProfile(context.Path)">Agent <span>.agent</span></button>
                                    <button type="button" role="menuitem" disabled="@(!CanManageTree)" @onclick="() => CreateSkill(context.Path)">Skill <span>.skill</span></button>
                                    <button type="button" role="menuitem" disabled="@(!CanManageTree)" @onclick="() => CreateGraphFunction(context.Path)">Function <span>.function</span></button>
                                    <button type="button" role="menuitem" disabled="@(!CanManageTree)" @onclick="() => CreateDocumentation(context.Path)">Markdown <span>.md</span></button>
                                </div>
                            }
                            <form class="vaw-tree-menu-form" @onsubmit="CreateProjectDirectory" @onsubmit:preventDefault>
                                <label>New subfolder <input @bind="treeOperationName" @bind:event="oninput" placeholder="e.g. Support/Triage" disabled="@(!CanManageTree)" /></label>
                                <button type="submit" role="menuitem" disabled="@(!CanManageTree || string.IsNullOrWhiteSpace(treeOperationName))">Create folder</button>
                            </form>
                            @if (!string.IsNullOrEmpty(context.Path))
                            {
                                <button type="button" role="menuitem" disabled="@(!CanManageTree)" @onclick="CutTreeItem">Cut folder</button>
                                <button type="button" role="menuitem" disabled="@(!CanManageTree)" @onclick="CopyTreeItem">Copy folder</button>
                                <button type="button" role="menuitem" disabled="@(!CanManageTree)" @onclick="BeginTreeRename">Rename folder…</button>
                                <button type="button" role="menuitem" class="is-danger" disabled="@(!CanManageTree)" @onclick="DeleteProjectDirectory">@(treeDeleteArmed ? "Confirm delete empty folder" : "Delete empty folder")</button>
                            }
                        }
                        else if (context.File is { } file)
                        {
                            @if (treeClipboard is not null)
                            { <button type="button" role="menuitem" disabled="@(!CanManageTree)" @onclick="PasteTreeClipboard">Paste beside this file</button> }
                            <button type="button" role="menuitem" disabled="@(!CanManageTree)" @onclick="() => OpenTreeFile(file)">Open</button>
                            <button type="button" role="menuitem" disabled="@(!CanManageTree)" @onclick="CutTreeItem">Cut</button>
                            <button type="button" role="menuitem" disabled="@(!CanManageTree)" @onclick="CopyTreeItem">Copy</button>
                            <button type="button" role="menuitem" disabled="@(!CanManageTree)" @onclick="DuplicateTreeFile">Duplicate</button>
                            <button type="button" role="menuitem" disabled="@(!CanManageTree)" @onclick="BeginTreeRename">Rename / move…</button>
                            <button type="button" role="menuitem" class="is-danger" disabled="@(!CanManageTree)" @onclick="DeleteTreeFile">@(treeDeleteArmed ? "Confirm delete file" : "Delete")</button>
                        }
                        @if (TreeOperationError is not null) { <p class="vaw-tree-menu-error" role="alert">@TreeOperationError</p> }
                        @if (treeRenameEditing)
                        {
                            <form class="vaw-tree-menu-form" @onsubmit="ApplyTreeRename" @onsubmit:preventDefault>
                                <label>@(context.IsDirectory ? "Folder name" : "New file name") <input @bind="treeOperationName" @bind:event="oninput" disabled="@(!CanManageTree)" /></label>
                                <button type="submit" role="menuitem" disabled="@(!CanManageTree || string.IsNullOrWhiteSpace(treeOperationName))">Apply</button>
                                <button type="button" role="menuitem" @onclick="CancelTreeRename">Cancel</button>
                            </form>
                        }
                    </div>
                </div>
            }

            <section class="vaw-folder-workflow-editor" aria-label="Project source editor">
                <div class="vaw-settings-section-heading">
                    <div><h2>@EditorTitle</h2><p>@EditorDescription</p></div>
                </div>
                @if (editorTabs.Count > 0)
                {
                    <nav @ref="fileTabStrip" class="vaw-file-tabs" aria-label="Open project files" aria-description="Scroll horizontally to reach tabs that do not fit. Drag tabs to reorder; press Alt+Shift+Arrow keys on a tab to move it.">
                        @foreach (var file in editorTabs)
                        {
                            var active = file.Path == SelectedFilePath;
                            <div class="vaw-file-tab @(active ? "is-active" : null) @(FileTabIsDirty(file) ? "is-dirty" : null) @(draggedFileTabPath == file.Path ? "is-dragging" : null) @(fileDropTargetPath == file.Path ? "is-drop-target" : null)" data-file-tab-path="@file.Path" @ondragstart="() => StartFileTabDrag(file.Path)" @ondragenter="() => fileDropTargetPath = file.Path" @ondragover:preventDefault="true" @ondrop="() => DropFileTab(file.Path)" @ondrop:preventDefault="true" @ondragend="ClearFileTabDrag" @key="file.Path" data-vaw-closable-tab @onmousedown="args => CloseFileMiddle(file, args)">
                                <button type="button" draggable="true" role="tab" aria-selected="@(active ? "true" : "false")" aria-description="Drag this tab to reorder. Press Alt+Shift+ArrowLeft or ArrowRight to move it." aria-keyshortcuts="Alt+Shift+ArrowLeft Alt+Shift+ArrowRight" @onkeydown="args => ReorderFileTabFromKeyboard(file.Path, args)" aria-label="Open @EditorFileName(file)" @onclick="() => ActivateFile(file)">
                                    <StudioFileIcon Kind="@FileIconKind(file.Kind)" />@EditorFileName(file)
                                    @if (FileTabIsDirty(file)) { <span class="vaw-file-tab-dirty" role="img" aria-label="Unsaved changes" title="Unsaved changes"></span> }
                                </button>
                                <button type="button" class="vaw-file-tab-close" aria-label="Close @EditorFileName(file)" title="Close file" @onclick="() => CloseFileTab(file)">×</button>
                            </div>
                        }
                    </nav>
                }
                @if (openedWorkflow is null)
                {
                    @if (openedDocumentationPath is not null || creatingNewDocumentation)
                    {
                        <section class="vaw-folder-markdown-editor" aria-label="Project Markdown editor">
                            <p class="vaw-help">Developer documentation is ordinary project source. It is not part of a consumer workflow package.</p>
                            <form class="vaw-markdown-form" @onsubmit="SaveDocumentationFromEditor" @onsubmit:preventDefault>
                                <label>File name <input required value="@markdownFileName" @oninput="SetMarkdownFileName" disabled="@(openedDocumentationPath is not null)" maxlength="120" placeholder="README.md" /></label>
                                @if (openedDocumentationPath is not null) { <p class="vaw-definition-status"><code>@openedDocumentationPath</code></p> }
                                <div class="vaw-markdown-editor-frame" aria-labelledby="markdown-source-label" aria-describedby="markdown-editor-help">
                                    <p id="markdown-source-label" class="vaw-markdown-editor-label">Markdown source</p>
                                    <div @ref="markdownEditorHost" class="vaw-markdown-editor-host @(markdownEditorError is null ? null : "is-hidden")" aria-label="Markdown source editor"></div>
                                    @if (!markdownEditorReady && markdownEditorError is null)
                                    { <p class="vaw-markdown-editor-status" role="status" aria-live="polite">Loading Markdown editor…</p> }
                                    @if (markdownEditorError is not null)
                                    {
                                        <div class="vaw-markdown-editor-fallback" role="alert">
                                            <p>@markdownEditorError</p>
                                            <button type="button" class="vaw-secondary" @onclick="RetryMarkdownEditor">Retry Monaco</button>
                                            <label>Markdown source <textarea required value="@markdownText" @oninput="SetMarkdownText" rows="24" spellcheck="false" placeholder="# Project notes"></textarea></label>
                                        </div>
                                    }
                                    <p id="markdown-editor-help" class="vaw-help">Markdown syntax highlighting · Ctrl+S to save</p>
                                </div>
                                <div class="vaw-provider-form-actions">
                                    <button type="submit" class="vaw-primary" data-vaw-file-save disabled="@(busy || !documentationDirty)">Save Markdown</button>
                                    <button type="button" class="vaw-secondary" @onclick="CancelDocumentationEdit" disabled="@busy">Discard changes</button>
                                </div>
                            </form>
                        </section>
                    }
                    else if (openedProfile is not null || creatingNewProfile)
                    {
                        <section class="vaw-folder-skill-editor" aria-label="Agent profile source editor">
                            @if (openedProfile is not null)
                            {
                                <p class="vaw-definition-status"><strong>Base revision</strong> <code>@($"{openedProfile.Item.Profile.Id}@{openedProfile.Item.Profile.Version}")</code> · @openedProfile.ContentHash[..8]</p>
                            }
                            <form class="vaw-provider-form" @onsubmit="SaveProfile" @onsubmit:preventDefault>
                                <label>Profile ID <input required @bind="profileId" @bind:event="oninput" @bind:after="MarkProfileFormDirty" disabled="@(openedProfile is not null)" maxlength="64" /></label>
                                <label>New version <input required @bind="profileVersion" @bind:event="oninput" @bind:after="MarkProfileFormDirty" maxlength="64" /></label>
                                <label>Name <input required @bind="profileName" @bind:event="oninput" @bind:after="MarkProfileFormDirty" maxlength="128" /></label>
                                <label>Folder <input @bind="profileFolder" @bind:event="oninput" @bind:after="MarkProfileFormDirty" maxlength="256" placeholder="Research/Review" /></label>
                                <label class="vaw-provider-form-wide">Delegate description <textarea required @bind="profileDescription" @bind:event="oninput" @bind:after="MarkProfileFormDirty" maxlength="512" rows="2" /></label>
                                <label>Model connection ID
                                    <input list="profile-provider-options" @bind="profileProviderId" @bind:event="oninput" @bind:after="MarkProfileFormDirty" required placeholder="model.primary" />
                                    <datalist id="profile-provider-options">
                                        @foreach (var provider in providers) { <option value="@provider.ProviderId" label="@($"{provider.DisplayName} · {provider.ModelId}")"></option> }
                                    </datalist>
                                </label>
                                @if (!string.IsNullOrEmpty(profileProviderId) && !providers.Any(provider => provider.ProviderId == profileProviderId))
                                { <p class="vaw-help vaw-provider-form-wide">This connection is not configured in this Studio host. The profile retains its stable ID; the consuming host must resolve it before execution.</p> }
                                <label>Reasoning effort
                                    <select @bind="profileReasoning" @bind:after="MarkProfileFormDirty"><option value="">Provider default</option><option value="Off">Off</option><option value="Low">Low</option><option value="Medium">Medium</option><option value="High">High</option></select>
                                </label>
                                <label>Maximum output tokens <input type="number" min="@AgentOutputTokenLimits.Minimum" max="@AgentOutputTokenLimits.Maximum" @bind="profileMaxOutputTokens" @bind:after="MarkProfileFormDirty" /></label>
                                <label class="vaw-provider-form-wide">Coordination channels <textarea @bind="profileChannelsText" @bind:event="oninput" @bind:after="MarkProfileFormDirty" maxlength="600" rows="3" placeholder="research&#10;review" /></label>
                                <label class="vaw-provider-form-wide">System instructions <textarea required @bind="profileInstructions" @bind:event="oninput" @bind:after="MarkProfileFormDirty" maxlength="8192" rows="6" /></label>
                                <fieldset class="vaw-provider-form-wide"><legend>Allowed MCP tools</legend>
                                    <p class="vaw-help">These are logical tool requirements. The consuming host still owns server connections, credentials, and grants.</p>
                                    @foreach (var tool in bindings)
                                    { <label @key="tool.BindingId"><input type="checkbox" checked="@selectedProfileTools.Contains(tool.BindingId)" @onchange="args => ToggleProfileTool(tool, args)" />@tool.DisplayName · @tool.BindingId</label> }
                                    @foreach (var tool in unavailableProfileTools)
                                    { <p class="vaw-help">Unavailable host binding retained: <code>@tool.BindingId</code> · contract @tool.ContractHash[..8]</p> }
                                </fieldset>
                                <fieldset class="vaw-provider-form-wide"><legend>Project skills</legend>
                                    <p class="vaw-help">Selected skill revisions are embedded in this immutable profile snapshot.</p>
                                    @foreach (var item in projectSkills)
                                    { <label @key="item.Skill.Id + item.Skill.Version"><input type="checkbox" checked="@selectedProfileSkills.Contains(item.Skill.Id + "@" + item.Skill.Version)" @onchange="args => ToggleProfileSkill(item, args)" />@item.Skill.Name · @item.Skill.Version</label> }
                                    @if (projectSkills.Count == 0) { <p>No skills in this project yet.</p> }
                                    @foreach (var skill in unavailableProfileSkills)
                                    { <p class="vaw-help">Unavailable project skill retained: <code>@skill.Id@skill.Version</code></p> }
                                </fieldset>
                                <p class="vaw-provider-form-note vaw-provider-form-wide">Saving adds an immutable profile revision to the project. Existing workflow and profile snapshots remain unchanged; no provider connection or MCP grant is copied.</p>
                                <div class="vaw-provider-form-actions vaw-provider-form-wide">
                                    <button type="submit" class="vaw-primary" data-vaw-file-save disabled="@(busy || !profileFormDirty || string.IsNullOrWhiteSpace(profileProviderId))">Save source profile version</button>
