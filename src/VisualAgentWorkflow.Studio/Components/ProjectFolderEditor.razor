            try { markdownText = await markdownEditorModule.InvokeAsync<string>("getValue", markdownEditorHost); }
            catch (JSDisconnectedException) { return; }
            catch (JSException exception)
            {
                Logger.LogWarning(exception, "Could not read Markdown source before saving");
