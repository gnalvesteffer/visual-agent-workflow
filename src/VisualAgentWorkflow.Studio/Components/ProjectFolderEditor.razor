    private void SaveDocumentation()
    {
        if (!documentationDirty || openDirectory is null) return;
        busy = true;
        error = null;
        try
        {
            StudioProjectFile savedFile;
            if (creatingNewDocumentation)
            {
                var fileName = markdownFileName.Trim();
                if (fileName != Path.GetFileName(fileName) || fileName is "." or "..")
                    throw new ArgumentException("Enter a file name without folder separators.");
                if (!fileName.EndsWith(".md", StringComparison.OrdinalIgnoreCase)) fileName += ".md";
                var relativePath = string.IsNullOrEmpty(creationDirectory) ? fileName : $"{creationDirectory}/{fileName}";
                savedFile = StudioProjectSourceTreeOperations.CreateDocumentation(openDirectory, relativePath, markdownText, sourceManifestHash);
            }
            else if (openedDocumentationPath is not null)
                savedFile = StudioProjectSourceTreeOperations.SaveDocumentation(openDirectory, openedDocumentationPath, markdownText, sourceManifestHash);
            else return;

            documentationDirty = false;
            creatingNewDocumentation = false;
            creationDirectory = null;
            RefreshProjectSource();
            openedDocumentationPath = savedFile.Path;
            markdownFileName = Path.GetFileName(savedFile.Path);
            markdownEditorNeedsSync = false;
            AddEditorTab(savedFile);
            message = $"Saved {savedFile.Path}.";
        }
        catch (Exception exception) when (exception is ArgumentException or IOException or UnauthorizedAccessException or System.Security.SecurityException or System.Text.Json.JsonException)
        { error = exception.Message; }
        finally { busy = false; }
    }

    private void CancelDocumentationEdit()
