    private void AddEditorTab(StudioProjectFile file)
    {
        var existingIndex = editorTabs.FindIndex(item => string.Equals(item.Path, file.Path, StringComparison.Ordinal) ||
            file.Kind == "workflow" && item.Kind == "workflow" && item.Id == file.Id);
        if (existingIndex >= 0) editorTabs[existingIndex] = file;
        else editorTabs.Add(file);
    }

    private void StartFileTabDrag(string path) => draggedFileTabPath = path;
    private void ClearFileTabDrag() { draggedFileTabPath = null; fileDropTargetPath = null; }
    private void DropFileTab(string targetPath)
    {
        if (draggedFileTabPath is { } sourcePath)
        {
            var sourceIndex = editorTabs.FindIndex(item => item.Path == sourcePath);
            var targetIndex = editorTabs.FindIndex(item => item.Path == targetPath);
            if (sourceIndex >= 0 && targetIndex >= 0 && sourceIndex != targetIndex)
            {
                var item = editorTabs[sourceIndex];
                editorTabs.RemoveAt(sourceIndex);
                editorTabs.Insert(targetIndex, item);
            }
        }
        ClearFileTabDrag();
    }
    private void ReorderFileTabFromKeyboard(string path, KeyboardEventArgs args)
    {
        if (!args.AltKey || !args.ShiftKey || args.Key is not ("ArrowLeft" or "ArrowRight")) return;
        var sourceIndex = editorTabs.FindIndex(item => item.Path == path);
        var targetIndex = sourceIndex + (args.Key == "ArrowLeft" ? -1 : 1);
        if (sourceIndex < 0 || targetIndex < 0 || targetIndex >= editorTabs.Count) return;
        var item = editorTabs[sourceIndex];
        editorTabs.RemoveAt(sourceIndex);
        editorTabs.Insert(targetIndex, item);
    }

    private Task ActivateFile(StudioProjectFile file) => file.Kind switch
    {
        "workflow" => OpenWorkflow(file.Id),
        "skill" => OpenSkill(file),
        "agent-profile" => OpenAgentProfile(file),
        "graph-function" => OpenGraphFunction(file),
        "documentation" => OpenDocumentation(file),
        _ => Task.CompletedTask
    };

    private StudioProjectFile? pendingCloseFile;

    private Task CloseFileMiddle(StudioProjectFile file, MouseEventArgs args) =>
        args.Button == 1 ? CloseFileTab(file) : Task.CompletedTask;

    private Task CloseFileTab(StudioProjectFile file)
    {
        if (busy || pendingCloseFile is not null) return Task.CompletedTask;
        if (file.Path == SelectedFilePath && HasUnsavedEdits)
        {
            pendingCloseFile = file;
            return Task.CompletedTask;
        }
        return CompleteCloseFile(file);
    }

    private void CancelCloseFile() => pendingCloseFile = null;

    private async Task ConfirmCloseFile()
    {
        if (pendingCloseFile is not { } file) return;
        pendingCloseFile = null;
        await CompleteCloseFile(file);
    }

    private async Task CompleteCloseFile(StudioProjectFile file)
    {
        var index = editorTabs.FindIndex(item => item.Path == file.Path);
        if (index < 0) return;
        var wasSelected = file.Path == SelectedFilePath;
        editorTabs.RemoveAt(index);
        if (!wasSelected) return;
        SetWorkflow(null);
        if (editorTabs.Count > 0) await ActivateFile(editorTabs[Math.Min(index, editorTabs.Count - 1)]);
    }

    private string EditorFileName(StudioProjectFile file) => file.Kind == "workflow"
        ? $"{workflowNames.GetValueOrDefault(file.Id, Path.GetFileNameWithoutExtension(file.Path))}.workflow"
        : fileNames.GetValueOrDefault(file.Path, Path.GetFileName(file.Path));

