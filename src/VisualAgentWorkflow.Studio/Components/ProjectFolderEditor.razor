@code {
    [Parameter, EditorRequired] public string ProjectId { get; set; } = "";
    [Parameter, EditorRequired] public string PanelId { get; set; } = "";
    [Parameter, EditorRequired] public string TabId { get; set; } = "";
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public EventCallback<bool> DirtyChanged { get; set; }

    private string directoryPath = "";
    private string? openDirectory;
    private StudioProjectTreeContext? treeContext;
    private ElementReference treeMenuElement;
    private bool focusTreeMenu;
    private StudioProjectTreeClipboard? treeClipboard;
    private string treeOperationName = "";
    private bool treeRenameEditing;
    private bool treeDeleteArmed;
    private bool showCreateSubmenu;
    private string? creationDirectory;
    private StudioProjectManifest? manifest;
    private IReadOnlyList<StudioProjectFileTreeNode> fileTree = [];
    private string projectTreeFilter = "";
    private readonly List<StudioProjectFile> editorTabs = [];
    private string? draggedFileTabPath;
