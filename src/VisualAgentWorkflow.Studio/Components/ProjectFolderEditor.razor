@implements IAsyncDisposable
@using VisualAgentWorkflow.Blazor
@using System.Collections.Immutable
@inject IToolBindingCatalog ToolCatalog
@inject IAgentProviderCatalog ProviderCatalog
@inject StudioProjectStore ProjectStore
@inject StudioProjectSnapshotStore SnapshotStore

<section id="@PanelId" class="vaw-project-folder-editor" role="tabpanel" aria-labelledby="@TabId"
    aria-label="Project folder editor" hidden="@(!IsActive)" aria-hidden="@(!IsActive)">
    @if (manifest is not null)
    {
        <header class="vaw-project-tab-heading">
            <div><h2>@manifest.ProjectName</h2><p><code>@openDirectory</code> · @manifest.Files.Length indexed files</p></div>
            <span class="vaw-provider-state"><span aria-hidden="true"></span>Folder open</span>
        </header>
        @if (externalSourceChanged)
        {
            <aside class="vaw-error vaw-source-change" role="alert">
                <strong>The project folder changed outside Studio.</strong>
                <p>Your current editor contents are preserved. Review or reload the validated folder snapshot before continuing.</p>
                @if (externalSourceProblem is not null) { <p>@externalSourceProblem</p> }
                @if (HasUnsavedEdits)
                { <button type="button" class="vaw-secondary" @onclick="DiscardAndReloadFolder" disabled="@busy">Discard local edits and reload folder</button> }
                else
                { <button type="button" class="vaw-secondary" @onclick="ReloadFolder" disabled="@busy">Reload project files</button> }
            </aside>
        }
        @if (error is not null) { <p role="alert" class="vaw-error">@error</p> }
        @if (message is not null) { <p role="status">@message</p> }
        <section class="vaw-settings-section vaw-project-release" aria-label="Build a consumer release">
            <div class="vaw-settings-section-heading">
                <div><h2>Build consumer package</h2><p>Select saved, executable workflows to include in a portable <code>.vawpkg</code>. Reusable assets embedded in those workflows travel with them; model connections, MCP endpoints, credentials, and grants stay with the consuming host.</p></div>
            </div>
            @if (manifest.Files.All(file => file.Kind != "workflow"))
            {
                <p class="vaw-empty-state">This project has no workflow source files yet.</p>
            }
            else
            {
                <form method="get" action="@($"/api/projects/{Uri.EscapeDataString(ProjectId)}/release.vawpkg")">
                    <fieldset class="vaw-release-workflow-list" disabled="@(busy || HasUnsavedEdits || externalSourceChanged)">
                        <legend>Workflow entry points</legend>
                        @foreach (var workflowFile in manifest.Files.Where(file => file.Kind == "workflow").OrderBy(file => file.Id, StringComparer.Ordinal))
                        {
                            <label @key="workflowFile.Id">
                                <input type="checkbox" name="workflowId" value="@workflowFile.Id"
                                    checked="@selectedPackageWorkflows.Contains(workflowFile.Id)"
                                    @onchange="args => TogglePackageWorkflow(workflowFile.Id, args)" />
                                <span>@WorkflowName(workflowFile.Id)</span><code>@workflowFile.Id</code>
                            </label>
                        }
                    </fieldset>
                    @if (HasUnsavedEdits) { <p class="vaw-help">Save or discard editor changes first. The package uses files currently saved in the project folder.</p> }
                    @if (externalSourceChanged) { <p class="vaw-help">Reload the changed project files before creating a release.</p> }
                    <button type="submit" class="vaw-primary" disabled="@(busy || HasUnsavedEdits || externalSourceChanged || selectedPackageWorkflows.Count == 0)">Download selected workflows</button>
                </form>
            }
        </section>
        <section class="vaw-settings-section vaw-project-snapshots" aria-label="Local restore points">
            <div class="vaw-settings-section-heading">
                <div><h2>Local restore points</h2><p>Save or restore a validated copy of this project’s indexed source. Restore points stay in ignored <code>.vaw/</code> and never enter exports.</p></div>
                <button type="button" class="vaw-secondary" @onclick="CreateSnapshot" disabled="@(busy || HasUnsavedEdits || externalSourceChanged)">Create restore point</button>
            </div>
            @if (snapshotError is not null) { <p role="status" class="vaw-error">Local restore points are unavailable: @snapshotError Project source remains available.</p> }
            @if (snapshots.Count == 0 && snapshotError is null) { <p class="vaw-empty-state">No local restore points yet.</p> }
            @if (snapshots.Count > 0)
            {
                <ul class="vaw-snapshot-list">
                    @foreach (var snapshot in snapshots)
                    {
                        <li @key="snapshot.Id">
                            <div><strong>@snapshot.CreatedAtUtc.ToLocalTime().ToString("g")</strong>
                                <code>@snapshot.Id[..Math.Min(snapshot.Id.Length, 12)]</code>
                                <span>@(snapshot.ArchiveBytes / 1024) KB</span>
                                @if (!snapshot.IsValid) { <span class="vaw-error">Unavailable: @snapshot.Problem</span> }
                            </div>
                            <div class="vaw-provider-actions">
                                <button type="button" class="vaw-secondary" @onclick="() => PreviewSnapshot(snapshot.Id)" disabled="@(busy || !snapshot.IsValid || HasUnsavedEdits || externalSourceChanged)">Preview restore</button>
                                <button type="button" class="vaw-danger-quiet" @onclick="() => RequestSnapshotDelete(snapshot.Id)" disabled="@busy">@(deleteSnapshotId == snapshot.Id ? "Confirm delete point" : "Delete point")</button>
                            </div>
                        </li>
                    }
                </ul>
            }
            @if (snapshotPreview is { } preview)
            {
                <aside class="vaw-source-restore-preview" role="group" aria-label="Restore preview">
                    <h3>Restore preview</h3>
                    <p>Current source <code>@preview.CurrentManifestHash[..12]</code> · restore point <code>@preview.SnapshotManifestHash[..12]</code></p>
                    <p>@preview.AddedFiles files will become indexed, @preview.RemovedFiles will leave the manifest, and @preview.ChangedFiles have changed content.</p>
                    <p>Restore switches the project manifest after validating and adding any missing immutable files. Newer or unindexed files are kept. No files are merged or deleted.</p>
                    @if (HasUnsavedEdits || externalSourceChanged)
                    { <p class="vaw-error">Save or discard edits and reload the current folder before restoring.</p> }
                    <div class="vaw-provider-actions">
                        <button type="button" class="vaw-secondary" @onclick="CancelSnapshotPreview">Cancel</button>
                        <button type="button" class="vaw-danger" @onclick="RestoreSnapshot" disabled="@(busy || HasUnsavedEdits || externalSourceChanged)">Restore this project snapshot</button>
                    </div>
                </aside>
            }
        </section>
    }
    @if (manifest is not null && source is not null)
    {
        <section class="vaw-settings-section vaw-source-workspace" aria-label="Project explorer and project editor">
            <aside class="vaw-project-explorer" aria-label="Project explorer">
                <header><h2>Project explorer</h2><span>@manifest.Files.Length files</span></header>
                @if (manifest.Files.IsEmpty)
                {
                    <p class="vaw-empty-state">No indexed files. Create a workflow to add the first source file.</p>
                }
                else
                {
                    <ul class="vaw-project-tree">
                        @foreach (var node in fileTree)
                        {
                            <li @key="node.Name + node.File?.Path">
                                <ProjectFileTreeItem Node="@node" SelectedPath="@(openedWorkflow?.RelativePath ?? openedSkill?.RelativePath ?? openedProfile?.RelativePath ?? openedGraphFunction?.RelativePath)"
                                    WorkflowNames="@workflowNames" CanOpenFiles="@(!busy && !HasUnsavedEdits)"
                                    OnOpenWorkflow="@OpenWorkflow" OnOpenSkill="@OpenSkill" OnOpenAgentProfile="@OpenAgentProfile" OnOpenGraphFunction="@OpenGraphFunction" />
                            </li>
                        }
                    </ul>
                    <p class="vaw-project-tree-legend">W Workflow · S Skill · A Agent preset · F Graph function</p>
                }
                @if (HasUnsavedEdits) { <p class="vaw-help">Save or discard the current edits before opening another file.</p> }
            </aside>

            <section class="vaw-folder-workflow-editor" aria-label="Project source editor">
                <div class="vaw-settings-section-heading">
                    <div><h2>@EditorTitle</h2><p>@EditorDescription</p></div>
                    <div class="vaw-provider-actions">
                        <button type="button" class="vaw-secondary" @onclick="CreateProfile" disabled="@(busy || HasUnsavedEdits)">New agent profile</button>
                        <button type="button" class="vaw-secondary" @onclick="CreateSkill" disabled="@(busy || HasUnsavedEdits)">New skill</button>
                        <button type="button" class="vaw-secondary" @onclick="CreateGraphFunction" disabled="@(busy || HasUnsavedEdits)">New graph function</button>
                        <button type="button" class="vaw-primary" @onclick="CreateWorkflow" disabled="@(busy || HasUnsavedEdits)">New workflow</button>
                    </div>
                </div>
                @if (openedWorkflow is null)
                {
                    @if (openedProfile is not null || creatingNewProfile)
                    {
                        <section class="vaw-folder-skill-editor" aria-label="Agent profile source editor">
                            @if (openedProfile is not null)
                            {
                                <p class="vaw-definition-status"><strong>Base revision</strong> <code>@($"{openedProfile.Item.Profile.Id}@{openedProfile.Item.Profile.Version}")</code> · @openedProfile.ContentHash[..8]</p>
                            }
                            <form class="vaw-provider-form" @onsubmit="SaveProfile" @onsubmit:preventDefault>
                                <label>Profile ID <input required @bind="profileId" @bind:event="oninput" @bind:after="MarkProfileFormDirty" disabled="@(openedProfile is not null)" maxlength="64" /></label>
                                <label>New version <input required @bind="profileVersion" @bind:event="oninput" @bind:after="MarkProfileFormDirty" maxlength="64" /></label>
                                <label>Name <input required @bind="profileName" @bind:event="oninput" @bind:after="MarkProfileFormDirty" maxlength="128" /></label>
                                <label>Folder <input @bind="profileFolder" @bind:event="oninput" @bind:after="MarkProfileFormDirty" maxlength="256" placeholder="Research/Review" /></label>
                                <label class="vaw-provider-form-wide">Delegate description <textarea required @bind="profileDescription" @bind:event="oninput" @bind:after="MarkProfileFormDirty" maxlength="512" rows="2" /></label>
                                <label>Model connection ID
                                    <input list="profile-provider-options" @bind="profileProviderId" @bind:event="oninput" @bind:after="MarkProfileFormDirty" required placeholder="model.primary" />
                                    <datalist id="profile-provider-options">
                                        @foreach (var provider in providers) { <option value="@provider.ProviderId" label="@($"{provider.DisplayName} · {provider.ModelId}")"></option> }
                                    </datalist>
                                </label>
                                @if (!string.IsNullOrEmpty(profileProviderId) && !providers.Any(provider => provider.ProviderId == profileProviderId))
                                { <p class="vaw-help vaw-provider-form-wide">This connection is not configured in this Studio host. The profile retains its stable ID; the consuming host must resolve it before execution.</p> }
                                <label>Reasoning effort
                                    <select @bind="profileReasoning" @bind:after="MarkProfileFormDirty"><option value="">Provider default</option><option value="Off">Off</option><option value="Low">Low</option><option value="Medium">Medium</option><option value="High">High</option></select>
                                </label>
                                <label>Maximum output tokens <input type="number" min="@AgentOutputTokenLimits.Minimum" max="@AgentOutputTokenLimits.Maximum" @bind="profileMaxOutputTokens" @bind:after="MarkProfileFormDirty" /></label>
                                <label class="vaw-provider-form-wide">Coordination channels <textarea @bind="profileChannelsText" @bind:event="oninput" @bind:after="MarkProfileFormDirty" maxlength="600" rows="3" placeholder="research&#10;review" /></label>
                                <label class="vaw-provider-form-wide">System instructions <textarea required @bind="profileInstructions" @bind:event="oninput" @bind:after="MarkProfileFormDirty" maxlength="8192" rows="6" /></label>
                                <fieldset class="vaw-provider-form-wide"><legend>Allowed MCP tools</legend>
                                    <p class="vaw-help">These are logical tool requirements. The consuming host still owns server connections, credentials, and grants.</p>
                                    @foreach (var tool in bindings)
                                    { <label @key="tool.BindingId"><input type="checkbox" checked="@selectedProfileTools.Contains(tool.BindingId)" @onchange="args => ToggleProfileTool(tool, args)" />@tool.DisplayName · @tool.BindingId</label> }
                                    @foreach (var tool in unavailableProfileTools)
                                    { <p class="vaw-help">Unavailable host binding retained: <code>@tool.BindingId</code> · contract @tool.ContractHash[..8]</p> }
                                </fieldset>
                                <fieldset class="vaw-provider-form-wide"><legend>Project skills</legend>
                                    <p class="vaw-help">Selected skill revisions are embedded in this immutable profile snapshot.</p>
                                    @foreach (var item in projectSkills)
                                    { <label @key="item.Skill.Id + item.Skill.Version"><input type="checkbox" checked="@selectedProfileSkills.Contains(item.Skill.Id + "@" + item.Skill.Version)" @onchange="args => ToggleProfileSkill(item, args)" />@item.Skill.Name · @item.Skill.Version</label> }
                                    @if (projectSkills.Count == 0) { <p>No skills in this project yet.</p> }
                                    @foreach (var skill in unavailableProfileSkills)
                                    { <p class="vaw-help">Unavailable project skill retained: <code>@skill.Id@skill.Version</code></p> }
                                </fieldset>
                                <p class="vaw-provider-form-note vaw-provider-form-wide">Saving adds an immutable profile revision to the project. Existing workflow and profile snapshots remain unchanged; no provider connection or MCP grant is copied.</p>
                                <div class="vaw-provider-form-actions vaw-provider-form-wide">
                                    <button type="submit" class="vaw-primary" disabled="@(busy || !profileFormDirty || string.IsNullOrWhiteSpace(profileProviderId))">Save source profile version</button>
                                    <button type="button" class="vaw-secondary" @onclick="CancelProfileEdit" disabled="@busy">Discard changes</button>
                                </div>
                            </form>
                        </section>
                    }
                    else if (openedSkill is not null || creatingNewSkill)
                    {
                        <section class="vaw-folder-skill-editor" aria-label="Skill source editor">
                            @if (openedSkill is not null)
                            {
                                <p class="vaw-definition-status"><strong>Base revision</strong> <code>@($"{openedSkill.Item.Skill.Id}@{openedSkill.Item.Skill.Version}")</code> · @openedSkill.ContentHash[..8]</p>
                            }
                            <form class="vaw-provider-form" @onsubmit="SaveSkill" @onsubmit:preventDefault>
                                <label>Skill ID <input required @bind="skillId" @bind:event="oninput" @bind:after="MarkSkillFormDirty" disabled="@(openedSkill is not null)" maxlength="64" /></label>
                                <label>New version <input required @bind="skillVersion" @bind:event="oninput" @bind:after="MarkSkillFormDirty" maxlength="64" /></label>
                                <label>Name <input required @bind="skillName" @bind:event="oninput" @bind:after="MarkSkillFormDirty" maxlength="128" /></label>
                                <label>Folder <input @bind="skillFolder" @bind:event="oninput" @bind:after="MarkSkillFormDirty" maxlength="256" placeholder="Research/Review" /></label>
                                <label class="vaw-provider-form-wide">Instructions <textarea required @bind="skillInstructions" @bind:event="oninput" @bind:after="MarkSkillFormDirty" maxlength="8192" rows="10"></textarea></label>
                                <p class="vaw-provider-form-note vaw-provider-form-wide">Saving adds an immutable revision to the project. Older workflow references and skill files remain unchanged.</p>
                                <div class="vaw-provider-form-actions vaw-provider-form-wide">
                                    <button type="submit" class="vaw-primary" disabled="@(busy || !skillFormDirty)">Save source skill version</button>
                                    <button type="button" class="vaw-secondary" @onclick="CancelSkillEdit" disabled="@busy">Discard changes</button>
                                </div>
                            </form>
                        </section>
                    }
                    else if (graphFunctionCatalog is not null && (openedGraphFunction is not null || creatingNewGraphFunction))
                    {
                        <ProjectGraphFunctionEditor @key="graphFunctionEditorGeneration" Source="graphFunctionCatalog"
                            ExpectedManifestHash="@sourceManifestHash" Asset="@openedGraphFunction"
                            Saved="OnGraphFunctionSaved" DirtyChanged="OnGraphFunctionDirtyChanged" Discarded="CancelGraphFunctionEdit" />
                    }
                    else
                    {
                        <p class="vaw-empty-state">Select a workflow, skill, agent profile, or graph function in the project tree, or create one.</p>
                    }
                }
                else if (definition is not null && layout is not null)
                {
                    <p class="vaw-definition-status"><strong>@WorkflowName(definition)</strong> <code>@definition.WorkflowId</code> · @(dirty ? "Unsaved changes" : "Source saved")</p>
                    <WorkflowEditor @key="definition.WorkflowId" ProjectId="folder-project" Definition="definition" DefinitionChanged="DefinitionChanged"
                        Layout="layout" LayoutChanged="LayoutChanged" Bindings="bindings" Providers="providers" SkillLibrary="skillSource"
                        AgentProfileLibrary="profileSource" FunctionCatalog="graphFunctionCatalog">
                        <EditorActions>
                            <button type="button" data-graph-save class="vaw-primary" @onclick="SaveWorkflow" disabled="@(busy || !dirty)">Save source file</button>
                        </EditorActions>
                    </WorkflowEditor>
                }
            </section>
        </section>
    }

</section>
@code {
    [Parameter, EditorRequired] public string ProjectId { get; set; } = "";
    [Parameter, EditorRequired] public string PanelId { get; set; } = "";
    [Parameter, EditorRequired] public string TabId { get; set; } = "";
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public EventCallback<bool> DirtyChanged { get; set; }

    private string directoryPath = "";
    private string? openDirectory;
    private StudioProjectManifest? manifest;
    private IReadOnlyList<StudioProjectFileTreeNode> fileTree = [];
    private StudioFolderWorkflowSource? source;
    private StudioFolderSkillSource? skillSource;
    private StudioFolderAgentProfileSource? profileSource;
    private StudioFolderGraphFunctionCatalog? graphFunctionCatalog;
    private List<StudioFolderWorkflow> workflows = [];
    private readonly HashSet<string> selectedPackageWorkflows = new(StringComparer.Ordinal);
    private IReadOnlyDictionary<string, string> workflowNames = new Dictionary<string, string>();
    private StudioFolderWorkflow? openedWorkflow;
    private StudioFolderSkill? openedSkill;
    private StudioFolderAgentProfile? openedProfile;
    private StudioFolderGraphFunction? openedGraphFunction;
    private bool creatingNewGraphFunction;
    private bool graphFunctionDirty;
    private int graphFunctionEditorGeneration;
    private string sourceManifestHash = "";
    private IReadOnlyList<StudioProjectSnapshot> snapshots = [];
    private StudioProjectSnapshotPreview? snapshotPreview;
    private string? snapshotError;
    private string? deleteSnapshotId;
    private string skillId = "";
    private string skillVersion = "1.0.0";
    private string skillName = "";
    private string skillFolder = "";
    private string skillInstructions = "";
    private bool creatingNewSkill;
    private bool skillFormDirty;
    private string profileId = "";
    private string profileVersion = "1.0.0";
    private string profileName = "";
    private string profileFolder = "";
    private string profileDescription = "";
    private string profileProviderId = "";
    private string profileInstructions = "";
    private string profileReasoning = "";
    private int? profileMaxOutputTokens;
    private string profileChannelsText = "";
    private AgentProfile? profileBeingEdited;
    private readonly HashSet<string> selectedProfileTools = new(StringComparer.Ordinal);
    private readonly HashSet<string> selectedProfileSkills = new(StringComparer.Ordinal);
    private bool creatingNewProfile;
    private bool profileFormDirty;
    private IReadOnlyList<SkillLibraryItem> projectSkills = [];
    private IReadOnlyList<ToolBindingRequest> unavailableProfileTools => (profileBeingEdited?.Tools ?? [])
        .Where(tool => !bindings.Any(available => available.BindingId == tool.BindingId)).ToArray();
    private IReadOnlyList<WorkflowSkill> unavailableProfileSkills => (profileBeingEdited?.Skills ?? [])
        .Where(skill => !projectSkills.Any(available => available.Skill.Id == skill.Id && available.Skill.Version == skill.Version)).ToArray();
    private WorkflowDefinition? definition;
    private WorkflowLayout? layout;
    private IReadOnlyList<ToolBindingDescriptor> bindings = [];
    private IReadOnlyList<AgentProviderDescriptor> providers = [];
    private bool dirty;
    private bool busy;
    private bool externalSourceChanged;
    private string? externalSourceProblem;
    private FileSystemWatcher? sourceWatcher;
    private CancellationTokenSource? sourceMonitorCancellation;
    private SemaphoreSlim? sourceMonitorSignal;
    private Task? sourceMonitorTask;
    private string? sourceMonitorRoot;
    private long sourceMonitorGeneration;
    private bool disposed;
    public bool HasUnsavedEdits => dirty || skillFormDirty || profileFormDirty || graphFunctionDirty;
    private string? loadedProjectId;
    private bool wasActive;
    private bool? lastReportedDirty;
    private string? error;
    private string? message;
    private string EditorTitle => openedWorkflow is not null ? "Workflow editor" : openedProfile is not null || creatingNewProfile ? "Agent profile editor" : openedSkill is not null || creatingNewSkill ? "Skill editor" : "Project editor";
    private string EditorDescription => openedWorkflow is not null
        ? "Workflow drafts save directly to source files. A stale edit is rejected if the project changed since it was loaded."
        : openedSkill is not null || creatingNewSkill
            ? "Skill text saves as a new immutable project revision. A stale project edit is rejected."
            : openedProfile is not null || creatingNewProfile
                ? "Profile settings save as an immutable project revision; provider and MCP services remain host-owned."
                : openedGraphFunction is not null || creatingNewGraphFunction
                    ? "Pure graph functions are edited visually and saved as immutable project revisions."
                    : "Select a source file to edit. Graph function revisions can be created from the project.";

    protected override async Task OnInitializedAsync()
    {
        bindings = await ToolCatalog.ListBindingsAsync();
        providers = await ProviderCatalog.ListProvidersAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!IsActive)
        {
            if (wasActive) await StopSourceMonitorAsync();
            wasActive = false;
            return;
        }

        try
        {
            var newlyActive = !wasActive;
            if (!string.Equals(loadedProjectId, ProjectId, StringComparison.Ordinal))
            {
                directoryPath = ProjectStore.FolderProjectPath(ProjectId);
                await LoadProjectFolderAsync(directoryPath);
                loadedProjectId = ProjectId;
            }
            else if (newlyActive && openDirectory is not null)
            {
                await ReconcileSourceSnapshotAsync();
            }

            if (openDirectory is not null) await StartSourceMonitorAsync(openDirectory);
            wasActive = true;
        }
        catch (Exception exception) when (exception is KeyNotFoundException or InvalidOperationException or IOException or UnauthorizedAccessException or System.Security.SecurityException or System.Text.Json.JsonException)
        {
            ClearProjectFolder();
            error = exception.Message;
            loadedProjectId = null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (lastReportedDirty == HasUnsavedEdits) return;
        lastReportedDirty = HasUnsavedEdits;
        await DirtyChanged.InvokeAsync(HasUnsavedEdits);
    }

    private async Task ReconcileSourceSnapshotAsync()
    {
        if (openDirectory is null) return;
        try
        {
            var (currentManifest, _) = StudioProjectSourceDirectory.Read(openDirectory);
            externalSourceChanged = StudioProjectSourceArchive.ComputeManifestHash(currentManifest) != sourceManifestHash;
            externalSourceProblem = null;
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or System.Security.SecurityException or System.Text.Json.JsonException)
        {
            externalSourceChanged = true;
            externalSourceProblem = "Studio could not validate the current project snapshot. Your editor contents are preserved.";
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadProjectFolderAsync(string folder)
    {
        var canonicalDirectory = Path.GetFullPath(folder);
        var (loadedManifest, _) = StudioProjectSourceDirectory.Read(canonicalDirectory);
        var loadedSource = new StudioFolderWorkflowSource(canonicalDirectory);
        var loadedSkillSource = new StudioFolderSkillSource(canonicalDirectory);
        var loadedProfileSource = new StudioFolderAgentProfileSource(canonicalDirectory);
        var loadedGraphFunctionCatalog = new StudioFolderGraphFunctionCatalog(canonicalDirectory);
        var loadedWorkflows = loadedSource.List().ToList();
        openDirectory = canonicalDirectory;
        manifest = loadedManifest;
        fileTree = StudioProjectFileTree.Build(loadedManifest.Files);
        source = loadedSource;
        skillSource = loadedSkillSource;
        profileSource = loadedProfileSource;
        graphFunctionCatalog = loadedGraphFunctionCatalog;
        projectSkills = loadedSkillSource.List().Select(skill => skill.Item).ToArray();
        sourceManifestHash = StudioProjectSourceArchive.ComputeManifestHash(loadedManifest);
        RefreshSnapshots();
        workflows = loadedWorkflows;
        workflowNames = ToWorkflowNames(loadedWorkflows);
        selectedPackageWorkflows.Clear();
        dirty = false;
        SetWorkflow(workflows.FirstOrDefault());
        externalSourceChanged = false;
        externalSourceProblem = null;
        error = null;
        message = $"Opened {loadedManifest.ProjectName}.";
    }

    private void RefreshSnapshots()
    {
        if (openDirectory is null) return;
        try
        {
            snapshots = SnapshotStore.List(openDirectory);
            snapshotError = null;
        }
        catch (Exception exception) when (exception is IOException or InvalidDataException or UnauthorizedAccessException or System.Security.SecurityException)
        {
            snapshots = [];
            snapshotError = exception.Message;
        }
    }

    private void CreateSnapshot()
    {
        if (openDirectory is null || HasUnsavedEdits || externalSourceChanged) return;
        busy = true;
        snapshotError = null;
        try
        {
            var snapshot = SnapshotStore.Create(openDirectory);
            RefreshSnapshots();
            message = $"Created local restore point {snapshot.Id[..12]}.";
            snapshotPreview = null;
        }
        catch (Exception exception) when (exception is ArgumentException or IOException or InvalidDataException or UnauthorizedAccessException or InvalidOperationException or System.Security.SecurityException or System.Text.Json.JsonException)
        {
            snapshotError = exception.Message;
        }
        finally { busy = false; }
    }

    private void PreviewSnapshot(string id)
    {
        if (openDirectory is null || HasUnsavedEdits || externalSourceChanged) return;
        try
        {
            snapshotPreview = SnapshotStore.Preview(openDirectory, id);
            deleteSnapshotId = null;
            snapshotError = null;
        }
        catch (Exception exception) when (exception is ArgumentException or IOException or InvalidDataException or UnauthorizedAccessException or System.Security.SecurityException or System.Text.Json.JsonException)
        {
            snapshotPreview = null;
            snapshotError = exception.Message;
            RefreshSnapshots();
        }
    }

    private async Task RestoreSnapshot()
    {
        if (openDirectory is null || snapshotPreview is not { } preview || HasUnsavedEdits || externalSourceChanged) return;
        busy = true;
        try
        {
            var restored = SnapshotStore.Restore(openDirectory, preview.Id, preview.CurrentManifestHash);
            snapshotPreview = null;
            deleteSnapshotId = null;
            await LoadProjectFolderAsync(openDirectory);
            message = $"Restored project source from {restored.Id[..12]}. Review the change in Git.";
            RefreshSnapshots();
        }
        catch (Exception exception) when (exception is ArgumentException or IOException or InvalidDataException or UnauthorizedAccessException or InvalidOperationException or System.Security.SecurityException or System.Text.Json.JsonException)
        {
            snapshotError = exception.Message;
            snapshotPreview = null;
        }
        finally { busy = false; }
    }

    private void RequestSnapshotDelete(string id)
    {
        if (deleteSnapshotId != id)
        {
            deleteSnapshotId = id;
            return;
        }
        if (openDirectory is null) return;
        try
        {
            SnapshotStore.Delete(openDirectory, id);
            deleteSnapshotId = null;
            snapshotPreview = null;
            RefreshSnapshots();
            message = "Deleted the selected local restore point. Project source was not changed.";
        }
        catch (Exception exception) when (exception is ArgumentException or IOException or UnauthorizedAccessException or System.Security.SecurityException)
        {
            snapshotError = exception.Message;
        }
    }

    private void CancelSnapshotPreview() => snapshotPreview = null;

    private Task ReloadFolder() => ReloadFolder(discardLocalEdits: false);

    private Task DiscardAndReloadFolder() => ReloadFolder(discardLocalEdits: true);

    private async Task ReloadFolder(bool discardLocalEdits)
    {
        if (openDirectory is null || busy || HasUnsavedEdits && !discardLocalEdits) return;
        busy = true;
        try
        {
            await LoadProjectFolderAsync(openDirectory);
            message = "Reloaded the latest validated project files.";
            error = null;
        }
        catch (Exception exception) when (exception is ArgumentException or IOException or UnauthorizedAccessException or System.Security.SecurityException or System.Text.Json.JsonException)
        {
            externalSourceChanged = true;
            externalSourceProblem = "Studio could not validate the current folder. Correct the folder contents before reloading.";
            error = exception.Message;
        }
        finally { busy = false; }
    }

    private async Task StartSourceMonitorAsync(string root)
    {
        if (sourceMonitorTask is not null && string.Equals(sourceMonitorRoot, root, StringComparison.Ordinal)) return;
        await StopSourceMonitorAsync();
        var generation = ++sourceMonitorGeneration;
        var cancellation = new CancellationTokenSource();
        var signal = new SemaphoreSlim(0, 1);
        sourceMonitorCancellation = cancellation;
        sourceMonitorSignal = signal;
        sourceMonitorRoot = root;
        try
        {
            var watcher = new FileSystemWatcher(root)
            {
                IncludeSubdirectories = true,
                NotifyFilter = NotifyFilters.FileName | NotifyFilters.DirectoryName | NotifyFilters.LastWrite | NotifyFilters.Size
            };
            watcher.Changed += (_, _) => SignalSourceMonitor(signal);
            watcher.Created += (_, _) => SignalSourceMonitor(signal);
            watcher.Deleted += (_, _) => SignalSourceMonitor(signal);
            watcher.Renamed += (_, _) => SignalSourceMonitor(signal);
            watcher.Error += (_, _) => SignalSourceMonitor(signal);
            watcher.EnableRaisingEvents = true;
            sourceWatcher = watcher;
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or ArgumentException or System.Security.SecurityException)
        {
            externalSourceProblem = "File notifications are unavailable for this folder. Studio will check for changes periodically.";
        }
        sourceMonitorTask = MonitorSourceFolderAsync(root, generation, signal, cancellation.Token);
    }

    private static void SignalSourceMonitor(SemaphoreSlim signal)
    {
        try { signal.Release(); }
        catch (SemaphoreFullException) { }
        catch (ObjectDisposedException) { }
    }

    private async Task MonitorSourceFolderAsync(string root, long generation, SemaphoreSlim signal, CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await signal.WaitAsync(TimeSpan.FromSeconds(20), cancellationToken);
                await Task.Delay(TimeSpan.FromMilliseconds(350), cancellationToken);
                while (signal.Wait(0)) { }
                await InvokeAsync(() => ReconcileSourceFolderAsync(root, generation));
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (ObjectDisposedException) when (cancellationToken.IsCancellationRequested) { }
        catch (InvalidOperationException) when (disposed) { }
    }

    private Task ReconcileSourceFolderAsync(string root, long generation)
    {
        if (disposed || !IsActive || generation != sourceMonitorGeneration || !string.Equals(openDirectory, root, StringComparison.Ordinal))
            return Task.CompletedTask;
        try
        {
            var (currentManifest, _) = StudioProjectSourceDirectory.Read(root);
            externalSourceChanged = StudioProjectSourceArchive.ComputeManifestHash(currentManifest) != sourceManifestHash;
            externalSourceProblem = null;
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or System.Security.SecurityException or System.Text.Json.JsonException)
        {
            externalSourceChanged = true;
            externalSourceProblem = "Studio cannot validate the current project snapshot. Your editor contents are preserved.";
        }
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task StopSourceMonitorAsync()
    {
        sourceMonitorGeneration++;
        sourceWatcher?.Dispose();
        sourceWatcher = null;
        var cancellation = sourceMonitorCancellation;
        var signal = sourceMonitorSignal;
        var task = sourceMonitorTask;
        sourceMonitorCancellation = null;
        sourceMonitorSignal = null;
        sourceMonitorTask = null;
        sourceMonitorRoot = null;
        cancellation?.Cancel();
        if (task is not null)
        {
            try { await task; }
            catch (OperationCanceledException) { }
        }
        signal?.Dispose();
        cancellation?.Dispose();
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        await StopSourceMonitorAsync();
    }

