                    <div class="vaw-studio-in-ide vaw-folder-workflow-document">
                    <header class="vaw-document-breadcrumb"><strong>@openedWorkflow.RelativePath</strong><span class="vaw-document-save-state">@(dirty ? "Unsaved changes" : "Source saved")</span><div class="vaw-document-actions">
                        <button type="button" data-graph-save data-vaw-file-save @onclick="SaveWorkflow" disabled="@(busy || !dirty)">Save source file</button>
                        <button type="button" class="vaw-primary" @onclick="OpenRunDialog" disabled="@(!CanRunSavedWorkflow)">Run workflow</button>
                        @if (folderRunActive && folderRun is not null) { <button type="button" @onclick="CancelFolderRun">Cancel run</button> }
                        <button type="button" @onclick="() => folderSettingsOpen = !folderSettingsOpen" aria-label="Workflow settings" aria-expanded="@(folderSettingsOpen ? "true" : "false")">Settings</button>
                    </div></header>
                    @if (folderInspectRun && folderRun is not null)
                    { <div class="vaw-inspection-document-bar"><button type="button" @onclick="() => folderInspectRun = false">Back to workflow</button><span>Execution inspection</span></div><WorkflowRunViewer Snapshot="folderRun" Layout="folderRun.Header.Layout" /> }
                    else
                    {
                    @if (folderSettingsOpen)
                    {
                        <section class="vaw-document-settings is-open" role="region" aria-label="Workflow settings panel" @onkeydown='args => { if (args.Key == "Escape") folderSettingsOpen = false; }'>
                            <header class="vaw-settings-heading"><h2>Workflow settings</h2><button type="button" aria-label="Close workflow settings" @onclick="() => folderSettingsOpen = false">Close</button></header>
                            <WorkflowParameterSettings @key="definition.WorkflowId" Definition="definition" DefinitionChanged="DefinitionChanged" Disabled="busy" />
                        </section>
                    }
                    <WorkflowEditor IdeMode="true" ShowWorkflowSettings="false" @key="definition.WorkflowId" ProjectId="@ProjectId" Definition="definition" DefinitionChanged="DefinitionChanged" HideNodeLibrary="true"
