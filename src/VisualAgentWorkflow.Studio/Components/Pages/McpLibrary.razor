@page "/mcp"
@rendermode InteractiveServer
@inject StudioMcpLibrary Library

<PageTitle>MCP library · Visual Agent Workflow</PageTitle>
<StudioNavigation />
<main class="vaw-provider-settings">
    <header class="vaw-settings-heading"><div><p class="vaw-settings-kicker">WORKFLOW STUDIO</p><h1>MCP library</h1>
        <p class="vaw-settings-intro">Connect an operator-approved MCP endpoint, review supported input fields, and choose which tools are available for assignment to agents. Workflow files contain only logical tool IDs and pinned contracts.</p></div></header>
    <section class="vaw-settings-section" aria-label="Configured MCP servers">
        <h2>Configured servers</h2>
        @if (Library.List().Count == 0) { <p>No servers configured yet. The built-in demo tools remain available.</p> }
        @foreach (var server in Library.List())
        {
            <article class="vaw-provider-card" @key="server.Id">
                <h3>@server.Name</h3><p><code>@server.Id</code> · @(string.IsNullOrEmpty(server.Folder) ? "Unfiled" : server.Folder)</p>
                <p>@ConnectionSummary(server) · @server.EnabledTools.Count enabled tools</p>
                <ul>@foreach (var tool in server.EnabledTools) { <li>@server.Id.@tool</li> }</ul>
                <button type="button" @onclick="() => TestSavedConnection(server)" disabled="@testingServerIds.Contains(server.Id)">@(testingServerIds.Contains(server.Id) ? "Testing…" : "Test connection")</button>
                <button type="button" @onclick="() => Edit(server)" disabled="@testingServerIds.Contains(server.Id)">Edit connection and tools</button>
                <button type="button" class="vaw-danger-quiet" @onclick="() => Delete(server)" disabled="@testingServerIds.Contains(server.Id)">Delete server</button>
                @if (serverTestResults.TryGetValue(server.Id, out var serverTestResult))
                { <p role="status" class="@(serverTestResult.Succeeded ? "vaw-settings-status" : "vaw-error")">@serverTestResult.Message</p> }
            </article>
        }
    </section>
    <section class="vaw-settings-section" aria-label="MCP server setup">
        <h2>@(editing ? "Edit MCP server" : "Connect MCP server")</h2>
        <p>Choose Streamable HTTP or a local stdio process. HTTP credentials and stdio environment values stay encrypted in this Studio.</p>
        <div class="vaw-provider-form">
            <label>Server ID <input @bind="id" maxlength="64" disabled="@editing" placeholder="research" /></label>
            <label>Display name <input @bind="name" maxlength="128" placeholder="Research tools" /></label>
            <label>Folder <input @bind="folder" maxlength="256" placeholder="Research/Search" /></label>
            <label class="vaw-provider-form-wide">Connection type
                <select @bind="transport">
                    <option value="Http">Streamable HTTP</option>
                    <option value="Stdio">Local process (stdio)</option>
                </select>
            </label>
            @if (transport == StudioMcpTransport.Http)
            {
                <label class="vaw-provider-form-wide">MCP endpoint <input @bind="endpoint" type="url" placeholder="https://server.example/mcp or http://127.0.0.1:8080/mcp" /></label>
                <label class="vaw-provider-form-wide">Bearer token <input @bind="token" type="password" autocomplete="new-password" placeholder="Optional; blank keeps the saved token when editing" /></label>
                <p class="vaw-help vaw-provider-form-wide">HTTPS is required for remote servers. Plain HTTP is limited to loopback addresses.</p>
            }
            else
            {
                <aside class="vaw-source-mode-note vaw-provider-form-wide" aria-label="Local MCP process warning">
                    <strong>Local process access</strong>
                    <span>This starts a program with the same OS-user privileges as Studio. It is not sandboxed. Configure only commands you trust. VAW does not use a shell or inherit Studio's environment secrets.</span>
                </aside>
                <label class="vaw-provider-form-wide">Executable <input @bind="command" maxlength="1024" placeholder="npx, node, dotnet, python" /></label>
                <label class="vaw-provider-form-wide">Arguments <textarea @bind="argumentsText" rows="5" placeholder="One argument per line&#10;-y&#10;&#64;brave/brave-search-mcp-server&#10;--transport&#10;stdio"></textarea></label>
                <p class="vaw-help vaw-provider-form-wide">Each line is passed as one argument; values are not interpreted by a shell. Do not put secrets in arguments.</p>
                <label class="vaw-provider-form-wide">Working directory <input @bind="workingDirectory" placeholder="Optional absolute path" /></label>
                <fieldset class="vaw-provider-form-wide">
                    <legend>Process environment</legend>
                    <p class="vaw-help">VAW provides a small set of system variables needed to start programs, then adds only the variables below. Values are encrypted in Studio settings and never included in workflows.</p>
                    @foreach (var variable in environmentVariables)
                    {
                        <div class="vaw-mcp-environment-row" @key="variable">
                            <label>Variable name <input @bind="variable.Name" maxlength="128" placeholder="BRAVE_API_KEY" /></label>
                            <label>Value <input @bind="variable.Value" type="password" autocomplete="new-password" placeholder="@(variable.Saved ? "Saved securely · blank keeps current value" : "Value")" /></label>
                            <button type="button" aria-label="Remove environment variable" @onclick="() => RemoveEnvironmentVariable(variable)">Remove</button>
                        </div>
                    }
                    <button type="button" @onclick="AddEnvironmentVariable">Add environment variable</button>
                </fieldset>
            }
            <button type="button" @onclick="Discover" disabled="@busy">@(busy ? "Testing connection…" : "Test connection & discover tools")</button>
            <p class="vaw-help">The test opens the configured transport and lists its tools. It does not save settings or enable tools.</p>
            @if (discovered.Count > 0)
            {
                <fieldset class="vaw-provider-form-wide"><legend>Enable compatible tools for this Studio</legend>
                    <p>@discovered.Count(tool => tool.IsSupported) supported · @discovered.Count(tool => !tool.IsSupported) excluded. Agents must separately request enabled tools in their node settings.</p>
                    @foreach (var tool in discovered.Where(tool => tool.IsSupported))
                    {
                        <div class="vaw-mcp-tool-choice">
                            <label><input type="checkbox" checked="@selected.Contains(tool.Name)" @onchange="args => Select(tool.Name, args)" />@tool.Name · @tool.InputSummary · schema @tool.ContractHash[..8] · description @tool.DescriptionHash[..8]</label>
                            @if (!string.IsNullOrWhiteSpace(tool.Description)) { <p class="vaw-help">@tool.Description</p> }
                        </div>
                    }
                </fieldset>
                @if (discovered.Any(tool => !tool.IsSupported))
                {
                    <section class="vaw-provider-form-wide vaw-mcp-excluded-tools" aria-label="Excluded MCP tools">
                        <h3>Excluded tools and compatibility reasons</h3>
                        <p>These tools were returned by the server but cannot currently be safely offered by this Studio.</p>
                        <ul>
                            @foreach (var tool in discovered.Where(tool => !tool.IsSupported))
                            {
                                <li><strong>@tool.Name</strong><span>@tool.RejectionReason</span></li>
                            }
                        </ul>
                    </section>
                }
            }
            <button type="button" class="vaw-primary" @onclick="Save" disabled="@(busy || discovered.Count == 0)">Save server and selected tools</button>
            @if (editing) { <button type="button" @onclick="Reset">Cancel edit</button> }
        </div>
        @if (message is not null) { <p role="status">@message</p> }
        @if (error is not null) { <p role="alert" class="vaw-error">@error</p> }
    </section>
</main>

@code {
    private string id = "";
    private string name = "";
    private string folder = "";
    private string endpoint = "";
    private string token = "";
    private StudioMcpTransport transport = StudioMcpTransport.Http;
    private string command = "";
    private string argumentsText = "";
    private string workingDirectory = "";
    private List<EnvironmentVariableRow> environmentVariables = [];
    private bool editing;
    private bool busy;
    private readonly HashSet<string> testingServerIds = new(StringComparer.Ordinal);
    private readonly Dictionary<string, (bool Succeeded, string Message)> serverTestResults = new(StringComparer.Ordinal);
    private string? error;
    private string? message;
    private IReadOnlyList<StudioMcpToolView> discovered = [];
    private HashSet<string> selected = new(StringComparer.Ordinal);

    private async Task Discover()
    {
        busy = true; error = null; message = null;
        try
        {
            discovered = await Library.DiscoverAsync(BuildDraft());
            selected.IntersectWith(discovered.Where(tool => tool.IsSupported).Select(tool => tool.Name));
            message = $"Discovered {discovered.Count} tools: {discovered.Count(tool => tool.IsSupported)} supported and {discovered.Count(tool => !tool.IsSupported)} excluded.";
        }
        catch (ArgumentException exception) { error = exception.Message; discovered = []; }
        catch (IOException) { error = "The MCP server process or connection failed. Check the command and server output."; discovered = []; }
        catch (Exception) { error = "Could not connect or discover tools. Check the endpoint, token and server logs."; discovered = []; }
        finally { busy = false; }
    }
    private void Select(string tool, ChangeEventArgs args)
    { if (args.Value is true) selected.Add(tool); else selected.Remove(tool); }
    private void Save()
    {
        try { Library.Save(BuildDraft(), selected.ToArray()); Reset(); message = "MCP server saved. Refresh tools in the designer to assign them."; error = null; }
        catch (ArgumentException exception) { error = exception.Message; }
    }
    private void Edit(StudioMcpServerView server)
    {
        id = server.Id; name = server.Name; folder = server.Folder; endpoint = server.Endpoint; token = "";
        transport = server.Transport; command = server.Command; argumentsText = string.Join(Environment.NewLine, server.Arguments);
        workingDirectory = server.WorkingDirectory;
        environmentVariables = server.EnvironmentVariableNames.Select(variable => new EnvironmentVariableRow { Name = variable, Saved = true }).ToList();
        selected = server.EnabledTools.ToHashSet(StringComparer.Ordinal); discovered = []; editing = true;
        message = "Rediscover tools before saving this connection.";
    }
    private void Delete(StudioMcpServerView server)
    { Library.Delete(server.Id); serverTestResults.Remove(server.Id); if (id == server.Id) Reset(); message = "Server removed. Existing workflow bindings now require a compatible host registration."; }
    private void Reset()
    { id = ""; name = ""; folder = ""; endpoint = ""; token = ""; transport = StudioMcpTransport.Http; command = ""; argumentsText = ""; workingDirectory = ""; environmentVariables = []; selected.Clear(); discovered = []; editing = false; }

    private StudioMcpConnectionDraft BuildDraft() => new(id.Trim(), name.Trim(), folder.Trim(), transport,
        endpoint.Trim(), token, command.Trim(), argumentsText.Split('\n', StringSplitOptions.RemoveEmptyEntries)
            .Select(argument => argument.TrimEnd('\r')).ToArray(),
        workingDirectory.Trim(), environmentVariables.Where(variable => !string.IsNullOrWhiteSpace(variable.Name))
            .ToDictionary(variable => variable.Name.Trim(), variable => variable.Value, StringComparer.Ordinal));

    private void AddEnvironmentVariable() => environmentVariables.Add(new());
    private void RemoveEnvironmentVariable(EnvironmentVariableRow variable) => environmentVariables.Remove(variable);

    private static string ConnectionSummary(StudioMcpServerView server) => server.Transport == StudioMcpTransport.Stdio
        ? $"stdio · {server.Command} · {server.Arguments.Count} arguments · {server.EnvironmentVariableNames.Count} environment values"
        : server.Endpoint;

    private async Task TestSavedConnection(StudioMcpServerView server)
    {
        testingServerIds.Add(server.Id);
        serverTestResults.Remove(server.Id);
        try
        {
            var result = await Library.TestSavedConnectionAsync(server.Id);
            serverTestResults[server.Id] = result.Succeeded
                ? (true, $"Connection succeeded: {result.DiscoveredTools} tools found, {result.SupportedTools} supported, {result.ExcludedTools} excluded. No settings were changed.")
                : (false, result.Error ?? "The connection test failed.");
        }
        catch (ArgumentException exception)
        {
            serverTestResults[server.Id] = (false, exception.Message);
        }
        catch (IOException)
        {
            serverTestResults[server.Id] = (false, "The MCP server process or connection failed. Check the command, endpoint, and server output.");
        }
        catch (Exception)
        {
            serverTestResults[server.Id] = (false, "Could not connect or list tools. Check the endpoint, credentials, and server logs.");
        }
        finally { testingServerIds.Remove(server.Id); }
    }

    private sealed class EnvironmentVariableRow
    {
        public string Name { get; set; } = "";
        public string Value { get; set; } = "";
        public bool Saved { get; set; }
    }
}
