@page "/projects"
@rendermode InteractiveServer
@inject StudioProjectStore ProjectStore
@inject StudioOpenWorkspaceStore OpenWorkspace
@inject NavigationManager Navigation

<PageTitle>Projects · Visual Agent Workflow</PageTitle>
<StudioNavigation />
<main class="vaw-provider-settings">
    <header class="vaw-settings-heading">
        <div><p class="vaw-settings-kicker">WORKFLOW STUDIO</p><h1>Projects</h1>
            <p class="vaw-settings-intro">Keep workflows and reusable authoring assets organized by project. Projects do not contain model credentials, MCP endpoints, or host permissions.</p></div>
    </header>
    <section class="vaw-settings-section" aria-label="Create project">
        <h2>Create a project</h2>
        <form class="vaw-project-create" @onsubmit="Create" @onsubmit:preventDefault>
            <label>Project name <input @bind="name" maxlength="80" required /></label>
            <button type="submit" class="vaw-primary">Create project</button>
        </form>
        @if (message is not null) { <p role="status">@message</p> }
        @if (error is not null) { <p role="alert" class="vaw-error">@error</p> }
        @if (ImportError is not null) { <p role="alert" class="vaw-error">Source import failed: @ImportError</p> }
    </section>
    <section class="vaw-settings-section" aria-label="Import project source">
        <h2>Import a source snapshot</h2>
        <p>Import a <code>.vawsrc.zip</code> into a new project. The archive is validated before anything is added. Run history, provider credentials, MCP endpoints, and permissions are not included.</p>
        <form class="vaw-project-create" action="/api/projects/import" method="post" enctype="multipart/form-data">
            <AntiforgeryToken />
            <label>Project source archive <input type="file" name="sourceArchive" accept=".zip,application/zip" required /></label>
            <button type="submit" class="vaw-primary">Import as new project</button>
        </form>
    </section>
    <section class="vaw-settings-section" aria-label="Open a project folder">
        <h2>Open a Git project folder</h2>
        <p>Open a validated source folder directly in the graph editor. Folder edits save back to the source files; the legacy catalog publish and revision controls are not used in this mode.</p>
        <a class="vaw-primary vaw-button-link" href="/source-project">Open project folder</a>
    </section>
    <section class="vaw-settings-section" aria-label="Your projects">
        <h2>Your projects</h2>
        @foreach (var project in ProjectStore.List())
        {
            <article class="vaw-provider-card" @key="project.Id">
                <h3>@project.Name @if (project.IsArchived) { <small>Archived</small> }</h3>
                <p>Created @project.CreatedAt.ToLocalTime().ToString("g")</p>
                @if (project.IsFolderBacked)
                {
                    <p class="vaw-help">Git folder · <code>@project.FolderPath</code></p>
                }
                @if (!project.IsArchived)
                {
                    @if (project.IsFolderBacked)
                    {
                        <button type="button" class="vaw-button-link" @onclick="() => OpenFolderProject(project.Id)">Open project</button>
                    }
                    else
                    {
                        <a class="vaw-button-link" href="/projects/@project.Id">Open project</a>
                    }
                    <a class="vaw-button-link" href="/api/projects/@project.Id/source.zip">Download source snapshot</a>
                    @if (project.Id != StudioProjectStore.DefaultProjectId)
                    {
                        <button type="button" class="vaw-danger-quiet" @onclick="() => SetArchived(project, true)">Archive project</button>
                    }
                }
                else
                {
                    <button type="button" @onclick="() => SetArchived(project, false)">Restore project</button>
                }
            </article>
        }
    </section>
</main>

@code {
    [SupplyParameterFromQuery(Name = "importError")]
    public string? ImportError { get; set; }

    private string name = "";
    private string? message;
    private string? error;

    private void Create()
    {
        try
        {
            var project = ProjectStore.Create(name);
            name = "";
            message = $"Created {project.Name}.";
            error = null;
        }
        catch (ArgumentException exception) { error = exception.Message; message = null; }
    }

    private void SetArchived(StudioProject project, bool archived)
    {
        ProjectStore.SetArchived(project.Id, archived);
        message = archived ? $"Archived {project.Name}. Its data is retained." : $"Restored {project.Name}.";
        error = null;
    }

    private void OpenFolderProject(string projectId)
    {
        try
        {
            OpenWorkspace.Open(projectId);
            Navigation.NavigateTo($"/source-project/folder/{Uri.EscapeDataString(projectId)}");
        }
        catch (Exception exception) when (exception is InvalidOperationException or KeyNotFoundException or IOException)
        {
            error = exception.Message;
        }
    }
}
