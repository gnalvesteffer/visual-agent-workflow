@page "/settings"
@rendermode InteractiveServer
@inject StudioModelProviderStore Providers

<PageTitle>Settings · Visual Agent Workflow</PageTitle>
<StudioNavigation />
<main class="vaw-provider-settings">
    <header class="vaw-settings-heading">
        <div>

        <h1>Model connections</h1>
            <p class="vaw-settings-intro">Connect any OpenAI-compatible chat API to your agent nodes. Each connection pins one endpoint, model, and optional API key. Credentials stay in this Studio and are never added to workflow files.</p>
        </div>
        <a class="vaw-primary vaw-add-provider-link" href="#add-provider">Add connection</a>
    </header>

    <section class="vaw-settings-section" aria-labelledby="configured-providers-title">
        <div class="vaw-settings-section-heading">
            <div>
                <h2 id="configured-providers-title">Configured connections</h2>
                <p>Each stable connection ID points to its current endpoint and model. Editing it affects future runs that use it.</p>
                <p class="vaw-provider-form-note">Testing a model connection sends a real chat request with an output limit of one token. Your provider may charge for it.</p>
            </div>
            <span class="vaw-provider-count">@providers.Count @(providers.Count == 1 ? "connection" : "connections")</span>
        </div>

        @if (providers.Count == 0)
        {
            <div class="vaw-provider-empty">
                <h3>No model connections yet</h3>
                <p>Add OpenAI, Unsloth, LM Studio, or another OpenAI-compatible endpoint to make its model available to agent nodes.</p>
                <a href="#add-provider">Set up a connection</a>
            </div>
        }
        else
        {
            <div class="vaw-provider-list">
                @foreach (var provider in providers)
                {
                    <article class="vaw-provider-card" @key="provider.ProviderId">
                        <div class="vaw-provider-card-heading">
                            <div>
                                <h3>@provider.DisplayName</h3>
                                <p class="vaw-provider-identity"><code>@provider.ProviderId</code><span>Stable connection ID</span></p>
                            </div>
                            <span class="vaw-provider-state"><span aria-hidden="true"></span>Configured</span>
                        </div>
                        <dl>
                            <div><dt>Model</dt><dd>@provider.Model</dd></div>
                            <div><dt>Endpoint</dt><dd>@provider.Endpoint</dd></div>
                            <div><dt>Transport</dt><dd>@(provider.AllowInsecureHttp ? "HTTP · unencrypted" : "HTTPS · encrypted")</dd></div>
                            <div><dt>API key</dt><dd>@(provider.HasCredential ? "Stored securely" : "Not configured · endpoint must not require a key")</dd></div>
                            <div><dt>Context window</dt><dd>@(provider.ContextWindowTokens is { } contextTokens ? $"{contextTokens:N0} tokens" : "Not configured")</dd></div>
                            <div><dt>Token pricing</dt><dd>@Pricing(provider.InputCostPerMillionTokens, provider.OutputCostPerMillionTokens)</dd></div>
                        </dl>
                        @if (pendingDelete == provider)
                        {
                            <div class="vaw-provider-delete-confirmation" role="alert">
                                <p><strong>Delete @provider.DisplayName?</strong> Workflows using connection <code>@provider.ProviderId</code> will no longer be able to start model calls.</p>
                                <div class="vaw-provider-actions">
                                    <button type="button" class="vaw-danger" disabled="@deleting" @onclick="() => Delete(provider)">@(deleting ? "Deleting…" : "Confirm delete")</button>
                                    <button type="button" @onclick="CancelDelete">Keep connection</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="vaw-provider-actions">
                                <button type="button" class="vaw-secondary" @onclick="() => TestSavedConnection(provider)" disabled="@testingProviderIds.Contains(provider.ProviderId)">@(testingProviderIds.Contains(provider.ProviderId) ? "Testing…" : "Test connection")</button>
                                <button type="button" class="vaw-secondary" @onclick="() => PrepareEdit(provider)" disabled="@testingProviderIds.Contains(provider.ProviderId)">Edit connection</button>
                                <button type="button" class="vaw-danger-quiet" @onclick="() => RequestDelete(provider)" disabled="@testingProviderIds.Contains(provider.ProviderId)">Delete connection</button>
                            </div>
                        }
                        @if (providerTestResults.TryGetValue(provider.ProviderId, out var providerTestResult))
                        { <p role="status" class="@(providerTestResult.Succeeded ? "vaw-settings-status" : "vaw-error")">@providerTestResult.Message</p> }
                    </article>
                }
            </div>
        }
        @if (error is not null) { <p role="alert" class="vaw-error">@error</p> }
        @if (message is not null) { <p role="status" class="vaw-settings-status">@message</p> }
    </section>

    <section id="add-provider" class="vaw-settings-section vaw-provider-form-section" aria-labelledby="provider-form-title">
        <div class="vaw-settings-section-heading">
            <div>
                <h2 id="provider-form-title">@(editing ? "Edit model connection" : "Add a model connection")</h2>
                <p>@(editing ? "Saving updates this connection for every workflow that references its ID. Existing run evidence still records the connection settings used at that time." : "Connect an OpenAI-compatible chat completions endpoint and the model it serves.")</p>
            </div>
        </div>
        <aside class="vaw-provider-tip"><strong>Works with compatible APIs</strong><span>Use OpenAI, Unsloth, LM Studio, llama.cpp, vLLM, or another server that implements OpenAI-compatible chat completions. Enter its base URL, served model ID, and API key if required.</span></aside>
        <form class="vaw-provider-form" @onsubmit="Save" @onsubmit:preventDefault>
            <label>Connection ID <input required @bind="form.ProviderId" @bind:after="ClearFormTest" autocomplete="off" disabled="@editing" /><small>Stable ID referenced by agent nodes and profiles.</small></label>
            <label>Connection name <input required @bind="form.DisplayName" @bind:after="ClearFormTest" /></label>
            <label>Model ID <input required @bind="form.Model" @bind:after="ClearFormTest" placeholder="For example, the model name shown by your server" /><small>Copy the exact served model identifier.</small></label>
            <label class="vaw-provider-form-wide">API base URL <input required type="url" @bind="form.Endpoint" @bind:after="ClearFormTest" placeholder="https://api.example.com/v1" /><small>Use the server's OpenAI-compatible API base URL, usually ending in <code>/v1</code>.</small></label>
            <label>Connection timeout <span class="vaw-input-suffix"><input required type="number" min="1" step="1" @bind="form.TimeoutSeconds" @bind:after="ClearFormTest" /><span>seconds</span></span><small>Positive whole number. Used when an agent node does not set its own timeout.</small></label>
            <label class="vaw-provider-option"><input type="checkbox" @bind="form.AllowInsecureHttp" @bind:after="ClearFormTest" />Allow unencrypted HTTP for this endpoint</label>
            <label>Context window <span class="vaw-input-suffix"><input type="number" min="128" max="2000000" step="1" @bind="form.ContextWindowTokens" /><span>tokens</span></span><small>Optional. Used to visualize prompt usage; this does not enforce a model limit.</small></label>
            <label>Input price <span class="vaw-input-suffix"><input type="number" min="0" max="100000" step="0.000001" @bind="form.InputCostPerMillionTokens" /><span>USD / 1M tokens</span></span></label>
            <label>Output price <span class="vaw-input-suffix"><input type="number" min="0" max="100000" step="0.000001" @bind="form.OutputCostPerMillionTokens" /><span>USD / 1M tokens</span></span><small>Optional. If both prices are set, runs show an estimate from provider-reported input and output usage.</small></label>
            <label class="vaw-provider-form-wide">API key (optional) <input type="password" autocomplete="new-password" @bind="form.ApiKey" @bind:after="ClearFormTest" placeholder="@(editing ? "Leave blank to keep the current key" : "Enter API key if required")" /><small>Encrypted when saved. If left blank on a new connection, no Authorization header is sent.</small></label>
            @if (editing && providerHasCredential)
            { <label class="vaw-provider-option"><input type="checkbox" @bind="form.RemoveApiKey" @bind:after="ClearFormTest" />Remove the saved API key</label> }
            <p class="vaw-provider-form-note vaw-provider-form-wide">Testing sends a short chat request to the selected model with an output limit of one token. The endpoint may charge for the request.</p>
            <p class="vaw-provider-form-note vaw-provider-form-wide">HTTPS protects prompts, responses, and API keys in transit. If you enable HTTP, traffic is unencrypted and anyone able to observe the network path could read it. Use HTTP only on a trusted network.</p>
            <div class="vaw-provider-form-actions vaw-provider-form-wide">
                <button type="submit" class="vaw-primary" disabled="@(saving || testingConnection)">@(saving ? "Saving…" : editing ? "Save connection" : "Add connection")</button>
                <button type="button" class="vaw-secondary" @onclick="TestFormConnection" disabled="@(testingConnection || saving)">@(testingConnection ? "Testing…" : "Test connection")</button>
                @if (editing) { <button type="button" class="vaw-secondary" @onclick="ResetForm" disabled="@testingConnection">Cancel edit</button> }
            </div>
        </form>
        @if (formError is not null) { <p role="alert" class="vaw-error">@formError</p> }
        @if (formTestResult is { } testResult)
        { <p role="status" class="@(testResult.Succeeded ? "vaw-settings-status" : "vaw-error")">@testResult.Message</p> }
    </section>
</main>

@code {
    private sealed class ProviderForm
    {
        [System.ComponentModel.DataAnnotations.Required] public string ProviderId { get; set; } = "openai.primary";
        [System.ComponentModel.DataAnnotations.Required] public string DisplayName { get; set; } = "OpenAI";
        [System.ComponentModel.DataAnnotations.Required] public string Model { get; set; } = "gpt-4.1";
        [System.ComponentModel.DataAnnotations.Required] public string Endpoint { get; set; } = "https://api.openai.com/v1/";
        [System.ComponentModel.DataAnnotations.Range(1, int.MaxValue)] public int TimeoutSeconds { get; set; } = 30;
        public int? ContextWindowTokens { get; set; }
        public decimal? InputCostPerMillionTokens { get; set; }
        public decimal? OutputCostPerMillionTokens { get; set; }
        public string ApiKey { get; set; } = "";
        public bool RemoveApiKey { get; set; }
        public bool AllowInsecureHttp { get; set; }
    }

    private ProviderForm form = new();
    private IReadOnlyList<StudioModelProviderView> providers = [];
    private StudioModelProviderView? pendingDelete;
    private bool providerHasCredential;
    private bool editing;
    private bool saving;
    private bool deleting;
    private bool testingConnection;
    private CancellationTokenSource? formTestCancellation;
    private readonly HashSet<string> testingProviderIds = new(StringComparer.Ordinal);
    private readonly Dictionary<string, StudioModelConnectionTestResult> providerTestResults = new(StringComparer.Ordinal);
    private StudioModelConnectionTestResult? formTestResult;
    private int formTestVersion;
    private string? error;
    private string? formError;
    private string? message;

    protected override void OnInitialized() => providers = Providers.List();

    private void PrepareEdit(StudioModelProviderView provider)
    {
        providerHasCredential = provider.HasCredential;
        form = new() { ProviderId = provider.ProviderId, DisplayName = provider.DisplayName,
            Model = provider.Model, Endpoint = provider.Endpoint, TimeoutSeconds = provider.TimeoutSeconds,
            AllowInsecureHttp = provider.AllowInsecureHttp, ContextWindowTokens = provider.ContextWindowTokens,
            InputCostPerMillionTokens = provider.InputCostPerMillionTokens,
            OutputCostPerMillionTokens = provider.OutputCostPerMillionTokens };
        editing = true;
        formError = error = null;
        message = null;
        formTestResult = null;
    }

    private void ResetForm()
    {
        ClearFormTest();
        editing = false;
        providerHasCredential = false;
        form = new();
        formError = null;
        formTestResult = null;
    }

    private void ClearFormTest()
    {
        formTestVersion++;
        formTestCancellation?.Cancel();
        formTestResult = null;
    }

    private void RequestDelete(StudioModelProviderView provider)
    {
        pendingDelete = provider;
        error = message = null;
    }

    private void CancelDelete() => pendingDelete = null;

    private void Delete(StudioModelProviderView provider)
    {
        deleting = true;
        error = message = null;
        try
        {
            if (!Providers.Delete(provider.ProviderId))
                throw new InvalidOperationException("This model connection is no longer configured. Refresh the page and try again.");
            providers = Providers.List();
            pendingDelete = null;
            message = $"Deleted model connection {provider.ProviderId}.";
        }
        catch (IOException) { error = "The provider could not be deleted from Studio settings. Check the local data directory and try again."; }
        finally { deleting = false; }
    }

    private void Save()
    {
        if (testingConnection) return;
        ClearFormTest();
        saving = true;
        formError = error = message = null;
        try
        {
            Providers.Save(form.ProviderId, form.DisplayName, form.Model, form.Endpoint, form.TimeoutSeconds,
                form.ApiKey, form.AllowInsecureHttp, form.RemoveApiKey,
                form.ContextWindowTokens, form.InputCostPerMillionTokens, form.OutputCostPerMillionTokens);
            providers = Providers.List();
            var savedName = form.DisplayName;
            editing = false;
            providerHasCredential = false;
            form = new();
            message = $"Saved {savedName}. It is now available to agent nodes that use this connection ID.";
        }
        catch (ArgumentException exception) { formError = exception.Message; }
        catch (InvalidOperationException exception) { formError = exception.Message; }
        finally { saving = false; }
    }

    private async Task TestFormConnection()
    {
        using var cancellation = new CancellationTokenSource();
        formTestCancellation = cancellation;
        var testVersion = formTestVersion;
        testingConnection = true;
        formError = null;
        formTestResult = null;
        try
        {
            var result = await Providers.TestConnectionAsync(form.ProviderId.Trim(), form.DisplayName.Trim(),
                form.Model.Trim(), form.Endpoint.Trim(), form.TimeoutSeconds, form.ApiKey,
                form.AllowInsecureHttp, form.RemoveApiKey, keepSavedCredentialWhenBlank: editing,
                cancellationToken: cancellation.Token);
            if (testVersion == formTestVersion) formTestResult = result;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (ArgumentException exception) { formError = exception.Message; }
        catch (InvalidOperationException exception) { formError = exception.Message; }
        finally
        {
            if (ReferenceEquals(formTestCancellation, cancellation)) formTestCancellation = null;
            testingConnection = false;
        }
    }

    private async Task TestSavedConnection(StudioModelProviderView provider)
    {
        testingProviderIds.Add(provider.ProviderId);
        providerTestResults.Remove(provider.ProviderId);
        try { providerTestResults[provider.ProviderId] = await Providers.TestSavedConnectionAsync(provider.ProviderId); }
        catch (ArgumentException exception) { providerTestResults[provider.ProviderId] = new(false, exception.Message); }
        finally { testingProviderIds.Remove(provider.ProviderId); }
    }

    private static string Pricing(decimal? input, decimal? output) => input is { } inputRate && output is { } outputRate
        ? $"${inputRate:0.######} in · ${outputRate:0.######} out / 1M tokens"
        : "Not configured";
}
