@page "/source-project"
@page "/source-project/folder/{FolderProjectId}"
@using VisualAgentWorkflow.Blazor
@inject StudioProjectStore ProjectStore
@inject StudioOpenWorkspaceStore OpenWorkspace
@inject NavigationManager Navigation
@inject IJSRuntime JavaScript

<PageTitle>Project workspace · Visual Agent Workflow</PageTitle>
<main class="vaw-provider-settings vaw-source-project vaw-open-project-workspace">
    <header class="vaw-settings-heading vaw-workspace-page-heading">
        <div><h1>Project workspace</h1><p class="vaw-settings-intro">Edit portable workflow source files. Run history and host credentials stay outside the project.</p></div>
        @if (openProjectIds.Count > 0)
        {
            <details @key="activeProjectId" class="vaw-open-project-details">
              <summary>Open folder</summary>
              <section class="vaw-settings-section vaw-project-open-panel" aria-label="Open a project folder">
                <form class="vaw-project-create" @onsubmit="OpenProject" @onsubmit:preventDefault>
                    <label>Absolute folder path
                        <input @bind="directoryPath" autocomplete="off" placeholder="/home/me/projects/my-workflow or C:\projects\my-workflow" />
                    </label>
                    <button type="submit" class="vaw-primary" disabled="@busy">@(busy ? "Opening…" : "Open folder")</button>
                </form>
                <p class="vaw-help">Up to @StudioOpenWorkspaceStore.MaximumOpenProjects project folders can be open. Project files stay portable in their folders; tab order is saved in local Studio settings.</p>
              </section>
            </details>
        }
    </header>

    @if (error is not null) { <p role="alert" class="vaw-error">@error</p> }
    @if (openProjectIds.Count == 0)
    {
      <section class="vaw-settings-section vaw-project-open-panel" aria-label="Open a project folder">
        <form class="vaw-project-create" @onsubmit="OpenProject" @onsubmit:preventDefault>
          <label>Absolute folder path
            <input @bind="directoryPath" autocomplete="off" placeholder="/home/me/projects/my-workflow or C:\projects\my-workflow" />
          </label>
          <button type="submit" class="vaw-primary" disabled="@busy">@(busy ? "Opening…" : "Open folder")</button>
        </form>
        <p class="vaw-help">Open a Git project folder to browse and edit its source files. Credentials and run history stay in Studio.</p>
      </section>
    }

    @if (openProjectIds.Count > 0)
    {
        <section class="vaw-project-tabs" aria-label="Open project folders">
            <div @ref="projectTabStrip" class="vaw-project-tab-list" role="tablist" aria-label="Project folders" aria-description="Scroll horizontally to reach tabs that do not fit. Drag tabs to reorder; press Alt+Shift+Arrow keys on a tab to move it.">
                @foreach (var projectId in openProjectIds)
                {
                    var project = ProjectStore.GetActive(projectId);
                    var selected = projectId == activeProjectId;
                    <div class="vaw-project-tab @(selected ? "is-active" : null) @(draggedProjectTabId == projectId ? "is-dragging" : null) @(projectDropTargetId == projectId ? "is-drop-target" : null)" @key="projectId" @ondragstart="() => StartProjectTabDrag(projectId)" @ondragenter="() => projectDropTargetId = projectId" @ondragover:preventDefault="true" @ondrop="() => DropProjectTab(projectId)" @ondrop:preventDefault="true" @ondragend="ClearProjectTabDrag" data-project-tab-id="@projectId" data-vaw-closable-tab @onauxclick="args => CloseProjectAux(projectId, args)">
                        <button type="button" id="@($"project-tab-{projectId}")" role="tab"
                            aria-controls="@($"project-panel-{projectId}")" aria-selected="@(selected ? "true" : "false")"
                            aria-label="@(dirtyProjects.Contains(projectId) ? $"{project.Name}, unsaved changes" : project.Name)"
                            title="@project.FolderPath"
                            aria-description="Drag this tab to reorder. Press Alt+Shift+ArrowLeft or ArrowRight to move it."
                            aria-keyshortcuts="Alt+Shift+ArrowLeft Alt+Shift+ArrowRight"
                            draggable="true"
                            @onkeydown="args => ReorderProjectTabFromKeyboard(projectId, args)"
                            @onclick="() => SelectProject(projectId)">
                            <span>@project.Name</span><code aria-hidden="true">@(dirtyProjects.Contains(projectId) ? "●" : "")</code>
                        </button>
                        <button type="button" class="vaw-project-tab-close" aria-label="Close @project.Name" title="Close project" @onclick="() => RequestClose(projectId)">×</button>
                    </div>
                }
            </div>
            @foreach (var projectId in openProjectIds)
            {
                <ProjectFolderEditor @key="projectId" ProjectId="@projectId" PanelId="@($"project-panel-{projectId}")"
                    TabId="@($"project-tab-{projectId}")" IsActive="@(projectId == activeProjectId)"
                    DirtyChanged="@(value => UpdateDirty(projectId, value))" />
            }
        </section>
    }
    else
    {
        <section class="vaw-settings-section vaw-project-empty-workspace">
            <h2>No project folders open</h2>
            <p>Enter a project directory above. Studio will validate and add it as a project tab.</p>
        </section>
    }

    @if (pendingCloseProjectId is not null && ProjectStore.List().FirstOrDefault(item => item.Id == pendingCloseProjectId) is { } closingProject)
    {
        <div class="vaw-project-close-backdrop" role="presentation">
            <section class="vaw-project-close-dialog" role="alertdialog" aria-modal="true" aria-labelledby="close-project-title" aria-describedby="close-project-description">
                <h2 id="close-project-title">Discard unsaved edits?</h2>
                <p id="close-project-description">@closingProject.Name has unsaved editor changes. Closing this tab will discard them.</p>
                <div class="vaw-provider-actions">
                    <button type="button" class="vaw-secondary" @onclick="CancelClose">Keep project open</button>
                    <button type="button" class="vaw-danger" @onclick="ConfirmClose">Discard and close</button>
                </div>
            </section>
        </div>
    }
</main>

<TabCloseBehavior />

@code {
    [Parameter] public string? FolderProjectId { get; set; }

    private string directoryPath = "";
    private string? error;
    private bool busy;
    private string? draggedProjectTabId;
    private string? projectDropTargetId;
    private ElementReference projectTabStrip;
    private string? pendingCloseProjectId;
    private readonly HashSet<string> dirtyProjects = new(StringComparer.Ordinal);
    private IReadOnlyList<string> openProjectIds => OpenWorkspace.ProjectIds;
    private string? activeProjectId => OpenWorkspace.SelectedProjectId;

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(FolderProjectId)) return;
        // A URL left behind by closing or switching tabs must not override the
        // machine-local selected tab. Other navigation paths explicitly open it first.
        if (OpenWorkspace.ProjectIds.Count > 0 && !OpenWorkspace.ProjectIds.Contains(FolderProjectId, StringComparer.Ordinal)) return;
        if (OpenWorkspace.ProjectIds.Contains(FolderProjectId, StringComparer.Ordinal)) return;
        try
        {
            OpenWorkspace.Open(FolderProjectId);
            error = null;
        }
        catch (Exception exception) when (exception is KeyNotFoundException or InvalidOperationException or IOException)
        {
            error = exception.Message;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (openProjectIds.Count > 0)
            await JavaScript.InvokeVoidAsync("vawStudioIde.revealActiveTab", projectTabStrip);
    }

    private void OpenProject()
    {
        busy = true;
        error = null;
        try
        {
            var canonicalDirectory = Path.GetFullPath(directoryPath);
            var (manifest, _) = StudioProjectSourceDirectory.Read(canonicalDirectory);
            var project = ProjectStore.RegisterFolderSource(canonicalDirectory, manifest.ProjectName);
            OpenWorkspace.Open(project.Id);
            directoryPath = canonicalDirectory;
            Navigation.NavigateTo($"/source-project/folder/{Uri.EscapeDataString(project.Id)}");
        }
        catch (Exception exception) when (exception is ArgumentException or IOException or UnauthorizedAccessException or System.Security.SecurityException or System.Text.Json.JsonException or InvalidOperationException)
        {
            error = exception.Message;
        }
        finally { busy = false; }
    }

    private void SelectProject(string projectId)
    {
        try
        {
            OpenWorkspace.Select(projectId);
            Navigation.NavigateTo($"/source-project/folder/{Uri.EscapeDataString(projectId)}");
            error = null;
        }
        catch (Exception exception) when (exception is InvalidOperationException or IOException)
        {
            error = exception.Message;
        }
    }

    private void StartProjectTabDrag(string projectId) => draggedProjectTabId = projectId;
    private void ClearProjectTabDrag() { draggedProjectTabId = null; projectDropTargetId = null; }
    private void DropProjectTab(string targetId)
    {
        if (draggedProjectTabId is { } sourceId)
        {
            var targetIndex = openProjectIds.ToList().IndexOf(targetId);
            if (targetIndex >= 0) OpenWorkspace.Reorder(sourceId, targetIndex);
        }
        ClearProjectTabDrag();
    }
    private void ReorderProjectTabFromKeyboard(string projectId, KeyboardEventArgs args)
    {
        if (!args.AltKey || !args.ShiftKey || args.Key is not ("ArrowLeft" or "ArrowRight")) return;
        var index = openProjectIds.ToList().IndexOf(projectId);
        var target = index + (args.Key == "ArrowLeft" ? -1 : 1);
        if (target >= 0 && target < openProjectIds.Count) OpenWorkspace.Reorder(projectId, target);
    }

    private void UpdateDirty(string projectId, bool isDirty)
    {
        if (isDirty) dirtyProjects.Add(projectId);
        else dirtyProjects.Remove(projectId);
    }

    private void CloseProjectAux(string projectId, MouseEventArgs args)
    {
        if (args.Button == 1) RequestClose(projectId);
    }

    private void RequestClose(string projectId)
    {
        if (pendingCloseProjectId is not null) return;
        if (dirtyProjects.Contains(projectId)) pendingCloseProjectId = projectId;
        else CloseProject(projectId);
    }

    private void ConfirmClose()
    {
        if (pendingCloseProjectId is not { } projectId) return;
        pendingCloseProjectId = null;
        dirtyProjects.Remove(projectId);
        CloseProject(projectId);
    }

    private void CloseProject(string projectId)
    {
        var next = OpenWorkspace.Close(projectId);
        Navigation.NavigateTo(next is null ? "/source-project" : $"/source-project/folder/{Uri.EscapeDataString(next)}");
    }

    private void CancelClose() => pendingCloseProjectId = null;
}
