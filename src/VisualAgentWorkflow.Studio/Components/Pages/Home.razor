@page "/"
@page "/projects/{ProjectId}"
@attribute [StreamRendering]
@inject IToolBindingCatalog Tools
@inject IAgentProviderCatalog Agents
@inject StudioProjectWorkspace ProjectWorkspace
@inject NavigationManager Navigation

<PageTitle>Visual Agent Workflow</PageTitle>
<main class="vaw-main-ide-route">
    @if (interfaceAuthoringSource is not null && !ProjectWorkspace.IsReadOnly)
    {
        <ProjectWorkflowInterfaceAssets @key="ProjectWorkspace.CurrentProjectId" Source="interfaceAuthoringSource"
            Saved="OnWorkflowInterfacesSaved" />
    }
    <WorkflowErrorBoundary>
        <ChildContent>
            <WorkflowStudio @key="(ProjectWorkspace.CurrentProjectId, WorkflowId)" ProjectId="@ProjectWorkspace.CurrentProjectId" InitialWorkflowId="@WorkflowId" IdeMode="true" DraftSaved="RefreshProjectExplorer" WorkflowSelected="SelectWorkflow" Client="ProjectWorkspace.Client" Catalog="ProjectWorkspace.Catalog" ToolCatalog="Tools" AgentCatalog="Agents" SkillLibrary="ProjectWorkspace.Skills" AgentProfileLibrary="ProjectWorkspace.AgentProfiles" FunctionCatalog="ProjectWorkspace.Functions" TemplateCatalog="ProjectWorkspace.Templates" InterfaceImplementations="@InterfaceImplementations" />
        </ChildContent>
        <ErrorContent>
            <section class="vaw-viewer" role="alert">
                <h1>The workflow interface could not be displayed</h1>
                <p>Backend runs continue independently. Reload the interface to reconnect.</p>
                <button type="button" @onclick="Reload">Reload interface</button>
            </section>
        </ErrorContent>
    </WorkflowErrorBoundary>
</main>

@code {
    [Parameter] public string? ProjectId { get; set; }
    [SupplyParameterFromQuery(Name = "workflow")] public string? WorkflowId { get; set; }
    [CascadingParameter(Name = "RefreshProjectExplorer")] public Func<Task>? RefreshProjectExplorer { get; set; }

    [CascadingParameter(Name = "WorkflowSelected")] public Func<string, Task>? WorkflowSelection { get; set; }
    private Task SelectWorkflow(string id) => WorkflowSelection?.Invoke(id) ?? Task.CompletedTask;

    private StudioCatalogWorkflowInterfaceAuthoringSource? interfaceAuthoringSource;
    private IReadOnlyList<WorkflowInterfaceImplementationRevision> InterfaceImplementations =>
        interfaceAuthoringSource?.Implementations.Select(item => item.Revision).ToArray() ?? [];

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            ProjectWorkspace.Select(ProjectId);
            await RefreshWorkflowInterfaces();
        }
        catch (KeyNotFoundException) { Navigation.NavigateTo("/projects", forceLoad: true); }
    }

    private async Task OnWorkflowInterfacesSaved() => await RefreshWorkflowInterfaces();

    private async Task RefreshWorkflowInterfaces()
    {
        var drafts = await ProjectWorkspace.Catalog.ListDraftsAsync();
        var published = new List<PublishedWorkflowRevision>();
        foreach (var draft in drafts)
            published.AddRange(await ProjectWorkspace.Catalog.ListRevisionsAsync(draft.Definition.WorkflowId));
        interfaceAuthoringSource = new StudioCatalogWorkflowInterfaceAuthoringSource(ProjectWorkspace.Interfaces, published);
    }

    private void Reload() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
}
