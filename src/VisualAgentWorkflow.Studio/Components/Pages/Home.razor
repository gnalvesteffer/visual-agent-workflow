@page "/"
@page "/projects/{ProjectId}"
@rendermode InteractiveServer
@inject IToolBindingCatalog Tools
@inject IAgentProviderCatalog Agents
@inject StudioProjectWorkspace ProjectWorkspace
@inject NavigationManager Navigation

<PageTitle>Visual Agent Workflow</PageTitle>
<StudioNavigation />
<main>
    <WorkflowErrorBoundary>
        <ChildContent>
            <WorkflowStudio @key="ProjectWorkspace.CurrentProjectId" ProjectId="ProjectWorkspace.CurrentProjectId" Client="ProjectWorkspace.Client" Catalog="ProjectWorkspace.Catalog" ToolCatalog="Tools" AgentCatalog="Agents" SkillLibrary="ProjectWorkspace.Skills" AgentProfileLibrary="ProjectWorkspace.AgentProfiles" FunctionCatalog="ProjectWorkspace.Functions" />
        </ChildContent>
        <ErrorContent>
            <section class="vaw-viewer" role="alert">
                <h1>The workflow interface could not be displayed</h1>
                <p>Backend runs continue independently. Reload the interface to reconnect.</p>
                <button type="button" @onclick="Reload">Reload interface</button>
            </section>
        </ErrorContent>
    </WorkflowErrorBoundary>
</main>

@code {
    [Parameter] public string? ProjectId { get; set; }

    protected override void OnParametersSet()
    {
        try { ProjectWorkspace.Select(ProjectId); }
        catch (KeyNotFoundException) { Navigation.NavigateTo("/projects", forceLoad: true); }
    }

    private void Reload() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
}
