@page "/functions"
@page "/projects/{ProjectId}/functions"
@rendermode InteractiveServer
@using System.Collections.Immutable
@inject StudioProjectWorkspace ProjectWorkspace

<PageTitle>Function library · Visual Agent Workflow</PageTitle>
<StudioNavigation />
<main class="vaw-provider-settings">
    <header class="vaw-settings-heading"><div><h1>Function library</h1>
        <p class="vaw-settings-intro">Build reusable deterministic functions from typed graph nodes. Saved revisions are immutable; workflow nodes embed the exact snapshot they use.</p></div></header>

    @if (error is not null) { <p class="vaw-error" role="alert">@error</p> }
    @if (message is not null) { <p class="vaw-settings-status" role="status">@message</p> }

    <section class="vaw-settings-section" aria-label="Saved pure graph functions">
        <div class="vaw-settings-section-heading"><div><h2>Saved functions</h2><p>Each revision is content-hash pinned. Moving or deleting a library item does not alter workflow snapshots.</p></div><button type="button" class="vaw-primary" @onclick="NewFunction">New function</button></div>
        <div class="vaw-provider-list">
            @if (Library.ListAssets().Count == 0) { <p class="vaw-provider-empty">No functions yet. Create one to get started.</p> }
            @foreach (var asset in Library.ListAssets())
            {
                var item = asset.Item;
                <article class="vaw-provider-card" @key="(item.Function.Definition.FunctionId,item.Function.Definition.Version)">
                    <div class="vaw-provider-card-heading"><h3>@item.Function.Definition.DisplayName <small>@($"v{item.Function.Definition.Version}")</small></h3><code>@item.Function.ContentHash[..8]</code></div>
                    <p class="vaw-provider-identity"><code>@item.Function.Definition.FunctionId</code><span>@(string.IsNullOrWhiteSpace(item.Folder) ? "Unfiled" : item.Folder)</span><span>@item.Function.Definition.Inputs.Count inputs · @item.Function.Definition.Outputs.Count outputs</span></p>
                    @if (!string.IsNullOrWhiteSpace(item.Function.Definition.Description)) { <p>@item.Function.Definition.Description</p> }
                    <label>Folder <input aria-label="@($"Folder for {item.Function.Definition.FunctionId} v{item.Function.Definition.Version}")" value="@item.Folder" @onchange="args => Move(asset, args)" /></label>
                    <div class="vaw-provider-actions"><button type="button" class="vaw-secondary" @onclick="() => CopyForNewVersion(asset)">New version from this function</button><button type="button" class="vaw-danger-quiet" @onclick="() => Delete(asset)">Delete from library</button></div>
                </article>
            }
        </div>
    </section>

    <section class="vaw-settings-section" aria-label="Function graph editor">
        <div class="vaw-settings-section-heading"><div><h2>@(editingExisting ? "Create a new revision" : "Create a function")</h2><p>Connect typed data pins. Function bodies allow string, Boolean, and integer constants and operators; control flow and effects are not supported.</p></div></div>
        <div class="vaw-function-editor">
            <div class="vaw-function-metadata">
                <label>Function ID <input required maxlength="128" @bind="functionId" /></label>
                <label>Version <input type="number" min="1" @bind="version" /></label>
                <label>Display name <input required maxlength="160" @bind="displayName" /></label>
                <label>Folder <input maxlength="256" placeholder="Text/Formatting" @bind="folder" /></label>
                <label class="vaw-provider-form-wide">Description <textarea rows="2" maxlength="2000" @bind="description" placeholder="What does this function return?" /></label>
            </div>

            <details class="vaw-function-interface" open>
                <summary>Function interface <span class="vaw-help">@inputPorts.Count inputs · @outputPorts.Count outputs</span></summary>
                <div class="vaw-layout-columns">
                    <section aria-label="Function inputs"><h3>Inputs</h3>
                        @foreach (var (portId, port) in inputPorts)
                        {
                            <div class="vaw-function-port" @key="portId"><label>@portId name <input value="@port.DisplayName" maxlength="160" @onchange="args => RenamePort(true, portId, args)" /></label><label>Type <select value="@port.DataType" @onchange="args => UpdatePortType(true, portId, args)"><option value="string">String</option><option value="boolean">Boolean</option><option value="integer">Integer</option></select></label><button type="button" class="vaw-danger-quiet" aria-label="Remove input @port.DisplayName" @onclick="() => RemovePort(true, portId)">Remove</button></div>
                        }
                        <div class="vaw-function-add-port"><label>Input ID <input maxlength="128" @bind="newInputId" /></label><label>Name <input maxlength="160" @bind="newInputName" /></label><label>Type <select @bind="newInputType"><option value="string">String</option><option value="boolean">Boolean</option><option value="integer">Integer</option></select></label><button type="button" class="vaw-secondary" @onclick="() => AddPort(true)">Add input</button></div>
                    </section>
                    <section aria-label="Function outputs"><h3>Outputs</h3>
                        @foreach (var (portId, port) in outputPorts)
                        {
                            <div class="vaw-function-port" @key="portId"><label>@portId name <input value="@port.DisplayName" maxlength="160" @onchange="args => RenamePort(false, portId, args)" /></label><label>Type <select value="@port.DataType" @onchange="args => UpdatePortType(false, portId, args)"><option value="string">String</option><option value="boolean">Boolean</option><option value="integer">Integer</option></select></label><button type="button" class="vaw-danger-quiet" aria-label="Remove output @port.DisplayName" @onclick="() => RemovePort(false, portId)">Remove</button></div>
                        }
                        <div class="vaw-function-add-port"><label>Output ID <input maxlength="128" @bind="newOutputId" /></label><label>Name <input maxlength="160" @bind="newOutputName" /></label><label>Type <select @bind="newOutputType"><option value="string">String</option><option value="boolean">Boolean</option><option value="integer">Integer</option></select></label><button type="button" class="vaw-secondary" @onclick="() => AddPort(false)">Add output</button></div>
                    </section>
                </div>
            </details>

            <WorkflowGraphCanvas Definition="editor" Layout="layout" LayoutChanged="LayoutChanged" ConnectionRequested="Connect" ConnectionDisconnectRequested="Disconnect" DeleteNodeRequested="RemoveNode" SelectedNodeId="selectedNode" SelectedNodeIdChanged="SelectNode" EnableContextMenu="false" NodesLabel="Function graph nodes">
                <ToolbarContent><span class="vaw-help">Pure dataflow · changes save as a new immutable revision</span></ToolbarContent>
                <NodeLibrary>
                    <h3>Function nodes</h3>
                    <p class="vaw-help">Add a node, then drag a wire between matching typed pins.</p>
                    <button type="button" class="vaw-secondary" @onclick="() => AddValueNode(NodeTypes.StringConstant)">String constant</button>
                    <button type="button" class="vaw-secondary" @onclick="() => AddValueNode(NodeTypes.TextConcat)">Concatenate text</button>
                    <button type="button" class="vaw-secondary" @onclick="() => AddValueNode(NodeTypes.StringEquals)">Compare strings</button>
                    <button type="button" class="vaw-secondary" @onclick="() => AddValueNode(NodeTypes.BooleanConstant)">Boolean constant</button>
                    <button type="button" class="vaw-secondary" @onclick="() => AddValueNode(NodeTypes.BooleanNot)">Boolean NOT</button>
                    <button type="button" class="vaw-secondary" @onclick="() => AddValueNode(NodeTypes.IntegerConstant)">Integer constant</button>
                    <button type="button" class="vaw-secondary" @onclick="() => AddValueNode(NodeTypes.IntegerAdd)">Add integers</button>
                    <button type="button" class="vaw-secondary" @onclick="() => AddValueNode(NodeTypes.IntegerEquals)">Compare integers</button>
                </NodeLibrary>
                <NodeContent Context="nodeId">
                    @if (editor.Nodes.TryGetValue(nodeId, out var node) && node.Type == NodeTypes.StringConstant) { <span>@(node.StringConstant?.Value ?? "")</span> }
                    else if (node?.Type == NodeTypes.BooleanConstant) { <span>@(node.BooleanConstant?.Value == true ? "True" : "False")</span> }
                    else if (node?.Type == NodeTypes.IntegerConstant) { <span>@node.IntegerConstant?.Value</span> }
                    else if (node?.Type == NodeTypes.FunctionInput) { <span>Interface input · @node.OutputDataType</span> }
                    else if (node?.Type == NodeTypes.FunctionOutput) { <span>Interface output · @node.InputDataType</span> }
                    else if (node is not null) { <span>@NodeDescription(node)</span> }
                </NodeContent>
                <NodeInspector Context="nodeId">
                    @if (editor.Nodes.TryGetValue(nodeId, out var node) && node.Type == NodeTypes.StringConstant)
                    { <label>Constant value <textarea rows="4" maxlength="16384" value="@node.StringConstant?.Value" @onchange="args => SetStringConstant(nodeId, args)" /></label> }
                    else if (node?.Type == NodeTypes.BooleanConstant)
                    { <label>Constant value <select value="@node.BooleanConstant?.Value.ToString().ToLowerInvariant()" @onchange="args => SetBooleanConstant(nodeId, args)"><option value="true">True</option><option value="false">False</option></select></label> }
                    else if (node?.Type == NodeTypes.IntegerConstant)
                    { <label>Constant value <input type="text" inputmode="numeric" pattern="-?[0-9]+" value="@node.IntegerConstant?.Value" @onchange="args => SetIntegerConstant(nodeId, args)" /></label> }
                    else if (node?.Type is NodeTypes.FunctionInput or NodeTypes.FunctionOutput)
                    { <p class="vaw-help">This boundary is part of the function's declared interface. Change its name or type above.</p> }
                    else { <p class="vaw-help">This node is deterministic and has no additional settings.</p> }
                    <button type="button" class="vaw-danger-quiet" @onclick="() => RemoveNode(nodeId)">Remove node</button>
                </NodeInspector>
            </WorkflowGraphCanvas>

            @if (!functionIssues.IsEmpty)
            {
                <section class="vaw-graph-issues" aria-label="Function validation issues"><h3>Resolve these issues before saving</h3><ul>@foreach (var issue in functionIssues) { <li><strong>@issue.Path</strong> · @issue.Message</li> }</ul></section>
            }
            <div class="vaw-provider-form-actions"><button type="button" class="vaw-primary" @onclick="Save" disabled="@(!functionIssues.IsEmpty)">Save immutable function version</button><button type="button" class="vaw-secondary" @onclick="NewFunction">Discard editor changes</button></div>
        </div>
    </section>
</main>

@code {
    [Parameter] public string? ProjectId { get; set; }
    private StudioGraphFunctionLibrary Library => ProjectWorkspace.Functions;

    protected override void OnParametersSet() => ProjectWorkspace.Select(ProjectId);

    private ImmutableSortedDictionary<string, GraphFunctionPort> inputPorts = ImmutableSortedDictionary<string, GraphFunctionPort>.Empty.WithComparers(StringComparer.Ordinal);
    private ImmutableSortedDictionary<string, GraphFunctionPort> outputPorts = ImmutableSortedDictionary<string, GraphFunctionPort>.Empty.WithComparers(StringComparer.Ordinal);
    private WorkflowDefinition editor = default!;
    private WorkflowLayout layout = default!;
    private string functionId = "text.append-suffix";
    private int version = 1;
    private string displayName = "Append suffix";
    private string description = "Appends a fixed suffix to text.";
    private string folder = "Text";
    private string newInputId = "text";
    private string newInputName = "Text";
    private string newInputType = "string";
    private string newOutputId = "result";
    private string newOutputName = "Result";
    private string newOutputType = "string";
    private string? selectedNode;
    private string? error;
    private string? message;
    private bool editingExisting;
    private ImmutableArray<ValidationIssue> functionIssues => GraphFunctionJson.Validate(BuildFunction());

    protected override void OnInitialized() => NewFunction();

    private void NewFunction()
    {
        var savedIds = Library.List().Select(item => item.Function.Definition.FunctionId).ToHashSet(StringComparer.Ordinal);
        var suffixNumber = 1;
        functionId = "text.append-suffix";
        displayName = "Append suffix";
        while (savedIds.Contains(functionId))
        {
            suffixNumber++;
            functionId = $"text.append-suffix-{suffixNumber}";
            displayName = $"Append suffix {suffixNumber}";
        }
        version = 1;
        description = "Appends a fixed suffix to text."; folder = "Text"; editingExisting = false;
        inputPorts = ImmutableSortedDictionary<string, GraphFunctionPort>.Empty.WithComparers(StringComparer.Ordinal)
            .Add("text", new("Text", "string"));
        outputPorts = ImmutableSortedDictionary<string, GraphFunctionPort>.Empty.WithComparers(StringComparer.Ordinal)
            .Add("result", new("Result", "string"));
        var input = new NodeDefinition(NodeTypes.FunctionInput, "1.0.0") { FunctionPortId = "text", OutputDataType = "string" };
        var constant = new NodeDefinition(NodeTypes.StringConstant, "1.0.0") { StringConstant = new("!") };
        var concat = new NodeDefinition(NodeTypes.TextConcat, "1.0.0");
        var output = new NodeDefinition(NodeTypes.FunctionOutput, "1.0.0") { FunctionPortId = "result", InputDataType = "string" };
        editor = Draft(new Dictionary<string, NodeDefinition> { ["input"] = input, ["suffix"] = constant, ["concat"] = concat, ["output"] = output },
            new Dictionary<string, ConnectionDefinition>
            {
                ["argument"] = new(new("input", "out"), new("concat", "left"), "data"),
                ["suffix"] = new(new("suffix", "out"), new("concat", "right"), "data"),
                ["result"] = new(new("concat", "out"), new("output", "in"), "data")
            });
        layout = WorkflowLayout.Create(editor);
        SetBoundaryLabels();
        selectedNode = "input"; error = null; message = null;
    }

    private static WorkflowDefinition Draft(IReadOnlyDictionary<string, NodeDefinition> nodes,
        IReadOnlyDictionary<string, ConnectionDefinition> connections) => new(WorkflowSchemaVersions.PureGraphFunctions,
            "function-editor", nodes.Keys.First(), nodes.ToImmutableSortedDictionary(StringComparer.Ordinal),
            connections.ToImmutableSortedDictionary(StringComparer.Ordinal));

    private GraphFunctionDefinition BuildFunction() => new(functionId.Trim(), version, displayName.Trim(), description.Trim(),
        inputPorts, outputPorts, editor.Nodes, editor.Connections);

    private void LoadForEdit(StudioGraphFunctionAsset asset)
    {
        var item = asset.Item;
        var function = item.Function.Definition;
        functionId = function.FunctionId; version = function.Version + 1; displayName = function.DisplayName;
        description = function.Description; folder = item.Folder; inputPorts = function.Inputs; outputPorts = function.Outputs;
        editor = Draft(function.Nodes, function.Connections); layout = asset.Layout;
        SetBoundaryLabels();
        selectedNode = WorkflowGraph.DisplayOrder(editor).FirstOrDefault();
        editingExisting = true; error = null; message = "Editing a copy. Saving creates a new immutable revision.";
    }

    private void CopyForNewVersion(StudioGraphFunctionAsset asset) => LoadForEdit(asset);

    private Task AddValueNode(string type)
    {
        if (editor.Nodes.Count >= GraphFunctionLimits.MaximumNodes) { error = "The function graph is at its 64-node limit."; return Task.CompletedTask; }
        var node = type switch
        {
            NodeTypes.StringConstant => new NodeDefinition(type, "1.0.0") { StringConstant = new("") },
            NodeTypes.BooleanConstant => new NodeDefinition(type, "1.0.0") { BooleanConstant = new(false) },
            NodeTypes.IntegerConstant => new NodeDefinition(type, "1.0.0") { IntegerConstant = new(0) },
            _ => new NodeDefinition(type, "1.0.0")
        };
        var previousNodeIds = editor.Nodes.Keys.ToHashSet(StringComparer.Ordinal);
        editor = GraphEditing.AddUnconnectedNode(editor, node);
        layout = layout.Reconcile(editor);
        selectedNode = editor.Nodes.Keys.First(id => !previousNodeIds.Contains(id)); error = null;
        return Task.CompletedTask;
    }

    private Task AddPort(bool isInput)
    {
        var portId = (isInput ? newInputId : newOutputId).Trim();
        var portName = (isInput ? newInputName : newOutputName).Trim();
        var type = isInput ? newInputType : newOutputType;
        var ports = isInput ? inputPorts : outputPorts;
        if (ports.Count >= 16) { error = "Functions support at most 16 inputs and 16 outputs."; return Task.CompletedTask; }
        if (string.IsNullOrWhiteSpace(portId) || portId.Length > GraphFunctionLimits.MaximumIdLength ||
            portId.Any(character => !(char.IsAsciiLetterOrDigit(character) || character is '-' or '_')))
        { error = "Port IDs use letters, numbers, dashes, or underscores, up to 128 characters."; return Task.CompletedTask; }
        if (string.IsNullOrWhiteSpace(portName) || portName.Length > GraphFunctionLimits.MaximumDisplayNameLength)
        { error = "Enter a port name of 1–160 characters."; return Task.CompletedTask; }
        if (ports.ContainsKey(portId)) { error = "That port ID already exists."; return Task.CompletedTask; }
        var nodeId = $"{(isInput ? "input" : "output")}-{Guid.NewGuid():N}";
        var node = isInput
            ? new NodeDefinition(NodeTypes.FunctionInput, "1.0.0") { FunctionPortId = portId, OutputDataType = type }
            : new NodeDefinition(NodeTypes.FunctionOutput, "1.0.0") { FunctionPortId = portId, InputDataType = type };
        editor = editor with { Nodes = editor.Nodes.Add(nodeId, node) };
        if (isInput) inputPorts = inputPorts.Add(portId, new(portName, type));
        else outputPorts = outputPorts.Add(portId, new(portName, type));
        var reconciled = layout.Reconcile(editor);
        layout = reconciled with { Nodes = reconciled.Nodes.SetItem(nodeId, reconciled.Nodes[nodeId] with { Label = portName }) };
        selectedNode = nodeId; error = null;
        return Task.CompletedTask;
    }

    private Task RenamePort(bool isInput, string portId, ChangeEventArgs args)
    {
        var name = args.Value?.ToString()?.Trim() ?? "";
        var ports = isInput ? inputPorts : outputPorts;
        if (!ports.TryGetValue(portId, out var port)) return Task.CompletedTask;
        var updated = ports.SetItem(portId, port with { DisplayName = name });
        if (isInput) inputPorts = updated; else outputPorts = updated;
        var nodeType = isInput ? NodeTypes.FunctionInput : NodeTypes.FunctionOutput;
        var boundaryId = editor.Nodes.FirstOrDefault(pair => pair.Value.Type == nodeType && pair.Value.FunctionPortId == portId).Key;
        if (boundaryId is not null && layout.Nodes.TryGetValue(boundaryId, out var presentation))
            layout = layout with { Nodes = layout.Nodes.SetItem(boundaryId, presentation with { Label = name }) };
        return Task.CompletedTask;
    }

    private Task UpdatePortType(bool isInput, string portId, ChangeEventArgs args)
    {
        var type = args.Value?.ToString() ?? "string";
        if (type is not ("string" or "boolean" or "integer")) return Task.CompletedTask;
        var ports = isInput ? inputPorts : outputPorts;
        if (!ports.TryGetValue(portId, out var port)) return Task.CompletedTask;
        if (isInput) inputPorts = ports.SetItem(portId, port with { DataType = type });
        else outputPorts = ports.SetItem(portId, port with { DataType = type });
        var nodeType = isInput ? NodeTypes.FunctionInput : NodeTypes.FunctionOutput;
        var boundary = editor.Nodes.FirstOrDefault(pair => pair.Value.Type == nodeType && pair.Value.FunctionPortId == portId);
        if (boundary.Value is not null)
            editor = editor with { Nodes = editor.Nodes.SetItem(boundary.Key, isInput
                ? boundary.Value with { OutputDataType = type }
                : boundary.Value with { InputDataType = type }) };
        return Task.CompletedTask;
    }

    private void SetBoundaryLabels()
    {
        var nodes = layout.Nodes;
        foreach (var (id, node) in editor.Nodes)
        {
            var portName = node.Type == NodeTypes.FunctionInput && node.FunctionPortId is { } inputId && inputPorts.TryGetValue(inputId, out var input)
                ? input.DisplayName : node.Type == NodeTypes.FunctionOutput && node.FunctionPortId is { } outputId && outputPorts.TryGetValue(outputId, out var output)
                    ? output.DisplayName : null;
            if (portName is not null && nodes.TryGetValue(id, out var presentation))
                nodes = nodes.SetItem(id, presentation with { Label = portName });
        }
        layout = layout with { Nodes = nodes };
    }

    private Task RemovePort(bool isInput, string portId)
    {
        var nodeType = isInput ? NodeTypes.FunctionInput : NodeTypes.FunctionOutput;
        var boundary = editor.Nodes.FirstOrDefault(pair => pair.Value.Type == nodeType && pair.Value.FunctionPortId == portId).Key;
        if (boundary is not null) RemoveNode(boundary);
        if (isInput) inputPorts = inputPorts.Remove(portId); else outputPorts = outputPorts.Remove(portId);
        error = null;
        return Task.CompletedTask;
    }

    private Task Connect((string SourceId, string SourcePort, string TargetId, string TargetPort) pins)
    {
        try { editor = GraphEditing.ConnectPins(editor, pins.SourceId, pins.SourcePort, pins.TargetId, pins.TargetPort); layout = layout.Reconcile(editor); error = null; }
        catch (ArgumentException exception) { error = exception.Message; }
        return Task.CompletedTask;
    }

    private Task Disconnect(string connectionId)
    {
        editor = GraphEditing.Disconnect(editor, connectionId); layout = layout.Reconcile(editor); error = null;
        return Task.CompletedTask;
    }

    private Task RemoveNode(string id)
    {
        if (!editor.Nodes.TryGetValue(id, out var node)) return Task.CompletedTask;
        editor = editor with
        {
            Nodes = editor.Nodes.Remove(id),
            Connections = editor.Connections.RemoveRange(editor.Connections.Where(edge => edge.Value.Source.NodeId == id || edge.Value.Target.NodeId == id).Select(edge => edge.Key))
        };
        if (node.Type == NodeTypes.FunctionInput && node.FunctionPortId is { } inputId) inputPorts = inputPorts.Remove(inputId);
        if (node.Type == NodeTypes.FunctionOutput && node.FunctionPortId is { } outputId) outputPorts = outputPorts.Remove(outputId);
        layout = layout.Reconcile(editor); selectedNode = WorkflowGraph.DisplayOrder(editor).FirstOrDefault(); error = null;
        return Task.CompletedTask;
    }

    private Task SelectNode(string id) { selectedNode = id; return Task.CompletedTask; }
    private Task LayoutChanged(WorkflowLayout changed) { layout = changed; return Task.CompletedTask; }

    private Task SetStringConstant(string id, ChangeEventArgs args)
    {
        editor = editor with { Nodes = editor.Nodes.SetItem(id, editor.Nodes[id] with { StringConstant = new(args.Value?.ToString() ?? "") }) };
        return Task.CompletedTask;
    }

    private Task SetBooleanConstant(string id, ChangeEventArgs args)
    {
        var value = bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;
        editor = editor with { Nodes = editor.Nodes.SetItem(id, editor.Nodes[id] with { BooleanConstant = new(value) }) };
        return Task.CompletedTask;
    }

    private Task SetIntegerConstant(string id, ChangeEventArgs args)
    {
        if (!long.TryParse(args.Value?.ToString(), System.Globalization.NumberStyles.AllowLeadingSign,
                System.Globalization.CultureInfo.InvariantCulture, out var value))
        { error = "Enter a signed 64-bit integer."; return Task.CompletedTask; }
        editor = editor with { Nodes = editor.Nodes.SetItem(id, editor.Nodes[id] with { IntegerConstant = new(value) }) };
        error = null;
        return Task.CompletedTask;
    }

    private string NodeDescription(NodeDefinition node) => node.Type switch
    {
        NodeTypes.TextConcat => "Join left + right",
        NodeTypes.StringEquals => "Ordinal string equality",
        NodeTypes.BooleanNot => "Invert Boolean value",
        NodeTypes.IntegerAdd => "Checked integer addition",
        NodeTypes.IntegerEquals => "Integer equality",
        _ => "Pure function node"
    };

    private void Save()
    {
        try
        {
            Library.Add(BuildFunction(), folder.Trim(), layout);
            message = $"Saved {displayName} v{version} as an immutable function revision."; error = null;
            editingExisting = true;
        }
        catch (Exception exception) when (exception is ArgumentException or InvalidOperationException)
        { error = exception.Message; message = null; }
    }

    private void Move(StudioGraphFunctionAsset asset, ChangeEventArgs args)
    {
        var item = asset.Item;
        try { Library.Move(item.Function.Definition.FunctionId, item.Function.Definition.Version, args.Value?.ToString() ?? ""); error = null; }
        catch (ArgumentException exception) { error = exception.Message; }
    }

    private void Delete(StudioGraphFunctionAsset asset)
    {
        var item = asset.Item;
        Library.Delete(item.Function.Definition.FunctionId, item.Function.Definition.Version);
        message = "Removed from the local library. Workflow definitions keep their embedded function snapshots."; error = null;
    }
}
