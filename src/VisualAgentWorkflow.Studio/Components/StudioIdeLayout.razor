@inherits LayoutComponentBase
@implements IDisposable
@inject StudioProjectWorkspace ProjectWorkspace
@inject StudioProjectStore ProjectStore
@inject StudioOpenWorkspaceStore OpenWorkspace
@inject NavigationManager Navigation
@inject IJSRuntime JavaScript

<div class="vaw-app-shell">
    <header class="vaw-ide-titlebar" aria-label="Visual Agent Workflow Studio">
        <a class="vaw-ide-brand" href="/" aria-label="Studio home" data-vaw-route-link>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 18V6h5l4 5 4-5h5v12h-5v-5l-4 5-4-5v5z" /></svg>
        </a>
        <span class="vaw-ide-product-name">Visual Agent Workflow Studio</span>
        <span class="vaw-ide-title-separator" aria-hidden="true"></span>
        <StudioProjectPicker Projects="ProjectWorkspace.Projects" SelectedProjectId="@SelectedProjectId" Selected="ChangeProject" />
        <nav class="vaw-ide-title-actions" aria-label="Studio settings and theme">
            <details class="vaw-host-settings">
                <summary aria-label="Studio settings">Studio settings</summary>
                <div class="vaw-host-settings-menu" aria-label="User-specific connections">
                    <a href="/mcp" aria-current="@(ActivePage == "mcp" ? "page" : null)" data-vaw-route-link>MCP connections</a>
                    <a href="/settings" aria-current="@(ActivePage == "models" ? "page" : null)" data-vaw-route-link>Model connections</a>
                    <button type="button" @onclick="ResetLayout">Reset editor layout</button>
                </div>
            </details>
            <StudioThemePicker />
        </nav>
    </header>
    <div class="vaw-global-ide-layout @(IsFolderWorkspace ? "vaw-folder-ide-layout" : null)">
        <nav class="vaw-ide-activitybar" aria-label="Studio views">
            <a href="@WorkflowRoute" class="@(ActivePage == "workflow" ? "is-active" : null)" aria-current="@(ActivePage == "workflow" ? "page" : null)" aria-label="Explorer" title="Workflow editor" data-vaw-route-link><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5.5h7l2 2h9v11H3zM3 8h18" /></svg><span>Explorer</span></a>
            <a href="/agents" class="@(ActivePage == "agents" ? "is-active" : null)" aria-current="@(ActivePage == "agents" ? "page" : null)" aria-label="Agents" title="Agent library" data-vaw-route-link><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3"/><path d="M5 20c.5-4 2.8-6 7-6s6.5 2 7 6"/></svg><span>Agents</span></a>
            <a href="/skills" class="@(ActivePage == "skills" ? "is-active" : null)" aria-current="@(ActivePage == "skills" ? "page" : null)" aria-label="Skills" title="Skill library" data-vaw-route-link><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h10l4 4v14H5zM14 3v5h5M8 13h8m-8 4h6"/></svg><span>Skills</span></a>
            <a href="/functions" class="@(ActivePage == "functions" ? "is-active" : null)" aria-current="@(ActivePage == "functions" ? "page" : null)" aria-label="Functions" title="Function library" data-vaw-route-link><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5-6 7 6 7m8-14 6 7-6 7m-2-16-4 18"/></svg><span>Functions</span></a>
            <a href="/observe" class="@(ActivePage == "observe" ? "is-active" : null)" aria-current="@(ActivePage == "observe" ? "page" : null)" aria-label="Observe" title="Run history" data-vaw-route-link><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 2.6-6.4L3 8m0-5v5h5m4-1v5l4 2"/></svg><span>Observe</span></a>
        </nav>
        @if (!IsFolderWorkspace)
        {
            <aside class="vaw-global-explorer" aria-label="Project explorer" tabindex="0" @oncontextmenu="args => OpenExplorerContext(args, string.Empty)" @oncontextmenu:preventDefault="true">
                <header><strong>EXPLORER</strong><span><button type="button" @onclick="RefreshExplorer" title="Refresh project files" aria-label="Refresh project files"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 7v5h-5M4 17v-5h5M5.5 9A7 7 0 0 1 18 6.5L20 12M4 12l2 5.5A7 7 0 0 0 18.5 15" /></svg></button><a href="/source-project" title="Open a folder project" data-vaw-route-link>Open folder</a></span></header>
                @if (!string.IsNullOrWhiteSpace(explorerError)) { <p role="status" class="vaw-explorer-status">@explorerError</p> }
                <div class="vaw-project-tree-filter vaw-global-explorer-filter">
                    <label class="vaw-sr-only" for="catalog-file-filter">Filter project files</label>
                    <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5"/><path d="m13 13 4 4"/></svg>
                    <input id="catalog-file-filter" type="search" placeholder="Filter files…" @bind="explorerFilter" @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(explorerFilter))
                    { <button type="button" aria-label="Clear file filter" title="Clear filter" @onclick="() => explorerFilter = string.Empty">×</button> }
                </div>
                <div class="vaw-explorer-tree">
                    <p class="vaw-explorer-project">⌄ <span>@ProjectWorkspace.CurrentProjectName</span></p>
                    @if (VisibleWorkflows.Count > 0 || string.IsNullOrWhiteSpace(explorerFilter))
                    {
                    <details open @oncontextmenu='args => OpenExplorerContext(args, "workflows")' @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">
                        <summary>workflows/</summary>
                        @foreach (var workflow in VisibleWorkflows)
                        {
                            var selected = workflow.Definition.WorkflowId == selectedWorkflowId;
                            <button type="button" class="vaw-explorer-file @(selected ? "is-selected" : null)" data-workflow-id="@workflow.Definition.WorkflowId" aria-current="@(selected ? "page" : null)" @onclick="() => SelectWorkflow(workflow.Definition.WorkflowId)" @oncontextmenu="args => OpenWorkflowContext(args, workflow)" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true" title="@workflow.Definition.WorkflowId"><StudioFileIcon Kind="workflow"/><span class="vaw-explorer-file-name">@(WorkflowName(workflow.Definition) + ".workflow")</span></button>
                        }
                        @if (workflows.Count == 0) { <span class="vaw-explorer-empty">No saved workflows</span> }
                    </details>
                    }
                    @if (VisibleProfiles.Count > 0 || string.IsNullOrWhiteSpace(explorerFilter))
                    { <details open="@(!string.IsNullOrWhiteSpace(explorerFilter))" @oncontextmenu='args => OpenExplorerContext(args, "agents")' @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">
                        <summary>agents/</summary>
                        @foreach (var profile in VisibleProfiles) { <a class="vaw-explorer-file" href="@($"/projects/{Uri.EscapeDataString(SelectedProjectId)}/agents")" data-vaw-route-link><StudioFileIcon Kind="agent" />@(profile.Profile.Name + ".agent")</a> }
                        @if (profiles.Count == 0) { <span class="vaw-explorer-empty">No agent profiles</span> }
                    </details> }
                    @if (VisibleSkills.Count > 0 || string.IsNullOrWhiteSpace(explorerFilter))
                    { <details open="@(!string.IsNullOrWhiteSpace(explorerFilter))" @oncontextmenu='args => OpenExplorerContext(args, "skills")' @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">
                        <summary>skills/</summary>
                        @foreach (var skill in VisibleSkills) { <a class="vaw-explorer-file" href="@($"/projects/{Uri.EscapeDataString(SelectedProjectId)}/skills")" data-vaw-route-link><StudioFileIcon Kind="skill" />@(skill.Skill.Name + ".skill")</a> }
                        @if (skills.Count == 0) { <span class="vaw-explorer-empty">No skills</span> }
                    </details> }
                    @if (VisibleFunctions.Count > 0 || string.IsNullOrWhiteSpace(explorerFilter))
                    { <details open="@(!string.IsNullOrWhiteSpace(explorerFilter))" @oncontextmenu='args => OpenExplorerContext(args, "functions")' @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">
                        <summary>functions/</summary>
                        @foreach (var function in VisibleFunctions) { <a class="vaw-explorer-file" href="@($"/projects/{Uri.EscapeDataString(SelectedProjectId)}/functions")" data-vaw-route-link><StudioFileIcon Kind="function" />@(function.Function.Definition.FunctionId + ".function")</a> }
                        @if (functions.Count == 0) { <span class="vaw-explorer-empty">No functions</span> }
                    </details> }
                    @if (string.IsNullOrWhiteSpace(explorerFilter) || "vaw.project.json".Contains(explorerFilter.Trim(), StringComparison.OrdinalIgnoreCase))
                    { <button type="button" class="vaw-explorer-file vaw-explorer-manifest" title="Project metadata"><StudioFileIcon Kind="file" />vaw.project.json</button> }
                    @if (!string.IsNullOrWhiteSpace(explorerFilter) && VisibleWorkflows.Count + VisibleProfiles.Count + VisibleSkills.Count + VisibleFunctions.Count == 0 && !"vaw.project.json".Contains(explorerFilter.Trim(), StringComparison.OrdinalIgnoreCase))
                    { <p class="vaw-explorer-empty" role="status">No files match “@explorerFilter”.</p> }
                </div>
            </aside>
        }
        @if (explorerContext is not null)
        {
            <div class="vaw-tree-menu-backdrop" @onclick="CloseExplorerContext" @onkeydown="ExplorerMenuKey" @oncontextmenu="OpenContextFromBackdrop" @oncontextmenu:preventDefault="true">
                <div class="vaw-tree-context-menu" role="menu" aria-label="Project actions" tabindex="-1" @ref="explorerMenuElement" @onclick:stopPropagation="true">
                    @if (contextWorkflow is not null)
                    {
                        <p class="vaw-tree-menu-heading">@(WorkflowName(contextWorkflow.Definition) + ".workflow")</p>
                        @if (workflowMenuMode == "rename")
                        {
                            <div class="vaw-tree-menu-form">
                                <label for="workflow-context-name">New workflow name</label>
                                <input id="workflow-context-name" @bind="workflowMenuName" @bind:event="oninput" maxlength="@WorkflowMetadataEditing.MaximumDisplayNameLength" @onkeydown="WorkflowMenuInputKey" />
                                <button type="button" role="menuitem" @onclick="RenameContextWorkflow">Rename workflow</button>
                                <button type="button" role="menuitem" @onclick="CancelWorkflowMenuAction">Cancel</button>
                            </div>
                        }
                        else if (workflowMenuMode == "delete")
                        {
                            <div class="vaw-tree-menu-form">
                                <p>This moves the workflow to Deleted workflows. Published revisions and run history are retained.</p>
                                <button type="button" class="is-danger" role="menuitem" @onclick="ArchiveContextWorkflow">Delete workflow</button>
                                <button type="button" role="menuitem" @onclick="CancelWorkflowMenuAction">Cancel</button>
                            </div>
                        }
                        else
                        {
                            <button type="button" role="menuitem" @onclick="OpenContextWorkflow">Open</button>
                            <button type="button" role="menuitem" @onclick="DuplicateContextWorkflow">Duplicate</button>
                            <button type="button" role="menuitem" @onclick="CopyContextWorkflow">Copy</button>
                            <button type="button" role="menuitem" @onclick="BeginWorkflowRename">Rename</button>
                            <button type="button" class="is-danger" role="menuitem" @onclick="BeginWorkflowDelete">Delete</button>
                        }
                        @if (!string.IsNullOrWhiteSpace(workflowMenuError)) { <p class="vaw-tree-menu-error" role="alert">@workflowMenuError</p> }
                    }
                    else if (explorerContext.Length == 0)
                    {
                        <button type="button" role="menuitem" aria-expanded="@explorerCreateOpen" @onclick="() => explorerCreateOpen = !explorerCreateOpen">New file <span aria-hidden="true">›</span></button>
                        @if (explorerCreateOpen)
                        {
                            <div class="vaw-tree-submenu">
                                <button type="button" role="menuitem" @onclick="CreateExplorerWorkflow">Workflow</button>
                                <button type="button" role="menuitem" @onclick='() => OpenExplorerLibrary("agents")'>Agent profile…</button>
                                <button type="button" role="menuitem" @onclick='() => OpenExplorerLibrary("skills")'>Skill…</button>
                                <button type="button" role="menuitem" @onclick='() => OpenExplorerLibrary("functions")'>Function…</button>
                            </div>
                        }
                    }
                    else if (explorerContext == "workflows")
                    {
                        <p class="vaw-tree-menu-heading">workflows/</p>
                        <button type="button" role="menuitem" @onclick="CreateExplorerWorkflow">New workflow</button>
                        @if (workflowClipboard is not null)
                        { <button type="button" role="menuitem" @onclick="PasteWorkflowCopy">Paste workflow</button> }
                        @if (archivedWorkflows.Count > 0)
                        {
                            <button type="button" role="menuitem" aria-expanded="@restoreMenuOpen" @onclick="() => restoreMenuOpen = !restoreMenuOpen">Deleted workflows <span aria-hidden="true">›</span></button>
                            @if (restoreMenuOpen)
                            {
                                <div class="vaw-tree-submenu">
                                    @foreach (var archived in archivedWorkflows)
                                    {
                                        <button type="button" role="menuitem" @onclick="() => RestoreArchivedWorkflow(archived)">Restore @(WorkflowName(archived.Definition)).workflow</button>
                                    }
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <p class="vaw-tree-menu-heading">@explorerContext/</p>
                        <button type="button" role="menuitem" @onclick="() => OpenExplorerLibrary(explorerContext)">@(explorerContext == "agents" ? "New agent profile…" : explorerContext == "skills" ? "New skill…" : "New function…")</button>
                    }
                    @if (contextWorkflow is null)
                    {
                        <button type="button" role="menuitem" @onclick="RefreshExplorerContext">Refresh Explorer</button>
                        <button type="button" role="menuitem" @onclick="OpenFolderContext">Open folder project…</button>
                        <p class="vaw-tree-menu-heading">Open a folder project for folders and Markdown files.</p>
                    }
                </div>
            </div>
        }
        <section class="vaw-ide-route-workspace" aria-label="Studio workspace">
            <div class="vaw-ide-route-heading" hidden="@(ActivePage == "workflow" && routeStatus is null)"><span>@CurrentViewName</span>@if (!string.IsNullOrWhiteSpace(routeStatus)) { <span role="status">@routeStatus</span> }</div>
            <div class="vaw-ide-route-content">
                <CascadingValue Name="RefreshProjectExplorer" Value="@((Func<Task>)RefreshExplorer)">
                    <CascadingValue Name="WorkflowSelected" Value="@((Func<string, Task>)WorkflowSelectionChanged)">
                        @Body
                    </CascadingValue>
                </CascadingValue>
            </div>
        </section>
    </div>
</div>

@code {
    private async Task ResetLayout() => await JavaScript.InvokeVoidAsync("vawStudioIde.resetLayout");
    private IReadOnlyList<WorkflowDraft> workflows = [];
    private IReadOnlyList<AgentProfileLibraryItem> profiles = [];
    private IReadOnlyList<SkillLibraryItem> skills = [];
    private IReadOnlyList<GraphFunctionCatalogEntry> functions = [];
    private IReadOnlyList<WorkflowDraft> archivedWorkflows = [];
    private string? selectedWorkflowId;
    private DotNetObjectReference<StudioIdeLayout>? selfReference;
    private string? explorerError;
    private string explorerFilter = "";
    private string? routeStatus;
    private string? loadedExplorerProjectId;
    private bool disposed;
    private string? explorerContext;
    private double explorerMenuX, explorerMenuY;
    private bool explorerCreateOpen, focusExplorerMenu;
    private bool restoreMenuOpen;
    private string? contextWorkflowId;
    private string? workflowMenuMode;
    private string workflowMenuName = "";
    private string? workflowMenuError;
    private WorkflowDesign? workflowClipboard;
    private ElementReference explorerMenuElement;
    private List<WorkflowDraft> VisibleWorkflows => workflows.Where(item => MatchesExplorerFilter(WorkflowName(item.Definition), item.Definition.WorkflowId)).ToList();
    private List<AgentProfileLibraryItem> VisibleProfiles => profiles.Where(item => MatchesExplorerFilter(item.Profile.Name, item.Profile.Id)).ToList();
    private List<SkillLibraryItem> VisibleSkills => skills.Where(item => MatchesExplorerFilter(item.Skill.Name, item.Skill.Id)).ToList();
    private List<GraphFunctionCatalogEntry> VisibleFunctions => functions.Where(item => MatchesExplorerFilter(item.Function.Definition.FunctionId, item.Function.Definition.DisplayName)).ToList();
    private WorkflowDraft? contextWorkflow => workflows.FirstOrDefault(item => item.Definition.WorkflowId == contextWorkflowId);
    private bool MatchesExplorerFilter(params string?[] values) => string.IsNullOrWhiteSpace(explorerFilter)
        || values.Any(value => value?.Contains(explorerFilter.Trim(), StringComparison.OrdinalIgnoreCase) == true);

    private void OpenExplorerContext(Microsoft.AspNetCore.Components.Web.MouseEventArgs args, string category)
    {
        explorerContext = category;
        explorerMenuX = args.ClientX; explorerMenuY = args.ClientY;
        contextWorkflowId = null; workflowMenuMode = null; workflowMenuError = null;
        explorerCreateOpen = false; restoreMenuOpen = false; focusExplorerMenu = true;
    }
    private void OpenWorkflowContext(Microsoft.AspNetCore.Components.Web.MouseEventArgs args, WorkflowDraft workflow)
    {
        OpenExplorerContext(args, "workflows");
        contextWorkflowId = workflow.Definition.WorkflowId;
    }
    private async Task OpenContextFromBackdrop(Microsoft.AspNetCore.Components.Web.MouseEventArgs args)
    {
        var target = await JavaScript.InvokeAsync<ExplorerContextTarget?>("vawStudioIde.getExplorerContextTargetAt", args.ClientX, args.ClientY);
        if (target?.Category == "workflow" && target.WorkflowId is { } id && workflows.FirstOrDefault(item => item.Definition.WorkflowId == id) is { } workflow)
        {
            OpenWorkflowContext(args, workflow);
            return;
        }
        if (target?.Category is { } category)
        {
            OpenExplorerContext(args, category);
            return;
        }
        CloseExplorerContext();
    }
    private void CloseExplorerContext()
    {
        explorerContext = null; contextWorkflowId = null; workflowMenuMode = null; workflowMenuError = null;
    }
    private void ExplorerMenuKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args)
    { if (args.Key == "Escape") CloseExplorerContext(); }
    private async Task RefreshExplorerContext() { CloseExplorerContext(); await RefreshExplorer(); }
    private void OpenFolderContext() { CloseExplorerContext(); Navigation.NavigateTo("/source-project"); }
    private void OpenContextWorkflow()
    {
        if (contextWorkflowId is not { } id) return;
        var target = id;
        CloseExplorerContext();
        _ = SelectWorkflow(target);
    }
    private void BeginWorkflowRename()
    {
        if (contextWorkflow is not { } workflow) return;
        workflowMenuName = WorkflowName(workflow.Definition);
        workflowMenuMode = "rename"; focusExplorerMenu = true;
    }
    private void BeginWorkflowDelete()
    { workflowMenuMode = "delete"; focusExplorerMenu = true; }
    private void CancelWorkflowMenuAction()
    { workflowMenuMode = null; workflowMenuError = null; }
    private void WorkflowMenuInputKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args)
    {
        if (args.Key == "Escape") CloseExplorerContext();
        else if (args.Key == "Enter") _ = RenameContextWorkflow();
    }
    private async Task<bool> CheckWorkflowEditorClean(string workflowId)
    {
        if (ActivePage != "workflow" || selectedWorkflowId != workflowId) return true;
        try
        {
            var dirty = await JavaScript.InvokeAsync<bool>("vawStudioIde.hasUnsavedWorkflow");
            if (!dirty) return true;
            workflowMenuError = "Save or discard the open workflow before changing Explorer files.";
            return false;
        }
        catch (Microsoft.JSInterop.JSDisconnectedException) { workflowMenuError = "The editor is reconnecting. Try again when it is ready."; return false; }
    }
    private async Task RenameContextWorkflow()
    {
        var source = contextWorkflow;
        if (source is null || !await CheckWorkflowEditorClean(source.Definition.WorkflowId)) return;
        try
        {
            if (ProjectWorkspace.Catalog is not IWorkflowDesignCatalog designCatalog)
                throw new InvalidOperationException("This project does not support workflow design file operations.");
            var current = await designCatalog.GetDesignAsync(source.Definition.WorkflowId)
                ?? throw new KeyNotFoundException("The workflow no longer exists. Refresh Explorer and try again.");
            var renamed = WorkflowMetadataEditing.Rename(current.Draft.Definition, workflowMenuName);
            if (renamed == current.Draft.Definition) { CloseExplorerContext(); return; }
            await designCatalog.SaveDesignAsync(renamed, current.Layout, current.Draft.Generation);
            var id = renamed.WorkflowId;
            CloseExplorerContext();
            await RefreshExplorer();
            if (selectedWorkflowId == id && ActivePage == "workflow")
                await JavaScript.InvokeVoidAsync("vawStudioIde.selectWorkflow", id);
            routeStatus = "Workflow renamed.";
        }
        catch (Exception exception) when (exception is ArgumentException or InvalidOperationException or KeyNotFoundException or WorkflowConflictException or IOException)
        { workflowMenuError = exception is WorkflowConflictException ? "This workflow changed elsewhere. Refresh Explorer and try again." : exception.Message; }
    }
    private async Task DuplicateContextWorkflow()
    {
        var source = contextWorkflow;
        if (source is null || !await CheckWorkflowEditorClean(source.Definition.WorkflowId)) return;
        try
        {
            if (ProjectWorkspace.Catalog is not IWorkflowDesignCatalog designCatalog)
                throw new InvalidOperationException("This project does not support workflow design file operations.");
            var current = await designCatalog.GetDesignAsync(source.Definition.WorkflowId)
                ?? throw new KeyNotFoundException("The workflow no longer exists. Refresh Explorer and try again.");
            await CreateWorkflowCopy(current);
        }
        catch (Exception exception) when (exception is ArgumentException or InvalidOperationException or KeyNotFoundException or WorkflowConflictException or IOException)
        { workflowMenuError = exception.Message; }
    }
    private async Task CopyContextWorkflow()
    {
        var source = contextWorkflow;
        if (source is null || !await CheckWorkflowEditorClean(source.Definition.WorkflowId)) return;
        try
        {
            if (ProjectWorkspace.Catalog is not IWorkflowDesignCatalog designCatalog)
                throw new InvalidOperationException("This project does not support workflow file operations.");
            workflowClipboard = await designCatalog.GetDesignAsync(source.Definition.WorkflowId)
                ?? throw new KeyNotFoundException("The workflow no longer exists. Refresh Explorer and try again.");
            var name = WorkflowName(workflowClipboard.Draft.Definition);
            CloseExplorerContext();
            routeStatus = $"Copied {name}. Right-click workflows/ and choose Paste workflow.";
        }
        catch (Exception exception) when (exception is ArgumentException or InvalidOperationException or KeyNotFoundException or IOException)
        { workflowMenuError = exception.Message; }
    }
    private async Task PasteWorkflowCopy()
    {
        if (workflowClipboard is null) return;
        try { await CreateWorkflowCopy(workflowClipboard); }
        catch (Exception exception) when (exception is ArgumentException or InvalidOperationException or KeyNotFoundException or IOException)
        { workflowMenuError = exception.Message; }
    }
    private async Task CreateWorkflowCopy(WorkflowDesign source)
    {
        if (ProjectWorkspace.Catalog is not IWorkflowDesignCatalog designCatalog)
            throw new InvalidOperationException("This project does not support workflow file operations.");
        var copyId = "workflow-" + Guid.NewGuid().ToString("N");
        var sourceName = WorkflowName(source.Draft.Definition);
        var copyName = (sourceName + " copy")[..Math.Min(sourceName.Length + 5, WorkflowMetadataEditing.MaximumDisplayNameLength)];
        var copyDefinition = WorkflowMetadataEditing.Rename(source.Draft.Definition with { WorkflowId = copyId }, copyName);
        await designCatalog.SaveDesignAsync(copyDefinition, source.Layout, expectedGeneration: 0);
        workflowClipboard = null;
        CloseExplorerContext();
        await RefreshExplorer();
        routeStatus = "Workflow duplicated as a new draft.";
        Navigation.NavigateTo($"{WorkflowRoute}?workflow={Uri.EscapeDataString(copyId)}");
    }
    private async Task ArchiveContextWorkflow()
    {
        var source = contextWorkflow;
        if (source is null || !await CheckWorkflowEditorClean(source.Definition.WorkflowId)) return;
        try
        {
            await ProjectWorkspace.CatalogFileOperations.ArchiveWorkflowAsync(source.Definition.WorkflowId, source.Generation);
            var wasSelected = selectedWorkflowId == source.Definition.WorkflowId;
            CloseExplorerContext();
            await RefreshExplorer();
            routeStatus = "Workflow moved to Deleted workflows. Revisions and run history were retained.";
            if (wasSelected && ActivePage == "workflow")
            {
                if (workflows.FirstOrDefault() is { } next)
                {
                    var result = await JavaScript.InvokeAsync<int>("vawStudioIde.selectWorkflow", next.Definition.WorkflowId);
                    if (result == 0) Navigation.NavigateTo($"{WorkflowRoute}?workflow={Uri.EscapeDataString(next.Definition.WorkflowId)}");
                }
                else await JavaScript.InvokeAsync<int>("vawStudioIde.createWorkflow");
            }
        }
        catch (Exception exception) when (exception is ArgumentException or InvalidOperationException or KeyNotFoundException or WorkflowConflictException or IOException)
        { workflowMenuError = exception is WorkflowConflictException ? "This workflow changed elsewhere. Refresh Explorer and try again." : exception.Message; }
    }
    private async Task RestoreArchivedWorkflow(WorkflowDraft archived)
    {
        try
        {
            await ProjectWorkspace.CatalogFileOperations.RestoreArchivedWorkflowAsync(archived.Definition.WorkflowId, archived.Generation);
            CloseExplorerContext();
            await RefreshExplorer();
            routeStatus = "Workflow restored.";
        }
        catch (Exception exception) when (exception is ArgumentException or InvalidOperationException or KeyNotFoundException or WorkflowConflictException or IOException)
        { workflowMenuError = exception.Message; }
    }
    private void OpenExplorerLibrary(string category)
    {
        CloseExplorerContext();
        Navigation.NavigateTo($"/projects/{Uri.EscapeDataString(SelectedProjectId)}/{category}#create-{category}");
    }
    private async Task CreateExplorerWorkflow()
    {
        CloseExplorerContext();
        if (ActivePage != "workflow") { Navigation.NavigateTo(WorkflowRoute); return; }
        var result = await JavaScript.InvokeAsync<int>("vawStudioIde.createWorkflow");
        if (result < 0) routeStatus = "Save or discard your edits before creating another workflow.";
        else if (result == 0) Navigation.NavigateTo(WorkflowRoute);
    }
    private string SelectedProjectId => IsFolderWorkspace && OpenWorkspace.SelectedProjectId is { } folderId ? folderId : ProjectWorkspace.CurrentProjectId;
    private string SelectedProjectName => ProjectStore.GetActive(SelectedProjectId).Name;
    private string WorkflowRoute => ProjectStore.GetActive(SelectedProjectId).IsFolderBacked
        ? $"/source-project/folder/{Uri.EscapeDataString(SelectedProjectId)}"
        : $"/projects/{Uri.EscapeDataString(SelectedProjectId)}";
    private string PathName => new Uri(Navigation.Uri).AbsolutePath.Trim('/');
    private string ActivePage => PathName.EndsWith("/agents", StringComparison.Ordinal) || PathName == "agents" ? "agents"
        : PathName.EndsWith("/skills", StringComparison.Ordinal) || PathName == "skills" ? "skills"
        : PathName.EndsWith("/functions", StringComparison.Ordinal) || PathName == "functions" ? "functions"
        : PathName == "mcp" ? "mcp" : PathName == "observe" ? "observe"
        : PathName == "projects" ? "projects" : PathName == "settings" ? "models" : "workflow";
    private bool IsFolderWorkspace => PathName.StartsWith("source-project", StringComparison.Ordinal);
    private string CurrentViewName => ActivePage switch { "agents" => "Agent library", "skills" => "Skill library", "functions" => "Function library", "mcp" => "MCP connections", "observe" => "Run history", "projects" => "Projects", "models" => "Model connections", _ => "Workflow" };

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += LocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            selfReference = DotNetObjectReference.Create(this);
            try
            {
                await JavaScript.InvokeVoidAsync("vawStudioIde.subscribeWorkflowSelection", selfReference);
                selectedWorkflowId = await JavaScript.InvokeAsync<string?>("vawStudioIde.getSelectedWorkflow");
            }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
        }
        if (explorerContext is not null)
        {
            await JavaScript.InvokeVoidAsync("vawStudioIde.layoutExplorerMenu", explorerMenuElement, explorerMenuX, explorerMenuY, focusExplorerMenu);
            focusExplorerMenu = false;
        }
        if (firstRender || !IsFolderWorkspace) await LoadExplorerAsync();
    }

    private async Task LoadExplorerAsync(bool force = false)
    {
        if (IsFolderWorkspace) return;
        if (!force && loadedExplorerProjectId == ProjectWorkspace.CurrentProjectId) return;
        try
        {
            workflows = await ProjectWorkspace.Catalog.ListDraftsAsync();
            archivedWorkflows = await ProjectWorkspace.CatalogFileOperations.ListArchivedDraftsAsync();
            profiles = ProjectWorkspace.AgentProfiles.List();
            skills = ProjectWorkspace.Skills.List();
            functions = ProjectWorkspace.Functions.List();
            explorerError = null;
            loadedExplorerProjectId = ProjectWorkspace.CurrentProjectId;
        }
        catch (InvalidOperationException) { workflows = []; archivedWorkflows = []; profiles = []; skills = []; functions = []; loadedExplorerProjectId = ProjectWorkspace.CurrentProjectId; }
        catch { explorerError = "Some project files could not be loaded. The editor remains available."; loadedExplorerProjectId = ProjectWorkspace.CurrentProjectId; }
        await InvokeAsync(StateHasChanged);
    }

    private Task RefreshExplorer() => LoadExplorerAsync(force: true);

    private void LocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        _ = InvokeAsync(async () =>
        {
            if (disposed) return;
            loadedExplorerProjectId = null;
            await LoadExplorerAsync();
            try { await JavaScript.InvokeVoidAsync("vawStudioTheme.navigationComplete"); }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
            StateHasChanged();
        });
    }

    private async Task ChangeProject(string id)
    {
        if (string.IsNullOrWhiteSpace(id)) return;
        try
        {
            var project = ProjectStore.GetActive(id);
            if (project.IsFolderBacked)
            {
                OpenWorkspace.Open(id);
                Navigation.NavigateTo($"/source-project/folder/{Uri.EscapeDataString(id)}");
            }
            else Navigation.NavigateTo($"/projects/{Uri.EscapeDataString(id)}");
        }
        catch (Exception exception) when (exception is KeyNotFoundException or InvalidOperationException or IOException)
        { routeStatus = exception.Message; }
    }

    private async Task SelectWorkflow(string id)
    {
        if (ActivePage == "workflow")
        {
            var result = await JavaScript.InvokeAsync<int>("vawStudioIde.selectWorkflow", id);
            if (result == -1)
            {
                routeStatus = "Save or discard the current draft before switching workflows.";
                return;
            }
            if (result == 0)
            {
                // Explorer can discover source created after this editor loaded its selector.
                // Open that saved document through the route instead of rejecting a fresh entry.
                routeStatus = null;
                Navigation.NavigateTo($"{WorkflowRoute}?workflow={Uri.EscapeDataString(id)}");
                return;
            }

            // The selector's async Blazor change handler loads the selected draft in place.
            // Navigating to a query-only URL here races that load against page initialization.
            selectedWorkflowId = id;
            routeStatus = null;
            return;
        }

        routeStatus = null;
        Navigation.NavigateTo($"{WorkflowRoute}?workflow={Uri.EscapeDataString(id)}");
    }

    [JSInvokable]
    public async Task WorkflowSelectionChanged(string id)
    {
        selectedWorkflowId = id;
        routeStatus = null;
        try { await JavaScript.InvokeVoidAsync("vawStudioIde.applySelectedWorkflow", id); }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
    }

    private static string WorkflowName(WorkflowDefinition definition) => string.IsNullOrWhiteSpace(definition.DisplayName) ? definition.WorkflowId : definition.DisplayName;
    private sealed record ExplorerContextTarget(string Category, string? WorkflowId);

    public void Dispose()
    {
        disposed = true;
        Navigation.LocationChanged -= LocationChanged;
        selfReference?.Dispose();
    }
}
