@if (Node.IsDirectory)
{
    <details class="vaw-project-tree-directory @(IsClipboardPath(NodePath) ? "is-cut" : "")" open
        @oncontextmenu="args => ContextDirectory(args)" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">
        <summary><span class="vaw-project-tree-icon" aria-hidden="true">▾</span>@Node.Name</summary>
        <ul>
            @foreach (var child in Node.Children)
            {
                <li @key="child.Name + child.File?.Path">
                @if (MatchesFilter(child))
                {
                <ProjectFileTreeItem Node="@child" PathPrefix="@NodePath" SelectedPath="@SelectedPath" ClipboardPath="@ClipboardPath" ClipboardIsCut="@ClipboardIsCut" WorkflowNames="@WorkflowNames" FileNames="@FileNames" Filter="@Filter"
                        CanOpenFiles="@CanOpenFiles" OnOpenWorkflow="@OnOpenWorkflow" OnOpenSkill="@OnOpenSkill" OnOpenAgentProfile="@OnOpenAgentProfile" OnOpenGraphFunction="@OnOpenGraphFunction" OnOpenDocumentation="@OnOpenDocumentation" OnContextMenu="@OnContextMenu" />
                }
                </li>
            }
        </ul>
    </details>
}
else if (Node.File is { Kind: "workflow" } file)
{
    var selected = file.Path == SelectedPath;
    <button type="button" class="vaw-project-tree-file @(selected ? "is-selected" : "") @(IsClipboardPath(file.Path) ? "is-cut" : "")"
            aria-current="@(selected ? "page" : "false")" aria-label="@($"Open workflow {WorkflowLabel(file)}")" title="@file.Path"
            disabled="@(!CanOpenFiles)" @onclick="() => OnOpenWorkflow.InvokeAsync(file.Id)"
            @oncontextmenu="args => ContextFile(args, file)" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">
        <StudioFileIcon Kind="workflow" />
        <span class="vaw-project-tree-file-name">@WorkflowLabel(file)</span>
    </button>
}
else if (Node.File is { Kind: "skill" } skillFile)
{
    var selected = skillFile.Path == SelectedPath;
    <button type="button" class="vaw-project-tree-file @(selected ? "is-selected" : "") @(IsClipboardPath(skillFile.Path) ? "is-cut" : "")"
            aria-current="@(selected ? "page" : "false")" aria-label="@($"Edit skill {Node.Name}")" title="@skillFile.Path"
            disabled="@(!CanOpenFiles)" @onclick="() => OnOpenSkill.InvokeAsync(skillFile)"
            @oncontextmenu="args => ContextFile(args, skillFile)" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">
        <StudioFileIcon Kind="skill" />
        <span class="vaw-project-tree-file-name">@FileLabel(skillFile)</span>
    </button>
}
else if (Node.File is { Kind: "agent-profile" } profileFile)
{
    var selected = profileFile.Path == SelectedPath;
    <button type="button" class="vaw-project-tree-file @(selected ? "is-selected" : "") @(IsClipboardPath(profileFile.Path) ? "is-cut" : "")"
            aria-current="@(selected ? "page" : "false")" aria-label="@($"Edit agent profile {Node.Name}")" title="@profileFile.Path"
            disabled="@(!CanOpenFiles)" @onclick="() => OnOpenAgentProfile.InvokeAsync(profileFile)"
            @oncontextmenu="args => ContextFile(args, profileFile)" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">
        <StudioFileIcon Kind="agent" />
        <span class="vaw-project-tree-file-name">@FileLabel(profileFile)</span>
    </button>
}
else if (Node.File is { Kind: "graph-function" } graphFunctionFile)
{
    var selected = graphFunctionFile.Path == SelectedPath;
    <button type="button" class="vaw-project-tree-file @(selected ? "is-selected" : "") @(IsClipboardPath(graphFunctionFile.Path) ? "is-cut" : "")"
            aria-current="@(selected ? "page" : "false")" aria-label="@($"Edit graph function {Node.Name}")" title="@graphFunctionFile.Path"
            disabled="@(!CanOpenFiles)" @onclick="() => OnOpenGraphFunction.InvokeAsync(graphFunctionFile)"
            @oncontextmenu="args => ContextFile(args, graphFunctionFile)" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">
        <StudioFileIcon Kind="function" />
        <span class="vaw-project-tree-file-name">@FileLabel(graphFunctionFile)</span>
    </button>
}
else if (Node.File is { Kind: "documentation" } documentFile)
{
    var selected = documentFile.Path == SelectedPath;
    <button type="button" class="vaw-project-tree-file @(selected ? "is-selected" : "") @(IsClipboardPath(documentFile.Path) ? "is-cut" : "")"
            aria-current="@(selected ? "page" : "false")" aria-label="@($"Edit Markdown document {Node.Name}")" title="@documentFile.Path"
            disabled="@(!CanOpenFiles)" @onclick="() => OnOpenDocumentation.InvokeAsync(documentFile)"
            @oncontextmenu="args => ContextFile(args, documentFile)" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">
        <StudioFileIcon Kind="documentation" />
        <span class="vaw-project-tree-file-name">@FileLabel(documentFile)</span>
    </button>
}
else if (Node.File is { } readOnlyFile)
{
    <span class="vaw-project-tree-file is-read-only" aria-label="@($"{AssetLabel(readOnlyFile.Kind)} {Node.Name}, read only")"
          title="@ReadOnlyMessage(readOnlyFile.Kind)">
        <StudioFileIcon Kind="@IconKind(readOnlyFile.Kind)" />
        <span class="vaw-project-tree-file-name">@Node.Name</span>
    </span>
}

@code {
    [Parameter, EditorRequired] public StudioProjectFileTreeNode Node { get; set; } = null!;
    [Parameter] public string PathPrefix { get; set; } = "";
    [Parameter] public string Filter { get; set; } = "";
    [Parameter] public string? ClipboardPath { get; set; }
    [Parameter] public bool ClipboardIsCut { get; set; }
    [Parameter] public string? SelectedPath { get; set; }
    [Parameter] public IReadOnlyDictionary<string, string> WorkflowNames { get; set; } = new Dictionary<string, string>();
    [Parameter] public IReadOnlyDictionary<string, string> FileNames { get; set; } = new Dictionary<string, string>();
    [Parameter] public bool CanOpenFiles { get; set; }
    [Parameter] public EventCallback<string> OnOpenWorkflow { get; set; }
    [Parameter] public EventCallback<StudioProjectFile> OnOpenSkill { get; set; }
    [Parameter] public EventCallback<StudioProjectFile> OnOpenAgentProfile { get; set; }
    [Parameter] public EventCallback<StudioProjectFile> OnOpenGraphFunction { get; set; }
    [Parameter] public EventCallback<StudioProjectFile> OnOpenDocumentation { get; set; }
    [Parameter] public EventCallback<StudioProjectTreeContext> OnContextMenu { get; set; }

    private string NodePath => string.IsNullOrEmpty(PathPrefix) ? Node.Name : $"{PathPrefix}/{Node.Name}";
    private bool HasFilter => !string.IsNullOrWhiteSpace(Filter);
    private bool MatchesFilter(StudioProjectFileTreeNode node) => MatchesFilter(node, PathPrefix);
    private bool MatchesFilter(StudioProjectFileTreeNode node, string prefix)
    {
        if (!HasFilter) return true;
        var query = Filter.Trim();
        var path = string.IsNullOrEmpty(prefix) ? node.Name : $"{prefix}/{node.Name}";
        var displayName = node.File is { } file ? FileNames.GetValueOrDefault(file.Path, node.Name) : node.Name;
        var workflowName = node.File is { Kind: "workflow" } workflow
            ? WorkflowNames.GetValueOrDefault(workflow.Id, Path.GetFileNameWithoutExtension(node.Name)) : "";
        return node.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
            || path.Contains(query, StringComparison.OrdinalIgnoreCase)
            || displayName.Contains(query, StringComparison.OrdinalIgnoreCase)
            || workflowName.Contains(query, StringComparison.OrdinalIgnoreCase)
            || node.Children.Any(child => MatchesFilter(child, path));
    }
    private bool IsClipboardPath(string path) => ClipboardIsCut && string.Equals(ClipboardPath, path, StringComparison.OrdinalIgnoreCase);
    private Task ContextDirectory(Microsoft.AspNetCore.Components.Web.MouseEventArgs args) =>
        OnContextMenu.InvokeAsync(new(NodePath, null, true, args.ClientX, args.ClientY));
    private Task ContextFile(Microsoft.AspNetCore.Components.Web.MouseEventArgs args, StudioProjectFile file) =>
        OnContextMenu.InvokeAsync(new(file.Path, file, false, args.ClientX, args.ClientY));

    private static string IconKind(string kind) => kind switch
    {
        "workflow" => "workflow",
        "skill" => "skill",
        "agent-profile" => "agent",
        "graph-function" => "function",
        "documentation" => "documentation",
        "mcp" => "mcp",
        _ => "file"
    };

    private string WorkflowLabel(StudioProjectFile file) =>
        $"{WorkflowNames.GetValueOrDefault(file.Id, Path.GetFileNameWithoutExtension(Node.Name))}.workflow";
    private string FileLabel(StudioProjectFile file) => FileNames.GetValueOrDefault(file.Path, Node.Name);

    private static string ReadOnlyMessage(string kind) => kind switch
    {
        "skill" => "Skill files are editable as new immutable revisions.",
        "agent-profile" => "Agent profile revisions are editable as new immutable source versions.",
        "graph-function" => "Graph function revisions are editable as new immutable source versions.",
        _ => "This project asset is visible but not editable in folder mode yet."
    };

    private static string AssetLabel(string kind) => kind switch
    {
        "skill" => "Skill",
        "agent-profile" => "Agent preset",
        "graph-function" => "Graph function",
        _ => "Project asset"
    };
}
