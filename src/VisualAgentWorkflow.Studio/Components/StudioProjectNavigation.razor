@inject StudioProjectStore Projects
@inject NavigationManager Navigation

<nav class="vaw-studio-navigation" aria-label="Project and Studio navigation">
    <label class="vaw-project-picker">Project
        <select aria-label="Current project" value="@ProjectId" @onchange="ChangeProject">
            @foreach (var project in Projects.List().Where(project => !project.IsArchived))
            {
                <option value="@project.Id">@project.Name</option>
            }
        </select>
    </label>
    <a href="/projects/@ProjectId">Workflow editor</a>
    <a href="/projects/@ProjectId/agents">Agent Designer</a>
    <a href="/projects/@ProjectId/skills">Skill library</a>
    <a href="/projects/@ProjectId/functions">Function library</a>
    <a href="/projects">Projects</a>
    <span aria-hidden="true">·</span>
    <a href="/mcp">MCP environment</a>
    <a href="/settings">Model environment</a>
    <a href="/observe">Observe a consumer service</a>
    <StudioThemePicker />
</nav>

@code {
    [Parameter, EditorRequired] public string ProjectId { get; set; } = StudioProjectStore.DefaultProjectId;

    private void ChangeProject(ChangeEventArgs args)
    {
        var projectId = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(projectId)) return;
        Navigation.NavigateTo($"/projects/{Uri.EscapeDataString(projectId)}", forceLoad: true);
    }
}
